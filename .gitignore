# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# ----------------------------------------------------------------------
# keel-ai-toolkit additions
# ----------------------------------------------------------------------

# Derived indexes (rebuilt from .sysml files — never source of truth)
.index/
*.kuzu/

# SysMLv2 pilot implementation cache (if used)
.sysml-cache/

# Environment
.env
.env.local

# Editor
.vscode/settings.json
*.swp

# OS
.DS_Store
Thumbs.db

# Node tooling (for the eventual GUI)
node_modules/
.next/
.turbo/

# Logs
*.log

# keel serve local runtime settings (per-clone preferences, e.g. the agent-bridge toggle)
.keel-serve.json

# Python bytecode cache
__pycache__/
*.pyc

# Generated computed-view artifacts — regenerate on demand, never commit as truth (§2.1/D0015/D0085)
/*.html
/orient_output.json
.playwright-mcp/

# viewer screenshot artifacts (never source)
architect-sure-*.png

# personal per-project Claude Code overrides (local experiments / prototype hooks)
.claude/settings.local.json

# Machine-local acting-actor binding (D0129). Per-machine by design: committing it would
# re-create the shared-default provenance defect it exists to remove (issue072).
.keel/

# Write-path scratch (issue184/issue185). A crashed writer can leave either behind, and `git add -A`
# is the standing instruction here - so an un-ignored lock file would get COMMITTED and then block
# every clone that pulled it.
.keel-write-lock
*.keel-lock
*.keel-tmp
scripts/exec_brief/decision-facts.json
scripts/exec_brief/__pycache__/
