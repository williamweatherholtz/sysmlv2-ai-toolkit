// CLI COMMAND FACTS (D0271) - every dispatched verb and every `show` lens as an authored fact, so
// 'these are variations of one idea' is queryable (family), 'a status command must not write' is testable
// (effect), and a rename can be a declared state (stability). Deferred by D0271 until the lens ruling,
// ruled by D0273, unauthored until issue344. THE HOME: keel --help renders from the Rust mirror
// (cli_facts.rs) and guard `cli-surface-declared` holds that mirror and the dispatch equal to THIS file
// both ways, so a fact added here without a dispatch arm, or an arm without a fact, is a violation.
package EngineCliFacts {
    private import EngineElement::*;
    private import EngineCli::*;

    // ---- governance ----
    part cliAccept : CliCommand { :>> id = "e7c41499-b231-4539-95aa-1f289a725824"; :>> title = "keel accept"; :>> createdAt = "2026-09-02"; :>> createdBy = "claudeOpus5"; :>> name = "accept"; :>> family = "governance"; :>> effect = CliEffect::writes; :>> stability = CliStability::stable; :>> invocation = "<decision> --note TEXT --by <person> --date YYYY-MM-DD"; :>> synopsis = "record a human's acceptance of a proposed Decision; refused for an AI actor"; }
