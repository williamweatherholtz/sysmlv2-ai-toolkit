    verification c14StandupGate : Test { :>> id = "0d8004d5-0814-64d5-9b3e-0000003004d5"; :>> title = "Sprint 338 standup gate"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Approach: correct the sprint-332 clause in place with the correction visible, exactly as sprints 328 and 332 did, then judge the final two and read the pool back from the computed view for all three types rather than declaring completion from the pass count. No blockers."; }
    part c14StandupGateR1 : TestResult { :>> id = "0d8004d6-0814-64d6-9b3e-0000003004d6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }

    verification c14ImplementGate : Test { :>> id = "0d8004d7-0814-64d7-9b3e-0000003004d7"; :>> title = "Sprint 338 implement gate"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::analyze; :>> procedureText = "ALL THREE OF MY CORRECTIONS HAVE ONE SHAPE: I asserted a defect where a governing element had already answered it. Sprint 328 — a comment claiming a gate was PENDING, believed over the passing acceptance result three lines below. Sprint 332 — the pair-to-kinds mapping declared impossible after checking rules.sysml, while /api/grammar was computing it. Sprint 338 — the observed grammar faulted as an oversight, while D0127 had chosen it deliberately and supplied the escape. THE DISCIPLINE THIS YIELDS is narrower and more useful than 'verify claims': before faulting a DESIGN, find the element that GOVERNS it and read that. A requirement's defect may be a Decision's deliberate choice, and the corpus is worth less than nothing if it records the choice as an error. Every one of the three corrections is left visible in the critique it corrects, with what I claimed, where I got it, and what the check found — because a reader of 201 critique results needs to know that this corpus can contain a confident false claim, and how such a claim gets caught."; }
    part c14ImplementGateR1 : TestResult { :>> id = "0d8004d8-0814-64d8-9b3e-0000003004d8"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }

    verification c14ReviewGate : Test { :>> id = "0d8004d9-0814-64d9-9b3e-0000003004d9"; :>> title = "Sprint 338 review gate"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Reviewed across all fourteen passes: 50 elements examined, 201 lenses, 127 fail and 74 pass, no code changed in any of them. WHAT THIS DOES AND DOES NOT MEAN. It means a judgment now exists against every Need, SystemRequirement and Decision in this model that an independent critic is permitted to judge, each with its reasoning, its evidence, and a named judge — the EXAMINED dimension of `keel verification`, which sprint 313 split from EXERCISED precisely so neither could stand in for the other. It does NOT mean the model is good, that any finding has been acted on, or that the human agrees with one of them: 127 failing critiques are 127 unresolved findings, and the model says so — `keel suspect` now reports every one of those elements as carrying an unresolved failing critique, which is the honest consequence of examining them rather than a regression. THE 87 BLOCKED ELEMENTS ARE THE REAL REMAINING GAP and no amount of work by me can close it: critique-policy.toml requires judgedBy to differ from the element's author, I authored all 87, and an AI adopting a second actor identity to judge its own work would be exactly the fabricated independence the rule exists to prevent."; }
    part c14ReviewGateR1 : TestResult { :>> id = "0d8004da-0814-64da-9b3e-0000003004da"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }

    verification c14CloseOutGate : Test { :>> id = "0d8004db-0814-64db-9b3e-0000003004db"; :>> title = "Sprint 338 closeOut gate (autonomous, D0049)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Autonomous closeOut (D0049). CRITIQUE BACKFILL COMPLETE for this critic across all three governed types: 0 critiquable remaining, 87 blocked on an independent critic. Zero open issues; ready frontier empty; D0159 queued for acceptance. validate 366 clean; check-engine clean; 35 guards ALL PASS; no code changed in the fourteen passes. WHAT REMAINS, stated so it is not mistaken for done: the 87 blocked elements need a critic who is not claudeOpus5; 127 failing critiques are findings nobody has dispositioned; and `keel verification --pending` still reports the EXERCISED gap separately, which this backfill did not touch — examining a requirement is not running the system against it."; }
    part c14CloseOutGateR1 : TestResult { :>> id = "0d8004dc-0814-64dc-9b3e-0000003004dc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }

    verification c14RetroGate : Test { :>> id = "0d8004dd-0814-64dd-9b3e-0000003004dd"; :>> title = "Sprint 338 retro gate (autonomous, D0049)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::analyze; :>> procedureText = "Autonomous retro (D0049) under D0131's retroTrack, covering the fourteen-pass backfill as a unit. WELL: (1) the independence split was MEASURED before any critique was written, so across 201 lenses not one was wasted on an element the policy would discard; (2) three published claims were corrected in place with the correction visible, and each correction made the surviving finding sharper rather than smaller; (3) two controls were added at the point of error rather than noted as reminders — the batch writer refuses a name collision (after duplicate-identity caught one) and refuses a batch that would leave a target short of its required lens set (after that happened twice); (4) findings that only a corpus could show emerged: the critique-independence collision across two must-priority Needs, the same unwritten fixture named by six elements, warning-first promotion that has never once fired, and a Decision (D0119) whose non-delivery moves no computed number at all. AVOIDABLE-ISSUES across the run: three false-absence claims (all corrected), two under-covered targets (now controlled), one duplicate-name batch (now controlled), one shell heredoc quoting failure, two cp1252 console crashes in helper scripts, and one commit message mangled because backticks inside printf were command-substituted by bash. Every one was caught by a control or by reading a computed number back — none by care alone, which is the argument for the controls. Estimate 3 pts, delivered; 42 pts across the fourteen passes against 42 estimated."; }
    part c14RetroGateR1 : TestResult { :>> id = "0d8004de-0814-64de-9b3e-0000003004de"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
