        part storyPrePushBehindCheckDoDR1 : TestResult { :>> id = "641397e1-6405-4053-987a-74ff5abc1bbe"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "42e5c6b"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
