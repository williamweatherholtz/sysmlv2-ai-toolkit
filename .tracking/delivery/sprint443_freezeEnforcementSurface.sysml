    action def DeliveryRunS443 {
        action storyFreezeEnforcementSurface;
        verification storyFreezeEnforcementSurfaceDoD : Test { :>> id = "e66975c3-4d09-4b3b-8de8-cec9e33b4d69"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: dcFreezeEnforcementSurface (D0209 clause 2, the manager-inversion panel's second increment). issue236 proved a control could be silently disarmed by editing its DEFINITION; dcRulesUnderKeystone closed only the declared-rule leg (.engine/rules/). This extends the keystone lock (process_change guard) to the ENFORCEMENT SURFACE: a staged change to guard SOURCE (files defining any -> GuardReport guard: keel-cli/src/guards.rs, adherence.rs), to .githooks/, or to .github/workflows/*.yml now requires a co-committed #ProspectiveChange/#SafetyChange-marked Decision - a human-signed act. A SEPARATE is_enforcement_surface predicate keeps the intent legible next to is_process_def; keystone_violations and the scanned-count cover both. A COVERAGE AUDIT (unit test enforcement_surface_covers_every_guard_source) scans the real src/ tree for -> GuardReport and fails CI if any guard-defining file sits outside GUARD_SOURCE_FILES, so a NEW guard file cannot be added to escape the lock. D0211 (marked #ProspectiveChange) co-commits, satisfying the very lock it installs. VERIFIED: negative probe - staging keel-cli/src/guards.rs alone turned process-change RED naming the file (the exact issue236 self-modification shape, now caught); positive - co-staging marked D0211 turned it GREEN; two new lib tests pass; workspace clippy --all-targets clean; the impl landed at 087afa2f. RESIDUAL (stated, not hidden): the lock ensures a control CHANGES only by a signed act, not that a guard's logic was not gutted while keeping its name and severity - that stays with code review and the recurring control evaluation."; }
        part storyFreezeEnforcementSurfaceDoDR1 : TestResult { :>> id = "45287c6f-1951-4fc1-8a62-33437abeee33"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "087afa2f10c2dfdde6b014ebeab60c744da08d1d"; :>> judgedAt = "2026-08-23"; :>> judgedBy = "claudeFable5"; }
    }

    verification freezeEnforcementSurfaceRefineGate : Test { :>> id = "920bff74-749a-44d0-971b-fd05f76531db"; :>> title = "Sprint 443 refine gate (DoR)"; :>> createdAt = "2026-08-24"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. Delivers D0209 clause 2. issue236/sprint440 found the self-modification gap and closed only .engine/rules/; the guard source, hook config and CI workflows were still freely editable. Scope: extend the keystone to those three surfaces + a self-checking coverage audit. 2 points."; }
