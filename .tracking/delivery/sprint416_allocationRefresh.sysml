        part storyAllocationRefreshDoDR1 : TestResult { :>> id = "6d495806-5e81-469d-bf37-9653b9746158"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "ccc5269"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
    }

