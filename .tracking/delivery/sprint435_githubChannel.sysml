    part githubChannelStory : Story {
        :>> id = "02b3d6b7-2256-4aba-a704-9b719c0d9a87";
        :>> title = "Sprint 435: the channel with receipts (3 pts)";
        :>> createdAt = "2026-08-23"; :>> createdBy = "claudeFable5"; :>> kind = WorkKind::code; :>> priority = WorkPriority::p0; :>> owner = "claudeFable5"; :>> estimatedPoints = 3;
    }

    action def DeliveryRunS435 {
        action storyGithubChannel;
        verification storyGithubChannelDoD : Test { :>> id = "04b02bf4-b633-43bd-bc3e-11d90169e60a"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: the githubChannel build per accepted D0205. PIECES: (1) keel decision-card [NAME] [--proposed] - the decision's deciding context as JSON, reusing the deck's own parser (one extraction, two consumers); (2) the ownership guard's ACCEPT-TRANSFORM carve-out - the one sanctioned non-owner edit is exactly status proposed-to-accepted, recognized mechanically; the reverse flip and rider edits still violate (live reverse-flip probe RED, unit test pins all four cases); (3) githubRecorder enrolled in the actor registry (kind ai - it records human judgment under the delegation family, never supplies it) and github-actors.toml maps the GitHub login to the keel Person, refusing unmapped logins; (4) decision-issue.yml - a proposed decision landing on main opens a GitHub issue (short-name title, own-context body via open_decision_issues.py, blocks-work label, assigned so mobile push fires), idempotent on the embedded keel-decision marker; (5) decision-record.yml + record_decision.sh - the hardened recorder per the red-team checklist: allowlisted login as the FIRST condition, body via env with strict first-line parse, keel binary never an agent, eyes-reaction acknowledgment, in-workflow gate of record (GITHUB_TOKEN pushes do not retrigger ci.yml - stated in the commit template; audit-history re-derives), merge-only push retries, receipt comment quoting exactly what entered git keyed receipt-for-comment for idempotency, auto-close as the done-signal, and a 30-minute sweeper re-driving missed gestures; rejection is acknowledged-in-thread v1 scope, stated. (6) D0206 retireInbox recorded proposed - the dry-run subject whose acceptance FROM ITS OWN ISSUE is the cutover proof. FOUND AND FIXED BY OUR OWN GUARD DURING THE BUILD: the quote-substance scanner treated a contraction's apostrophe as the closing quote - the real D0205 acceptance quoting 'yep let's go' scanned as 7 chars and went RED; the scanner now closes only at an apostrophe not followed by a letter, with the incident pinned in the unit test. VERIFIED: local dry-runs of the issue script (mocked gh, body and assignee asserted), bash -n on the recorder, YAML lints, decision-card read-backs, suite 10/10, clippy clean, all 47 guards green."; }
        part storyGithubChannelDoDR1 : TestResult { :>> id = "b152ada4-ff8b-485b-93d4-2ac9fde901c4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f51da898d6bdb60fba6ff9d8ee5ee0becab3698c"; :>> judgedAt = "2026-08-23"; :>> judgedBy = "claudeFable5"; }
    }

    verification githubChannelRefineGate : Test { :>> id = "fb4da06d-5c50-4ece-9bf2-063591a4d0a8"; :>> title = "Sprint 435 refine gate (DoR)"; :>> createdAt = "2026-08-23"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. D0205 accepted on their words is the charter; the dry-run gating (D0206 accepted from its own issue before anything old retires) is the acceptance clause. 3 points."; }
