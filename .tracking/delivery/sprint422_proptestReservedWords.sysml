        verification storyProptestReservedWordsDoD : Test { :>> id = "0714648b-cee0-4496-9555-5809e74d4a8e"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: dcProptestReservedWords (resolves issue225). THE DEFECT: the sprint-421 push went CI-red on prop_part_string_attr - the identifier strategy [a-zA-Z_][a-zA-Z0-9_]{0,31} generated the reserved word 'doc' and the parser CORRECTLY refused it as a bare name; nothing in the push touched the parser, the random seed simply found a latent generator defect that could redden any future push. THE ROOT FIX: the lexer exposes is_reserved_word - implemented as a query against keyword_or_ident itself, never a copied list, so the predicate cannot drift from the grammar - and the proptest strategy filters through it; a deterministic regression pins both halves (reserved words are recognized; 'part doc' is a parse error). VERIFIED: keel-parser suite green including the new regression; full workspace suite 10/10 result-ok; clippy pedantic+nursery clean."; }
        part storyProptestReservedWordsDoDR1 : TestResult { :>> id = "d4c5784f-dacd-4f38-abc7-52b27b78f438"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "90e38d6c1e7c3d87fd92dd6b13a0d14888b60562"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
    }

    verification proptestReservedWordsRefineGate : Test { :>> id = "e1c53e72-7da2-4ecf-a6d2-6040a2a211fc"; :>> title = "Sprint 422 refine gate (DoR)"; :>> createdAt = "2026-08-22"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. D0047 correction: CI red on the prior push must clear at the root, not by re-running until the seed misses. 1 point."; }
