    verification proptestReservedWordsStandupGate : Test { :>> id = "13d51d8c-4719-4b85-bb43-33f45fc1ecef"; :>> title = "Sprint 422 standup gate"; :>> createdAt = "2026-08-22"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Approach: fix the GENERATOR, not the parser - a reserved bare name is correctly an error (kernel semantics), so the property under test ('any valid identifier parses') needed its input domain corrected to match the grammar. Single-source: the filter asks the lexer, the lexer asks its own keyword match. No blockers."; }
    part proptestReservedWordsStandupGateR1 : TestResult { :>> id = "964cb12d-0ca6-4278-b9e6-4343952d436b"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "90e38d6c1e7c3d87fd92dd6b13a0d14888b60562"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
    verification proptestReservedWordsImplementGate : Test { :>> id = "ecf93b23-d6bd-4c13-85e6-fc8b45f1bf41"; :>> title = "Sprint 422 implement gate"; :>> createdAt = "2026-08-22"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::test; :>> procedureText = "Verified by running: cargo test -p keel-parser (proptest suites + the new reserved_word_is_not_a_bare_identifier regression, all green); full workspace suite 10 result-ok lines, zero failures; clippy clean after one doc-paragraph lint. The failing case is now IMPOSSIBLE by construction rather than improbable by seed."; }
    part proptestReservedWordsImplementGateR1 : TestResult { :>> id = "3c988e91-afbb-4bc5-9151-d9bcccd965b3"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "90e38d6c1e7c3d87fd92dd6b13a0d14888b60562"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
    verification proptestReservedWordsReviewGate : Test { :>> id = "1c5550b9-5a7c-434f-86bc-30f02ffb2d4d"; :>> title = "Sprint 422 review gate — three passes per D0172"; :>> createdAt = "2026-08-22"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "PASS 1, CLAIMS: the CI failure text ('expected identifier, got Doc', keel-parser/tests/parser_proptest.rs:39) is quoted from the run 's log; the fix cites it. PASS 2, BOUNDARY: prop_filter discards ~23 strings out of the strategy's space - statistically negligible, and proptest reports filter rejection rates if they ever mattered. PASS 3, OWN DIFF: first doc comment tripped the too-long-first-paragraph lint - machine-caught, split. WHAT A REVIEWER SHOULD ATTACK: quoted-name support ('doc' as a QUOTED identifier is legal SysML v2) is absent from the parser entirely - out of this sprint's scope, visible in parser-coverage's skipped census if it ever bites an instance file."; }
