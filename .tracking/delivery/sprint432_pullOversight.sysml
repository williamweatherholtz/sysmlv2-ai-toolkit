        verification storyPullOversightDoD : Test { :>> id = "b99149f2-5e1c-4ba5-a808-8a1f8044fac0"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: D0204 pullOversight, accepted on their verbatim words ('none of that. I don't need governance, you do. I don't need a schedule, or due items. highlight blockers and the most critical items, but I'm not here to subscribe to your processes') - a direction reversal of the obligation semantics in D0200 clauses 3 and 5 and the D0049 sitting-gate framing, one day after signature, on contact with what OPTION A asked OF THEM. RETIRED (the ask): the deck's sitting section, deep-review sampling labels, and batch-acknowledge solicitation; authority-queue's perSittingReview row (the queue now lists ONLY what genuinely blocks on their judgment); the process-change oversight throttle (nothing gates the AI's work on the human's attention cadence - a deliberate ABSENT-BY-DESIGN comment marks the spot). KEPT (the record): sitting-coverage with its read/batch split, the sittingOverrideRateIndicator, the batch-ack API verdict for voluntary use, and sittings reviewable on demand through the console - pull, never push. CLAUDE.md rewritten: the human's only inherent gates are direction decisions that block work and confirmations they choose to give. Chat reporting contract (memory + D0203 addendum in practice): blockers, then critical items, then stop. VERIFIED: deck read back at 5 items (2 blockers + 3 findings, immediately dispositioned under D0165 to leave 2 true blockers), zero sitting content; authority-queue read back listing only decisions and undispositioned findings; suite 10/10, clippy clean."; }
        part storyPullOversightDoDR1 : TestResult { :>> id = "600760bc-ccc3-4823-899f-7510b343af7d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "7ef444399f80b9ee54fe420555d9319607818865"; :>> judgedAt = "2026-08-23"; :>> judgedBy = "claudeFable5"; }
    }

    verification pullOversightRefineGate : Test { :>> id = "1315d307-0f76-49cf-b98e-c46925606701"; :>> title = "Sprint 432 refine gate (DoR)"; :>> createdAt = "2026-08-23"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. Their words are the charter and the acceptance. In scope: every surface that pushed obligations at them; out of scope: any record or computation - detection strength must be provably unchanged. 2 points."; }
