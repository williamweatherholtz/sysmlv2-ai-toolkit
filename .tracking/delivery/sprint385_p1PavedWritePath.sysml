    part p1PavedWritePathCloseOutGateR1 : TestResult { :>> id = "22e8f2ce-3994-4311-b73c-ae15d2c9622d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "894e394"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    verification p1PavedWritePathRetroGate : Test { :>> id = "16fe1a66-510a-4e9b-9d64-fe0357f7b5e3"; :>> title = "Sprint 385 retro gate (autonomous, D0049)"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::analyze; :>> procedureText = "Autonomous retro (D0049). AVOIDABLE-ISSUE SCAN under rcRecurrence: (1) doc-comment severing by insertion recurred (occurrence two THIS PROGRAM: dispositions in sprint 383, actor::resolve here) - per D0172 second-occurrence this now carries its preventing change: insertions above a documented item are made ABOVE the doc comment, stated as the mechanical rule; clippy's missing-errors-doc is the backstop that caught both. (2) The live-probe-shadowed-by-earlier-layer pattern (accept channel refusing before the write layer could be observed) is a first: the practice - when layers stack, each layer gets its own test at its own seam - is recorded here. WELL: (1) the channel control REFUSING ITS OWN AUTHOR is the strongest live evidence a control can produce; (2) deriving the never-exempt set from the declared table killed the hand-list drift class the panel flagged; (3) reading the accepted decision texts as the spec (not the proposal summary) caught scope the summary compressed away - the charter notes were implemented, not just the headlines. Estimate 13 pts, delivered."; }
    part p1PavedWritePathRetroGateR1 : TestResult { :>> id = "5c78d2ee-8c80-4f45-a0dc-23c33722803e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "894e394"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
