    verification p1PavedWritePathStandupGate : Test { :>> id = "d6a393f6-0d56-40df-85ef-f8191cdc13c8"; :>> title = "Sprint 385 standup gate"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Approach: enforcement points live where they already fire - the tiers in hook pre-write, the matcher in hook pre-bash, the human-channel refusals INSIDE the write functions under the lock (no caller or transport can route around them), rules in the three gate surfaces that already exist. The never-exempt set is DERIVED from a declared table per d0178's own charter note, so apply-review and future judgment ops are covered without a hand list. Session-binding on the override is realized as single-use + path-bound + 900s TTL + consumed-by-session recorded, because a CLI cannot know the harness session a priori - stated in the code where the deviation lives."; }
    part p1PavedWritePathStandupGateR1 : TestResult { :>> id = "d0832f73-d221-4fc3-9459-e66e525c6253"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "894e394"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    verification p1PavedWritePathImplementGate : Test { :>> id = "64852bd8-1ac3-47b2-987a-e2a743dc0e6d"; :>> title = "Sprint 385 implement gate"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::test; :>> procedureText = "Every tier and branch RUN: strict scaffold - tier1 deny, tier2 ask, control-plane ask, override arm/consume/re-deny cycle with the obligation file read back; guided self-build - advisory lines for the same probes; the matcher probed with eleven commands including the quoted-prose negative; `keel accept` refused THIS session (agent markers, no TTY); rules --enforce clean over the real tree; the K6 write-layer refusals unit-tested (AI refused, unregistered refused, Person passes, method=test unaffected). Notable: the live accept-as-AI probe was SHADOWED by the channel layer refusing first - correct ordering, and the write layer got its own tests instead of a weaker live claim."; }
    part p1PavedWritePathImplementGateR1 : TestResult { :>> id = "10ddf2c3-ca6a-45a9-b420-eea937be5719"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "894e394"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    verification p1PavedWritePathReviewGate : Test { :>> id = "5aec4c09-a6e0-4172-9e05-8347c033228b"; :>> title = "Sprint 385 review gate — three passes per D0172"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "PASS 1, CLAIMS vs computed/emitted: every verdict above is from a run or a test, none from reading; 220 tests, clippy 0 after twelve real findings (two severed doc comments, two indexing panics, a dead tokenizer arm). PASS 2, BOUNDARY: the override expires (TTL branch), misses on a different path (path-bound branch), and its obligation write failure degrades to the ledger with a printed sync obligation; an unresolvable actor skips the tracked red-yield record entirely rather than fabricating createdBy. PASS 3, OWN DIFF: the tokenizer's dead arm and a no-op push/pop pair were this sprint's own code, caught by clippy and removed. WHAT A REVIEWER SHOULD ATTACK: python-driven writes (io.open in a Bash-run script) bypass the Write|Edit matcher entirely - acknowledged in the proposal (friction, not proof; layer 3 is the guarantee) and visible in this very sprint's own workflow; the strict-profile Bash tier narrows it downstream, and the fire-ledger records what fires here."; }
    part p1PavedWritePathReviewGateR1 : TestResult { :>> id = "c2f5c356-1509-4487-be58-3f8136f965f7"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "894e394"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
