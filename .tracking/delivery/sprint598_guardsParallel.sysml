    verification guardsParallelRetroGate : Test { :>> id = "ff3da013-c19a-4b26-8c14-a736a5955afd"; :>> title = "Sprint 598 retro gate (autonomous, D0049)"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::analyze; :>> procedureText = "AVOIDABLE-ISSUE SCAN HELD. One process finding: the pre-bash hook refused two heredocs carrying a backslash inside Python source - D0309 doing what it says (issue372 tracks the class), and each cost one retry to the Write tool; no new item. One measurement finding kept in the sprint rather than deferred: parallelism exposed a memo that was correct only because callers were serial (fingerprint::of), the class 'a cache validated by the caller's discipline' - carried into dcOneCorpusPerProcess, whose corpus cache must be validated by the file's own (len, mtime), never by the caller's order; no new item."; }
