        :>> id = "bb7b4a13-9253-4f5a-9278-cd6cd985f81e";
        :>> title = "Sprint 611: Sprint 611 makes the checksum a normal part of the release (dcReleaseAssetsCarryChecksums, resolves issue417 and issue418) under D0385: release.yml hashes each asset in the job that built it and publishes the hash beside it, a checksums job verifies the published binaries against one SHA256SUMS before attaching it, guard release-checksums-published holds the workflow to that, guard wrapper-pin-checksummed warns when the pinned engine has no wrapper entry, the release skill names the step, and keel-wrapper.toml gains the 0.4.1 entries the pin has lacked since 2026-09-06. (3 pts)";
        :>> createdAt = "2026-09-08"; :>> createdBy = "claudeOpus5"; :>> kind = WorkKind::code; :>> priority = WorkPriority::p0; :>> owner = "claudeOpus5"; :>> estimatedPoints = 3;
