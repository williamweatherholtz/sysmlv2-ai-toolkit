    action def DeliveryRunS611 {
        action storyReleaseChecksums;
        verification storyReleaseChecksumsDoD : Test { :>> id = "9db08849-d726-4714-9587-f6d42c2c2dfc"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: a keel release cannot publish a binary without its SHA-256 beside it, and the release process names the checksum at every step that consumes it. Resolves issue417 and issue418. DO: .github/workflows/release.yml hashes each staged asset in the job that built it and attaches `<asset>.sha256` (sha256sum format) with the binary; a `checksums` job after the matrix downloads every `.sha256`, writes one `SHA256SUMS`, downloads the binaries and VERIFIES them against it with `sha256sum -c` before attaching it. Guard `release-checksums-published` (HARD) fails a workflow that attaches release assets without hashing them and publishing the hash; guard `wrapper-pin-checksummed` (WARN) reports when the pinned engine version has no entry in keel-wrapper.toml for a release asset the wrapper can download. The release skill's step 3 verifies the downloaded asset against the published SHA256SUMS and copies the entries into keel-wrapper.toml before step 4 records the Release; keel-wrapper.toml gains the 0.4.1 entries computed from the published assets. VERIFY: the guard tests read FAIL / clean and WARN / clean on constructed trees; `keel guard` is clean on this tree with both guards enforced; the release skill and deploy process text name the step."; }
        // RAN: release.yml hash steps + checksums job; guards 66/67 with 6 integration tests passing; keel-wrapper.toml 0.4.1 entries hashed from the assets gh release download v0.4.1 returned 2026-09-08; release skill and deploy process text name the step; keel guard exit 0 with 67 guards
        part storyReleaseChecksumsDoDR1 : TestResult { :>> id = "3eb2ff24-b2fd-490f-b8e4-e8ec973879dc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b54cf82ed6fc3da94262fcb7ea8eea80b3e8749a"; :>> judgedAt = "2026-09-08"; :>> judgedBy = "claudeOpus5"; }
    }

