    verification recallSecondHopStandupGate : Test { :>> id = "02b2b3b8-c16f-4527-9f40-876c6e93673f"; :>> title = "Sprint 593 standup gate"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "NO BLOCKER AND NO SIGNATURE OWED. Both Decisions are non-fork and carry no process-change or safety-change marker, so record-time standing consent applies and neither waits on the human. The four Decisions already in the authority queue (d0360 to d0363) are untouched by this work."; }
    // RAN: keel suite 570 passed 0 failed (receipt 91238ffbf2c6); recall_bench.py 49/50@13 and --hops 2 22/50; recall_ab.py 7/8 x3; validate 674; guard ALL PASS; clippy clean
