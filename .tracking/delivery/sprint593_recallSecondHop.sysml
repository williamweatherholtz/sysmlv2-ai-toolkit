        // RAN: keel suite 570 passed 0 failed (receipt 91238ffbf2c6); recall_bench.py 49/50 in mean 13 rows vs control+1hop 47/50 in mean 14, median 3, McNemar p=0.000; recall_bench.py --hops 2 22/50 vs control+1hop 8/50; recall_ab.py 7/8 x3 consecutive runs; validate 674; check-engine clean; guard ALL PASS; clippy -D warnings clean
        part storyRecallSecondHopDoDR1 : TestResult { :>> id = "df7901d9-e141-49cf-8f91-a195af75c245"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "018315ace003b7751ab5cb31f5ab653f2faa58bf"; :>> judgedAt = "2026-09-07"; :>> judgedBy = "claudeOpus5"; }
