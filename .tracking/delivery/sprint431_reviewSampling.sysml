    verification reviewSamplingStandupGate : Test { :>> id = "22862377-4588-4288-a91d-5498f08ee9fd"; :>> title = "Sprint 431 standup gate"; :>> createdAt = "2026-08-23"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Approach: the batch verdict is a machine token in the record's own text (the ceremony-guard convention family) because Test is frozen core and a schema field would need a CR for what a stated convention provides; sampling is seeded from HEAD so the ask is stable per tree; the throttle lives in the EXISTING process-change guard rather than a new one - the CHANGE route is already the gate the debt should hold. No blockers."; }
    part reviewSamplingStandupGateR1 : TestResult { :>> id = "7883d277-10c9-4fb7-8b43-a5373cd5a48c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "aa548b4231eb141f84ac0d89afeff885f2b933bb"; :>> judgedAt = "2026-08-23"; :>> judgedBy = "claudeFable5"; }
