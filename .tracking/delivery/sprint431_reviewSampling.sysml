    action def DeliveryRunS431 {
        action storyReviewSampling;
        verification storyReviewSamplingDoD : Test { :>> id = "eb92ac1a-f4bf-41b3-ba81-31d2072874d2"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: dcOversightRedesign (resolves issue228; delivers D0200 OPTION A, their deck-tap choice, the process-value panel's most convergent human-side recommendation). ALL FIVE CLAUSES: (1) SPLIT COUNTS - sitting-coverage reports readReviewed and batchAcknowledgedOnly as two numbers, never one (read back live: covered 107 = 43 read + 64 batch-only - the panel's 62-percent finding is now a permanent computed fact, with the classification basis stated: the machine token forward, the word batch for pre-D0200 history rather than laundering it into read). (2) JUDGEABLE DELTA CARDS - every sitting card renders the sprint's own DELIVERED text plus its pass/fail result census in a collapsible panel (open by default on deep-review cards): raw evidence, not narrative, per the deference research the panel cited. (3) N+M SAMPLING - per deck, 2 randomly-sampled (HEAD-seeded, so a reopened deck deals the same hand) + 1 risk-flagged (the sprint leaning hardest on guard/decision/schema surfaces) sittings are marked DEEP REVIEW; the rest offer an explicit Batch-acknowledge button recording the DISTINCT batch verdict (machine token, outcome pass, never counted as a read) with review-anyway still available. (4) OVERRIDE-RATE ALARM - sittingOverrideRateIndicator (computed, goal observe): fail-verdict share of READ reviews; live value 0.00 percent AT DECLARATION - the alarm state the HITL literature names, now on the dashboard instead of in a panel report. (5) ESCALATION WITH TEETH - the process-change guard refuses process-def commits while the DUE sitting queue's oldest item exceeds 14 days: the human's absence now changes system behavior (meaningful-human-control); delivery work and the review-recording writes that SHRINK the debt land freely, so no deadlock; fresh due sittings never block. VERIFIED: split counts and indicator read back live; deck greps show 1 risk-flagged + 2 random deep cards, 7 batch-ackable, delta panels with real censuses; full workspace suite 10/10 green; clippy pedantic+nursery clean after index-free sampling rewrite."; }
        part storyReviewSamplingDoDR1 : TestResult { :>> id = "1067ab22-a733-4a22-8642-b725f5e210b6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "aa548b4231eb141f84ac0d89afeff885f2b933bb"; :>> judgedAt = "2026-08-23"; :>> judgedBy = "claudeFable5"; }
    }

    verification reviewSamplingRefineGate : Test { :>> id = "0d766582-198e-4add-bf12-ce38026a10ea"; :>> title = "Sprint 431 refine gate (DoR)"; :>> createdAt = "2026-08-23"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. Chartered by their D0200 OPTION A tap. All five clauses in scope; recommended parameters N=2, M=1 adopted as drafted. Out of scope (stated): retro-editing historical batch reviews - they are CLASSIFIED honestly, never rewritten. 3 points."; }
