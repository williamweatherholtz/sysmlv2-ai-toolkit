    part boundViewsStory : Story {
        :>> id = "9451f74f-f87b-4b8f-a178-b34ed7f43850";
        :>> title = "Sprint 539: six advertised views served live with HTTP 200, the binding control failing by name when a binding is removed, and viewStatus stamped once (1 pt)";
        :>> createdAt = "2026-09-04"; :>> createdBy = "claudeOpus5"; :>> kind = WorkKind::code; :>> priority = WorkPriority::p0; :>> owner = "claudeOpus5"; :>> estimatedPoints = 1;
