        // RAN: wrapper_resolves_only_the_pin.rs hashes with sha2 and guards each scenario with sh_missing; 7 passed from PowerShell and 7 from git-bash; D0392
        part storySuiteVerdictIsShellIndependentDoDR1 : TestResult { :>> id = "df32df88-71e2-4126-9b78-5bdc822c4c18"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "4b75101b6cda8ce6a72768657ba4f3670fb4e0ac"; :>> judgedAt = "2026-09-08"; :>> judgedBy = "claudeOpus5"; }
