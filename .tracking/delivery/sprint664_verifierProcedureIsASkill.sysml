    verification verifierProcedureIsASkillStandupGate : Test { :>> id = "b9d08c07-2f4a-4827-8002-d49efb06d243"; :>> title = "Sprint 664 standup gate"; :>> createdAt = "2026-09-11"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Order: read the DoD and issue469/471 for the exact failure each names; write the skill with the mandate as its first section; patch the registry purpose and trigger through textpatch; record D0438 from a draft file with the process-change marker; sync-claude and diff the deployed copy; doc-sync CLAUDE.md sec 4; write the probe pair and run it on both known cases BEFORE the verifier is dispatched; then dispatch the verifier naming only the skill, keel-serve.exe, the receipt path, probe664's two cases and the full suite for the ten-minute case (no keel-cli/src moved, so the touched set is empty by construction); the recorder writes the ceremony from that receipt."; }
