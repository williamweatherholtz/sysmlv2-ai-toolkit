        :>> title = "Sprint 470: the shipped reference decision history gets its own package namespace, and the init smoke test finally records a fact (3 pts)";
        :>> createdAt = "2026-08-27"; :>> createdBy = "claudeOpus5"; :>> kind = WorkKind::code; :>> priority = WorkPriority::p0; :>> owner = "claudeOpus5"; :>> estimatedPoints = 3;
