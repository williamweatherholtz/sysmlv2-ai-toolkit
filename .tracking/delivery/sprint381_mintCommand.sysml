    action def DeliveryRunS381 {
        action storyMintCommand;
        verification storyMintCommandDoD : Test { :>> id = "e568b3a9-591f-424c-8564-2b26e43b2a35"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED BACKLOG ITEMS: dcMintCommand. Their instruction (st013): we should be programatically creating UUIDs, not via AI diligence. DONE AS SPECIFIED IN THE DoD: `keel mint [N]` prints N (default 1) engine-minted v4 UUIDs via the same gen_uuid the write API uses (OS CSPRNG, loud abort if unavailable), lowercase, one per line, nothing else on stdout; leading-dash, zero, non-numeric, and extra args are refused with usage at exit 2 per the positional_arg convention; advertised in the help catalogue under its coverage test. Tests: minted ids checked against GUARD 38'S OWN uuid_shaped predicate (one truth, not a re-derivation) with 10000-mint uniqueness; every refusal branch also RUN live against the built binary. 213 unit tests; clippy 0. THIS FILE'S OWN SIXTEEN IDS ARE `keel mint 16` OUTPUT - the first sprint record with no hand-authored identity. Doc-sync rode along: the bridged-session oversight advisory still told sessions to run the DELETED python generator (a Rust string literal, outside guard 39's doc-surface scope - residual noted in the retro); it now names `keel deck`."; }
        part storyMintCommandDoDR1 : TestResult { :>> id = "e54f73ac-b802-4ff2-9dec-c64ec9e3d2f2"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36f226e"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
    }

    verification mcRefineGate : Test { :>> id = "db11c035-4ea9-4f41-ab2b-ace76f5f888f"; :>> title = "Sprint 381 refine gate (DoR)"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. Top of the ready frontier (D0052 auto-follow), fully specified by dcMintCommandDoD, no human gate: the DoD names the flag semantics, the refusal behaviour, the catalogue line, and the exact tests. estimatedPoints=2."; }
    part mcRefineGateR1 : TestResult { :>> id = "0a3ba166-17e4-4da5-bf26-f7f70abe6c4e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36f226e"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }

    verification mcStandupGate : Test { :>> id = "4ea8bf6b-d397-49ac-9199-b7938ec21138"; :>> title = "Sprint 381 standup gate"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Approach: expose, do not reinvent - gen_uuid already exists, is CSPRNG-backed, and is what the write API mints with; the command is a thin printer over it, and the test asserts against guard 38's own predicate so the minter and the checker cannot drift apart. The bigger consumer (sprint scaffolding) is dcSprintScaffold, next on the frontier. No blockers."; }
    part mcStandupGateR1 : TestResult { :>> id = "f3120478-5dc9-4a49-b10b-b0cfc64e2680"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36f226e"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }

    verification mcImplementGate : Test { :>> id = "05f2e334-cbad-4698-a83c-fa2703f7be8a"; :>> title = "Sprint 381 implement gate"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::test; :>> procedureText = "Every claim from a run: `keel mint` prints one, `keel mint 3` prints three, `keel mint 0` / `abc` / `-3` / extra args each refuse with usage at exit 2 - all executed against the built binary, not read from the source (the dcAuthorViaWriteTool rule). uuid_shaped opened to pub(crate) so the test uses the guard's predicate itself. The stale python-generator reference in the oversight advisory was found by GREPPING THE PLACEMENT SITE before adding the catalogue line - the doc-sync habit applied to code strings."; }
    part mcImplementGateR1 : TestResult { :>> id = "0a1966ce-161f-4b45-a9fd-3505b7c16333"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36f226e"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }

    verification mcReviewGate : Test { :>> id = "b92c7225-5912-4f58-b977-54867ed91ce9"; :>> title = "Sprint 381 review gate — three passes per D0172"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "PASS 1, CLAIMS vs emitted/computed: 213 tests, clippy 0, live runs of all six argument shapes, help line present in the built binary's --help output. PASS 2, BOUNDARY: N has deliberately no upper cap because the DoD names none - a runaway `keel mint 999999999` prints for a while and stops, which is composable-tool behaviour, and inventing a cap would be authoring a constraint the item does not carry. PASS 3, OWN DIFF: the catalogue line first shipped without the leading two-space indent its siblings carry - caught by reading the emitted --help, not the source. WHAT A REVIEWER SHOULD ATTACK: guard 39 does not scan Rust string literals, which is where this sprint found its stale reference; noted in the retro as a scoped residual rather than silently absorbed."; }
    part mcReviewGateR1 : TestResult { :>> id = "3d725636-91ce-4fd7-b8a3-cb6af7c57145"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36f226e"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }

