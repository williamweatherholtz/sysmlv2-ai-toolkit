    part mcCloseOutGateR1 : TestResult { :>> id = "8b806c04-6d60-469c-b915-697432b26393"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36f226e"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }

    verification mcRetroGate : Test { :>> id = "7bd1fd74-5662-45dd-9945-79f08ccbd690"; :>> title = "Sprint 381 retro gate (autonomous, D0049)"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::analyze; :>> procedureText = "Autonomous retro (D0049). AVOIDABLE-ISSUE SCAN under rcRecurrence: the stale tool reference in a Rust STRING LITERAL is the issue196 family's residual - guard 39 scans the doc surface and deliberately not source comments (historical references there are truthful), but user-facing advisory STRINGS are doc surface that happens to live in code. FIRST occurrence in this location; if a second string-literal staleness appears, the guard grows a strings-in-advisories scope per D0172's second-occurrence rule. WELL: (1) the frontier item was executed exactly to its DoD with nothing invented beyond it - the no-cap choice cites the DoD's silence rather than my preference; (2) the sprint record itself consumed the deliverable, which is the cheapest possible field test; (3) the mint-vs-guard one-truth coupling (test uses the guard's predicate) prevents the drift class where a generator and its checker disagree. Estimate 2 pts, delivered."; }
    part mcRetroGateR1 : TestResult { :>> id = "dc8a7d28-3ffb-4eb6-bf1a-79a51ce24cda"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36f226e"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
