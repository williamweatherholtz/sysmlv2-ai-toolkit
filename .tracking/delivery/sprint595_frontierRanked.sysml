    action def DeliveryRunS595 {
        action storyFrontierRanked;
        verification storyFrontierRankedDoD : Test { :>> id = "332a2b94-fa7b-4e5d-ad40-997385224873"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: the refineAssessPriority step performed (D0258 clause A, D0311), the discharge D0052 names for a standing priority-inversion warning. DONE: the 34 ready items in EngineBuild are re-declared in computed-class order - resolver Issue severity, and retro recurrence where two namings make High and three or more Critical - with the previous declaration order kept WITHIN each class, so the judgment already embedded in that order is reassessed rather than discarded. The block comment names the signal, so the next reader can disagree with the ranking instead of reverse-engineering it. The reorder was performed by a script that refills only the slots the ready items already occupied and refuses to write unless the file's line multiset is unchanged - every other block, comment and done item stays byte for byte where it was. VERIFIED, read back from the computed view and not from the script's own report: keel show priority reports 0 inversions, down from 166, with eleven High-class items now at positions 1 to 11; keel validate 676 clean; guard ALL PASS with the priority-inversion guard silent; keel whats-next leads with dcProcessRemoveCommand."; }
        // RAN: keel show priority: 0 inversions (was 166), eleven High-class items at positions 1-11, read back from the computed view not the script; keel whats-next leads with dcProcessRemoveCommand; reorder script control total held - same 2709 lines, same line multiset; validate 676 clean; guard ALL PASS with priority-inversion silent
        part storyFrontierRankedDoDR1 : TestResult { :>> id = "a1c3fc4c-d2a4-4704-9534-e9c3f05f398c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8442d175afa20551be5074d1acbdc87e3e087549"; :>> judgedAt = "2026-09-07"; :>> judgedBy = "claudeOpus5"; }
    }

    verification frontierRankedRefineGate : Test { :>> id = "eb9716b7-c04a-4e79-afd2-8889baf3c964"; :>> title = "Sprint 595 refine gate (DoR)"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "READY. This was the work sprint 594 interrupted: the reorder script refused because none of the ready items were inside the def it was pointed at, which turned out to be issue407 and cost a sprint. With that fixed and the two mis-filed items refiled, the reorder is what it always was - a mechanical re-declaration under a rule that already exists. Sized 1: no code, no schema, one file's declaration order and a comment. The one judgment is the tie-break within a class, and it is to change nothing."; }
    // RAN: keel show priority: 0 inversions (was 166), eleven High-class items at positions 1-11, read back from the computed view not the script; keel whats-next leads with dcProcessRemoveCommand; reorder script control total held - same 2709 lines, same line multiset; validate 676 clean; guard ALL PASS with priority-inversion silent
    part frontierRankedRefineGateR1 : TestResult { :>> id = "321b929b-5251-4c9c-82bc-88119b725054"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8442d175afa20551be5074d1acbdc87e3e087549"; :>> judgedAt = "2026-09-07"; :>> judgedBy = "claudeOpus5"; }
    verification frontierRankedStandupGate : Test { :>> id = "f96742ea-1e9c-480a-82b7-ed8eb11316e1"; :>> title = "Sprint 595 standup gate"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "NO BLOCKER. This changes authored data, not a process or an enforcement surface, so no Decision is owed - D0052 already says reordering IS how you reprioritize. Still waiting on the human: D0366, and d0360 to d0363."; }
    // RAN: keel show priority: 0 inversions (was 166), eleven High-class items at positions 1-11, read back from the computed view not the script; keel whats-next leads with dcProcessRemoveCommand; reorder script control total held - same 2709 lines, same line multiset; validate 676 clean; guard ALL PASS with priority-inversion silent
    part frontierRankedStandupGateR1 : TestResult { :>> id = "b2c5d5f1-7184-4e1d-b1de-550689827935"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8442d175afa20551be5074d1acbdc87e3e087549"; :>> judgedAt = "2026-09-07"; :>> judgedBy = "claudeOpus5"; }
    verification frontierRankedImplementGate : Test { :>> id = "5a14a341-63b6-4130-91f2-acdffa033dde"; :>> title = "Sprint 595 implement gate"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::test; :>> procedureText = "RAN: keel show priority read for each ready item's computed class; the 34 blocks re-declared in class order by a script whose control total is the file's own line multiset; the block comment written to name the signal and the count it discharges; validate, guard and show priority re-run afterwards. The count came back 0 from the view rather than from the script."; }
    // RAN: keel show priority: 0 inversions (was 166), eleven High-class items at positions 1-11, read back from the computed view not the script; keel whats-next leads with dcProcessRemoveCommand; reorder script control total held - same 2709 lines, same line multiset; validate 676 clean; guard ALL PASS with priority-inversion silent
    part frontierRankedImplementGateR1 : TestResult { :>> id = "23735c7f-ab69-4caa-bfb8-6092ec93aab5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8442d175afa20551be5074d1acbdc87e3e087549"; :>> judgedAt = "2026-09-07"; :>> judgedBy = "claudeOpus5"; }
    verification frontierRankedReviewGate : Test { :>> id = "5dae41a1-9fbb-495f-b8aa-8d08491a97f4"; :>> title = "Sprint 595 review gate — three passes per D0172"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "THREE PASSES per D0172. (1) DID THE REORDER CHANGE ANYTHING BUT ORDER: no, and it is checked rather than asserted - the script compares the sorted line multiset before and after and refuses to write on any difference, so a block that lost a line or gained one could not have been committed. (2) IS THE NEW ORDER A JUDGMENT I MADE: only in the tie-break, and the tie-break is to keep what was there. Class comes from resolver severity and retro recurrence, both computed; I chose neither. That matters because a reorder is exactly the place where an agent could quietly promote its own work, and eleven of the twelve items now at the top are not mine to prefer. (3) DID THE CONTROLS CATCH ME: the pre-bash hook denied a heredoc carrying a backslash while I was probing the file - the same control that fired in sprint 593, on the same shape, which is the third time this session it has been right."; }
    // RAN: keel show priority: 0 inversions (was 166), eleven High-class items at positions 1-11, read back from the computed view not the script; keel whats-next leads with dcProcessRemoveCommand; reorder script control total held - same 2709 lines, same line multiset; validate 676 clean; guard ALL PASS with priority-inversion silent
    part frontierRankedReviewGateR1 : TestResult { :>> id = "286e282e-dc59-4c01-a828-10a8fd94281f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8442d175afa20551be5074d1acbdc87e3e087549"; :>> judgedAt = "2026-09-07"; :>> judgedBy = "claudeOpus5"; }
    verification frontierRankedCloseOutGate : Test { :>> id = "d6d99764-d3bb-49a9-a7f6-1b329665b0f3"; :>> title = "Sprint 595 closeOut gate (autonomous, D0049)"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "CLOSED. `keel whats-next` and `keel show priority` now agree, and the frontier hands out High-class work first."; }
    // RAN: keel show priority: 0 inversions (was 166), eleven High-class items at positions 1-11, read back from the computed view not the script; keel whats-next leads with dcProcessRemoveCommand; reorder script control total held - same 2709 lines, same line multiset; validate 676 clean; guard ALL PASS with priority-inversion silent
    part frontierRankedCloseOutGateR1 : TestResult { :>> id = "37f903d4-7b4b-4ced-a873-dffd8a1e21de"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8442d175afa20551be5074d1acbdc87e3e087549"; :>> judgedAt = "2026-09-07"; :>> judgedBy = "claudeOpus5"; }
    verification frontierRankedRetroGate : Test { :>> id = "9538445e-1c63-4214-b524-09e54f4c0759"; :>> title = "Sprint 595 retro gate (autonomous, D0049)"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::analyze; :>> procedureText = "AVOIDABLE-ISSUE SCAN HELD. No new item. Already tracked: issue408's resolver dcSelfBuildHooksLeaveTheBuildTree arrives at position 11 under the new ranking, which is where a High-severity finding from this session belongs and is a small proof that the ranking now moves. The thing worth carrying is about the warning itself: 166 inversions had been standing long enough to become part of the scenery, and every one of them was a computed statement that the frontier was handing out the wrong work first. A warning that is always present is read as a condition rather than as a message - the same failure as the turn-boundary line D0359 retired for being accurate at every turn until nobody read it. This one was discharged only because a sprint happened to trip over it."; }
    // RAN: keel show priority: 0 inversions (was 166), eleven High-class items at positions 1-11, read back from the computed view not the script; keel whats-next leads with dcProcessRemoveCommand; reorder script control total held - same 2709 lines, same line multiset; validate 676 clean; guard ALL PASS with priority-inversion silent
    part frontierRankedRetroGateR1 : TestResult { :>> id = "40f8a83f-d280-4ef9-97d7-1da3df888577"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8442d175afa20551be5074d1acbdc87e3e087549"; :>> judgedAt = "2026-09-07"; :>> judgedBy = "claudeOpus5"; }
}
