    #CharteredBy dependency from frontierRankedStory to d0258;

    part frontierRankedStory : Story {
        :>> id = "d5b705ed-559f-4985-bec4-5ba2c8725577";
        :>> title = "Sprint 595: the ready frontier is ranked by its own computed signal - 166 priority inversions to zero (1 pts)";
