    action def DeliveryRunS428 {
        action storyParserRatchet;
        verification storyParserRatchetDoD : Test { :>> id = "fff7e100-49a5-4553-9999-04b8cb3ee519"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: dcParserCoverageRatchet (resolves issue231, the process-value panel's formal-methods finding: the parser is the TCB of every guard and view, and its skipped-statement census was a warning whose count could grow silently). TWO HALVES: (1) THE RATCHET - .engine/contracts/parser-coverage-baseline.toml declares the committed baseline (7, the known legacy successions); the parser-coverage guard now goes RED when the live count EXCEEDS baseline (new invisibility is a violation), keeps warning at any nonzero count (legacy invisibility stays visible), warns to ratchet DOWN when the count shrinks, fails loud on a malformed contract, and states non-adoption when the contract is absent (D0136) - never the D0132 all-or-nothing trap. (2) SKIP-FREEDOM BY GENERATION - the keel-parser proptest suite gains supported_statements_are_never_skipped: random compositions of every supported statement form (parts with attrs, verifications, plain and markered dependencies, satisfy, allocate, actions) must parse with pkg.skipped empty, so a parser regression that silently drops a supported form is caught by generation rather than by whoever next reads the census (the ShardStore lightweight-formal-methods pattern the panel cited). VERIFIED: negative probe - a planted connect statement pushed the count to 8 and turned the guard RED with the exceeds-baseline message, removal green; the PBT runs green in the suite; workspace clippy clean; guards.md synced."; }
        part storyParserRatchetDoDR1 : TestResult { :>> id = "70b4a899-cf1f-4f1f-9ae6-07c6ab1d13ef"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f760170eb8b54758875aa8b071a0ccd2139148ca"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
    }

    verification parserRatchetRefineGate : Test { :>> id = "8dc12675-4468-4ba2-ba7e-7a8d21b958cd"; :>> title = "Sprint 428 refine gate (DoR)"; :>> createdAt = "2026-08-23"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. Chartered from the panel's issue231. In scope: the baseline contract, the guard ratchet, the generation suite, doc-sync. Out of scope (stated): parse-print round-trip identity - keel-parser has no printer, and building one for the test's sake would be ceremony; skip-freedom is the property that guards the TCB boundary. 1 point."; }
    part parserRatchetRefineGateR1 : TestResult { :>> id = "27d709b4-c56f-4d62-8339-6bc9be55b861"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f760170eb8b54758875aa8b071a0ccd2139148ca"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
