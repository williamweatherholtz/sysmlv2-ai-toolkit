    action def DeliveryRunS376 {
        action storyScriptParse;
        verification storyScriptParseDoD : Test { :>> id = "0d800731-0814-6731-9b3e-000000300731"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED BACKLOG ITEMS: dcEmittedJsMustParse declared and cleared. THE HUMAN READ THE INSTRUMENT - script did not finish - AND ASKED WHY, and the answer took one mechanical check that had been available all along: node --check on the extracted script found THREE syntax errors. (1) Sprint 372's regex fix appended an end-of-line comment inside a single-line .then(), commenting out its closing braces. (2) A stray fragment of a replaced multi-line push survived an old edit as a bare line. (3) A heredoc-eaten backslash-n split L.join's string literal in two - the shell-mangling class, fossilised in the artifact since the earliest versions. A SYNTAX ERROR RUNS NOTHING, so the script was dead in EVERY version: all four button reports were this one defect, and the three real contract fixes shipped along the way were untestable. FIXED: the .then() is multi-line so no line-scoped edit can swallow structure; the fragment deleted; the join uses String.fromCharCode(10), which no authoring layer can eat. node --check now PASSES and is pass ZERO of the skill's checklist. Published as deck v5, visible in the sub-line. The demo remains theirs. validate 408 clean; check-engine clean; 38 guards ALL PASS."; }
        part storyScriptParseDoDR1 : TestResult { :>> id = "0d800732-0814-6732-9b3e-000000300732"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1b78b12"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
    }

    verification spRefineGate : Test { :>> id = "0d800733-0814-6733-9b3e-000000300733"; :>> title = "Sprint 376 refine gate (DoR)"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. The self-report marker built in sprint 371 finally did its one job: the human read `script did NOT finish` and asked why. The route was mechanical from there - extract, node --check, read the line number. Scoped to: fix the three errors in the generator, make the parse check pass zero of the checklist, publish v5. estimatedPoints=3."; }
