        part storySprintFillDoDR1 : TestResult { :>> id = "1dece151-8ad6-4aa0-838e-feb282c16aa4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "bd996ee"; :>> judgedAt = "2026-09-04"; :>> judgedBy = "claudeOpus5"; }
