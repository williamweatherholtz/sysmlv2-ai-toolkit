    verification c4StandupGate : Test { :>> id = "0d800425-0814-6425-9b3e-000000300425"; :>> title = "Sprint 327 standup gate"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Approach: unchanged from pass 3 — verify every factual claim against the codebase or the model before writing it, batch as JSON through the writer that refuses unquotable text, read coverage back from the computed view rather than counting what I wrote. No blockers."; }
    part c4StandupGateR1 : TestResult { :>> id = "0d800426-0814-6426-9b3e-000000300426"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }

    verification c4ImplementGate : Test { :>> id = "0d800427-0814-6427-9b3e-000000300427"; :>> title = "Sprint 327 implement gate"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::analyze; :>> procedureText = "THE MOST VALUABLE FINDING OF THE WHOLE NEEDS BACKFILL IS A CROSS-NEED COLLISION NO SINGLE NEED COULD SHOW: critique INDEPENDENCE constrains two accepted must-priority Needs that never mention it. nViewerInProgramEdit's edit-then-critique loop self-critiques whenever the editor is the author, because an edit does not change createdBy; nViewerIterativeCritique's axis iteration produces findings that do not count for 87 of 154 elements. Neither Need is wrong on its own terms, and a reader examining either alone would not see it — which is the argument for critiquing a corpus rather than an element, and for doing it with the measurement in hand. A SECOND CROSS-NEED FACT: three Needs (N-1's form vocabulary, N-5's bound, N-6's shape) defer their own acceptance criteria to a handoff document or to a later Need, and one of those later Needs (N-18) is itself still unaccepted — so an accepted Need's only elaboration is unapproved, and decomposing it today means inventing the criterion or waiting."; }
    part c4ImplementGateR1 : TestResult { :>> id = "0d800428-0814-6428-9b3e-000000300428"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }

    verification c4ReviewGate : Test { :>> id = "0d800429-0814-6429-9b3e-000000300429"; :>> title = "Sprint 327 review gate"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Reviewed across all four passes: 20 Needs, 60 lenses, 45 fail and 15 pass. THE PASSES ARE THE PART I RE-EXAMINED, because a critic's passes are where laziness hides and they carry no visible cost. Of the 15, four pass on a NEGATIVE clause that is falsifiable and currently FAILS in the implementation (nViewerViewpointForm's three fixed modes, nViewerExplorableGraph's incremental loading, nViewerInProgramEdit's no-second-store, nServeReuseModel's set equivalence) — those are the most useful verifications in the corpus, because each measures a real gap rather than asserting one. Two pass because a check CONTRADICTED my expectation (pass 3). The rest pass on properties that are genuinely well-formed. None passes because I ran out of things to say. WHAT I AM NOT CLAIMING: that these 20 Needs are now good. They are EXAMINED — a judgment has been formed and recorded against each, with its reasoning — which is the EXAMINED half of `keel verification` and says nothing about whether the owner agrees or acts."; }
    part c4ReviewGateR1 : TestResult { :>> id = "0d80042a-0814-642a-9b3e-00000030042a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }

