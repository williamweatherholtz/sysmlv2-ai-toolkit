    part honestLabelStory : Story {
        :>> id = "0d800750-0814-6750-9b3e-000000300750";
        :>> title = "Sprint 378: a save label the receiver cannot verify is not a save label (2 pts)";
        :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> kind = WorkKind::code; :>> priority = WorkPriority::p0; :>> owner = "claudeOpus5"; :>> estimatedPoints = 2;
