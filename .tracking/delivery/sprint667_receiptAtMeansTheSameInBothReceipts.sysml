        verification storyReceiptAtMeansTheSameInBothReceiptsDoD : Test { :>> id = "d0e1361b-540f-4924-acff-8e7b13f28f23"; :>> method = VerificationMethod::test; :>> procedureText = "suite.rs's done receipt is built by one pure function done_receipt(fingerprint, head, started, finished, passed, failed, outcome) whose at is finished and whose seconds is finished minus started; the running stub keeps at = started with seconds 0; Receipt carries seconds, render_receipt writes it after outcome and names in its header what at means, parse_receipt reads it and a receipt from before the field parses with seconds 0. The test-verify skill's SUITE clause names seconds and drops the mtime derivation; scripts/exec_brief/facts.py's suiteWallMinutes reads seconds first and falls back to mtime minus at only for a receipt with no seconds. D0388 pair in suite.rs: known-positive - done_receipt(started=100, finished=700) renders at = 700 and seconds = 600 and round-trips through parse_receipt; known-negative - the stub rendered at 100 reads at = 100 and seconds = 0, and a pre-field receipt text parses with seconds 0. On this host a keel suite run's at minus seconds is within two seconds of its launch epoch. sync-claude --check clean; clippy -D warnings clean."; }
        // RAN: touched run pass 560/0 in 542s at 1789109802 head b50ee9b; probe pair 6 passed; validate, check-engine, guard, sync-claude, clippy all green per verifier receipt 2026-09-11
        part storyReceiptAtMeansTheSameInBothReceiptsDoDR1 : TestResult { :>> id = "56856d00-5f05-42a6-a9b0-ef59c268461c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b50ee9b"; :>> judgedAt = "2026-09-11"; :>> judgedBy = "claudeOpus5"; }
    }

    verification receiptAtMeansTheSameInBothReceiptsRefineGate : Test { :>> id = "97a10076-6b42-45b7-bde3-6c94b1c97727"; :>> title = "Sprint 667 refine gate (DoR)"; :>> createdAt = "2026-09-11"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Chartered by D0442 (proposed, process-change: the test-verify skill's text is a locked process surface, so the commit carries the marked Decision and the human's word accepts it). Sized 2 points: one field on Receipt, one pure constructor, two unit tests beside the existing stub test, a skill paragraph and a facts.py branch. Read before design: suite.rs:242 takes started, :253 stamps the stub at started, :301 stamped the done receipt at started too; touched.rs:342 already stamps at write and :377 computes seconds as now minus started - the convention to match is already in the tree. facts.py:784-797 derived wall minutes from the log's mtime minus at with a how that named at as the START - a claim this sprint inverts, so it is in the DoD as doc-sync rather than left to be found. DoR: points set, charter edge set, DoD authored, no blocking dependency."; }
