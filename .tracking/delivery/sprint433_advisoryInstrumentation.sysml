    verification advisoryInstrumentationStandupGate : Test { :>> id = "622f8143-6f9f-45ba-95f6-1e18e57e609a"; :>> title = "Sprint 433 standup gate"; :>> createdAt = "2026-08-23"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Approach: fit INSIDE the frozen schema by adding EVENTS, not fields - the freeze protects the line shape, and the event vocabulary is exactly the extension joint D0193 built; repeat-of-same-hash as the ignore signal is the only mechanically observable proxy this harness offers, and every surface that reports it says approximate."; }
