    action def DeliveryRunS392 {
        action storyAmbientActorAudit;
        verification storyAmbientActorAuditDoD : Test { :>> id = "bbc0ef3c-c0c0-4b0e-88c7-384265a13549"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: the WRITE_OPS-anchored sweep sprint 390's review gate named. AUDIT TABLE (all 16 declared write endpoints + the console page + the deck): CLEAN BY CONSTRUCTION - /api/deck/sitting (Person-verified `by`), /api/commit (attribution reasoning recorded, D0182 note 3), /api/launch/form + /api/run/ask + /api/run/asks (no attestation), /api/item /api/edge /api/resolver /api/item/attr /api/project /api/testresult /api/decision-author (mechanical or authoring writes where the session binding IS the correct actor). DEFECTS FOUND AND FIXED: (1) /api/disposition, /api/decision/accept, /api/decision/reject, /api/gate-result resolved an omitted judged_by from the machine binding - the issue197/199 vector - and now REFUSE without it; (2) /api/run/answer took no actor at all and an allow left no record (issue200): `by` is now required + registered-Person-verified, the poll returns it, an ALLOW records a tracked obligation naming the approver (mirroring the override tier's K7 consumption record), and a human DENY is recorded as THEIR judgment while expiry stays attributed to the run; (3) console.html hardcoded judged_by='wweatherholtz' on test results and defaulted CANCELLED prompts to the human's name - a cancelled dialog forged an attestation - now one judgedBy() helper that records nothing without a name, fed by the new GET /api/persons so no page ships a hardcoded human; (4) the ask queue had NO surface (issue201, doc claimed 'console renders it') - the console now polls /api/run/asks and answers with the named human. KEEL_API_VERSION 1.17.0 -> 2.0.0 (breaking: required fields). VERIFIED live on a scratch instance: all four refusals return 400 with the rule named; ask round-trip returns answer+by; /api/persons lists the one registered Person; cargo test 277 passed, clippy pedantic+nursery clean."; }
        part storyAmbientActorAuditDoDR1 : TestResult { :>> id = "b017b423-3d04-4350-9e21-b1049b8e41df"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "7aa0779"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    }

    verification ambientActorAuditRefineGate : Test { :>> id = "fec4c7fe-23a9-44bd-b71e-42cb2df65008"; :>> title = "Sprint 392 refine gate (DoR)"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. Chartered by d0178 (K6: human-judgment writes are human-channel-only); the sweep was named as the next control in sprint 390's review gate, anchored on the WRITE_OPS table. Scope: audit first, fix what the audit finds, record what it clears. 2 points."; }
