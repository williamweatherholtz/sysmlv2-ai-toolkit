    part selfBuildHooksRunAStableCopyImplementGateR1 : TestResult { :>> id = "8fb538c0-6750-4bfd-8d08-6a4e2acf0dd1"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cafde85c5a8d0e08120d41ad7e5412eacc969ad7"; :>> judgedAt = "2026-09-08"; :>> judgedBy = "claudeOpus5"; }
