    // RAN: DoR inspected: 3 points, charter d0391, scope in the refine text, DoD authored, no blocking dependency
    part selfBuildHooksRunAStableCopyRefineGateR1 : TestResult { :>> id = "9ffe4942-d210-41bb-993f-a02d9da4ed91"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cafde85c5a8d0e08120d41ad7e5412eacc969ad7"; :>> judgedAt = "2026-09-08"; :>> judgedBy = "claudeOpus5"; }
    verification selfBuildHooksRunAStableCopyStandupGate : Test { :>> id = "c6f8a5d8-ef79-4a30-b74e-7ded207c97b5"; :>> title = "Sprint 616 standup gate"; :>> createdAt = "2026-09-08"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Plan: (1) hook_binary.rs with a pure refresh decision (output exists, two seconds old, differs from the stamp) and a copy-through-.next-then-rename that works on a running image; (2) the hook entry refreshes before dispatch and writes hook-binary-refreshed; (3) sync-claude places the copy when absent and prints which binary the hooks will run; (4) status prints the same, marks Attention with no copy, and names the commits the last fire's build sits behind HEAD; (5) integration tests on a constructed self-build tree: placed on first fire and recorded, refreshed on a new output, a young output left alone, a plain project untouched, sync-claude places and names; (6) bootstrap this repository through sync-claude and read the ledger's bin and build; gates."; }
    // RAN: plan of six steps recorded in the standup text; all six executed in this commit
    part selfBuildHooksRunAStableCopyStandupGateR1 : TestResult { :>> id = "2cfc2114-0983-457e-a770-e4cb3987d1fd"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cafde85c5a8d0e08120d41ad7e5412eacc969ad7"; :>> judgedAt = "2026-09-08"; :>> judgedBy = "claudeOpus5"; }
    verification selfBuildHooksRunAStableCopyImplementGate : Test { :>> id = "6a950ea3-2185-4a97-9c0e-3e673a14155c"; :>> title = "Sprint 616 implement gate"; :>> createdAt = "2026-09-08"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::test; :>> procedureText = "RAN: cargo build --release; cargo clippy --release --all-targets -D warnings; cargo test --release --lib hook_binary; cargo test --release --test self_build_hooks_leave_the_build_tree; keel sync-claude . on this repository; keel status . read back; tail of .keel/metrics/hooks.jsonl; keel gate --fast; keel guard."; }
