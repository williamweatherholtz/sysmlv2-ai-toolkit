    part selfBuildHooksRunAStableCopyStory : Story {
        :>> id = "7d98a69c-f287-4281-9f6d-19f96f0edf30";
        :>> title = "Sprint 616: Sprint 616 takes the hooks off the build tree (dcSelfBuildHooksLeaveTheBuildTree, resolves issue408) under D0391: on a self-build tree the hooks run a stable copy at .keel/bin that they refresh from target/release themselves, sync-claude places it and says which binary the hooks will run, and status names the copy's build beside HEAD so the lag it trades for is a fact. (3 pts)";
        :>> createdAt = "2026-09-08"; :>> createdBy = "claudeOpus5"; :>> kind = WorkKind::code; :>> priority = WorkPriority::p0; :>> owner = "claudeOpus5"; :>> estimatedPoints = 3;
    }

    action def DeliveryRunS616 {
        action storySelfBuildHooksRunAStableCopy;
        verification storySelfBuildHooksRunAStableCopyDoD : Test { :>> id = "61472100-88f8-4b5b-b1d3-e7878b6a7417"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: a self-build project's hooks do not run the file its build is writing. Resolves issue408. The pin probe's order is KEEL_BIN, then .keel/bin/keel(.exe), then the pin cache, then PATH. In a project whose DELIVERABLE is the engine, nothing writes .keel/bin/keel.exe - init seeds .keel/bin/<version>/<asset> and keelw fetches into the same shape - so the probe falls through to PATH and resolves into target/release, which is the exact file cargo must unlink to relink. DO: on a self-build tree, the surfaces that write hook commands ALSO place or refresh a stable copy at .keel/bin/keel(.exe), and say which binary the hooks will run; and the copy is refreshed by the build path that produces a new binary rather than by a human remembering. The staleness this trades for is real and must be visible, not silent: keel status names the hook binary's build commit beside the engine pin, so a hook set running an older image than the tree is a fact a reader can see rather than an inference from behaviour. VERIFY: on this repository, a cargo build followed by a suite run completes with no `failed to remove file target/release/keel.exe`; the fire-ledger's bin field names the stable copy, not target/release; keel status shows the hook binary's build and flags it when it differs from the tree's HEAD; a non-self-build project is unaffected."; }
        // RAN: hook_binary.rs + wiring; 2 unit + 5 integration tests pass; this repository bootstrapped through sync-claude, ledger shows the stable copy at build cafde85+dirty; D0391
        part storySelfBuildHooksRunAStableCopyDoDR1 : TestResult { :>> id = "2bd2cde3-d053-4c30-b516-aabceafe3e0e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cafde85c5a8d0e08120d41ad7e5412eacc969ad7"; :>> judgedAt = "2026-09-08"; :>> judgedBy = "claudeOpus5"; }
    }

