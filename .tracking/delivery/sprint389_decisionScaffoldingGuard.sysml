    part decisionScaffoldingGuardStandupGateR1 : TestResult { :>> id = "37496c7c-b24e-4a38-b228-d4abf1a41053"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "06742e4"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    verification decisionScaffoldingGuardImplementGate : Test { :>> id = "a3cfb452-dfcf-4a4d-933c-77c3b9742954"; :>> title = "Sprint 389 implement gate"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::test; :>> procedureText = "Run live on the real tree: 3 post-boundary #ProspectiveChange acceptances scanned; d0173 and d0188 reachable (their program edges), d0187 warned as genuinely bare, the newest violator graced. The warning is left STANDING - it is the guard's correct output about a real gap, and silencing it with a cosmetic edge would be exactly the fabricated-scaffolding defect D0188 exists to expose."; }
    part decisionScaffoldingGuardImplementGateR1 : TestResult { :>> id = "d43cdd56-9fd4-4c10-b6f3-8b3a50c97602"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "06742e4"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    verification decisionScaffoldingGuardReviewGate : Test { :>> id = "9853cb8c-d299-47d6-acf5-c42ca7dc8e3b"; :>> title = "Sprint 389 review gate — three passes per D0172"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "PASS 1, CLAIMS: the live run's numbers quoted from the guard's own output; full suite green. PASS 2, BOUNDARY: absent d0188 = zero scanned; missing acceptance dates exclude a candidate rather than guessing. PASS 3, OWN DIFF: a needless format! on a static prefix, self-caught. WHAT A REVIEWER SHOULD ATTACK: reachability is line-anchored text matching (' to <name>;'), so an edge split across lines would be missed - the corpus writes edges on one line and edge-endpoints enforces resolvability, but the parser-based rewrite is the tightening path if multi-line edges ever appear."; }
    part decisionScaffoldingGuardReviewGateR1 : TestResult { :>> id = "e4668ca1-7932-46fb-b583-752c15bc138b"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "06742e4"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
