    part decisionScaffoldingGuardCloseOutGateR1 : TestResult { :>> id = "739daaa0-516e-4b4e-aeb5-082a8ea2e653"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "06742e4"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
