        verification storyDecisionScaffoldingGuardDoD : Test { :>> id = "19534a35-ab43-4502-945a-ecf31de14ec7"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED BACKLOG ITEMS: dcDecisionScaffoldingGuard. Guard 42 (decision-scaffolding) implements D0188 exactly as signed: an accepted #ProspectiveChange Decision must be reachable by a tracked-item edge (charteredby/derivedfrom/resolves/satisfy). WARNING-TIER per D0188's composed rule with D0180 - promotion to hard is a recorded review citing the fire-ledger window, never a default. FORWARD-ONLY: the boundary is D0188's OWN acceptance date, read from the model at guard time (a downstream tree without d0188 gets zero scanned - adoption is by decision, never inferred); the 64 historical gaps are untouched. The landing-sprint grace exempts the newest violator. FIRST LIVE RUN CAUGHT A REAL ONE: d0187 - the panel's own process decision - promises the adversarial-panel-review process and charters no tracked work; the warning STANDS in the tree as the guard's designed output, which is the human's issue174 complaint materializing as a control against the very program that answered it. Registered everywhere a guard lives (GUARD_NAMES 42, dispatch, guards.md warning-only row, CLAUDE.md count); the guards.md header's stale hand-counted split replaced with a pointer to keel version's computed one (one number, one home)."; }
        part storyDecisionScaffoldingGuardDoDR1 : TestResult { :>> id = "046f6c2d-e015-4ca2-8af6-eb6f8d58edd6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "06742e4"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    }

