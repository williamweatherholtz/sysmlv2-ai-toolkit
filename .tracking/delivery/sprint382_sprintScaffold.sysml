    part sprintScaffoldStandupGateR1 : TestResult { :>> id = "2fee5b52-15d5-4e1d-a1ac-5ab72b69ba0c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "74ecefb"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
    verification sprintScaffoldImplementGate : Test { :>> id = "280a8cb1-27df-4fd4-be65-40541216245e"; :>> title = "Sprint 382 implement gate"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::test; :>> procedureText = "Every claim from a run: scaffold on a COPY tree, fast gate exit 1 on the unfilled skeleton, all five refusal branches executed against the built binary; then the DOGFOOD - this very record scaffolded on the real tree and held red by its own guard until filled. One measurement error caught and corrected mid-sprint: a pipeline exit code read tail's status, not the gate's - re-measured without the pipe (exit 1 confirmed), the verify-the-right-surface rule applied to shell plumbing. Clippy found one real panic path (args slicing) - replaced with get()."; }
    part sprintScaffoldImplementGateR1 : TestResult { :>> id = "6d244abf-dd15-41de-956b-6830f39dde71"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "74ecefb"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
    verification sprintScaffoldReviewGate : Test { :>> id = "d27565b0-e4e5-4f61-bf65-8812e460cf13"; :>> title = "Sprint 382 review gate — three passes per D0172"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "PASS 1, CLAIMS vs computed/emitted: 215 tests, clippy 0, 40 guards ALL PASS over the real tree with this scaffold present-and-filled; the scaffolded file's ids counted and shape-checked from the FILE, not the generator. PASS 2, BOUNDARY: slug validation refuses non-camelCase (it becomes item names and a filename); sprint-number reuse refuses on PREFIX match so sprint999_a and sprint999_b cannot coexist; the charter check reads declared Decisions rather than trusting the caller. PASS 3, OWN DIFF: the generated gate titles were checked against the ceremony guard's GATE_ORDER suffix matching BEFORE writing the generator - the class of drift where a generator and its consumer disagree, prevented rather than found. WHAT A REVIEWER SHOULD ATTACK: chrono_date is a hand-rolled civil-from-days conversion; verified against the live date today, and wrong-by-one exactly at a UTC date boundary would stamp createdAt one day off - an authoring date, not evidence, so the blast radius is cosmetic."; }
    part sprintScaffoldReviewGateR1 : TestResult { :>> id = "4ad7a4ed-5dce-4d92-9530-363634441f24"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "74ecefb"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
