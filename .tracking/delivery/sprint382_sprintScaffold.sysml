    part sprintScaffoldCloseOutGateR1 : TestResult { :>> id = "7f7d8f88-10a8-48b2-a237-64f3d15ca38c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "74ecefb"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
