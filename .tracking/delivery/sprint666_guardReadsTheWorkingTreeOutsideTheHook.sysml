    part guardReadsTheWorkingTreeOutsideTheHookRetroGateR1 : TestResult { :>> id = "059a6a08-abf9-4ca6-9a42-5dbaae5399dc"; :>> outcome = VerdictKind::proposed; :>> judgedAgainst = "c88feb2"; :>> judgedAt = "2026-09-11"; :>> judgedBy = "claudeOpus5"; }
