    part recordCorrectionsStory : Story {
        :>> id = "a5f68455-2f56-4be4-b6db-e5051529be3d";
        :>> title = "Sprint 567: D0234's record corrected to what was measured - and the gate learned to let a correction and its re-binding land together (3 pts)";
