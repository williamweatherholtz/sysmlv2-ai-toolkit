    action def DeliveryRunS419 {
        action storyDeckForkOptions;
        verification storyDeckForkOptionsDoD : Test { :>> id = "1f5420d7-bf18-4942-971b-58d8c7ae0057"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: dcDeckForkOptions (resolves issue223). THE DEFECT: d0192 enumerates OPTION A / OPTION B and states 'accepting this Decision means choosing ONE', yet the deck rendered it as one bare Sign button; wweatherholtz tapped it (inbox row uid 5b1d2b0e, At 2026-08-22T06:54:40Z) and the gesture could not be recorded - solicited and wasted, the D0054 friction class. THE CONTROL (D0047): fork_options() scans a pending acceptance's decision file for two-or-more 'OPTION X (label)' enumerations; a fork card renders one full-width sign button per option ('Sign A - amend the requirement' / 'Sign B - close the path'); the chosen option is stamped into the note on BOTH transports (local /api/decision/accept body and the remote inbox row's Note cell), so the recorded acceptance CARRIES the choice; tapping a different option switches instead of clearing (data-opt-chosen tracked alongside data-verdict). VERIFIED: unit test pins the D0192 text shape plus the one-option and no-option negatives; the emitted-JS parse test still passes; the regenerated deck shows exactly 1 waiting item with both data-opt buttons (read back by grep); full suite 280+ green, clippy pedantic+nursery clean. The republished deck (same URL) now offers the human the choice their last tap could not express."; }
        part storyDeckForkOptionsDoDR1 : TestResult { :>> id = "bfb55770-9a39-411a-be88-90ebcbb4737e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "0a5d84be7185612dba5cb078845014a5777185c1"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
    }

    verification deckForkOptionsRefineGate : Test { :>> id = "bab69145-e678-43b2-9842-f80a83abf567"; :>> title = "Sprint 419 refine gate (DoR)"; :>> createdAt = "2026-08-22"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. Correction-becomes-control (D0047) for issue223, found this morning when the 2026-08-22 inbox batch carried a d0192 accept tap that could not bind. In scope: the deck generator and its emitted JS. Out of scope: the acceptance API (a note is already a first-class field on both transports). 1 point."; }
    part deckForkOptionsRefineGateR1 : TestResult { :>> id = "7d29f3f9-28cd-4b01-9992-2e009c623856"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "0a5d84be7185612dba5cb078845014a5777185c1"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
