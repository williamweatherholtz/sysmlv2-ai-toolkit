    part deckForkOptionsImplementGateR1 : TestResult { :>> id = "d778ab7c-d063-42e5-903c-d327dd209949"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "0a5d84be7185612dba5cb078845014a5777185c1"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
    verification deckForkOptionsReviewGate : Test { :>> id = "e3c64e29-d729-49ce-bbf8-a3938b06e398"; :>> title = "Sprint 419 review gate — three passes per D0172"; :>> createdAt = "2026-08-22"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "PASS 1, CLAIMS: the button labels and data-opt values quoted above are grep output from the generated page, not intent. PASS 2, BOUNDARY: the OPTION-enumeration convention is a TEXT convention, not schema - a decision that words its fork differently gets the old bare Sign button; that boundary is stated in fork_options' doc and the failure mode is the status quo, never a wrong recording. PASS 3, OWN DIFF: my first DoD text cited issue224 before the write returned issue223 - the issue212 lesson (cite the number the write RETURNS) recurred in draft and was caught before commit; both surfaces swept. WHAT A REVIEWER SHOULD ATTACK: the toggle semantics on a fork card (data-opt-chosen) are hand-verified JS, covered only by the parse check - a behavioral JS test rig remains the deck's known verification gap (issue191's residual)."; }
