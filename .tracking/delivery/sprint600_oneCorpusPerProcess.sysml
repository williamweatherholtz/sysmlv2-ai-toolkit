    part oneCorpusPerProcessRefineGateR1 : TestResult { :>> id = "5d4e9121-ad7f-483c-bea1-1970f6b275fc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f954788ab41fc61408c77112469143ac634bd5b8"; :>> judgedAt = "2026-09-07T23:30:00-06:00"; :>> judgedBy = "claudeOpus5"; }
    verification oneCorpusPerProcessStandupGate : Test { :>> id = "2369845a-d468-46af-bfe6-153c95300a64"; :>> title = "Sprint 600 standup gate"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "TWO CHOICES. First, validity is a fact the file carries - (len, mtime) for content, a directory's mtime for its entries - never a clear() the callers must remember: sprint 598's retro named a memo that was right only because its callers were serial, and a cache that depends on caller discipline is that defect waiting for a concurrent caller. Second, the counters are unconditional: the first cut counted opens behind KEEL_PERF and the DoD's own test failed at 'the first read opens the file' because the count was zero - a test that skips when instrumentation is off is not the receipt the DoD asked for, so the open count is always kept and an atomic add is the price."; }
