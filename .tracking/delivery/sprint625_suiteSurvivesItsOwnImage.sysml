    verification suiteSurvivesItsOwnImageImplementGate : Test { :>> id = "a441690d-c599-440a-b1ae-649f6538a9b0"; :>> title = "Sprint 625 implement gate"; :>> createdAt = "2026-09-09"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::test; :>> procedureText = "target_dir, image_collides, own_image_refusal, never_ran in suite.rs; the previous receipt is read before the stub and restored on a run that never reached a test; module doc gains the what-was-measured paragraph. Release build, clippy -D warnings and the keel-cli lib tests (430) exit 0."; }
    // RAN: cargo build --release exit 0; cargo clippy --release -p keel-cli -- -D warnings exit 0; cargo test --release -p keel-cli --lib: 430 passed 0 failed
