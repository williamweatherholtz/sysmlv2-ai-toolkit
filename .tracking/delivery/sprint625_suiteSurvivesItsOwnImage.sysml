    verification suiteSurvivesItsOwnImageReviewGate : Test { :>> id = "3920f0de-c976-401b-bba4-cc809b0de60c"; :>> title = "Sprint 625 review gate — three passes per D0172"; :>> createdAt = "2026-09-09"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Pass 1 (intent): the DoD's live case was run as written - from target/release/keel.exe on a changed tree - and the receipt was compared by md5 before and after. Pass 2 (defects): the refusal is gated on cfg!(windows) because elsewhere the build replaces a running file without harm, and the predicate is deliberately narrower than 'inside the target directory' so the remedy itself is not refused. Pass 3 (docs): the stale D0353 synopsis (the gate D0356 withdrew) was corrected in passing, in both homes."; }
