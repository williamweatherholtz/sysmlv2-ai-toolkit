        verification storySuiteSurvivesItsOwnImageDoD : Test { :>> id = "6bac033d-3cb4-4c63-879b-eb6e8ffd5e6d"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: suite.rs refuses, before the running stub, when the executing image is the file cargo relinks - `<target>/release/keel(.exe)` or anything under `<target>/release/deps/` (`image_collides`, pure; narrow enough that the documented `keel-serve.exe` copy in the same directory does not collide) - exit 2, the copy-and-rerun remedy named, no receipt touched; and a cargo exit with no `test result:` line (`never_ran`, pure) restores the previous receipt instead of recording `fail - 0 passed, 0 failed`. VERIFIED: unit test the_suite_knows_its_own_image_and_a_run_that_never_ran covers both predicates on any host; live, `target/release/keel.exe suite .` on a tree whose sources changed exited 2 with the receipt's md5 unchanged (3cc53f64) and no new log; `keel-serve.exe suite . -- --no-such-cargo-flag` exited 2 with the receipt restored byte-for-byte and the log written. Docs: CLAUDE.md section 6 and the suite synopsis in both fact homes (commands.sysml, cli_facts.rs) - the latter caught by guard cli-surface-declared when only one was edited."; }
        // RAN: unit test the_suite_knows_its_own_image_and_a_run_that_never_ran passes in the 430; live: keel.exe suite . exit 2 receipt md5 3cc53f64 unchanged; keel-serve.exe suite . -- --no-such-cargo-flag exit 2 receipt restored byte-identical
        part storySuiteSurvivesItsOwnImageDoDR1 : TestResult { :>> id = "2697490e-647d-4baa-bb28-2d66ae7ef6de"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "9a5ae60"; :>> judgedAt = "2026-09-09"; :>> judgedBy = "claudeOpus5"; }
    }

    verification suiteSurvivesItsOwnImageRefineGate : Test { :>> id = "c025b047-8d1f-43ff-b041-524fe04c3ab1"; :>> title = "Sprint 625 refine gate (DoR)"; :>> createdAt = "2026-09-09"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "READY. Head of keel whats-next after sprint 624. The DoD offers two shapes - run from a copy, or refuse naming the cause - and only the refusal is honest here: a process cannot outlive its own image to let cargo relink it, so a re-exec would inherit the same lock. 2 points: one module, two pure predicates, a live check on the host that has the lock."; }
    // RAN: keel whats-next . at 9a5ae60: dcSuiteSurvivesItsOwnImage at the head; 2 points; DoD read
    part suiteSurvivesItsOwnImageRefineGateR1 : TestResult { :>> id = "7eef0174-94ba-4dae-86b8-d19d5b13695c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "9a5ae60"; :>> judgedAt = "2026-09-09"; :>> judgedBy = "claudeOpus5"; }
    verification suiteSurvivesItsOwnImageStandupGate : Test { :>> id = "5525c4b6-4ee9-433e-aecb-724701f05675"; :>> title = "Sprint 625 standup gate"; :>> createdAt = "2026-09-09"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Blockers: none. The synopsis lives in two places (the SysML fact and the Rust fact table) and the guard holds them equal; the edit was made in one and the guard named the other."; }
