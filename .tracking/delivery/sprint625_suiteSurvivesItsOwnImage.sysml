    part suiteSurvivesItsOwnImageReviewGateR1 : TestResult { :>> id = "7829472c-570c-41d9-afb4-b1e4cac829d2"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "9a5ae60"; :>> judgedAt = "2026-09-09"; :>> judgedBy = "claudeOpus5"; }
