        verification storyInstrumentsAreDeclaredAndAnalysedDoD : Test { :>> id = "d233b9c5-653c-49ce-bddf-fd7f00548ad1"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED: the instrument inventory (20 declared in .engine/contracts/instruments.toml, each with what it measures, whose belief it maintains, its output form, its determinism and its known failure modes), STPA step 4 over the feedback half of this project's own control structure (hazard EHZ10 plus nine loss scenarios as causal chains, eight evidenced by incidents and one named before it happens), and guard 65 instruments-declared holding the declaration against the tree in both directions. Chartered by D0361, with D0360 supplying the rule that a new control ships with its demonstrated catch. VERIFIED: keel suite 569 passed 0 failed (receipt bc74b6ded639); instruments_declared_catches_it 4/4 including the undeclared case, the stale-declaration case and the no-manifest case; keel validate 671 clean; keel guard ALL PASS at 65 guards; clippy -D warnings clean; the proof census moved 16 to 18 proven because guard 65 arrived with its test rather than after it."; }
        // RAN: keel suite . = 569 passed 0 failed (receipt bc74b6ded639); instruments_declared_catches_it 4/4; keel validate 671; keel guard ALL PASS (65); clippy clean
        part storyInstrumentsAreDeclaredAndAnalysedDoDR1 : TestResult { :>> id = "043e0750-0eac-4f2c-9892-340ef9b3ea1b"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "HEAD"; :>> judgedAt = "2026-09-06"; :>> judgedBy = "claudeOpus5"; }
    }

    verification instrumentsAreDeclaredAndAnalysedRefineGate : Test { :>> id = "ba843247-2244-4c40-bf5f-9a2c2882c6fc"; :>> title = "Sprint 591 refine gate (DoR)"; :>> createdAt = "2026-09-07"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::inspect; :>> procedureText = "READY: the owner asked for the list, an STPA over it, and the tightening. The STPA was RESUMED rather than started - four losses, nine hazards, seven controllers and eighteen UCAs already stood - and the finding that shaped the work was that the model held ZERO Feedback items, because feedback is computed from CliCommand facts and every instrument outside the CLI is therefore invisible to it."; }
    // RAN: keel suite 569/0 (bc74b6ded639)
