    action def DeliveryRunS408 {
        action storyVersionIdentity;
        verification storyVersionIdentityDoD : Test { :>> id = "3a23e81d-98c4-493b-8a9a-3e149844067f"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED (D0190, accepted on their 'approved. keep the momentum going'): (1) engine-version.toml - the declared version this on-disk engine's checks are defined against; keel init stamps it, keel migrate re-stamps it on a completed apply, and the SELF-BUILD's own declaration is authored at 0.2.3. DESIGN RECONCILIATION, stated in both files: migrate's recorded no-stamp rule still holds - migrate derives its vintage from the TREE and never reads this file; the declaration exists ONLY for the parity warning, so the two designs answer different questions (which transforms apply vs which binary's checks govern). (2) The parity warning at all three gate entry points (keel validate, keel guard, hook stop): advisory, names keel migrate, never blocks (skew is not dishonest state, D0098); VERIFIED BOTH WAYS live - a deliberately stale 0.1.0 declaration fired the warning at validate, the restored 0.2.3 silenced it. (3) The binary version is the ONE declared semver: keel --version and /api/version report the API contract (2.0.0) and claude-surface versions as DERIVED facts beside it (probed live: api 2.0.0 / binary 0.2.3 / surface 0.2.3), with breaking API changes recorded in release Decisions rather than versioned apart. (4) Both sprint-394 verification FAILs flipped exactly per the decision's clause 4: srDcEngineVersionParityV1R2 and srRelSemverReconciledV1R2 record pass with the probe evidence. engine-version.toml joined the process-def guard's instance-data exemptions (machine-stamped, like unit-ids)."; }
        part storyVersionIdentityDoDR1 : TestResult { :>> id = "4475538a-98d7-4a6b-b54c-985200105405"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8d603de"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
    }

    verification versionIdentityRefineGate : Test { :>> id = "3124966b-bed7-446f-8c4d-e0bb36270914"; :>> title = "Sprint 408 refine gate (DoR)"; :>> createdAt = "2026-08-22"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR. Chartered by d0190, accepted this session. The one open design question (D0190's stamp vs migrate's recorded no-stamp rule) was resolved by scoping, not by overruling either: the stamp is read by the warning alone. 2 points."; }
    part versionIdentityRefineGateR1 : TestResult { :>> id = "11c55a6e-3ebc-40ca-bdab-e8be402ab8f3"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "8d603de"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
