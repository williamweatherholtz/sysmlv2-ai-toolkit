    verification pf07Disp1 : Test {
        :>> id = "344116ff-b056-4823-bc86-840f0db3298e";
        :>> title = "pf07 disposition: acceptRisk - event-less controls stay hand-reconciled";
        :>> createdAt = "2026-08-29"; :>> createdBy = "claudeOpus5";
        :>> method = VerificationMethod::confirmation;
        :>> disposition = DispositionKind::acceptRisk;
        :>> procedureText = "ACCEPT-RISK, selected by the human on the program-summary page (st036, verbatim: '[x] Accept the residual as a recorded disposition (acceptRisk)'). The residual: guard 54 reconciles the control map only against control-events.toml, so an implemented control that emits NO declared event - a CI job, a remote configuration - can be absent from the map with no violation (the D0254 class, event-less subclass). ACCEPTED because pf07's own defeater analysis holds: no machine-readable anchor exists for event-less enforcement, and inventing a second hand-maintained list to fence it would recreate the drift the guard exists to end. THE FLIP CONDITION, recorded so the acceptance is falsifiable: a second implemented-but-undeclared control found in the field reopens this as build-the-anchor (workflow files are parseable). Known live instances at acceptance: ctlAdoptionCheck and ctlAuditAdherence were both declared BY HAND this week, which is the residual working as accepted, not failing.";
    }
    part pf07Disp1R1 : TestResult { :>> id = "54a0a800-4a29-4c4c-b92d-ef23cec5bdc1"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "616d613"; :>> judgedAt = "2026-08-29"; :>> judgedBy = "claudeOpus5"; }
