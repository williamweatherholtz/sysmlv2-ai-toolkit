    part us064 : UserStory {
        :>> id = "1d11589f-dddc-4362-9dc5-4ed45eb63bd8";
        :>> title = "An unrecognised flag must be refused, not silently taken as the ROOT";
        :>> createdAt = "2026-08-31"; :>> createdBy = "claudeOpus5";
        :>> asA = "any operator";
        :>> iWant = "a mistyped flag to fail loudly";
        :>> soThat = "a typo cannot produce a green run over a directory that does not exist";
        :>> implication = ImplicationKind::bug;
        :>> triageNote = "bug and the worst kind: TWO defects compounding - silent argument mis-parsing plus pass-at-zero - so keel guard --read gated a phantom directory and reported every guard PASS with 0 scanned, which is indistinguishable from a clean tree. I hit the same class building github-ingest, where a trailing --at value became the root.";
    }
