    verification srDcActorRoleModeledV1 : Test { :>> id = "cd4f20ea-ef8f-4b9d-8e91-53bbb6e141d0"; :>> title = "Actor roles are model data with a project-declared vocabulary"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Role is a field on Actor/Person instances in .tracking/actors.sysml (probed: wweatherholtz role=supervisor, the AI actors role=contributor) - model data, queryable, not prose. The vocabulary is project-declared where it CONSTRAINS: .engine/contracts/attestation-policy.toml names permitted roles per attestation class (roles=[supervisor] probed), with the recorded forward-only rule that an empty list means any role so pre-D0146 actors are not retro-failed. A downstream team declares its own roles by writing its own actors + policy."; }
    part srDcActorRoleModeledV1R1 : TestResult { :>> id = "52e399a6-818c-419d-bdcb-3f39ca499d2a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
