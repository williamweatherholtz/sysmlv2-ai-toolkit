    verification srDcEngineVersionParityV1 : Test { :>> id = "450885f9-d8ef-4ec0-912c-070c2c2f930f"; :>> title = "No declared engine version, no parity check"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "HONEST FAIL. The SR requires the project to DECLARE the engine version its checks are defined against and a contributor's toolchain to be compared against it before authoring. No such declaration exists (grep across .engine/contracts and src finds no engine-version parity mechanism), and nothing compares a contributor's binary to anything - the two field incidents this gap already caused are on record (issue089: a v0.2.0 binary against a pre-D0133 on-disk engine, 566 violations; issue090: absent rules read as violations). The chartered remedy exists as dcProjectMigrationTool (vintage DETECTION is its first clause) - this result flips when a declared version + parity check land."; }
    part srDcEngineVersionParityV1R1 : TestResult { :>> id = "d6859d32-3a40-4e33-8569-a73ac8a30bd5"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
