    verification srConsoleProjectRebindV1 : Test { :>> id = "888803fa-97a5-4c4b-b5e1-c6a1f4e0817d"; :>> title = "The API rebinds projects; the surface shows none of it"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "HONEST FAIL. The API half exists and was probed: GET /api/projects returns the bound set with activeProject, and POST /api/project switches in-process without restart (issue178 made it a declared write endpoint). The SURFACE half does not: grep finds ZERO occurrences of 'project' in console.html - no switcher, and the active project is NOT visible at all times (or ever) on the surface, which is a named clause of the SR. Fails on the visibility clause and the surface-switch clause; the parse-failure refusal branch is API-side only."; }
    part srConsoleProjectRebindV1R1 : TestResult { :>> id = "8f8290fa-63b7-45c3-958d-3c397ca988a2"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
