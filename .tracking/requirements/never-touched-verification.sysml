    verification srConsoleModelScopeResolvedV1 : Test { :>> id = "cf36256d-0406-40af-8768-6258d0974b24"; :>> title = "Scope resolves at the API; the surface never names it"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "HONEST FAIL. GET /api/scope resolves an item to a scope and names this repository COINCIDENT (probed) - the resolution machinery exists. But the SR requires the scope in view to be NAMED ON THE SURFACE at all times without interaction, and the console renders scope nowhere: grep finds no scope badge, banner or label in console.html. Fails on the always-visible clause; the resolution clause alone is not the requirement."; }
    part srConsoleModelScopeResolvedV1R1 : TestResult { :>> id = "9c842ba5-2067-4911-ac55-d8b105ec23dd"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
