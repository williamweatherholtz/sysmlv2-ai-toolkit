    verification srViewerPersistedViewStateV1 : Test { :>> id = "1df206d3-63cc-45ff-9864-98e31e18ef69"; :>> title = "No declared view-state artifact exists"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "HONEST FAIL. The SR requires a viewer session's viewpoint selection, filters and view state persisted as a DECLARED artifact in the repository (.engine/views form) and restored on re-open. Nothing does this: the console keeps selection in the URL hash and in-memory state, the deck keeps verdict drafts in browser localStorage keyed by item uuid, and .engine/views holds viewpoint DEFINITIONS, not sessions. Unbuilt end to end."; }
    part srViewerPersistedViewStateV1R1 : TestResult { :>> id = "7ba79dbb-b0e9-4d10-82d9-91c9cd7a8b93"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
