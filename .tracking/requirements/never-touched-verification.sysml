    verification srConsoleArrivalBoundedV1 : Test { :>> id = "74bf7bd5-bcfe-4260-96dc-b4b5ddac8f0c"; :>> title = "Top-level choices are a function of declared grouping, not viewpoint count"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "The /api/surfaces computation groups by DISTINCT declared `surface` values (probed; the endpoint states it), so N added viewpoints leave the top-level count unchanged unless one names a NEW surface - which is the declared-grouping function the SR demands, not a per-viewpoint tab. Viewpoints declaring no surface appear under one explicit unsurfaced group rather than adding choices. Not re-probed by actually adding a viewpoint (that writes to the registry); the derivation is structural in the endpoint."; }
    part srConsoleArrivalBoundedV1R1 : TestResult { :>> id = "2d3ceb11-cca7-40ef-84bd-7459b2713afd"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    #Verify dependency from srConsoleArrivalBoundedV1 to srConsoleArrivalBounded;

    verification srConsoleViewStatusExplicitV1 : Test { :>> id = "89f8676b-eedd-4b6e-8786-3e9f995bf683"; :>> title = "Every rendered view carries a status discriminant, four states distinguishable"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::test; :>> procedureText = "The server wraps every render in with_status (unit-tested in view_status_tests, including the array-body case: no render path emits content without a status); the page's statusBanner draws each state distinctly, and error paths render FAILURE as failure - the obligations bar's catch branch literally renders 'this is a FAILURE, not nothing owed'. Live responses probed on /api/surfaces, /api/projects and /api/scope all carried viewStatus."; }
    part srConsoleViewStatusExplicitV1R1 : TestResult { :>> id = "cb3c1707-8655-43c2-ab31-5de29214f6eb"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
