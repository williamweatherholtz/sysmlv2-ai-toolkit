    verification srDcTwoLaneIntegrationV1 : Test { :>> id = "c7612380-d171-4193-9cc2-28834913a2c2"; :>> title = "Two integration lanes, routed by what a contribution changes"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::demo; :>> procedureText = "Both lanes are shipped machinery, exercised constantly. TRUNK LANE (RECORD/EXECUTE): keel sync integrates by merge and gates the result; keel land pushes and on rejection gates the MERGED tree before retrying - this session alone landed sprints 390-393 through it, each gated at the merge. CHANGE LANE: schema/process changes go through a recorded Decision with explicit human acceptance (D0106 machinery; the review queue and deck exist to record exactly that sign-off), and the CR process itself is frozen. Routing is by change class per the response contract's routing table, enforced at the turn boundary by hook stop."; }
    part srDcTwoLaneIntegrationV1R1 : TestResult { :>> id = "712df499-a9bf-445a-af6d-e28b59ef3259"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    #Verify dependency from srDcTwoLaneIntegrationV1 to srDcTwoLaneIntegration;

    verification srGovTieredAffordancesV1 : Test { :>> id = "ca1f4309-e061-40af-a689-c4fcf5accfff"; :>> title = "Gating tiers exist and are added on measured evidence"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "The tiers exist exactly as graded: the turn-boundary stop gate blocks dishonest state; the per-edit post-tool tier runs the fast checks (D0134); the pre-action deny tier exists for protected fact surfaces (D0176 three-tier write path) with ask and recorded-override grades below it. The MEASURED-evidence clause is machinery, not intent: every hook fire appends to the fire-ledger (D0180), keel enforcement-report reads it, and the guided adoption profile keeps new controls advisory-first with promotion requiring cited ledger evidence (the D0174 profile design records roughly three sprints as the promotion bar). Blocking is reserved for clear violations; the rest warn - the honest-state rule (D0098) is the grading criterion."; }
    part srGovTieredAffordancesV1R1 : TestResult { :>> id = "11f9f09c-1e3d-487c-b64b-ba4a07c277b0"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
    #Verify dependency from srGovTieredAffordancesV1 to srGovTieredAffordances;

    verification srRelPublishedArtifactV1 : Test { :>> id = "492850a8-b201-4262-a8ae-bb3953836ee0"; :>> title = "A tag publishes downloadable binaries carrying the embedded engine"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::demo; :>> procedureText = "Probed against GitHub: releases v0.2.0 through v0.2.3 exist and v0.2.3 carries three platform artifacts (keel-linux-x86_64, keel-macos-aarch64, keel-windows-x86_64.exe) published by CI on tag. The engine keel init ships is embedded IN the binary at build time (include_dir; K3 parity by construction), so the download IS binary-plus-engine and obtaining a version is a download, not a local build."; }
