    verification srConsoleNavigationDerivedV1 : Test { :>> id = "eb9260d3-262c-4bd5-afb1-7315a74fd785"; :>> title = "Navigation is computed from the Viewpoint registry"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::demo; :>> procedureText = "Probed live: GET /api/surfaces returns navigation COMPUTED from the declared Viewpoint registry (its own response text names D0154 and states the derivation: top-level choices are the DISTINCT declared surfaces). The console fetches this at render time and its source declares - and grep confirms - NO literal list of surfaces, tabs or sections anywhere in the page (the header comment records that twelve hardcoded tabs were removed for exactly this SR). Declaring a viewpoint with a new surface adds a choice; one on an existing surface does not."; }
