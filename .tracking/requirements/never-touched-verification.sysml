    verification srConsoleObligationsOnArrivalV1 : Test { :>> id = "31b02f8e-72ac-495f-b156-18ba9a6f62e7"; :>> title = "Obligations render on arrival, classes derived from declared act-surface viewpoints"; :>> createdAt = "2026-08-21"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "render() awaits obligationBar() FIRST and prepends it to the arrival view - no navigation act reaches the obligations, they are already there. The class set comes from /api/obligations, whose classes are the declared act-surface viewpoints (the page's own empty-state text says so: declare a viewpoint with surface=act to add one) - derived, not enumerated in page code. A computation failure renders as failure, never as nothing-owed."; }
    part srConsoleObligationsOnArrivalV1R1 : TestResult { :>> id = "977316be-d856-429c-98fe-db262ed59026"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "aeaca42"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
