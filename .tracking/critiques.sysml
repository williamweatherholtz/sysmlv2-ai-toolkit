    // == Element-critique backfill pass, 2026-08-17 (sprint 324). Five human-authored Needs x Core-3.
    // INDEPENDENT by the declared policy: each target's createdBy is wweatherholtz and the judge is
    // claudeOpus5 (critique-policy.toml requires judgedBy != the element's author). The 87 uncovered
    // elements authored by claudeOpus5 CANNOT be critiqued here - they need a different critic.
    verification nProcessPortabilityCompletenessCritique : Test { :>> id = "7377ee0a-22c5-4305-b8b0-daf126b593d3"; :>> title = "Critique nProcessPortability - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "The Need bundles FIVE capabilities and only THREE are decomposed. Import/export/activate/disable is srPortCatalogExchange, the self-contained unit is srPortModularProcessUnit, and the palette is `keel init` shipping .engine/processes. But 'AI helps select from a described goal' and 'usage/popularity is (opt-in) observable' have NO requirement and no backlog item, and process_cmd.rs explicitly DECLINED the popularity clause in its own module doc on the grounds that sending usage data outward is a decision for a human. So two clauses of an accepted Need are unrooted, and one was refused at implementation time without the Need being revised - the reader cannot tell which clauses are live. SECOND GAP: the Need never says what portable MEANS measurably. srPortModularProcessUnit supplies 'moved between projects whole, without carrying the rest of the engine and without leaving its enforcement behind', which is a good criterion, but it was authored downstream - the Need itself sets no boundary, so a partial implementation could satisfy it."; }
    part nProcessPortabilityCompletenessCritiqueR1 : TestResult { :>> id = "d2bc03c1-b007-49f9-b212-867c15259a1b"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nProcessPortabilityCompletenessCritique to nProcessPortability;
    verification nProcessPortabilityCorrectnessCritique : Test { :>> id = "a8445810-14b5-4e4b-853a-1514c589eaeb"; :>> title = "Critique nProcessPortability - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'A process is a self-contained unit ... whose enforcement travels with it (activate turns its guards on, disable off)' ASSERTS MORE THAN ANY FILE TRANSFER CAN DELIVER, and the implementation already documents the gap: unit.toml warns that 'a receiving project must have them in its binary and activate this process for them to run - importing the files alone lands the skill and leaves the teeth behind'. Guards are compiled into keel, so what travels is the NAME of the enforcement and its activation, not the enforcement. A downstream project on an older binary can import a process and activate it while a named guard silently does not exist. The Need as written is therefore not satisfiable by the mechanism it describes, and the true property - enforcement travels IF the receiving binary implements it - is materially weaker and belongs in the statement rather than in a manifest comment."; }
    part nProcessPortabilityCorrectnessCritiqueR1 : TestResult { :>> id = "97568ce1-e93f-4f58-940e-8740723cea4b"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nProcessPortabilityCorrectnessCritique to nProcessPortability;
    verification nProcessPortabilityTestabilityCritique : Test { :>> id = "867ebc44-ac22-4810-8d80-bd4f786248a6"; :>> title = "Critique nProcessPortability - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "Three clauses are demonstrable and two are not. DEMONSTRABLE: import/export (a bundle written and read back), activate/disable (a guard's GuardState flipping Active/Inactive), and the palette (a fresh `keel init` holding the curated set). NOT FALSIFIABLE AS WRITTEN: 'AI helps select from a described goal' names no success criterion - any suggestion whatsoever satisfies it - and 'usage/popularity is (opt-in) observable' names no observer, no metric and no threshold, so no test can fail. A Need with unfalsifiable clauses cannot be closed: coverage will read as satisfied on the three testable clauses while two remain permanently unverifiable, which is the Goodhart shape CLAUDE.md invariant 7 warns about - promote to a requirement only when a justified boundary exists, or drop the clause to an indicator."; }
    part nProcessPortabilityTestabilityCritiqueR1 : TestResult { :>> id = "cf6bb5e8-93f5-466b-bac3-e410c7be7e4c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nProcessPortabilityTestabilityCritique to nProcessPortability;
    verification nAiGovernanceInLoopCompletenessCritique : Test { :>> id = "e405bbfb-7f34-4d93-8480-bbea59889237"; :>> title = "Critique nAiGovernanceInLoop - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "The Need specifies the mechanism (in-loop gates that block at the action/turn boundary with corrective feedback) but never the FALSE-POSITIVE PATH, which is the part that decides whether such a system is usable. 'Guard against over-governance thrash: block clear violations, warn the rest' gestures at it and defines neither 'clear' nor what an agent does when a gate is wrong. The engine answered this downstream - 25 hard-blocking and 9 warning-only guards, honest-state gating (D0098) that never blocks on incompleteness, and D0136's absent-rule-means-not-adopted - all of which are good answers the Need does not ask for and would not detect the absence of. ALSO MISSING: nothing says the gate's verdict must be RECORDED. In practice every guard run is transient; only the reverify path stamps evidence. A governance Need that does not require its own gates' verdicts to be inspectable after the fact leaves the strongest audit question unasked."; }
    part nAiGovernanceInLoopCompletenessCritiqueR1 : TestResult { :>> id = "4b717f88-1fd1-435b-9580-53bd5dedbe39"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nAiGovernanceInLoopCompletenessCritique to nAiGovernanceInLoop;
    verification nAiGovernanceInLoopCorrectnessCritique : Test { :>> id = "8329f54d-d746-4c6f-ac4b-4b0b68353545"; :>> title = "Critique nAiGovernanceInLoop - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "SOLUTION-BOUND: the Need names its own implementation - 'CLI + MCP surface serves discovery' - and MCP is a technology choice, not a need. The need is that the required process be discoverable by the agent; whether that arrives via MCP, a CLI, or a system prompt is architecture. This matters concretely rather than pedantically: the engine's actual answer to discovery became the output style plus `keel orient` plus the hook surface, with no MCP server built, so the Need names a mechanism that does not exist while the concern it stands for IS served. A reader auditing satisfaction has to decide whether an unbuilt MCP surface is a gap - and the honest answer is that the clause was never the requirement."; }
    part nAiGovernanceInLoopCorrectnessCritiqueR1 : TestResult { :>> id = "61f84810-3b8c-4587-9404-cd2a6b4d2ae9"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nAiGovernanceInLoopCorrectnessCritique to nAiGovernanceInLoop;
    verification nAiGovernanceInLoopTestabilityCritique : Test { :>> id = "bb762746-f2ee-41be-a940-c72220e8c88d"; :>> title = "Critique nAiGovernanceInLoop - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "The load-bearing clause is the one that cannot be tested, and the engine has already recorded this: 'no prose-as-truth' and 'the agent's natural narrative is CHANNELED into typed fields' both concern what the agent SAYS, and D0151 states plainly that the verify-before-asserting clause of the response contract has NO control behind it because no gate can read conversational output. So the Need's central compliance property is verifiable only by a human reading transcripts - it has no automatable test, and its own governing Decision says so. That is honest but it means this Need can never compute as verified by machine. It should either carry an explicit human-inspection verification method, or the unenforceable half should be separated from the enforceable half (blocking gates at the tool boundary) so coverage stops implying the whole is checked."; }
    part nAiGovernanceInLoopTestabilityCritiqueR1 : TestResult { :>> id = "99179e68-4f5c-4340-b13e-1fe8a044a961"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nAiGovernanceInLoopTestabilityCritique to nAiGovernanceInLoop;
    verification nReleaseDisciplineCorrectnessCritique : Test { :>> id = "b5500353-c5d4-4df1-99fe-a61e20c3e096"; :>> title = "Critique nReleaseDiscipline - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE JUSTIFYING CLAUSE IS NOW FALSE. The statement ends 'This operationalises the DEFINED-but-never-run Deploy workflow (a dogfooding gap: the engine governs Business->Architecture->Delivery->Deploy->Operate but has never run its own Deploy)' - and the engine has since run it repeatedly: releaseTag010Story, release020Story and releaseAssetStory are recorded delivery sprints, and the crate is at 0.2.3. The gap the Need cites as its reason no longer exists. A stale justification is not cosmetic: a reader deciding whether this Need is still live reads a parenthetical asserting a dogfooding gap and concludes nothing has shipped. The concern (release with discipline, every time) survives; the evidence offered for it has expired and needs re-basing on what is now unmet."; }
    part nReleaseDisciplineCorrectnessCritiqueR1 : TestResult { :>> id = "21d7989b-d9f1-4269-a931-36032683eb90"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nReleaseDisciplineCorrectnessCritique to nReleaseDiscipline;
    verification nReleaseDisciplineCompletenessCritique : Test { :>> id = "d5771ad6-fa13-4ab8-92dd-aef8386ed518"; :>> title = "Critique nReleaseDiscipline - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Complete on the FORWARD path and silent on everything after. Named: semver reconciled across crate + API contract + embedded engine, a git tag, a CI-built published artifact, a recorded Release item. Absent: (a) what 'published' means - GitHub release asset, crates.io, both? The distinction is the difference between a downstream project being able to cargo-install and having to build from source; (b) any withdrawal path - no yank, no rollback, no superseded-release state, so a release shipped with a defect has no recorded remedy in a system whose whole premise is that state is computed from records; (c) WHO may cut a release - every other authority in this engine is declared (attestation-policy.toml names who may accept a Decision or disposition a finding) and release authority is not."; }
    part nReleaseDisciplineCompletenessCritiqueR1 : TestResult { :>> id = "eec42241-bc67-4c69-96fa-98b14cec7d5f"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nReleaseDisciplineCompletenessCritique to nReleaseDiscipline;
    verification nReleaseDisciplineTestabilityCritique : Test { :>> id = "8b472c97-df3c-430a-9f2d-25d96e0bb80e"; :>> title = "Critique nReleaseDiscipline - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, and narrowly. The artifact clauses are a conjunction of independently checkable facts - a version string reconciled across three places, a tag that resolves, an artifact that exists at a URL, a Release item present with its edges - and `keel version` already reports the reconciliation, so a test can fail. THE ONE UNFALSIFIABLE CLAUSE is 'Cadence is per-milestone/on-demand (not per-sprint)': any release interval whatsoever satisfies 'on-demand', including never. It is a non-goal dressed as a property, and reading it as a constraint would be reading something testable into it that is not there. Recorded as a pass because the clause is honestly a scope exclusion rather than a requirement, and the Need's substantive content is verifiable."; }
    part nReleaseDisciplineTestabilityCritiqueR1 : TestResult { :>> id = "15de364b-eca9-48b4-a58b-8366bcfb6d94"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nReleaseDisciplineTestabilityCritique to nReleaseDiscipline;
    verification nServeApproveBeforeExecuteCompletenessCritique : Test { :>> id = "a49ce6bd-5344-4352-b917-0324af29ede0"; :>> title = "Critique nServeApproveBeforeExecute - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Specifies the approval and nothing around it. THREE UNSPECIFIED PATHS: (a) DISAPPROVAL - what happens when the operator rejects the parse? Re-parse, edit the routing, abandon the task? The Need requires an approval gate without saying what the gate's other branch does, and a gate with one defined outcome is a formality; (b) ABSENCE - `keel serve` is local and the operator may be away, so a task waiting on approval waits forever with no timeout, expiry or queue semantics stated, which is precisely the state the authority-queue view had to be invented to make visible; (c) SCOPE - 'before an AI task runs' does not distinguish a task that WRITES from one that only reads, so it demands approval for a read the operator could simply have run themselves, and over-governance of exactly the kind nAiGovernanceInLoop warns about."; }
    part nServeApproveBeforeExecuteCompletenessCritiqueR1 : TestResult { :>> id = "9a6bc4fa-3b86-4eb7-9837-5e00777a5493"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeApproveBeforeExecuteCompletenessCritique to nServeApproveBeforeExecute;
    verification nServeApproveBeforeExecuteCorrectnessCritique : Test { :>> id = "3d2af82c-2f1e-42d1-9bac-ef69a15cc433"; :>> title = "Critique nServeApproveBeforeExecute - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "AMBIGUOUS BETWEEN TWO AGENTS, and only one of them can satisfy it. Read as the serve-launched task path it is correct and implemented (srServeApproveGateHuman, an approve gate before spawn). Read as 'any AI task', which the words support, it is UNSATISFIABLE: an agent working in a terminal parses and routes in its own output, and D0151 records that no gate can read conversational output - the Parsed block that shows routing is a response-contract clause with no control behind it. So the same sentence is satisfied for one execution path and unenforceable for the other, with nothing in the Need to tell a reader which was meant. 'The agent never SILENTLY acts on its own interpretation' is also stronger than the mechanism delivers: showing the parse prevents silence, not misinterpretation - an operator can approve a wrong parse, and approval then records assent rather than correctness."; }
    part nServeApproveBeforeExecuteCorrectnessCritiqueR1 : TestResult { :>> id = "2c37e1ef-cfe9-49f2-bc07-2ba0adfd2483"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeApproveBeforeExecuteCorrectnessCritique to nServeApproveBeforeExecute;
    verification nServeApproveBeforeExecuteTestabilityCritique : Test { :>> id = "40482a8c-69e6-4d85-8790-30b308d2cebc"; :>> title = "Critique nServeApproveBeforeExecute - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "Testable exactly where the mechanism is a gate, and untestable where it is a habit. For a serve-launched task, 'the operator saw the parse and approved' is a recordable event with a real negative case: launch without approval must fail. For the terminal path there is no observable at all, per D0151. Since the Need does not say which path it governs (see the correctness lens), a verification cannot be written that would fail for the right reason - it will be written against the serve path, pass, and be read as evidence for the whole Need. That is not a testability defect in the mechanism but in the STATEMENT: it admits a reading no test can reach."; }
    part nServeApproveBeforeExecuteTestabilityCritiqueR1 : TestResult { :>> id = "1c22a1cd-eea0-4773-b955-8034df0efd83"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeApproveBeforeExecuteTestabilityCritique to nServeApproveBeforeExecute;
    verification nServeBoundedContextCompletenessCritique : Test { :>> id = "e9ea470e-5b91-4e8d-892c-0151bf45d4f1"; :>> title = "Critique nServeBoundedContext - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "No bound is stated for a Need whose entire subject is a bound. 'Narrow, single-purpose context' names no unit - tokens, files, items, or one work item - and 'large work is decomposed into small launches' names no threshold at which decomposition becomes required. Nothing says who decides, either: the operator, the agent, or a computed rule. Compare nProcessPortability, whose downstream requirement supplied the missing criterion; here the downstream requirements (srServeBoundedReachableContext, srServeScopedContext) chose bounds of their own, so the boundary exists in the architecture and NOT in the need it claims to serve - which means the Need cannot adjudicate a dispute about whether a given context is too wide."; }
    part nServeBoundedContextCompletenessCritiqueR1 : TestResult { :>> id = "b8f176d6-2765-49a6-bf83-12a0a407d844"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeBoundedContextCompletenessCritique to nServeBoundedContext;
    verification nServeBoundedContextCorrectnessCritique : Test { :>> id = "43e3d60b-1d94-4eaa-9c41-5d894b401f7f"; :>> title = "Critique nServeBoundedContext - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE NEED IS CONTRADICTED BY THE PRIMARY WAY THIS ENGINE IS ACTUALLY USED, and that is the finding rather than a quibble. This very session is a long-running, diffuse, multi-sprint goal in one continuous context - the opposite of 'narrow, single-purpose context so the agent does not drift' - and it has been the productive mode: sprints 317-323 depended on continuity that a decomposed launch would have discarded. Also asserted without evidence: that narrow context PREVENTS drift. The engine's observed drift control is not context size but the computed frontier and the gates - the agent re-reads state rather than remembering it. So the Need's causal claim is at best unproven and at worst inverted, and it competes with an unstated benefit (continuity) that no Need currently represents."; }
    part nServeBoundedContextCorrectnessCritiqueR1 : TestResult { :>> id = "8907c28f-535b-4b29-be93-3151f3d90d0d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeBoundedContextCorrectnessCritique to nServeBoundedContext;
    verification nServeBoundedContextTestabilityCritique : Test { :>> id = "1b803388-3914-424a-8bc0-f4fe7d1ecaf9"; :>> title = "Critique nServeBoundedContext - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "UNFALSIFIABLE AS WRITTEN. With no unit and no threshold (see completeness), no observation can contradict 'narrow, single-purpose context': any context can be described as single-purpose at a sufficiently abstract purpose, and any work as decomposed at a sufficiently coarse grain. A verification would have to invent the bound it is testing, which makes the test a statement of the tester's opinion rather than a check of the Need. The honest options are to bind it to a measurable proxy and accept Goodhart risk, or to demote it to an INDICATOR - monitored by direction with no enforced threshold - which is exactly the disposition CLAUDE.md invariant 7 prescribes when a defensible boundary cannot be set."; }
    part nServeBoundedContextTestabilityCritiqueR1 : TestResult { :>> id = "4d480aa2-eee4-44af-839d-dacc08989e26"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "763b016"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeBoundedContextTestabilityCritique to nServeBoundedContext;

    // == Element-critique backfill pass 2, 2026-08-17 (sprint 325). Five human-authored Needs x Core-3.
    // INDEPENDENT: every target's createdBy is wweatherholtz; the judge is claudeOpus5.
    verification nServeLaunchDefinedOnlyCompletenessCritique : Test { :>> id = "59df5753-1c78-4416-b46d-79ad085a330b"; :>> title = "Critique nServeLaunchDefinedOnly - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE NEED FORBIDS AT THE BOUNDARY THE EXACT CASE THE PROCESS REQUIRES. CLAUDE.md section 3 says that if a non-trivial request maps to no existing process, the correct response is to DEFINE the process - 'that is the creative output, not an ad-hoc action'. This Need says only a DEFINED process is invocable and 'a freeform / un-routed action is not offered'. Both are right, and between them there is no stated path: nothing says how an operator or agent AUTHORS a new process from the launch surface, so the first-ever encounter with a novel request is either refused at the boundary or done outside it. The Need needs a defining clause - process authoring is itself a defined process, invocable like any other - or it makes the console structurally unable to grow its own vocabulary. ALSO ABSENT: what happens when a process is DECLARED but INACTIVE (activation.toml can disable one); the launchable set's relationship to activation state is unstated, so a disabled process is either offered and fails, or hidden with no explanation."; }
    part nServeLaunchDefinedOnlyCompletenessCritiqueR1 : TestResult { :>> id = "5383f003-6857-4818-a290-a19da87e9982"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeLaunchDefinedOnlyCompletenessCritique to nServeLaunchDefinedOnly;
    verification nServeLaunchDefinedOnlyCorrectnessCritique : Test { :>> id = "c43884b2-df87-4d0b-a0f5-4d8912d1f4f8"; :>> title = "Critique nServeLaunchDefinedOnly - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'Invalid actions are unrepresentable at the boundary' OVERCLAIMS what a launch surface can guarantee, and the gap matters because the phrase invokes a strong design property. What is genuinely unrepresentable is an unlisted SELECTION: the operator cannot pick a process that is not declared. But the launch spawns an agent, and from that instant the agent's action space is its own tools, not the boundary's menu - it can edit any file, run any command, and work outside every defined process. So the property holds for the CHOICE and not for the EXECUTION, which is the part that actually needs governing, and which is why in-loop gates (nAiGovernanceInLoop) exist as a separate Need. As written a reader concludes the boundary makes process violation impossible; it makes unlisted process SELECTION impossible."; }
    part nServeLaunchDefinedOnlyCorrectnessCritiqueR1 : TestResult { :>> id = "80ad6290-40c8-4830-af5c-ba7f36072090"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeLaunchDefinedOnlyCorrectnessCritique to nServeLaunchDefinedOnly;
    verification nServeLaunchDefinedOnlyTestabilityCritique : Test { :>> id = "b49aa7fe-14c2-41de-b702-4b3ca6eb2d80"; :>> title = "Critique nServeLaunchDefinedOnly - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES with a narrower reading than the words. The falsifiable claim is precise and has a real negative case: POST a launch naming a process that is not in the declared set and the surface must REFUSE. That test can fail, and it tests the property that is actually implemented. The unrepresentability claim in its strong reading (see correctness) is not testable at all, since it quantifies over everything a spawned agent might do - but that reading is not what any verification would be written against. Recorded as a pass because the testable core is well-defined and adversarially checkable, with the caveat that a passing verification evidences the selection boundary only."; }
    part nServeLaunchDefinedOnlyTestabilityCritiqueR1 : TestResult { :>> id = "456c4728-7288-447a-a384-02310ba13f8d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeLaunchDefinedOnlyTestabilityCritique to nServeLaunchDefinedOnly;
    verification nServeReuseModelCorrectnessCritique : Test { :>> id = "e33c93aa-43c0-46ae-83b9-5e45527c2fb6"; :>> title = "Critique nServeReuseModel - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE ENGINE CONTAINS A LIVE VIOLATION OF THIS EXACT PROPERTY, in the control that validates viewpoints. The Need forbids 'a separately-maintained list that can drift' in favour of reading from the declared model. guards.rs holds VIEW_SUBCOMMANDS, a hardcoded array of known keel commands, and the viewpoint-renderer guard validates every declared renderer against it. Its own comments record the drift: 'authority-queue - real since D0129 sync work; never added here, so the first viewpoint naming it failed'. A real command was rejected because the hand-maintained list had not caught up - which is the failure mode this Need exists to prevent, occurring inside a guard. issue139 (fixed in sprint 322) was the same shape one level over: a viewpoint enumeration read from one hardcoded filename while the model saw them all. The Need is correct as an aspiration and is not upheld by the implementation it governs."; }
    part nServeReuseModelCorrectnessCritiqueR1 : TestResult { :>> id = "bc81c379-e3cf-4d1e-bfcd-fdd3ca802fe2"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeReuseModelCorrectnessCritique to nServeReuseModel;
    verification nServeReuseModelCompletenessCritique : Test { :>> id = "66e4a81b-ed54-4bc1-a698-709e1fbd162f"; :>> title = "Critique nServeReuseModel - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "One direction is specified and the inverse is silent. The Need requires the launchable set to be READ from the model, so a process removed from the model disappears from the surface. It does not say what happens when the MODEL declares something the BINARY cannot serve - a process whose deploying skill is absent, or a declared renderer with no matching subcommand - which is the failure that actually occurs, since the model is text a human edits and the binary is a compiled artifact that lags it. Reading from one source of truth removes drift between two LISTS; it does not remove the gap between what is declared and what is executable, and only the second gap can strand an operator at a button that cannot work. The unit.toml precedent shows the answer the engine reaches elsewhere: name the capability and report what the receiving binary lacks."; }
    part nServeReuseModelCompletenessCritiqueR1 : TestResult { :>> id = "8a68b952-6ceb-4f84-ab76-615af4b8a8b2"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeReuseModelCompletenessCritique to nServeReuseModel;
    verification nServeReuseModelTestabilityCritique : Test { :>> id = "bc8a6012-2342-4d20-b041-1486c11cbf8c"; :>> title = "Critique nServeReuseModel - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES. The property is a genuine equivalence between two observable sets and has an obvious falsifier: add a process to the model and it must appear in the launchable set with no code change; remove it and it must disappear. Both halves fail loudly if a hardcoded list exists anywhere in the path, which makes this one of the few Needs in this batch whose test would actually have caught the defect its correctness lens found - had the test been written for VIEW_SUBCOMMANDS as well as for the launchable set. The gap is that no verification currently exercises it, not that none could."; }
    part nServeReuseModelTestabilityCritiqueR1 : TestResult { :>> id = "9f2d4dda-92a1-48db-a355-42add999e890"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeReuseModelTestabilityCritique to nServeReuseModel;
    verification nServeValidatedOutputCompletenessCritique : Test { :>> id = "93adf5ad-c1d5-42ae-b21d-f485b295d7ad"; :>> title = "Critique nServeValidatedOutput - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'Sent back for repair' names a loop with no exit. Unspecified: how many repair attempts before the task is abandoned; what the operator sees when repair keeps failing; and whether the failed attempts are RECORDED. The last is the one that matters in this engine, because a repair loop is where evidence of a systematic generation defect would live - three malformed outputs in a row is a finding about the prompt or the schema, and if nothing is recorded that signal is discarded every time. ALSO UNSPECIFIED: which outputs have an 'expected structure' at all. Some AI output is a Decision's rationale (free prose by design, and deliberately so per nAiGovernanceInLoop's channelling clause) and some is a typed item; the Need reads as though everything is schema-bearing."; }
    part nServeValidatedOutputCompletenessCritiqueR1 : TestResult { :>> id = "84604a2a-049d-404a-9e1d-e8d38e6bbd0c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeValidatedOutputCompletenessCritique to nServeValidatedOutput;
    verification nServeValidatedOutputCorrectnessCritique : Test { :>> id = "daefe488-c256-43ce-8e91-bb993a6f19d7"; :>> title = "Critique nServeValidatedOutput - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "The MECHANISM claim does not match the control that actually protects the model. The Need says malformed output is caught 'at generation time - before it reaches a commit or the model'. What exists is different and arguably better: the post-edit hook runs the fast tier after each .sysml edit, and the Stop hook runs validate plus all guards at the turn boundary, so malformed content is caught AFTER it reaches a file and BEFORE it reaches a commit. The distinction is not pedantic - a generation-time check must know the schema before the text exists, while an edit-time check reads the authored file and can therefore be exact, which is why the implemented control is the exact one and the described control is not. Read literally, the Need asks for a weaker check in an earlier place."; }
    part nServeValidatedOutputCorrectnessCritiqueR1 : TestResult { :>> id = "9ae5ba72-1fd8-41c4-932a-b9330b09abd7"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeValidatedOutputCorrectnessCritique to nServeValidatedOutput;
    verification nServeValidatedOutputTestabilityCritique : Test { :>> id = "0355de2f-ac84-45f5-aeac-858f3e7522d6"; :>> title = "Critique nServeValidatedOutput - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES. Structural validation is the most testable property in this batch: feed output that violates the expected structure and require rejection, then feed conforming output and require acceptance. The negative case is trivially constructible and the engine already demonstrates it - the edit gate rejected an undeclared WorkKind enum member during sprint 318 and named the line. The one clause that resists testing is 'never silently persist', a universal over all paths; a verification can only evidence the paths it exercises, which is a limit of the claim's scope rather than a defect in its statement."; }
    part nServeValidatedOutputTestabilityCritiqueR1 : TestResult { :>> id = "4844c9a1-26cc-4bde-b585-e5bbf66c4faa"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nServeValidatedOutputTestabilityCritique to nServeValidatedOutput;
    verification nViewerBaselineCompareCompletenessCritique : Test { :>> id = "325ca1fb-6f59-430c-8291-1383ac7774f4"; :>> title = "Critique nViewerBaselineCompare - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "BASELINE IS UNDEFINED, and it cannot be left to the reader in this engine. Invariant 1 forbids authoring a baseline as a document, so a baseline must be COMPUTED - and from what is exactly what the Need does not say. Candidates each give different answers: a git tag, a recorded Release item, an arbitrary commit, or a date. The parenthetical says git history is the substrate, which identifies the raw material and not the concept. Without it, 'compare between two baselines' has no operational meaning and two implementers would build two incompatible features. ALSO MISSING: whether a baseline is comparable across a SUPERSESSION - if an element was superseded between the two points, is that a change, a removal, or neither? That is the case a reader most needs answered, since supersession is how this model retires anything."; }
    part nViewerBaselineCompareCompletenessCritiqueR1 : TestResult { :>> id = "5f17589a-1b35-425a-9df0-9a71f99a5227"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerBaselineCompareCompletenessCritique to nViewerBaselineCompare;
    verification nViewerBaselineCompareCorrectnessCritique : Test { :>> id = "c5080435-8c6a-45bc-a5c6-b4689c4e5b5e"; :>> title = "Critique nViewerBaselineCompare - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'What was added / removed / changed / re-verified since' is CORRECT for three of its four terms and quietly wrong for one. Added, removed and changed are properties of the model text between two commits, computable by diff over declared items. RE-VERIFIED is not: a TestResult carries judgedAt and judgedAgainst, so a verification can be re-stamped at a new commit with no change to the element it judges, and it can also go STALE without any commit at all when the deliverable source it was judged against moves (the suspect view exists for exactly this). So re-verification is not a diff between two points; it is a relation between an element, a result, and a commit's resolvability. Grouping it with the diff terms invites an implementation that reports re-verification by diffing result files and therefore misses every staleness transition."; }
    part nViewerBaselineCompareCorrectnessCritiqueR1 : TestResult { :>> id = "3acc13dc-cb04-4b0f-9b26-2ff09df8b03d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerBaselineCompareCorrectnessCritique to nViewerBaselineCompare;
    verification nViewerBaselineCompareTestabilityCritique : Test { :>> id = "73a15d96-c9c9-471c-babe-0c925027c44e"; :>> title = "Critique nViewerBaselineCompare - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "NOT TESTABLE UNTIL BASELINE IS DEFINED. A verification would have to choose what a baseline is (see completeness), and the test would then evidence the tester's choice rather than the Need - a test that cannot fail for the right reason. The diff terms would be testable given a definition, with clean negative cases: an element added between two commits must appear as added and must not appear as changed. The re-verification term needs its own separate criterion for the reason the correctness lens gives. This Need is priority could, which makes the missing definition a smaller problem than it would otherwise be - but it is the reason this cannot be picked up and built as written."; }
    part nViewerBaselineCompareTestabilityCritiqueR1 : TestResult { :>> id = "134f593b-5e31-4dbf-ae42-3c37bb6dc316"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerBaselineCompareTestabilityCritique to nViewerBaselineCompare;
    verification nViewerChangeImpactCorrectnessCritique : Test { :>> id = "aac34b47-6041-4322-8eb3-44cfee213398"; :>> title = "Critique nViewerChangeImpact - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "BLAST RADIUS OVER TYPED EDGES SYSTEMATICALLY UNDERSTATES IMPACT IN THIS ENGINE, and this session supplies three proofs. The Need scopes impact to 'downstream dependents over typed edges'. But the dependencies that actually broke things here were none of them typed: issue139 - a computed view and a hard guard depended on a hardcoded FILE PATH, so splitting one file would have silently disabled a control over 32 elements; issue129 - the attribute-vocabulary guard depended on the union of engine and project SCHEMA, and a project type not in that union produced 1287 false violations; and every TestResult depends on a COMMIT SHA resolving, which is why rebasing orphans evidence and makes orient machine-dependent. None of those three appears in any typed-edge traversal. A change-impact view built exactly to this Need would have reported zero dependents for each of them, with confidence."; }
    part nViewerChangeImpactCorrectnessCritiqueR1 : TestResult { :>> id = "3856fe04-b7e5-401f-955e-c1b4b88ad14d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerChangeImpactCorrectnessCritique to nViewerChangeImpact;
    verification nViewerChangeImpactCompletenessCritique : Test { :>> id = "49f60312-288b-4c8b-bdd9-227e92ef3e9e"; :>> title = "Critique nViewerChangeImpact - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Three unspecified parameters, each of which changes the answer. DEPTH: 'what depends on it' is transitive, and in a graph this dense the transitive closure of a schema type is most of the model - so an unbounded answer is useless and a bounded one needs a stated bound. EDGE SEMANTICS: the edge algebra is not uniform in direction, and supersede in particular runs opposite to dependency - a superseded element's dependents are affected by its RETIREMENT, not by changes to it, which a naive traversal reports backwards. STRENGTH: a satisfy edge and a dependency edge are both traversable and mean entirely different things about impact, and nothing says whether they are weighted or merely enumerated. A blast radius that counts every reachable element equally is a number a reader will learn to ignore."; }
    part nViewerChangeImpactCompletenessCritiqueR1 : TestResult { :>> id = "9df987c1-8fb2-48ba-bc18-9d76e48f15fa"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerChangeImpactCompletenessCritique to nViewerChangeImpact;
    verification nViewerChangeImpactTestabilityCritique : Test { :>> id = "8017e169-0935-4a00-9335-e746c4d72e16"; :>> title = "Critique nViewerChangeImpact - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES for the stated scope. Given a fixture model, 'the dependents of element X over typed edges' has one right answer and a test can fail on it - and the correctness lens's objection is about the SCOPE being too narrow, not about the claim being unfalsifiable. The negative case is well-formed: an element with no incoming edges must report no dependents. What no test can establish is the Need's purpose clause - 'so the blast radius of a proposed change is visible' - since visibility of true impact depends on the untyped dependencies the scope omits. A verification will therefore honestly pass while the stated benefit remains partly unmet, which is the most useful thing to know about this Need."; }
    part nViewerChangeImpactTestabilityCritiqueR1 : TestResult { :>> id = "100b44bf-b6f1-4363-9a88-bbeaa5355b6e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "ee5a7a3"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerChangeImpactTestabilityCritique to nViewerChangeImpact;

    // == Element-critique backfill pass 3, 2026-08-17 (sprint 326). Five human-authored viewer Needs x Core-3.
    // INDEPENDENT: every target's createdBy is wweatherholtz; the judge is claudeOpus5.
    verification nViewerCrossCuttingSlicesCompletenessCritique : Test { :>> id = "100007a9-a7ab-4ca7-a182-afaa856d978c"; :>> title = "Critique nViewerCrossCuttingSlices - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "CONFIGURABLE depth and edge selection are asked for and neither is bounded, and unbounded is the failure case here rather than a nicety: this model's typed-edge graph is dense enough that a depth-4 slice around most seeds reaches most of the corpus, so an unbounded configuration produces the thing the Need exists to prevent - everything shown. Nothing states a maximum, a default, or what the UI does when a requested slice would return the whole model. THE MORE IMPORTANT OMISSION IS THE SLICE BOUNDARY: when a slice cuts an edge whose far end is excluded, the Need does not say whether that edge appears as a stub or vanishes. A slice that silently omits a cut edge shows an element as having no dependents when it has some outside the frame, which is exactly the partial-view-reported-as-complete failure that produced issue109, issue136 and issue139 in this engine. The seed-relative view must say something about its own edges, and this Need does not require it to."; }
    part nViewerCrossCuttingSlicesCompletenessCritiqueR1 : TestResult { :>> id = "ba3eb00a-bb28-4512-bd5f-87b7012f654c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerCrossCuttingSlicesCompletenessCritique to nViewerCrossCuttingSlices;
    verification nViewerCrossCuttingSlicesCorrectnessCritique : Test { :>> id = "40f54a0d-4b9b-4a26-847d-cf57495d9d9f"; :>> title = "Critique nViewerCrossCuttingSlices - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT, and I checked the claim I expected to be stale rather than assuming it. The statement says it generalizes 'the fixed 1-hop / Need-only slices (element_neighbourhood / need_slice) that exist today', and my first reading was that those named the retired query.py functions (D0074) - which would have made the clause false. They do not: both still exist, in keel-cli/src/view.rs, so the Need accurately describes a generalization of live behaviour. The characterisation is also right: the existing slices are fixed at one hop and seeded only from a Need, and configurable depth plus edge selection is a genuine generalization of exactly that. Recorded as a pass on verified fact, not on the absence of an objection."; }
    part nViewerCrossCuttingSlicesCorrectnessCritiqueR1 : TestResult { :>> id = "b28ec86c-18f4-49fd-b083-28156f233845"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerCrossCuttingSlicesCorrectnessCritique to nViewerCrossCuttingSlices;
    verification nViewerCrossCuttingSlicesTestabilityCritique : Test { :>> id = "d59a631d-d3f3-481c-95b0-4cfdcf53a7aa"; :>> title = "Critique nViewerCrossCuttingSlices - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "Testable in its parameters and untestable in its purpose. GIVEN a depth and an edge set, the returned element set has one right answer against a fixture, with a clean negative case: an element two hops away must not appear in a one-hop slice. But the Need's actual claim is 'view only the data interrelated with a seed and hide everything else', and INTERRELATED is not defined - it is the thing depth-and-edge-selection is supposed to approximate. So a verification tests the approximation the tester chose, and passes, while the claim about relevance remains unexamined. Combined with the unbounded depth (see completeness), no test can fail for the right reason on the property that matters: that what is shown is what is related."; }
    part nViewerCrossCuttingSlicesTestabilityCritiqueR1 : TestResult { :>> id = "5483d96d-7c9c-46aa-9bb4-d2de909ea2a1"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerCrossCuttingSlicesTestabilityCritique to nViewerCrossCuttingSlices;
    verification nViewerEncodingViewpointsCompletenessCritique : Test { :>> id = "be0a7144-c23d-48cd-9f0e-a4fd0fc43abd"; :>> title = "Critique nViewerEncodingViewpoints - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "The channel list is unusually thorough - colour, horizontal position, swimlane bands, nested bands - and the CONFLICT RULES are entirely absent, which is where such a feature actually fails. Unspecified: what happens when two attributes are bound to the same channel; what happens when a bound attribute is ABSENT on some elements in the view (surface is optional on Viewpoint, and dozens of attributes are 0..1, so a partial binding is the normal case rather than the exception); and whether an element with no value for the bound attribute is hidden, greyed, or placed in an other band - three choices that tell the reader three different things about the data. ALSO MISSING: any statement that the encoding must be LEGIBLE to a reader who did not configure it. A view whose colour means something only to its author is a private note, and this Need's stated purpose is a reusable declarable analytical view."; }
    part nViewerEncodingViewpointsCompletenessCritiqueR1 : TestResult { :>> id = "a371594c-747d-4bc9-aa03-a7aa88f32838"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerEncodingViewpointsCompletenessCritique to nViewerEncodingViewpoints;
    verification nViewerEncodingViewpointsCorrectnessCritique : Test { :>> id = "d5feeabf-1a47-46f3-bf67-999b6bab1488"; :>> title = "Critique nViewerEncodingViewpoints - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT, and specifically the auto-generation premise holds - which I expected to fail and verified instead of assuming. The Need requires the mapping to be 'defined SEMANTICALLY enough to AUTO-GENERATE from the schema + data (types, attribute kinds, enum members, value ranges)', and my first reading was that the schema could not support it because dates would be plain Strings, making 'horizontal position <- a date attribute' unresolvable. It can: schema/core/element.sysml declares createdAt as Timestamp, a distinct type, and enum members are declared types the binary already derives vocabulary from (schema.rs). So types, attribute kinds and enum members are all genuinely available to an auto-generator. The one clause with no schema support is 'value ranges' for continuous binning, which must come from the DATA rather than the schema - and the Need says schema plus data, so it accounts for that too."; }
    part nViewerEncodingViewpointsCorrectnessCritiqueR1 : TestResult { :>> id = "31b388c9-c2eb-471b-8a13-4721120582a5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerEncodingViewpointsCorrectnessCritique to nViewerEncodingViewpoints;
    verification nViewerEncodingViewpointsTestabilityCritique : Test { :>> id = "70418567-e029-463b-b2a1-20e403805ab7"; :>> title = "Critique nViewerEncodingViewpoints - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "'Defined SEMANTICALLY ENOUGH to auto-generate' is the clause the whole Need rests on and it carries no criterion, so it cannot fail. Enough for what quality of output? A generator that binds every enum to a colour ramp and every Timestamp to the x-axis satisfies the words while producing views nobody would use, and a generator that produces one excellent default per type also satisfies them. Without a stated acceptance criterion - the generated view must be usable with no manual override for at least the declared viewpoints, say - a verification records that generation HAPPENED, not that the semantics were sufficient. THE OVERRIDE LAYER IS TESTABLE and should be verified separately: an override must survive a regeneration, which is a real falsifiable property with an obvious failure mode. CORRECTED 2026-08-17 (sprint 328), and the correction is left visible because the error is instructive: this lens originally closed with a claim that N-18 was not yet accepted, sourced from a prose comment reading PENDING human acceptance of N-18 - NOT yet accepted. That comment was STALE and sat directly above the passing acceptance result it denied (keelViewerNeedsAccept5R1, judgedBy wweatherholtz, 2026-07-15). N-18 IS accepted, its testability defect is therefore already inherited by five derived SystemRequirements, and the stale comments are deleted with a guard added so the class cannot recur (issue140). The testability finding above stands unchanged on its own ground."; }
    part nViewerEncodingViewpointsTestabilityCritiqueR1 : TestResult { :>> id = "3674e20d-e831-4f8a-b019-f04db96879a7"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerEncodingViewpointsTestabilityCritique to nViewerEncodingViewpoints;
    verification nViewerExplorableGraphCorrectnessCritique : Test { :>> id = "18e7a808-4952-4e7a-abb0-85597abc744e"; :>> title = "Critique nViewerExplorableGraph - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE SCALE TARGET IS ALREADY BEHIND THE DATA. The Need asks the graph to scale 'past a few thousand nodes', citing a freeze at about 2500. This repository's own model was measured in sprint 317 at 8005 deliverable items plus 689 engine items - so the corpus the viewer must open is roughly three times the target the Need sets, and a viewer that satisfied this Need exactly would still be unable to open keel. 'A few thousand' was a description of the failure that prompted the Need rather than a requirement derived from the data, and it aged in the wrong direction because the model grows monotonically. The mechanism clause (incremental loading rather than embedding the whole model) is right and is the durable part; the number needs re-basing on the corpus, and ideally on its growth rate rather than its current size."; }
    part nViewerExplorableGraphCorrectnessCritiqueR1 : TestResult { :>> id = "8724a7a6-f093-4d9b-b752-e5f072a8fb3a"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerExplorableGraphCorrectnessCritique to nViewerExplorableGraph;
    verification nViewerExplorableGraphCompletenessCritique : Test { :>> id = "1196f867-05c4-4269-a734-23161b36ac5a"; :>> title = "Critique nViewerExplorableGraph - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Three terms of art, none defined. STABLE LAYOUT - stable across what? Reloads of the same data, additions to it, a filter change, or a different machine? Each is a different and much harder guarantee, and the useful one (an element does not jump when unrelated elements are added) is not implied by the weakest one. DRILL-INTO-DETAIL - unspecified whether detail replaces the graph, opens beside it, or expands in place, which decides whether the reader keeps their orientation. NO LATENCY BUDGET: 'scaling' is stated as a node count with no time bound, so a viewer that opens 8000 nodes in forty seconds satisfies the Need while being unusable. The freeze this Need reacts to was a latency failure, and the Need records the node count rather than the time."; }
    part nViewerExplorableGraphCompletenessCritiqueR1 : TestResult { :>> id = "cdaf8a2f-65e4-4dfa-90b6-556f343fd06d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerExplorableGraphCompletenessCritique to nViewerExplorableGraph;
    verification nViewerExplorableGraphTestabilityCritique : Test { :>> id = "26798914-7997-43a5-9616-b4e9b3554688"; :>> title = "Critique nViewerExplorableGraph - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, and it is the most falsifiable Need in this batch - which is what a Need written in response to an observed failure tends to look like. It names a concrete mechanism (incremental loading, not whole-model embedding) and a concrete threshold (past a few thousand nodes, where about 2500 froze), so a test can load a corpus above the threshold and fail if the viewer embeds the whole model or stops responding. The negative case is constructible from this repository's own data. What the test cannot bound is time, since no latency budget is stated (see completeness), so the honest verification is that incremental loading is used and that a large corpus opens at all - which is a real check with a real failure mode, if narrower than the Need's evident intent."; }
    part nViewerExplorableGraphTestabilityCritiqueR1 : TestResult { :>> id = "e4f5053d-009b-451e-868e-da182866353c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerExplorableGraphTestabilityCritique to nViewerExplorableGraph;
    verification nViewerExportShareCorrectnessCritique : Test { :>> id = "f8d47f21-6dfc-4e3c-bf00-975b7c7d8509"; :>> title = "Critique nViewerExportShare - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'LINK' CANNOT SERVE THE STATED AUDIENCE. The Need offers 'link / PDF / image' for 'someone who cannot or need not open the live tool', and D0158 records that the console is local-only and unauthenticated. A link to a local server is unreachable by definition for the person this Need exists to serve; it works only for someone who can already open the tool, which is the excluded case. So of the three offered mechanisms one is inapplicable under the current deployment scope, and the Need does not say so - a reader would reasonably implement a share-link and discover it serves nobody. Either the link clause depends on D0157's deferred hosted service and should say so, or it should be dropped in favour of the two mechanisms that survive a local-only tool."; }
    part nViewerExportShareCorrectnessCritiqueR1 : TestResult { :>> id = "fe28aa6f-27e8-4313-86d1-5955832fe989"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerExportShareCorrectnessCritique to nViewerExportShare;
    verification nViewerExportShareCompletenessCritique : Test { :>> id = "32c709d2-6b0a-49c4-8843-33171e7a5160"; :>> title = "Critique nViewerExportShare - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "AS-OF IS RECORDED WITHOUT SAYING WHAT AS-OF IS, and this engine has an unusually strong answer it does not use here: every TestResult pins judgedAgainst to a COMMIT, precisely because a date is ambiguous across branches and machines while a SHA resolves or does not. This Need asks only for 'the snapshot's as-of date recorded', which is the weaker of the two and reintroduces the ambiguity the rest of the model has eliminated. ALSO ABSENT: whether a snapshot must be REPRODUCIBLE - regenerable from the recorded as-of point - which is what would let a reader check a shared claim rather than merely read it, and which is the whole difference between a snapshot and a screenshot in a system whose premise is that every view is computed."; }
    part nViewerExportShareCompletenessCritiqueR1 : TestResult { :>> id = "28b58da7-654b-45fd-9eb7-e1f213ccb35d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerExportShareCompletenessCritique to nViewerExportShare;
    verification nViewerExportShareTestabilityCritique : Test { :>> id = "46dcdbae-5794-4e37-99e3-21def6cca3cc"; :>> title = "Critique nViewerExportShare - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES for the export mechanisms and not for the share mechanism. An exported file is directly checkable: it exists, it renders, and it carries a recorded as-of stamp - with a clean negative case, since an export missing its as-of must fail. That covers PDF and image. The link clause is untestable for a different reason than vagueness: it is inapplicable under the current deployment scope (see correctness), so a verification would either skip it or test a local URL that no external recipient could resolve, and passing on the latter would be worse than not testing it. Recorded as a pass because the testable core is well-formed, with the caveat that a passing verification evidences file export only."; }
    part nViewerExportShareTestabilityCritiqueR1 : TestResult { :>> id = "5beae925-a3b7-4c1f-affa-32c5c02edd1f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerExportShareTestabilityCritique to nViewerExportShare;
    verification nViewerGenerativeUiCorrectnessCritique : Test { :>> id = "e8fb97fb-32bf-49f9-9c9e-bcd4850430d8"; :>> title = "Critique nViewerGenerativeUi - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'NO VIEWER CODE CHANGE' IS TRUE FOR READING AND FALSE FOR WRITING, and the split is exact rather than approximate. Reading generalizes: view::item_detail returns any item's type, authored attributes and typed edges from one computation, so a NEW ITEM TYPE is viewable with no code change, and sprint 315 derived the console's whole navigation from declared viewpoint surfaces. Writing does not: keel record accepts exactly two verbs, decision and issue, each with its own hardcoded required-flag list, and the rest of the write API is likewise per-verb (append-result, append-gate-result, add-task). So a new item type arrives with a generic read path and NO write path, and this Need claims it becomes 'viewable + manipulable in the UI with NO viewer code change'. Manipulable is the half that requires code, and it requires it in the ENGINE rather than the viewer - which is arguably worse for this Need, since the viewer cannot fix it."; }
    part nViewerGenerativeUiCorrectnessCritiqueR1 : TestResult { :>> id = "c47612e6-e247-4035-9970-add51917cdd0"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerGenerativeUiCorrectnessCritique to nViewerGenerativeUi;
    verification nViewerGenerativeUiCompletenessCritique : Test { :>> id = "cc008ee4-42ca-42fe-bf25-365b63d2d568"; :>> title = "Critique nViewerGenerativeUi - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "The Need requires the UI to be generated from the declared model and never says what the UI does when the model declares something it cannot serve - which is the case that actually occurs, because the model is text a human edits while the binary is a compiled artifact that lags it. A declared viewpoint whose renderer names no subcommand, a declared process with no deploying skill, an attribute of a type the UI has no widget for: each is a live possibility and the Need is silent on all three. The engine's own answer elsewhere is to REPORT the gap rather than hide or default it - unit.toml names what a receiving binary must have, and the obligation bar shows NOT COUNTABLE rather than zero - and this Need should require the same, or a generated UI will silently omit whatever it cannot render and present the remainder as complete."; }
    part nViewerGenerativeUiCompletenessCritiqueR1 : TestResult { :>> id = "3ed58081-2d36-47b3-aebe-6656ce01ee3c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerGenerativeUiCompletenessCritique to nViewerGenerativeUi;
    verification nViewerGenerativeUiTestabilityCritique : Test { :>> id = "587aed32-e99d-415f-b0e3-269829e28a10"; :>> title = "Critique nViewerGenerativeUi - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, with the sharpest negative case of any Need in this batch: add an attribute to the schema, or a new item type, or a new process, and require it to appear in the UI WITHOUT a viewer edit - and the test fails if a hardcoded list is anywhere in the path. That is a genuinely adversarial check, and it is the same test that would have caught the VIEW_SUBCOMMANDS drift found against nServeReuseModel in pass 2, which suggests one fixture could serve both Needs. The clause it cannot reach is 'manipulable', for the reason the correctness lens gives - a generic write path does not exist, so a test for it would fail on the engine rather than the viewer, and would be reported against the wrong component."; }
    part nViewerGenerativeUiTestabilityCritiqueR1 : TestResult { :>> id = "d428aed3-0bc6-481c-b3fc-cb47f663e19d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1b3d471"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerGenerativeUiTestabilityCritique to nViewerGenerativeUi;

    // == Element-critique backfill pass 4, 2026-08-17 (sprint 327). The LAST five critiquable Needs x Core-3.
    // After this pass every Need not authored by claudeOpus5 is critique-covered; the remaining 16 are mine
    // and are blocked on a critic who is not their author (critique-policy.toml).
    verification nViewerInProgramEditCorrectnessCritique : Test { :>> id = "5c8db9eb-414b-4f06-92d9-192a6096fc6d"; :>> title = "Critique nViewerInProgramEdit - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'EVERY CHANGE WRITTEN BACK THROUGH KEELS WRITE API' NAMES A PATH THAT DOES NOT EXIST FOR A GENERAL EDIT, and the engine's own instructions concede it: CLAUDE.md section 4 lists the sanctioned write API - append-result, append-gate-result, add-task, record decision, record issue, accept, apply-review, actor set, enroll - and then says plainly that 'direct file editing is for what the API doesn't cover'. keel record accepts exactly two verbs, each with its own hardcoded required-flag list. So modifying an arbitrary element's arbitrary attribute has no API route at all, and a viewer honouring this Need literally could edit almost nothing. The invariant the Need is reaching for is real and is satisfied a different way: every write, API or direct, passes the same guards and the same validate. GUARDS are the single gate; the API is one convenient entrance to it. As written the Need constrains the entrance and mis-states the gate."; }
    part nViewerInProgramEditCorrectnessCritiqueR1 : TestResult { :>> id = "d6dd7b2c-0b32-47bf-b811-e62e85793409"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerInProgramEditCorrectnessCritique to nViewerInProgramEdit;
    verification nViewerInProgramEditCompletenessCritique : Test { :>> id = "4d7f37dc-b132-418f-827a-6d556a75a311"; :>> title = "Critique nViewerInProgramEdit - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "EDIT-THEN-CRITIQUE IN ONE PLACE COLLIDES WITH THE INDEPENDENCE RULE and the Need does not notice. critique-policy.toml requires a critique's judgedBy to differ from the element's author, and an edit does not transfer authorship - createdBy is the ownership key and an owner editing their own element stays its author. So the natural workflow this Need describes, a user editing an element and then critiquing it on the same surface, produces a SELF-CRITIQUE that the coverage computation discards for the common case where the editor is the author. Nothing in the statement says who may critique what, and a surface built exactly to it would let a user do work that silently fails to count. ALSO UNSPECIFIED: what the viewer does when a guard REJECTS the edit - the gate is honest-state and will block a malformed write, and the Need says nothing about whether the draft survives, which decides whether the tight iteration loop it wants is usable at all."; }
    part nViewerInProgramEditCompletenessCritiqueR1 : TestResult { :>> id = "b3341d61-d70e-4f46-a64a-e2ca9cc29976"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerInProgramEditCompletenessCritique to nViewerInProgramEdit;
    verification nViewerInProgramEditTestabilityCritique : Test { :>> id = "bed3427f-6422-413b-824d-300ab9ab80e6"; :>> title = "Critique nViewerInProgramEdit - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on its load-bearing clause, which is the negative one: 'never a second store' is falsifiable by inspection and by test - if any viewer state survives that is not in the repository, the Need is violated, and that check is mechanical. The write-back clause is also testable once read as 'through the same guards' rather than 'through the API' (see correctness): make an edit in the viewer, then require that the model validates and the change appears in git. What resists testing is 'iterate tightly', a claim about interaction quality with no measure - but it reads as motivation rather than requirement, and no verification would be written against it."; }
    part nViewerInProgramEditTestabilityCritiqueR1 : TestResult { :>> id = "b6ad7439-1343-4182-a710-0d9df565100f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerInProgramEditTestabilityCritique to nViewerInProgramEdit;
    verification nViewerIterativeCritiqueCorrectnessCritique : Test { :>> id = "40bd3d25-bdd0-4632-bfdb-ea421d4eadd0"; :>> title = "Critique nViewerIterativeCritique - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE FEATURE WOULD HIT THE INDEPENDENCE WALL ON MOST OF THIS MODEL, and the Need does not mention independence at all. It asks to iterate over an axis and record a finding per element. Measured today: of 154 critique-uncovered elements, 87 were authored by claudeOpus5 - so an AI iterating an axis produces findings that the coverage computation discards for 56 percent of them, silently, because judgedBy equals the element's author. That is not a corner case, it is the majority case, and it is the reason this session's own backfill had to MEASURE the split before choosing targets. A useful version of this feature must know whose critique counts for which element and say so; as written it would iterate an axis, report N findings, and raise coverage by a fraction of N with nothing explaining the gap. SECOND, SMALLER: 'findings land as tracked critiques (apply-review)' binds the Need to one mechanism, and this repository's own backfill was directed to author critiques.sysml DIRECTLY rather than through apply-review - so the named mechanism is not the one in use for exactly this job."; }
    part nViewerIterativeCritiqueCorrectnessCritiqueR1 : TestResult { :>> id = "c076a49f-caa5-4a43-8c8e-c57ed078c352"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerIterativeCritiqueCorrectnessCritique to nViewerIterativeCritique;
    verification nViewerIterativeCritiqueCompletenessCritique : Test { :>> id = "db9a40fb-aab9-4a63-abb8-2057a5e58684"; :>> title = "Critique nViewerIterativeCritique - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "An iteration with no bound and no idempotence. UNSPECIFIED: (a) COST - iterating an axis means one AI invocation per element, and nothing states a maximum, a confirmation step, or what the user sees before committing to a hundred of them; (b) IDEMPOTENCE - what happens when an element already carries a critique for that lens: add a second, replace the first, or skip? All three are defensible and they produce different corpora, and the wrong choice makes a re-run either destructive or a duplicate factory; (c) FAILURE - what is recorded when the critique of element 40 of 100 errors? Silence would leave a partial pass indistinguishable from a complete one, which is the exact defect shape this engine keeps finding elsewhere. The axis itself is well specified; everything about running it repeatedly is not."; }
    part nViewerIterativeCritiqueCompletenessCritiqueR1 : TestResult { :>> id = "8df445cc-8e5c-4dfe-93ab-3b9615ba3d94"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerIterativeCritiqueCompletenessCritique to nViewerIterativeCritique;
    verification nViewerIterativeCritiqueTestabilityCritique : Test { :>> id = "7694b104-e474-479c-84f6-ae65715af20e"; :>> title = "Critique nViewerIterativeCritique - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, on a mechanical property with a clean negative case: constrain a query to N elements, run the axis iteration, and require N findings each #Verify-linked to its element - the test fails if any element is skipped or if a finding lands unlinked. That is worth having, because an unlinked finding is invisible to every coverage computation and would otherwise look like success. What the test cannot judge is whether the findings are any GOOD, which is the property the user actually wants; the engine's answer to that is the separate critique-rigor diagnostic, and this Need would benefit from naming it rather than leaving quality unaddressed."; }
    part nViewerIterativeCritiqueTestabilityCritiqueR1 : TestResult { :>> id = "d37cb6a7-d0ba-48aa-b319-7119c6b620a6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerIterativeCritiqueTestabilityCritique to nViewerIterativeCritique;
    verification nViewerQueryExpansionTestabilityCritique : Test { :>> id = "dd4de2d8-c9f2-4733-aa57-93bbcac78748"; :>> title = "Critique nViewerQueryExpansion - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "THE NEED DECLARES ITS OWN ACCEPTANCE BOUNDARY UNRESOLVED, in its own last sentence: 'The bound is an open question (handoff Q3).' The requirement is to add date/range predicates and probably OR while NOT becoming an unbounded query language, so the entire content is a limit - and the limit is explicitly not set. No verification can be written: any predicate set whatsoever satisfies 'at least date/range' while nothing distinguishes acceptable expansion from the sledgehammer the Need forbids. This is honest and it is also unfinishable as recorded. The engine's own doctrine says what to do with it: invariant 7 - when a defensible boundary cannot be set, it stays an INDICATOR rather than a requirement, and is promoted when a justified boundary emerges."; }
    part nViewerQueryExpansionTestabilityCritiqueR1 : TestResult { :>> id = "a1f6079a-5b04-4ac0-8873-6a2561a20aba"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerQueryExpansionTestabilityCritique to nViewerQueryExpansion;
    verification nViewerQueryExpansionCompletenessCritique : Test { :>> id = "7eeee1ed-1625-4928-a36e-75add7582ef0"; :>> title = "Critique nViewerQueryExpansion - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'AND LIKELY OR' IS A HEDGE INSIDE A NORMATIVE STATEMENT, and it is load-bearing rather than decorative: OR is the difference between a filter language and a predicate list, and its presence or absence changes the implementation shape entirely. A Need cannot leave its most consequential term at 'likely'. ALSO ABSENT: the existing predicate vocabulary is never enumerated, so 'expansion' has no baseline - a reader cannot tell what is already supported and therefore what is being asked for. The seven declared .view.toml files are the de facto vocabulary and the Need does not reference them, which means the same words could be read as a small addition or a rewrite."; }
    part nViewerQueryExpansionCompletenessCritiqueR1 : TestResult { :>> id = "9ee375ef-f802-4902-ae03-d9a6381dfe1d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerQueryExpansionCompletenessCritique to nViewerQueryExpansion;
    verification nViewerQueryExpansionCorrectnessCritique : Test { :>> id = "ea9e9992-9c8d-4f94-bb1c-6ef0dcd108b7"; :>> title = "Critique nViewerQueryExpansion - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT in the part that is stated as fact rather than as an open question. The characterisation of keel's stance - a deliberate fixed predicate vocabulary rather than a general query language - is accurate: views are declared in .view.toml files with a bounded predicate set, and that is a design choice the engine has held to rather than an accident. The Need also correctly identifies date and range predicates as the concrete gap for temporal and stakeholder filtering, which matches what the temporal Needs elsewhere ask for. Recorded as a pass because nothing asserted here is false; what is missing is a decision, and that absence is recorded under the testability and completeness lenses rather than double-counted as an error."; }
    part nViewerQueryExpansionCorrectnessCritiqueR1 : TestResult { :>> id = "aace04df-de50-4c27-afaf-ece44de5776d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerQueryExpansionCorrectnessCritique to nViewerQueryExpansion;
    verification nViewerSeparationCorrectnessCritique : Test { :>> id = "1b1b9173-5570-4c7d-b3d0-aec0c9028dae"; :>> title = "Critique nViewerSeparation - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "TWO CLAIMS, BOTH NOW WRONG. FIRST: 'keels write API + guards remain the ONLY write path' is false in practice and the engine's own instructions say so - CLAUDE.md section 4 concedes that 'direct file editing is for what the API doesn't cover', and essentially all of this repository's authoring, including every record in this critique pass, was written directly to files. The true invariant is the GUARDS: every write, however made, passes validate and 34 guards before it can land. Naming the API as the only path both overstates the API and understates the guards, which are the thing that actually holds. SECOND: the embedded architecture question - 'WHICH shape (A extend serve / B separate app / C thin renderer) is the core architecture decision ... recommendation: B' - has been ANSWERED and then answered again: D0114 chose a shape and D0152 superseded it with one filtered app. The Need still presents the decision as open and carries a recommendation the record has overtaken."; }
    part nViewerSeparationCorrectnessCritiqueR1 : TestResult { :>> id = "5e5bdb8e-df32-4119-8c3c-20a7952732f0"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerSeparationCorrectnessCritique to nViewerSeparation;
    verification nViewerSeparationCompletenessCritique : Test { :>> id = "80b66035-dc1c-44ca-8c60-e588c4799300"; :>> title = "Critique nViewerSeparation - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "A Need containing an unresolved architecture choice is incomplete by construction, and this one names three shapes without naming the criteria that would decide between them. If the Need had recorded what mattered - one truth, no second store, no duplicated SysML management, and an evolution cost the viewer can bear - then the later Decisions (D0114, then D0152) would have been evaluable AGAINST it, and a reader could check whether the chosen shape actually satisfies the Need. As written the Need defers to a handoff document and a recommendation, so the Decisions that answered it did so without a stated bar to clear. ALSO MISSING: what 'authoritative engine' obliges the viewer NOT to do - it may not duplicate management, but may it cache, precompute, or hold derived indexes? Those are the choices that erode single-truth in practice, and none is addressed."; }
    part nViewerSeparationCompletenessCritiqueR1 : TestResult { :>> id = "1af456bc-4201-4ab0-b7b1-467dce96d4e8"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerSeparationCompletenessCritique to nViewerSeparation;
    verification nViewerSeparationTestabilityCritique : Test { :>> id = "faf013fe-3868-4df1-a2df-1e286537daca"; :>> title = "Critique nViewerSeparation - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "The strongest clause is testable and FALSE, which is a different failure from being untestable: 'keels write API + guards remain the ONLY write path' can be checked by looking for writes that bypass the API, and they are everywhere by design - so a faithful verification of the Need as written must FAIL, permanently, on correct behaviour. That is worse than an unfalsifiable clause, because it makes honest verification impossible: a verifier either records a failure that nobody intends to fix, or quietly re-reads the clause as 'through the guards' and records a pass against words the Need does not contain. The remaining clauses are testable given the shape decision that the Need leaves open."; }
    part nViewerSeparationTestabilityCritiqueR1 : TestResult { :>> id = "d2c83bfa-be48-4305-97d5-17e08cc94aba"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerSeparationTestabilityCritique to nViewerSeparation;
    verification nViewerViewpointFormCorrectnessCritique : Test { :>> id = "d7e5680d-0ef3-4eb3-be2b-40be2ffcf877"; :>> title = "Critique nViewerViewpointForm - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT, and its complaint is still live - I checked rather than assuming the prototype had moved on. The statement objects to being 'limited to three fixed render modes (graph/table/review) with hardcoded palette', and `keel render` still accepts exactly --mode graph|table|review, with the mode dispatch hardcoded in view.rs. The other half is right too: a viewpoint declares an audience today (the Viewpoint type carries an audience attribute), so 'targeting a named audience' describes something the model already supports, and the gap is in the FORM half rather than the audience half. The Need accurately locates the deficit."; }
    part nViewerViewpointFormCorrectnessCritiqueR1 : TestResult { :>> id = "aa5c19f2-cf21-4def-9f2b-65c0305d7df4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerViewpointFormCorrectnessCritique to nViewerViewpointForm;
    verification nViewerViewpointFormCompletenessCritique : Test { :>> id = "9f2bd5bf-2c11-44da-b476-21f7b5778808"; :>> title = "Critique nViewerViewpointForm - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'A CHOSEN VISUAL FORM' NAMES NO SET TO CHOOSE FROM, and the Need delegates that content without saying so: N-18 later elaborates the channel bindings and describes itself as realising N-1 concretely, but N-1 contains no reference to N-18 and no criterion of its own, so read alone it asks for an open-ended visual vocabulary. The dependency also runs the wrong way for a reader: N-1 is ACCEPTED and N-18 is still PENDING its Business gate, so the accepted Need's only elaboration is unaccepted, and a decomposition of N-1 today would either invent a form vocabulary or wait on a Need nobody has approved. ALSO UNSPECIFIED: whether query and form are independently reusable - one query rendered several ways, one form applied to several queries - which is the difference between a viewpoint library and a list of fixed reports."; }
    part nViewerViewpointFormCompletenessCritiqueR1 : TestResult { :>> id = "1dc86866-668f-4caa-ba55-070969154093"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerViewpointFormCompletenessCritique to nViewerViewpointForm;
    verification nViewerViewpointFormTestabilityCritique : Test { :>> id = "eeb2390b-fecd-4a5b-9175-c1fd27da65f0"; :>> title = "Critique nViewerViewpointForm - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on the negative clause, which is the one with teeth: 'not limited to three fixed render modes with hardcoded palette' is falsifiable by adding a fourth form and a declared palette and requiring both to work with no code change - and it fails today, correctly, because the mode dispatch is a hardcoded match. That is a verification worth having precisely because it fails now: it measures the gap rather than asserting it. The positive clause (declarable as a query AND a form) is testable only as far as the form vocabulary is defined, which it is not (see completeness), so a full verification waits on N-18."; }
    part nViewerViewpointFormTestabilityCritiqueR1 : TestResult { :>> id = "5f2361c7-09a3-4081-8abf-901f847cdae3"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "13f825e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from nViewerViewpointFormTestabilityCritique to nViewerViewpointForm;

    // == Element-critique backfill pass 5, 2026-08-17 (sprint 329). Five encoding SystemRequirements x Core-3.
    // All five derive from N-18, which IS accepted (keelViewerNeedsAccept5R1) - the stale comment that said
    // otherwise is gone and guarded against (issue140). INDEPENDENT: author wweatherholtz, judge claudeOpus5.
    verification srEncodingModularCompletenessCritique : Test { :>> id = "bc35de36-a72b-43a3-81bd-5e0b3455e86c"; :>> title = "Critique srEncodingModular - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE REQUIREMENT NEVER SAYS WHERE THE REGISTRY LIVES, and in this engine that is the whole question rather than an implementation detail. A channel registry compiled into the viewer satisfies every word of this requirement while violating two things the engine holds elsewhere: nServeReuseModel forbids a separately-maintained list that can drift, and D0150 requires vocabulary to be DERIVED from the schema rather than restated. The engine has a live example of the failure - VIEW_SUBCOMMANDS, a hardcoded command list inside a guard, which rejected a real command because the list had not caught up. A registry of channel modules is exactly the same shape, and this requirement as written permits the bad answer. It should say whether a channel is a DECLARED element of the model or a compiled artifact of the viewer, because those decompose into different work and only one of them lets a project add a channel."; }
    part srEncodingModularCompletenessCritiqueR1 : TestResult { :>> id = "72d4dbf7-2b16-4e55-a1bb-899d2efeb5db"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingModularCompletenessCritique to srEncodingModular;
    verification srEncodingModularCorrectnessCritique : Test { :>> id = "208f76e6-f505-4879-9018-ee0fb01daa3d"; :>> title = "Critique srEncodingModular - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "The no-change clause is right for the channel family it names and overclaims for the general case. 'Adding a new encoding type shall require adding ONE module ... with NO changes to the panel, the apply pass, or the legend' holds for channels that are a value-to-style mapping over a static picture: colour, size, shape, position. It cannot hold for a channel whose channel-ness is INTERACTIVE or temporal - animation over a date attribute, or an edge-routing channel - because those need affordances the panel does not have and a legend concept the legend generator cannot express. The requirement's own parenthetical concedes the shape it assumes: role, accepted attribute kinds, value-to-style mapping, legend. Any 'new encoding type' outside that four-part shape breaks the guarantee, so the guarantee is really about new channels of the SAME KIND - which is still valuable and is what should be stated."; }
    part srEncodingModularCorrectnessCritiqueR1 : TestResult { :>> id = "b1063ab0-f2be-47b9-a20b-f32e11c33132"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingModularCorrectnessCritique to srEncodingModular;
    verification srEncodingModularTestabilityCritique : Test { :>> id = "d4e38260-c2d9-48b8-9504-b17147e92e1e"; :>> title = "Critique srEncodingModular - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, and it is the strongest verification in this batch because the negative case is mechanical: add one channel module, then require the diff to touch NOTHING but that module and the registry entry. A test can fail on a diff, with no judgment involved, and it fails loudly the first time someone reaches into the apply pass for a special case. That is the rare requirement whose test is cheaper than the argument about whether it is met - and it also measures the property that actually rots, since channel-specific branches accumulate one convenient exception at a time."; }
    part srEncodingModularTestabilityCritiqueR1 : TestResult { :>> id = "2a4b1220-c8f6-4872-98e2-e62ec0893d30"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingModularTestabilityCritique to srEncodingModular;
    verification srEncodingOverrideCompletenessCritique : Test { :>> id = "b5b5565e-16c5-4073-81b8-2f0b9f20daff"; :>> title = "Critique srEncodingOverride - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "AN OVERRIDE WITH NO PERSISTENCE STATEMENT IS A TOY, and the model already has the answer this requirement should point at: N-19 requires a saved viewpoint selection, filters and layout to persist as a repository artifact and travel to another machine. This requirement lists four override kinds and says nothing about whether any of them survives a reload, let alone a clone - so an implementation that keeps them in browser memory satisfies it. SECOND AND SHARPER: nothing says what happens when the schema MOVES UNDER an override. A colour pinned to an enum member that is later removed, or bins set on a numeric attribute whose range shifts, is a stale reference to a vanished target - the defect class this session hit three times (issue109, issue136, issue139). The requirement needs to say whether a dangling override is reported, dropped, or silently ignored, because silently ignored is the one that misleads."; }
    part srEncodingOverrideCompletenessCritiqueR1 : TestResult { :>> id = "6cce5d0f-fc8a-4f61-9d16-d73c4d32646a"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingOverrideCompletenessCritique to srEncodingOverride;
    verification srEncodingOverrideCorrectnessCritique : Test { :>> id = "7ab3503a-f72c-4c7d-9a2d-0ea49d8fe83b"; :>> title = "Critique srEncodingOverride - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT, and precise about the thing that matters most: 'layered on top of the semantic defaults'. That is the right architecture and it is stated unambiguously - the override is a delta over a regenerable base, not a replacement for it, which means a schema change can refresh the defaults without discarding the user's intent. The four override kinds are also the right four for the channels N-18 names: enum order, enum colour pinning, continuous ranges and bins, and swimlane nesting order. Nothing asserted here is false or unachievable, and the rationale's honesty about scope ('auto-defaults get you 80 percent') is the kind of stated limit that makes a requirement usable rather than aspirational."; }
    part srEncodingOverrideCorrectnessCritiqueR1 : TestResult { :>> id = "bdc322c3-b543-4911-9344-1f7e78a2c2a4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingOverrideCorrectnessCritique to srEncodingOverride;
    verification srEncodingOverrideTestabilityCritique : Test { :>> id = "8982a2fa-1e22-4282-a0c7-c15a124cb479"; :>> title = "Critique srEncodingOverride - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on the property that would actually break: an override must SURVIVE a regeneration of the defaults. That is a clean falsifiable test - set an override, regenerate, require the override still applied - and it fails exactly when someone implements the override as a replacement rather than a layer. The four override kinds are each individually checkable too. What is not testable is persistence, because the requirement does not claim it (see completeness), so a verification will honestly pass on a purely in-memory implementation, which is worth knowing before this is built rather than after."; }
    part srEncodingOverrideTestabilityCritiqueR1 : TestResult { :>> id = "a2532bf2-fbc9-46eb-9fae-20a6aea917a9"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingOverrideTestabilityCritique to srEncodingOverride;
    verification srEncodingRenderCorrectnessCritique : Test { :>> id = "051c295f-1a21-4597-8d5a-7eda287f67a8"; :>> title = "Critique srEncodingRender - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "SOLUTION-BOUND IN ITS LAST FIVE WORDS: 'via compound + nested-compound nodes' names a specific graph-library construct inside a requirement statement. Whether swimlane bands are drawn as compound nodes, as background regions, or by layout constraint is an implementation choice, and binding it here means a later change of rendering approach - or of library - must revise a REQUIREMENT rather than a design. The engine has been bitten by exactly this shape one level up: nAiGovernanceInLoop names an MCP surface that was never built while the concern it stood for was served another way, so a reader auditing satisfaction has to decide whether the unbuilt mechanism is a gap. The channel-to-attribute mappings in this statement are the requirement; the node construct is how it is met."; }
    part srEncodingRenderCorrectnessCritiqueR1 : TestResult { :>> id = "8e864d74-0b45-4626-af76-c65d680f646b"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingRenderCorrectnessCritique to srEncodingRender;
    verification srEncodingRenderCompletenessCritique : Test { :>> id = "c27dfc4e-f547-4f78-a194-40c37e6cd4a7"; :>> title = "Critique srEncodingRender - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "No conflict rules and no depth rule, for a requirement whose whole content is simultaneous bindings. Unspecified: what is rendered when two attributes bind the same channel; what happens to an element whose bound attribute is ABSENT, which is the normal case rather than the exception since most attributes are optional (surface on Viewpoint is 0..1, and dozens of others are); and whether nesting stops at the one 'nested/superseding' layer the statement names or generalises to depth N, which decides whether the renderer needs recursion. Also absent: any statement of what the reader is shown when the encoding cannot be rendered at all - the engine's answer elsewhere is to REPORT the gap explicitly (NOT COUNTABLE on the obligation bar, unit.toml naming what a binary lacks) rather than to draw a partial picture that looks complete."; }
    part srEncodingRenderCompletenessCritiqueR1 : TestResult { :>> id = "f366bfe2-4162-4407-872c-56f1d070941f"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingRenderCompletenessCritique to srEncodingRender;
    verification srEncodingRenderTestabilityCritique : Test { :>> id = "8de3b6af-f289-41d5-97bd-185bc816a1c6"; :>> title = "Critique srEncodingRender - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "The least testable requirement in this batch, and the reason is structural rather than sloppy: its subject is a rendered picture. 'Map attributes to node colours, position, swimlane bands, and a nested layer' can be verified as a DATA transformation - the spec in, a set of computed style attributes out - and that is a real test worth writing. It cannot be verified as a rendering without either a visual baseline (brittle, and this engine has no such fixture) or DOM assertions that would encode the very library binding the correctness lens objects to. The requirement states no acceptance criterion for the visual result, so a verification will test the transform and be read as evidence for the render. That gap should be named in the requirement, ideally by splitting the computable spec-to-style mapping from the drawing."; }
    part srEncodingRenderTestabilityCritiqueR1 : TestResult { :>> id = "83a0b5ac-7cb1-4568-8e10-3af203a1c307"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingRenderTestabilityCritique to srEncodingRender;
    verification srEncodingSchemaSemanticsCorrectnessCritique : Test { :>> id = "bbcf40a7-9225-4b28-ae66-c761eb3405e2"; :>> title = "Critique srEncodingSchemaSemantics - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE KIND VOCABULARY MAKES FREE TEXT INDISTINGUISHABLE FROM A CATEGORY, and the implementation shows it: view::stat_kind maps the DECLARED type, so an enum becomes enum, Integer and Real become numeric, Timestamp becomes temporal, and EVERYTHING ELSE FALLS THROUGH TO categorical. So title, a free-text String with hundreds of distinct values, and owner, a String with about eight, both report kind=categorical - and an auto-encoder told to bind colour to a categorical attribute would attempt a palette over several hundred titles. The requirement chose the four-value vocabulary that produces this, and it is the requirement's defect rather than the implementation's: a fifth kind (free-text, or a distinct-count threshold that separates a category from a label) is what an encoder actually needs. The mitigation the implementation added on its own initiative - a truncated flag once distinct values exceed the cap - is the signal that would support the distinction, and the requirement never asked for it."; }
    part srEncodingSchemaSemanticsCorrectnessCritiqueR1 : TestResult { :>> id = "9b9bb9b9-0317-45c0-abc1-5c4a1abedaf3"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingSchemaSemanticsCorrectnessCritique to srEncodingSchemaSemantics;
    verification srEncodingSchemaSemanticsCompletenessCritique : Test { :>> id = "a661485d-70f0-4f14-aefb-58573e2495f3"; :>> title = "Critique srEncodingSchemaSemantics - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'OBSERVED DISTINCT VALUES (CAPPED)' NAMES NO CAP, so the threshold was set by the implementation - 64, in attribute_stats - and a requirement whose number lives only in the code it governs cannot verify that code. The cap is also semantically load-bearing rather than a performance detail: it is the boundary past which an attribute stops being usable as a categorical channel at all, which is precisely the distinction the correctness lens says is missing. ALSO ABSENT: what is reported for an attribute with ZERO instances - no distinct values, no min, no max - which is the common case for a newly declared attribute and the moment an auto-encoder is most likely to be run; and whether stats are computed over live elements only or include SUPERSEDED ones, which changes every range in a model that retires by supersession."; }
    part srEncodingSchemaSemanticsCompletenessCritiqueR1 : TestResult { :>> id = "c6a88e00-8354-4aec-b73a-1db2db4aed52"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingSchemaSemanticsCompletenessCritique to srEncodingSchemaSemantics;
    verification srEncodingSchemaSemanticsTestabilityCritique : Test { :>> id = "10c87b65-00cb-4b50-9df0-e3c3953e702a"; :>> title = "Critique srEncodingSchemaSemantics - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, and it is already exercised in substance: the endpoint exists, view::schema_json composes declared types and enums with attribute_stats, and every clause is a checkable property of a JSON response - enum defs carry members, each (type,attribute) carries a kind, distinct values are present and capped, numeric and temporal ranges carry min and max. The negative cases are clean: declare a new enum member and require it to appear with no code change, which is the same nothing-hardcoded test that serves nServeReuseModel and nViewerGenerativeUi. The untestable part is the unnamed cap (see completeness) - a test can only assert the cap the code chose, which makes it a tautology rather than a check."; }
    part srEncodingSchemaSemanticsTestabilityCritiqueR1 : TestResult { :>> id = "f2d3c387-fd1c-455d-b22a-93763bf287ff"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingSchemaSemanticsTestabilityCritique to srEncodingSchemaSemantics;
    verification srEncodingSpecCorrectnessCritique : Test { :>> id = "a72a421d-05f9-48df-b6d4-3c39fb0b0a9b"; :>> title = "Critique srEncodingSpec - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'SENSIBLE DEFAULTS PER KIND' INHERITS N-18'S UNVERIFIABLE CLAUSE, and this is the concrete cost of that Need's testability defect rather than a restatement of it: N-18 asks for a mapping defined 'semantically enough to AUTO-GENERATE', this requirement translates that into 'sensible defaults', and neither says what sensible means. A generator that binds every enum to a colour ramp and every Timestamp to the x-axis satisfies both. Because N-18 IS accepted - the comment claiming otherwise was stale, issue140 - the defect is already inherited by this requirement and by four siblings, which is exactly what makes an unfalsifiable clause in a Need expensive: it does not stay in the Need. The fixable version is a stated default PER KIND, which is a short table and would also settle the free-text question the schema-semantics requirement leaves open."; }
    part srEncodingSpecCorrectnessCritiqueR1 : TestResult { :>> id = "8d2448fa-4f79-4045-bc88-824935b02059"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingSpecCorrectnessCritique to srEncodingSpec;
    verification srEncodingSpecCompletenessCritique : Test { :>> id = "d702ba96-4983-4c00-b7f7-f7def499cdc9"; :>> title = "Critique srEncodingSpec - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE SPEC'S HOME IS UNSTATED and every consequence follows from it. 'The viewer shall model an encoding viewpoint as a declarative spec' - is that spec a VIEWPOINT in the model, which would need a schema addition the way `surface` did (D0154, frozen core, human sign-off), or a viewer-side object with no model presence? The first makes a spec reviewable, diffable and portable and costs a frozen-core change; the second makes it invisible to every computed view and violates the dual-truth invariant if it holds anything the model cannot see. The requirement's own words point both ways: 'encoding viewpoint' suggests the model, 'the viewer shall model' suggests the viewer. ALSO ABSENT: whether the ORDER of bindings is significant (the statement says 'an ordered set', which implies it matters, and never says what the order DOES)."; }
    part srEncodingSpecCompletenessCritiqueR1 : TestResult { :>> id = "4c92e892-a5b0-42e4-8667-29ba5f3ff0b3"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingSpecCompletenessCritique to srEncodingSpec;
    verification srEncodingSpecTestabilityCritique : Test { :>> id = "414e650a-a892-4d80-ae39-b8ddda58c11a"; :>> title = "Critique srEncodingSpec - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "Half testable, and the untestable half is the requirement's purpose. The STRUCTURE is checkable: a spec is an ordered set of bindings, each naming a channel from a closed list, a model attribute, and a scale - a malformed spec must be rejected, which is a real negative case. AUTO-GENERATION FROM SEMANTICS is not, because its acceptance criterion is 'sensible' (see correctness), so a verification records that a spec was generated rather than that it was any good. A test would therefore pass on a generator nobody would use, and the passing result would be read as evidence for the auto-generation clause. The remedy is the same short table of per-kind defaults: with it, generation becomes exactly checkable - for this kind, this channel and this scale."; }
    part srEncodingSpecTestabilityCritiqueR1 : TestResult { :>> id = "494af362-1b64-4165-9927-2c8b2caffde2"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "41a237f"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srEncodingSpecTestabilityCritique to srEncodingSpec;

    // == Element-critique backfill pass 6, 2026-08-17 (sprint 330). Five viewer/authoring SystemRequirements.
    // INDEPENDENT: every target's createdBy is wweatherholtz; the judge is claudeOpus5.
    verification srViewerAuthoringSurfaceCorrectnessCritique : Test { :>> id = "cd529c29-ab94-40ec-b73f-998a2eac94ce"; :>> title = "Critique srViewerAuthoringSurface - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE GENERATIVE CLAUSE QUIETLY MAKES THIS REQUIREMENT SATISFIABLE BY OFFERING ALMOST NOTHING. It demands the full authoring set - create an item of a declared type, edit attributes, author a typed edge, critique, disposition - and then adds that each action is 'offered iff the endpoint is advertised'. That second clause is good engineering and it is also an escape hatch: an implementation that advertises two endpoints offers two actions and satisfies every word. And the gap is real rather than hypothetical - `keel record` accepts exactly two verbs, decision and issue, each with its own hardcoded required-flag list, so CREATE AN ITEM OF A DECLARED TYPE has no generic endpoint to advertise. So the ambitious clause and the safety clause point in opposite directions, and as written the safety clause wins silently. The requirement should name which endpoints must EXIST, not only that the surface must offer whatever does."; }
    part srViewerAuthoringSurfaceCorrectnessCritiqueR1 : TestResult { :>> id = "9f24a1cc-41ea-4978-873d-1f3da276d8b7"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerAuthoringSurfaceCorrectnessCritique to srViewerAuthoringSurface;
    verification srViewerAuthoringSurfaceCompletenessCritique : Test { :>> id = "b71d2127-4581-401f-aaec-8ede723ba1c4"; :>> title = "Critique srViewerAuthoringSurface - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'EDIT ATTRIBUTES THROUGH PROCESS' names no process, and in this engine that phrase is the whole difficulty: there is no general edit process, D0108 restricts field edits to the item's owner, and CLAUDE.md concedes that direct file editing covers what the API does not. So a reader cannot tell whether this means an existing process, a process to be defined, or the guarded API generally. SECOND GAP - 'never auto-commits' states what the surface must not do and not what happens instead: who commits, when, and what becomes of an edit that is written to the working tree and never committed. That state is real and has bitten this project before, since keel serve writes into the working tree where an uncommitted human edit can be swept into someone else's commit. A requirement that forbids auto-commit owes the reader the disposition of the uncommitted write."; }
    part srViewerAuthoringSurfaceCompletenessCritiqueR1 : TestResult { :>> id = "43edf83c-72c6-4d28-94f0-2606d4a7c91d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerAuthoringSurfaceCompletenessCritique to srViewerAuthoringSurface;
    verification srViewerAuthoringSurfaceTestabilityCritique : Test { :>> id = "b71d252c-2d52-4859-9d4b-498c422369b9"; :>> title = "Critique srViewerAuthoringSurface - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "UNFALSIFIABLE BY CONSTRUCTION, for the reason the correctness lens gives: since each action is required only when its endpoint is advertised, a verification cannot fail on a missing action - it can only observe that whatever was advertised was offered. The one genuinely testable clause is the negative one, 'never auto-commits', which has a clean failure case: perform an action and require the working tree to be dirty rather than committed. 'Inline guard feedback' is testable too - submit a write that violates a guard and require the message to reach the surface rather than a generic error. Those two are worth verifying; the headline claim about a full authoring surface is not, and a pass on this requirement would mean much less than it appears to."; }
    part srViewerAuthoringSurfaceTestabilityCritiqueR1 : TestResult { :>> id = "6ebf1114-7e71-4b4f-b83c-086baf3c131c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerAuthoringSurfaceTestabilityCritique to srViewerAuthoringSurface;
    verification srViewerBaselineCompareCorrectnessCritique : Test { :>> id = "26b5403e-7e33-4742-be0b-47a8b12ff085"; :>> title = "Critique srViewerBaselineCompare - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE LAST CLAUSE IS INDETERMINATE AND ONE OF ITS TWO READINGS IS FLATLY WRONG: 'an element predating one point reads as added since'. Which point? If an element predates the EARLIER point it existed before the window and is emphatically not added since - it is pre-existing, and reporting it as added would mark most of the model as new in any recent comparison. If it predates only the LATER point, then it was created inside the window and 'added since' is correct. The sentence does not say, and the wrong reading is the more literal one. INHERITED AND NOT FIXED: 'baselines' remains undefined here just as in N-13, so the requirement that was supposed to make the Need buildable did not supply the missing concept; and 're-verified' is grouped with the diff terms although it is not a diff - a TestResult can be re-stamped with no change to the element, and can go stale with no commit at all, which is why the suspect view exists."; }
    part srViewerBaselineCompareCorrectnessCritiqueR1 : TestResult { :>> id = "ece71599-8c70-4ca9-958a-82715bb0ab39"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerBaselineCompareCorrectnessCritique to srViewerBaselineCompare;
    verification srViewerBaselineCompareCompletenessCritique : Test { :>> id = "60d70fa6-d7eb-4f44-8dd8-2e9f85d542ff"; :>> title = "Critique srViewerBaselineCompare - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Decomposition was the chance to define BASELINE and it was not taken, so the requirement inherits the Need's central gap: a baseline could be a git tag, a recorded Release item, an arbitrary commit, or a date, and each produces a different feature. The statement offers 'dates or baselines' as alternatives, which makes it worse than the Need - it now implies baselines are something OTHER than dates without saying what. ALSO ABSENT: how supersession is reported. Supersession is how this model retires anything, so an element superseded between the two points is the case a reader most needs answered, and it is neither added, removed, nor changed in any obvious sense. And nothing says what the diff does with elements that entered or left the VIEWPOINT rather than the model - a viewpoint-scoped diff has two ways to gain an element and the requirement treats only one."; }
    part srViewerBaselineCompareCompletenessCritiqueR1 : TestResult { :>> id = "02b412c4-32eb-4a9b-8ae4-4549f83e9e9e"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerBaselineCompareCompletenessCritique to srViewerBaselineCompare;
    verification srViewerBaselineCompareTestabilityCritique : Test { :>> id = "4b5f1d80-96ad-4f78-95f7-46e06c3585b0"; :>> title = "Critique srViewerBaselineCompare - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "Not testable until baseline is defined, and the ambiguity in the added-since clause makes the situation worse than mere absence: a verifier must GUESS which of two contradictory readings to encode, and the test then passes against the guess. Given a definition, the diff terms are cleanly testable - an element created between two commits must appear as added and must not appear as changed - and the re-verified term needs its own criterion for the reason the correctness lens gives. As it stands a verification would be an assertion of the tester's interpretation, which is the failure mode where a green test increases confidence without increasing evidence."; }
    part srViewerBaselineCompareTestabilityCritiqueR1 : TestResult { :>> id = "edb2de35-ed45-40bf-b516-158e824a11c7"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerBaselineCompareTestabilityCritique to srViewerBaselineCompare;
    verification srViewerChangeImpactCorrectnessCritique : Test { :>> id = "b87ee196-25cd-42b5-8361-90ddc979af9f"; :>> title = "Critique srViewerChangeImpact - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and it is a better statement than the Need it decomposes - which is what decomposition is for. Three additions each answer a real objection: CONFIGURABLE typed edges rather than all edges, so a traversal can follow satisfy without following supersede; GROUPED BY DISTANCE, which gives a reader a way to read a large result rather than a flat blob; and CYCLES SHOWN ONCE, which is the difference between a traversal that terminates and one that does not. The engine's traversal already walks edges in both directions, so the inverse-direction slice is a real capability rather than an aspiration. THE INHERITED LIMIT IS NOT THIS REQUIREMENT'S FAULT and is recorded against the Need: impact over TYPED edges misses the untyped dependencies that actually broke things here - a hardcoded file path, the engine/project schema union, a commit SHA resolving. This requirement is faithful to the Need it was given."; }
    part srViewerChangeImpactCorrectnessCritiqueR1 : TestResult { :>> id = "f54fd562-4bf7-4a57-bacf-3a118d31d4ff"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerChangeImpactCorrectnessCritique to srViewerChangeImpact;
    verification srViewerChangeImpactCompletenessCritique : Test { :>> id = "357f8a02-8dbe-4626-8813-702a1a09ea56"; :>> title = "Critique srViewerChangeImpact - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "GROUPING BY DISTANCE IS NOT BOUNDING BY DISTANCE, and the requirement supplies only the first. An unbounded traversal over a graph this dense still reaches most of the corpus - grouping makes the result readable, not small - so nothing states a maximum depth, a default, or what the surface does when a slice would return the whole model. ALSO UNSPECIFIED: whether edges are WEIGHTED or merely enumerated. A satisfy edge and a dependency edge are both traversable and mean different things about impact, and a blast radius that counts every reachable element equally is a number a reader learns to ignore. AND NOTHING ABOUT SUPERSEDED elements: a superseded dependent is affected by the retirement rather than by a change, and including it silently inflates every radius in a model that retires by supersession."; }
    part srViewerChangeImpactCompletenessCritiqueR1 : TestResult { :>> id = "4db99d6d-3c5a-4c94-b6da-082e80ded5e9"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerChangeImpactCompletenessCritique to srViewerChangeImpact;
    verification srViewerChangeImpactTestabilityCritique : Test { :>> id = "a2435189-924f-44a7-89aa-91301838771a"; :>> title = "Critique srViewerChangeImpact - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, with the best negative cases of this batch because each clause has an obvious failure. Cycles shown once: construct a cycle and require finite output - a regression here hangs or explodes, which is unmissable. Grouped by distance: a dependent two hops away must appear at distance two, not one. Configurable edges: restricting the edge set must shrink the result. An element with no incoming edges must report no dependents. All four are checkable against a fixture with no judgment involved, which makes this requirement genuinely verifiable in a way most of its siblings are not."; }
    part srViewerChangeImpactTestabilityCritiqueR1 : TestResult { :>> id = "c5356235-5743-4066-9e8c-c5e51e9357f8"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerChangeImpactTestabilityCritique to srViewerChangeImpact;
    verification srViewerConfigurableSliceCorrectnessCritique : Test { :>> id = "cd9c0f0a-3b67-468d-b882-e4676c351837"; :>> title = "Critique srViewerConfigurableSlice - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT, and its factual claim was checked rather than assumed: it describes itself as generalizing 'today's fixed 1-hop element_neighbourhood and Need-only need_slice', and both functions are LIVE in keel-cli/src/view.rs - not retired with query.py, which was my first assumption. The characterisation is accurate on both counts: the existing behaviour is fixed at one hop and seeded only from a Need, and configurable depth plus a selectable edge set is a genuine generalization of exactly that. Naming the functions it generalizes is also better practice than the Need's prose, because it makes the baseline checkable instead of leaving 'expansion' relative to nothing."; }
    part srViewerConfigurableSliceCorrectnessCritiqueR1 : TestResult { :>> id = "2b986e35-396c-4ce7-9cef-fbc653f26223"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerConfigurableSliceCorrectnessCritique to srViewerConfigurableSlice;
    verification srViewerConfigurableSliceCompletenessCritique : Test { :>> id = "9354e35b-9afe-4ece-a3c8-3d0fbba1add2"; :>> title = "Critique srViewerConfigurableSlice - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE NEED'S SLICE-BOUNDARY GAP SURVIVED DECOMPOSITION UNCHANGED, which is the finding: 'returning only the connected subgraph and hiding the rest' says nothing about an edge whose far end is excluded. A slice that silently omits a cut edge shows an element as having no dependents when it has some outside the frame, and that is the partial-view-reported-as-complete failure this engine has hit three times (issue109's unresolvable endpoint, issue136's wrong-kind resolver, issue139's narrow enumeration). A slice is the one view where the omission is guaranteed rather than accidental, so it needs a stated answer - stub, count, or explicit boundary marker. ALSO ABSENT: any maximum depth, so a configurable depth with no ceiling can return the whole model, which is precisely what the Need asked to avoid."; }
    part srViewerConfigurableSliceCompletenessCritiqueR1 : TestResult { :>> id = "6287462a-d9fa-45df-8f10-e8b678756205"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerConfigurableSliceCompletenessCritique to srViewerConfigurableSlice;
    verification srViewerConfigurableSliceTestabilityCritique : Test { :>> id = "b85ea430-5a7a-49bb-b534-44788acb504c"; :>> title = "Critique srViewerConfigurableSlice - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES. Given a fixture, a slice at depth N over a chosen edge set has exactly one right answer, and the negative cases are clean: an element at depth N+1 must be absent, and an element reachable only over an unselected edge kind must be absent. Both fail loudly on an off-by-one or a leaked edge kind. What a test cannot establish is that the slice shows what is RELEVANT - the Need's actual purpose - because relevance is what depth and edge selection approximate; but that limit belongs to the Need and is recorded there, and this requirement's own claims are fully checkable."; }
    part srViewerConfigurableSliceTestabilityCritiqueR1 : TestResult { :>> id = "7f19dc45-2d93-4447-9526-09b96d95f099"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerConfigurableSliceTestabilityCritique to srViewerConfigurableSlice;
    verification srViewerContextActionsCorrectnessCritique : Test { :>> id = "b9690626-b4ba-4586-aeb2-ec17bed28c9c"; :>> title = "Critique srViewerContextActions - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE CONTRACT IT GENERATES FROM CAN LIE, and I checked the mechanism rather than the intent. The requirement is right that the action set must come from the advertised contract rather than a hardcoded menu, and that contract genuinely exists: /api/version returns readEndpoints and writeEndpoints. But those are two hardcoded Rust arrays, and the test that guards them - api_version_contract_is_self_consistent - asserts only that they CONTAIN certain entries. Nothing asserts they MATCH the router. So the failure directions are asymmetric: a route added and not listed fails CLOSED (the action is simply not offered, which is safe), while a route removed and left listed fails OPEN - the viewer advertises an action, the user right-clicks it, and it 404s. Generating from a contract only moves the drift; it does not remove it, and this requirement inherits VIEW_SUBCOMMANDS' shape one layer up."; }
    part srViewerContextActionsCorrectnessCritiqueR1 : TestResult { :>> id = "a082aace-e452-41bd-8938-4aaadf433fc2"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerContextActionsCorrectnessCritique to srViewerContextActions;
    verification srViewerContextActionsCompletenessCritique : Test { :>> id = "d48deb37-00cf-4f00-a82a-57a5145b3160"; :>> title = "Critique srViewerContextActions - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "The action list is specific and its BEHAVIOUR is unstated. Focus and Expand always, then Critique, Edit, Connect, Supersede, Create when advertised - but nothing says what an action does to the element it is invoked on: does Supersede author the #Supersede edge immediately, or open the Decision that would justify it? Does Connect ask for the edge KIND, and is the kind list derived from the declared edge algebra or hardcoded, which is the same question the correctness lens raises one level down? ALSO ABSENT: what the menu shows when an action is advertised but not PERMITTED for this element and actor - a disposition on a Medium finding requires human authority, and Edit requires ownership under D0108. Offering an action that will be refused is worse than not offering it, because the refusal arrives after the user has committed to the intent."; }
    part srViewerContextActionsCompletenessCritiqueR1 : TestResult { :>> id = "b329ffaf-930a-45cc-8735-417900b97969"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerContextActionsCompletenessCritique to srViewerContextActions;
    verification srViewerContextActionsTestabilityCritique : Test { :>> id = "9c771412-45b4-487b-a6bd-6002b9ef3f13"; :>> title = "Critique srViewerContextActions - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on the clause that matters most and is the reason to state it this way: the action set must be GENERATED, so the test is to change the advertised contract and require the menu to change with no viewer edit - and it fails the moment anyone hardcodes an entry. That is the same nothing-hardcoded fixture that would serve nServeReuseModel and nViewerGenerativeUi, which is now the third requirement in this corpus whose verification is the same test nobody has written. The always-available pair (Focus, Expand) is trivially checkable. What is not testable is permission-awareness, because the requirement does not claim it (see completeness)."; }
    part srViewerContextActionsTestabilityCritiqueR1 : TestResult { :>> id = "d9eb6163-cdad-4f91-9be1-d3376cfb973c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "27b4c15"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerContextActionsTestabilityCritique to srViewerContextActions;

    // == Element-critique backfill pass 7, 2026-08-17 (sprint 331). Five viewer SystemRequirements x Core-3.
    // INDEPENDENT: every target's createdBy is wweatherholtz; the judge is claudeOpus5.
    verification srViewerCreateLinkageCorrectnessCritique : Test { :>> id = "8fa85af0-3a88-425e-a93a-4d4c0a03505f"; :>> title = "Critique srViewerCreateLinkage - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'THE CLOSED ALGEBRA KEEL PERMITS FOR THE PAIR' NAMES A FACT THE MODEL ONLY PARTLY CARRIES. keel declares the edge KINDS (the marker vocabulary, enforced by guard marker-vocabulary) and it declares a handful of TYPE-PAIR constraints inside EdgeRules - capabilityRootednessRule binds subjectType Capability to objectType Need, issuesTriagedRule binds Issue to objectType star. But that is five rules, not a table over the type product: for the overwhelming majority of pairs nothing declares which kinds are permitted. CORRECTED 2026-08-17 (sprint 332): this lens originally concluded that a create flow would have to INVENT the pair-to-kinds mapping in viewer code. IT WOULD NOT, and I had not looked far enough - /api/grammar exists (srViewerRelationshipGrammar, D0126/D0127) and returns (sourceType, edge, targetType) triples, and AUTHORABLE_EDGE_KINDS bounds what the write surface may author. The finding survives in a sharper and more accurate form: grammar_json builds its triples by iterating THE MODEL'S EXISTING EDGES, so the grammar is DESCRIPTIVE (what has been authored) where this requirement's clause is PRESCRIPTIVE (what is permitted). Offering only observed triples refuses a legitimate first-of-its-kind connection - the grammar cannot bootstrap - while a single mistaken edge, once authored, legitimises its own triple forever. So the mapping is derivable and the derivation answers a different question than the one this clause asks."; }
    part srViewerCreateLinkageCorrectnessCritiqueR1 : TestResult { :>> id = "e9229e90-6b17-4f61-b667-e8f21e8c000c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerCreateLinkageCorrectnessCritique to srViewerCreateLinkage;
    verification srViewerCreateLinkageCompletenessCritique : Test { :>> id = "7495b1c1-aba2-4895-b266-ac4e0b64e9ba"; :>> title = "Critique srViewerCreateLinkage - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "The flow is specified and its failure modes are not. Absent: what happens when the requested edge would create a CYCLE - a satisfy loop or a supersede cycle is well-formed to a writer and meaningless to every traversal, and srViewerChangeImpact has to handle cycles precisely because they occur; what happens on a DUPLICATE edge, which validates clean today and silently double-counts in any coverage computation that enumerates edges; and what happens when the intended counterpart DOES NOT EXIST YET, which is the common case in an authoring flow - the requirement says edges may attach to new and existing items but not whether both ends may be new in one action. ALSO ABSENT: ownership. D0108 lets a non-owner ADD an edge but not edit another actor's item, and the requirement's own phrase 'to new (and existing) items' spans both sides of that line without naming it."; }
    part srViewerCreateLinkageCompletenessCritiqueR1 : TestResult { :>> id = "ffefb0d7-f1b0-41f0-af2a-fcbc4563291b"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerCreateLinkageCompletenessCritique to srViewerCreateLinkage;
    verification srViewerCreateLinkageTestabilityCritique : Test { :>> id = "d7efda94-8d18-4d64-b658-d8ec40761f3b"; :>> title = "Critique srViewerCreateLinkage - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on its central claim, which has an unusually good negative case: create an item WITHOUT an edge and require the flow to have offered one, then create with an edge and require the item to appear in a trace or coverage view rather than in orphans. The engine already computes the orphan set, so the test can assert against a live view rather than an invented fixture - an item that lands unconnected shows up, and that is exactly the outcome the requirement exists to prevent. The offered-kinds clause is testable only as far as the pair algebra is declared (see correctness), so a verification would today assert whatever the implementation chose."; }
    part srViewerCreateLinkageTestabilityCritiqueR1 : TestResult { :>> id = "41eb583a-cc7f-4a06-9dbb-fadd6ef0f068"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerCreateLinkageTestabilityCritique to srViewerCreateLinkage;
    verification srViewerDatePredicatesCorrectnessCritique : Test { :>> id = "099b9c44-d2f3-4f6d-9f7a-79dc5b5bf236"; :>> title = "Critique srViewerDatePredicates - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE PREMISE IS ALREADY OUT OF DATE, and I checked rather than trusting the rationale. It asserts that date/range comparisons are what 'the current equality/set-membership-only vocabulary cannot express'. Two things contradict that: D0075, accepted, declares the select-predicate form as type, equality, in-set, TIME-RANGE, and has/missing-edge - so a time range is part of the declared vocabulary; and DateFilter (attr, since, until) is implemented in view.rs and wired into /api/slice in serve.rs, documented in its own doc comment as the N-5 time-as-query-filter. So date filtering exists on the slice path and is declared for the select path. WHAT I DID NOT ESTABLISH, and say so rather than guess: whether the TOML select evaluator actually honours the time-range D0075 declares - no shipped .view.toml uses since or until. That unknown is the real content this requirement should have carried: not add date predicates, but reconcile a declared predicate with its implementation."; }
    part srViewerDatePredicatesCorrectnessCritiqueR1 : TestResult { :>> id = "78c51bd0-9b83-4de0-8bed-f6138889c1ca"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerDatePredicatesCorrectnessCritique to srViewerDatePredicates;
    verification srViewerDatePredicatesCompletenessCritique : Test { :>> id = "12b441b2-20a5-4cad-be88-5d7031921319"; :>> title = "Critique srViewerDatePredicates - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'AND LIKELY OR' SURVIVED DECOMPOSITION, which is the failure this requirement existed to fix. A Need may hedge; a requirement is where the hedge must be resolved, because OR is the difference between a filter list and a boolean language and it changes the evaluator's shape entirely. The bound is deferred to 'a follow-on Decision (open question Q3)' and NO SUCH DECISION EXISTS - I looked through the decisions directory and found none setting a predicate bound. So this requirement is blocked on an unwritten Decision, and nothing surfaces that: a backlog action can be blocked by a #DependsOn to a proposed Decision and drop off the ready frontier, but a requirement waiting on a Decision nobody has authored is simply quiet. That asymmetry is worth naming - the engine can express blocked WORK and cannot express a blocked REQUIREMENT."; }
    part srViewerDatePredicatesCompletenessCritiqueR1 : TestResult { :>> id = "13843c1a-a4da-4ebb-a2c3-1427d8be9820"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerDatePredicatesCompletenessCritique to srViewerDatePredicates;
    verification srViewerDatePredicatesTestabilityCritique : Test { :>> id = "6e633805-4a99-4d0a-abf8-34329a25178c"; :>> title = "Critique srViewerDatePredicates - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "Untestable in both directions at once, which is unusual. The POSITIVE clause cannot fail: any predicate set satisfies 'add date/range predicates sufficient for temporal and stakeholder filtering', since sufficiency is unmeasured. The NEGATIVE clause cannot fail either: 'while remaining a BOUNDED, fixed vocabulary' has no bound, so no addition can violate it. A requirement whose expansion clause and whose limiting clause are both unfalsifiable records an intention rather than a contract. Fixing it is cheap and mechanical - enumerate the predicates that will exist and state that anything else is out of scope - and that enumeration IS the follow-on Decision the requirement defers to."; }
    part srViewerDatePredicatesTestabilityCritiqueR1 : TestResult { :>> id = "dd96fc26-a8da-4319-a5c9-8aa81dfe4408"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerDatePredicatesTestabilityCritique to srViewerDatePredicates;
    verification srViewerExportShareCorrectnessCritique : Test { :>> id = "57fabf5f-3b63-4713-bd57-bb19618fc4e1"; :>> title = "Critique srViewerExportShare - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "FIXES ITS NEED'S AS-OF DEFECT AND KEEPS ITS AUDIENCE DEFECT. The fix is real and worth crediting: where N-12 asked only for an as-of DATE, this requirement stamps 'as-of date + scope + the source commit, so the snapshot is reproducible', which is exactly the right anchor in a system where every TestResult already pins a commit because a date is ambiguous across branches. What survives unrepaired is the audience: it offers 'link / file' for a snapshot so 'a non-user gets the view', and D0158 records the console as local-only and unauthenticated - a link to a local server is unreachable by definition for a non-user, which is the only person this requirement serves. One of the two named mechanisms therefore cannot work under the current deployment scope, and the requirement does not say that the link half depends on D0157's deferred hosted service."; }
    part srViewerExportShareCorrectnessCritiqueR1 : TestResult { :>> id = "3ef37a59-f9aa-4566-9981-b43ed1325fd6"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerExportShareCorrectnessCritique to srViewerExportShare;
    verification srViewerExportShareCompletenessCritique : Test { :>> id = "4c12fb34-b84b-4c4e-bd81-8ece08aa23af"; :>> title = "Critique srViewerExportShare - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'OVERSIZED VIEWPOINTS EXPORT THE SCOPED/FILTERED SUBSET WITH A NOTE' names no threshold, so oversized is set by whatever the implementation chooses - the same unnamed-bound pattern as the distinct-value cap in srEncodingSchemaSemantics, where the number ended up living only in the code the requirement governs. It also does not say what the NOTE must contain, and the note is the load-bearing part: a truncated export that says only truncated is a partial view presented as complete, while one that says which scope was applied and how many elements were dropped is honest. The engine's own pattern elsewhere is the second - the obligation bar reports NOT COUNTABLE with the unbound command named, and sitting-coverage reports its grandfather basis - and this requirement should require the same."; }
    part srViewerExportShareCompletenessCritiqueR1 : TestResult { :>> id = "f7bc393a-d520-42c4-9193-916feae08109"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerExportShareCompletenessCritique to srViewerExportShare;
    verification srViewerExportShareTestabilityCritique : Test { :>> id = "be5b2cc6-a937-4e4d-b3a7-88450d73d364"; :>> title = "Critique srViewerExportShare - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, and reproducibility is what makes it testable in a way the Need was not: export a snapshot, read its stamped commit, regenerate the viewpoint at that commit, and require the same contents. That is a real round-trip with a real failure mode, and it is only possible because the requirement added the source commit. The truncation clause is testable in structure (an oversized export must carry a note) but not in threshold (see completeness). The link mechanism is not testable for its stated purpose, since a local URL that no external recipient can resolve would pass a naive check while failing the requirement's own intent."; }
    part srViewerExportShareTestabilityCritiqueR1 : TestResult { :>> id = "60358435-3b61-4155-b446-84710eb3f1a2"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerExportShareTestabilityCritique to srViewerExportShare;
    verification srViewerGenerativeUiCorrectnessCritique : Test { :>> id = "5fa50ce5-d09e-4ff2-8917-403726d5441b"; :>> title = "Critique srViewerGenerativeUi - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "TWO DEFECTS, ONE INHERITED AND ONE ITS OWN. INHERITED: 'the guarded write API + keel processes drive changes ... with NOTHING hardcoded per type/process/field' repeats N-17's read/write asymmetry - view::item_detail generalizes to any item type, so DISPLAY genuinely needs no per-type code, while `keel record` accepts exactly two verbs with hardcoded flag lists, so MANIPULATION has no generic path and the missing half lives in the engine where the viewer cannot supply it. ITS OWN: the parenthetical cites 'shape B', and that architecture decision has been superseded - D0114 chose shape B and D0152 superseded D0114 with one filtered app. So an accepted requirement points at a retired shape, and a reader deciding how to build it would follow a Decision that is no longer in force. That is the stale-reference class this session has now found four times (a Need's dogfooding clause, N-6's open shape question, six gate comments, and here)."; }
    part srViewerGenerativeUiCorrectnessCritiqueR1 : TestResult { :>> id = "81e3ba52-9979-46cc-b799-c5f9a8485b77"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerGenerativeUiCorrectnessCritique to srViewerGenerativeUi;
    verification srViewerGenerativeUiCompletenessCritique : Test { :>> id = "e349e0bb-faa4-4900-b8eb-631bd6de39b8"; :>> title = "Critique srViewerGenerativeUi - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Silent on the case that certainly occurs: a declared type with NO write endpoint. The requirement drives forms from /api/schema and actions from /api/launchables and the write API, and since the schema advertises every declared type while the write API covers two, the intersection is where most types land - viewable, unmanipulable. Nothing says whether the UI shows a read-only surface, hides the action, or offers one that fails. The engine's answer elsewhere is to report the gap explicitly (NOT COUNTABLE on the obligation bar; unit.toml naming what a receiving binary lacks), and that is what should be required here. ALSO ABSENT: what happens to a form field whose attribute has no widget for its declared type - a Timestamp, an enum and a free-text String are three different inputs, and 'nothing hardcoded per field' forbids the obvious per-field solution without supplying a derivation."; }
    part srViewerGenerativeUiCompletenessCritiqueR1 : TestResult { :>> id = "466c72b2-9531-4153-91db-116db8a65ddd"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerGenerativeUiCompletenessCritique to srViewerGenerativeUi;
    verification srViewerGenerativeUiTestabilityCritique : Test { :>> id = "50fecb06-d723-44df-8ae0-6c99ea3c885d"; :>> title = "Critique srViewerGenerativeUi - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, with the sharpest fixture in the whole corpus: add an attribute to the schema, or a declared type, or a process, and require it to appear in the UI with NO viewer edit - a test that fails the instant a hardcoded list appears anywhere in the path. This is now the FIFTH element whose verification is that same one fixture (with nServeReuseModel, nViewerGenerativeUi's parent Need, srViewerContextActions and srEncodingModular), and it still does not exist. The clause it cannot reach is manipulation, for the reason the correctness lens gives: a test for it would fail on the engine rather than the viewer, and would be reported against the wrong component."; }
    part srViewerGenerativeUiTestabilityCritiqueR1 : TestResult { :>> id = "aa5946c6-3fa7-4e74-97e2-61b3d1b1610e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerGenerativeUiTestabilityCritique to srViewerGenerativeUi;
    verification srViewerGraphExpandCorrectnessCritique : Test { :>> id = "fae8b878-ba1c-4e83-adc7-1f10e567e043"; :>> title = "Critique srViewerGraphExpand - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and it repairs the vaguest term in its Need. N-2 asked for a 'stable layout' without saying stable against what; this requirement defines it operationally as a layout 'that does not re-shuffle on expand', which is both the property a walker actually needs and a checkable one. It also states the mechanism (load neighbours on demand, incremental rather than whole-model embedding) and cites the observed failure point rather than inventing a target. On the number: it says 'remains interactive past the ~2,500-node point where whole-graph layout froze', which is open-ended rather than a ceiling - so unlike its Need it does not become false as the corpus grows, though a reader should know that past now means at least the 8005 deliverable items this repository measured in sprint 317."; }
    part srViewerGraphExpandCorrectnessCritiqueR1 : TestResult { :>> id = "6cd5554c-f6b1-4d37-8cfe-7502161f5403"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerGraphExpandCorrectnessCritique to srViewerGraphExpand;
    verification srViewerGraphExpandCompletenessCritique : Test { :>> id = "9dda8222-8ad5-4cb7-a578-8c05fbaf0c7e"; :>> title = "Critique srViewerGraphExpand - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "NO LATENCY BUDGET, for a requirement whose entire subject is responsiveness. The failure it reacts to was a freeze - a time failure - and the requirement records a node count and a mechanism, so an implementation that opens 8000 nodes in forty seconds while loading incrementally satisfies every word. 'Remains interactive' is the claim and no interval bounds it. ALSO UNSPECIFIED: what expand does at a hub. Some elements in this model have dozens of neighbours, so expanding one can inject a hundred nodes in a single action, and nothing says whether that is paged, capped, or simply dumped - which is where a seed-and-expand walk actually breaks down. And 'drill-into-detail' still does not say whether detail replaces, accompanies or overlays the graph, which decides whether the reader keeps their place."; }
    part srViewerGraphExpandCompletenessCritiqueR1 : TestResult { :>> id = "1b59419c-705c-4b56-82dd-ae056e4d9c4b"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerGraphExpandCompletenessCritique to srViewerGraphExpand;
    verification srViewerGraphExpandTestabilityCritique : Test { :>> id = "9c2c0f5e-444c-4d28-a92f-460ea76ce905"; :>> title = "Critique srViewerGraphExpand - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on the two clauses that carry the requirement, both mechanically checkable without a visual baseline. INCREMENTAL LOADING: assert that opening a viewpoint fetches a bounded neighbourhood rather than the whole model - a request count or payload size, and it fails loudly if anyone reverts to embedding. STABLE LAYOUT: record node positions, expand a node, and require the pre-existing nodes' positions to be unchanged - a precise assertion that the operational definition (does not re-shuffle on expand) makes possible and that N-2's wording did not. What cannot be tested is interactivity itself, for lack of a latency budget (see completeness)."; }
    part srViewerGraphExpandTestabilityCritiqueR1 : TestResult { :>> id = "47ac4e55-cfb2-46bd-9ded-149302c92195"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "59994b0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerGraphExpandTestabilityCritique to srViewerGraphExpand;

    // == Element-critique backfill pass 8, 2026-08-17 (sprint 332). Five viewer SystemRequirements x Core-3.
    // INDEPENDENT: every target's createdBy is wweatherholtz; the judge is claudeOpus5.
    verification srViewerRelationshipGrammarCorrectnessCritique : Test { :>> id = "573e9a39-06a3-450f-954b-78d2b9a442fb"; :>> title = "Critique srViewerRelationshipGrammar - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "DESCRIPTIVE WHERE THE REQUIREMENT IS PRESCRIPTIVE, and the implementation makes the gap exact. The statement asks keel to expose a grammar of which triples are VALID. view::grammar_json builds its triples by iterating THE MODEL'S EXISTING EDGES - for each edge, insert (sourceType, kind, targetType) - so what /api/grammar returns is a census of what HAS BEEN AUTHORED. Two consequences follow directly and both are bad in a specific way. CORRECTED 2026-08-17 (sprint 338): I wrote that a valid triple nobody has authored yet is absent, so a client would refuse a legitimate first-of-its-kind connection and the grammar could never bootstrap. THE BOOTSTRAP HALF IS WRONG and its governing Decision answers it: D0127 chooses the observational grammar deliberately and states that new never-used pairings remain reachable via the full closed algebra through Connect, and then become part of the observed grammar - so there IS an escape and the grammar does bootstrap through it. What survives, and is the real finding: this REQUIREMENT says the grammar states which triples are VALID while its governing Decision says the grammar is OBSERVED, so requirement and Decision disagree in wording about the same artifact - and a mistaken edge authored once still legitimises its own triple permanently, which D0127 does not address. And an INVALID triple authored once by mistake is present forever, so the error legitimises itself and every future client offers it. The requirement's own words point at the fix - it says the grammar is built on the closed edge algebra plus the EdgeRule/ElementRule layer, which is prescriptive material - and the implementation did not use that material."; }
    part srViewerRelationshipGrammarCorrectnessCritiqueR1 : TestResult { :>> id = "014038fe-b8a9-490d-b7c7-102ed12d63a7"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerRelationshipGrammarCorrectnessCritique to srViewerRelationshipGrammar;
    verification srViewerRelationshipGrammarCompletenessCritique : Test { :>> id = "f9705bef-3378-4d0c-8097-60fe606734a4"; :>> title = "Critique srViewerRelationshipGrammar - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE PRESCRIPTIVE SOURCE IT NAMES IS NEARLY EMPTY, measured: rules.sysml declares three objectType values in total - two are the wildcard star and one is Need - so the EdgeRule layer supplies exactly ONE constrained pair. A grammar over the type product cannot be built on one triple, and the requirement does not acknowledge the shortfall or ask for the rules to be extended first, so 'built on the existing layer' reads as though the data is largely there. ALSO UNSPECIFIED, and it is the clause that makes this a metamodel requirement rather than a keel-only one: it promises validity 'for ANY project's schema', and a downstream project declares its own types, so the grammar must admit project-declared triples. Nothing says whether a project extends the grammar, where it declares that, or what happens to a project type absent from it - offered nothing, or offered everything."; }
    part srViewerRelationshipGrammarCompletenessCritiqueR1 : TestResult { :>> id = "d1d27d8e-9f9e-469e-9d76-2679f7c47c52"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerRelationshipGrammarCompletenessCritique to srViewerRelationshipGrammar;
    verification srViewerRelationshipGrammarTestabilityCritique : Test { :>> id = "51491a54-8a5c-4782-ba5c-a490d3fd2e52"; :>> title = "Critique srViewerRelationshipGrammar - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, and the negative case is exact once the prescriptive-versus-descriptive question is settled: declare a triple valid, do not author any instance of it, and require /api/grammar to include it. That test FAILS today, correctly, which makes it the most valuable verification named in this pass - it measures the defect the correctness lens found rather than asserting it. The complementary case is equally clean: author an edge the grammar does not permit and require the write surface to refuse. Both are mechanical. What cannot be tested from the requirement alone is the project-extension clause, since it names no extension point (see completeness)."; }
    part srViewerRelationshipGrammarTestabilityCritiqueR1 : TestResult { :>> id = "dd621262-6a27-482e-aeb8-9091b7eb2f54"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerRelationshipGrammarTestabilityCritique to srViewerRelationshipGrammar;
    verification srViewerInProgramEditCorrectnessCritique : Test { :>> id = "d9138d5f-b97b-401c-b7e8-551e307645c3"; :>> title = "Critique srViewerInProgramEdit - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and it REPAIRS the exact defect its Need carries. N-16 asks that every change be 'written back through keel's write API', which names a path that does not exist for a general field edit - keel record takes two verbs. This requirement instead enumerates the real write PROCESSES (record a Decision, supersede a Need, apply-review, append-result, add-task) and reframes editing a fact as SUPERSEDING it, citing the invariant that a change to a fact IS a superseding Decision. That is the correct move in this engine and it converts an unsatisfiable clause into a satisfiable one. It also states the two failure paths its Need omitted: a guard-rejected write is refused inline with the guard message, and a concurrent change flags a conflict. This is what a decomposition is supposed to do to a defective parent."; }
    part srViewerInProgramEditCorrectnessCritiqueR1 : TestResult { :>> id = "f2b35180-b5cd-4894-995f-3210982e9590"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerInProgramEditCorrectnessCritique to srViewerInProgramEdit;
    verification srViewerInProgramEditCompletenessCritique : Test { :>> id = "ed68f875-5efe-4e1e-8cc0-95a9d80e374a"; :>> title = "Critique srViewerInProgramEdit - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'A CONCURRENT CHANGE FLAGS A CONFLICT' NAMES NO DETECTION MECHANISM, and the model gives it nothing to work with: items carry no version, no etag and no content hash, so the only way to notice a concurrent change is a read-modify-write comparison the requirement does not ask for. Without it the clause is aspirational, and its failure mode is the silent one D0108 exists to prevent - a lost update that validates clean. ALSO ABSENT: the SELF-CRITIQUE collision. This surface's whole purpose is critique-then-change-then-re-critique, and critique independence requires judgedBy to differ from the element's author while an edit does not transfer authorship - so the loop's most natural user, the element's own author, produces re-critiques that the coverage computation discards. Its sibling srViewerIterativeCritique names the independent-critic discipline explicitly; this one does not."; }
    part srViewerInProgramEditCompletenessCritiqueR1 : TestResult { :>> id = "197532aa-8ea1-4cf2-8a8c-5486bd2ea0d1"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerInProgramEditCompletenessCritique to srViewerInProgramEdit;
    verification srViewerInProgramEditTestabilityCritique : Test { :>> id = "1bb694ae-43fa-464e-a21d-81f80ae50eef"; :>> title = "Critique srViewerInProgramEdit - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on three clauses with real failure cases. NEVER A RAW FIELD MUTATION: assert that no write path bypasses the API - a diff of the working tree after an in-program edit must show a process-shaped record, not a mutated field. GUARD-REJECTED WRITE REFUSED INLINE: submit a write that violates a guard and require the guard's own message to reach the surface rather than a generic failure, which is checkable and is the difference between a usable surface and an opaque one. NEVER A SECOND STORE: falsifiable by inspection. The conflict clause is not testable for lack of a detection mechanism (see completeness), so a verification would pass while the concurrency guarantee remains unevidenced."; }
    part srViewerInProgramEditTestabilityCritiqueR1 : TestResult { :>> id = "73d7e18c-f355-4cb6-b43e-eca1ec34131f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerInProgramEditTestabilityCritique to srViewerInProgramEdit;
    verification srViewerIterativeCritiqueCorrectnessCritique : Test { :>> id = "7e1bb04e-9582-4df4-92ae-dff606b3c3f5"; :>> title = "Critique srViewerIterativeCritique - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and it fixes its Need's most consequential omission - which I credit specifically because I faulted the Need for it. N-15 says nothing about who may critique what; this requirement records 'with the independent-critic + provenance discipline', which is precisely the constraint that decides whether an iteration's output counts: critique-policy.toml requires judgedBy to differ from the element's author, and in this repository 87 of 154 uncovered elements are AI-authored, so an AI iterating an axis without that discipline would produce findings the coverage computation discards for the majority. Naming it means an implementation must confront it. The two named use cases (process plus downstream on a best-practice lens, requirement plus downstream on semantic sufficiency) are also concrete enough to build against rather than illustrative."; }
    part srViewerIterativeCritiqueCorrectnessCritiqueR1 : TestResult { :>> id = "330db870-7b85-4d8d-8c2d-86fee084f9b6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerIterativeCritiqueCorrectnessCritique to srViewerIterativeCritique;
    verification srViewerIterativeCritiqueCompletenessCritique : Test { :>> id = "e769888b-8293-4f06-b226-5d04932e9ac6"; :>> title = "Critique srViewerIterativeCritique - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "An iteration with no cost bound and no idempotence rule. UNSPECIFIED: (a) COST - one AI invocation per element with no maximum, no confirmation before committing to a hundred, and no statement of what the user sees mid-run; (b) IDEMPOTENCE - what a re-run does when an element already carries a critique for that lens: add a second, replace the first, or skip. All three are defensible and they produce different corpora, and the wrong choice makes a re-run either destructive or a duplicate factory. This session's own backfill hit exactly that question and answered it by hand; (c) PARTIAL FAILURE - what is recorded when element 40 of 100 errors, since silence leaves a partial pass indistinguishable from a complete one. ALSO: it binds itself to apply-review, and this repository's own backfill was directed to author critiques directly instead, so the named mechanism is not the one in use for this exact job."; }
    part srViewerIterativeCritiqueCompletenessCritiqueR1 : TestResult { :>> id = "a6e1c67d-4601-4b8e-bf7b-7d02739194d6"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerIterativeCritiqueCompletenessCritique to srViewerIterativeCritique;
    verification srViewerIterativeCritiqueTestabilityCritique : Test { :>> id = "6ed36d7c-2dee-4a72-8559-c3914ec9ffac"; :>> title = "Critique srViewerIterativeCritique - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on a mechanical property: constrain a query to N elements, run the axis iteration with a lens, and require N tracked critiques each #Verify-linked to its element and each carrying a judge distinct from that element's author. The link assertion matters most, because an unlinked finding is invisible to every coverage computation and would otherwise look like success; the judge assertion is what makes the independence clause verifiable rather than decorative. Not testable: whether the findings are any GOOD. The engine has a separate diagnostic for that (critique-rigor, which flags affirming-only critics), and this requirement would be stronger for naming it."; }
    part srViewerIterativeCritiqueTestabilityCritiqueR1 : TestResult { :>> id = "a3b6d50b-1345-42d6-accb-df24de09c862"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerIterativeCritiqueTestabilityCritique to srViewerIterativeCritique;
    verification srViewerKeelApiCorrectnessCritique : Test { :>> id = "1f1e59d8-2aaa-438a-960f-ffd0703efaab"; :>> title = "Critique srViewerKeelApi - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "'BREAKING CHANGES BUMP THE VERSION' IS AN UNENFORCED PROMISE, and I checked the control rather than the intent. KEEL_API_VERSION exists and is semver-shaped, and api_version_contract_is_self_consistent asserts the shape and that certain endpoints are advertised. Nothing detects a BREAKING CHANGE: there is no recorded baseline contract to diff a release against, so removing an endpoint, renaming a field, or changing a response shape all pass every gate with the version untouched. The requirement therefore states a discipline that rests entirely on the author remembering - which D0047 rejects in this engine, since manual vigilance is not a control. And the consequence lands on the one consumer the requirement exists for: a separate viewer app pinning a major version has no way to learn that the contract moved under it."; }
    part srViewerKeelApiCorrectnessCritiqueR1 : TestResult { :>> id = "772260c0-82e0-4de0-9023-823a54d4a998"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerKeelApiCorrectnessCritique to srViewerKeelApi;
    verification srViewerKeelApiCompletenessCritique : Test { :>> id = "8dcc4ef8-038d-4886-b1d8-6bb4754d14f8"; :>> title = "Critique srViewerKeelApi - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "BREAKING IS NEVER DEFINED, and every part of the version promise depends on it. Removing an endpoint is obviously breaking; adding a FIELD is not, unless a client validates strictly; making an optional field required is; changing a field's TYPE is; reordering an array may be. Without a stated rule the author decides case by case, which is how a version stops meaning anything. ALSO ABSENT: what the api version covers. The statement scopes it to 'read/query/graph/temporal', while /api/version advertises write endpoints too and the write surface is where a breaking change hurts most - so a reader cannot tell whether the write contract is versioned by this requirement or by nothing. And no DEPRECATION path is named: no way to mark an endpoint going away, which is the only mechanism that lets a consumer migrate before it breaks."; }
    part srViewerKeelApiCompletenessCritiqueR1 : TestResult { :>> id = "930fe898-7c01-4440-a851-d63b036bd5bb"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerKeelApiCompletenessCritique to srViewerKeelApi;
    verification srViewerKeelApiTestabilityCritique : Test { :>> id = "16074752-fe5b-4dd2-bac8-ad24862b9039"; :>> title = "Critique srViewerKeelApi - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "The version's SHAPE is testable and its PROMISE is not, and only the promise matters. That a version string exists and is semver-shaped is already asserted by a unit test - a true and nearly empty check. That breaking changes bump it cannot be tested at all without two things the requirement does not ask for: a definition of breaking (see completeness) and a RECORDED BASELINE contract to compare a candidate release against. With both, the test is mechanical and valuable: diff the advertised contract against the last released baseline, classify the differences, and require the version to have moved accordingly. That test would also catch the removed-but-still-advertised endpoint that srViewerContextActions depends on, which makes it a second place where one unwritten check would serve two requirements."; }
    part srViewerKeelApiTestabilityCritiqueR1 : TestResult { :>> id = "e29c4567-8022-49b7-9b29-669d5903af33"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerKeelApiTestabilityCritique to srViewerKeelApi;
    verification srViewerNavHistoryCorrectnessCritique : Test { :>> id = "693c2823-427b-43f7-811f-01293f085c91"; :>> title = "Critique srViewerNavHistory - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and its parenthetical is the sharpest line in this batch: 'Model WRITES are reversed through keel processes - supersede / git - not this client history.' That draws the boundary that makes an undo feature safe in a system whose truth is text in git. A client history that undid model writes would be a second write path and a second source of truth; scoping undo to focus and graph state keeps exploration cheap while leaving reversal of FACTS where it belongs, with supersession and git. Requiring each control to be disabled at its end of the history is also correct and specific - a live undo button at the start of history is the small lie that teaches a user to distrust the surface."; }
    part srViewerNavHistoryCorrectnessCritiqueR1 : TestResult { :>> id = "d8aba11f-4a70-4654-99d6-bdbcafad2628"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerNavHistoryCorrectnessCritique to srViewerNavHistory;
    verification srViewerNavHistoryCompletenessCritique : Test { :>> id = "d34dc4b1-8efd-49a5-83e0-4e22c748ab29"; :>> title = "Critique srViewerNavHistory - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Three gaps, one of which is a genuine interaction trap. THE TRAP: nothing says what undo does AFTER a model write. Since writes are deliberately not in this history, a user who focuses, records a Decision, then presses undo moves the focus back while the model has moved on - so undo silently returns them to a view of a state that no longer exists, and the requirement's own boundary is what creates the hazard. It should require the history to be invalidated or marked at a write. ALSO ABSENT: a depth bound, so the history grows for a long session with no stated ceiling; and whether history survives a reload, which ties to N-19's requirement that view state persist as an artifact and travel - if it does persist, an undo stack crossing machines needs saying, and if it does not, that should be stated too."; }
    part srViewerNavHistoryCompletenessCritiqueR1 : TestResult { :>> id = "166fce57-0dd6-48ed-9102-9fa2b4d4d333"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerNavHistoryCompletenessCritique to srViewerNavHistory;
    verification srViewerNavHistoryTestabilityCritique : Test { :>> id = "a798ab1f-55cc-4795-ae3e-b225f608de67"; :>> title = "Critique srViewerNavHistory - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES, and it is the most directly checkable requirement in the batch: navigate three steps, undo twice, and require the second state; redo once and require the third; at each end require the corresponding control disabled. Every clause has an unambiguous failure. The keyboard bindings are assertable too. What no test covers is the post-write hazard the completeness lens names, because the requirement does not claim anything about it - which is exactly why a verification here would pass comfortably while the surface could still return a user to a stale view."; }
    part srViewerNavHistoryTestabilityCritiqueR1 : TestResult { :>> id = "e1162c62-3cc1-4d12-a230-f82e5440e5e6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "643d0da"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerNavHistoryTestabilityCritique to srViewerNavHistory;

    // == Element-critique backfill pass 9, 2026-08-17 (sprint 333). The LAST five critiquable SystemRequirements.
    // After this pass every SR not authored by claudeOpus5 is critique-covered; 42 remain blocked as mine.
    // INDEPENDENT: every target's createdBy is wweatherholtz; the judge is claudeOpus5.
    verification srViewerSchemaApiCorrectnessCritique : Test { :>> id = "92806025-f468-4b31-afbf-999ced1405e3"; :>> title = "Critique srViewerSchemaApi - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "THE MECHANISM IT COMMITS TO IS THE ONE THIS ENGINE HAS ALREADY BEEN BITTEN BY. The rationale is honest that the parser skips type-def bodies, so a TEXT SCAN of the schema is the first mechanism - and view::scan_schema_defs is exactly that, a line-oriented scan over the root's .engine/schema. The failure mode is not hypothetical: the attribute-vocabulary guard shipped with a line-oriented scan that missed every SINGLE-LINE record, reported 8088 of 41036 assignments scanned and PASSED, and had to be fixed to read all assignments per line. A schema written in a valid but unanticipated layout is therefore silently absent from /api/schema, and a generative UI built on it silently omits those fields - a partial answer presented as complete, with no signal. The requirement should require the scan's COVERAGE to be reported (how many type defs and attributes were found) so a shortfall is visible, which is the same remedy the guard needed. SMALLER NOTE: the statement scopes automatic pickup to 'schema/core' while the implementation scans all of .engine/schema, so the implementation is broader than its requirement."; }
    part srViewerSchemaApiCorrectnessCritiqueR1 : TestResult { :>> id = "7774e1a4-b252-4d3a-8299-60e03162f2b7"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSchemaApiCorrectnessCritique to srViewerSchemaApi;
    verification srViewerSchemaApiCompletenessCritique : Test { :>> id = "674166ef-46fb-45bc-858c-413c5fd53bc9"; :>> title = "Critique srViewerSchemaApi - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Nothing states what a downstream project sees. This requirement is the substrate for a generative UI, and a downstream project declares its own types under .engine/schema alongside the engine's - so the interesting question is whether /api/schema returns the union, and if so whether a consumer can tell which types are ENGINE and which are PROJECT. That distinction is exactly what sprint 317's /api/scope exists to make visible for ITEMS, and it is unaddressed for TYPES. A UI that cannot tell an engine type from a project type cannot present the two-model separation CLAUDE.md's second invariant insists on. ALSO ABSENT: what is returned for an attribute whose declared type is itself a project type, and whether enum members are returned for project enums as well as engine ones."; }
    part srViewerSchemaApiCompletenessCritiqueR1 : TestResult { :>> id = "67e0293a-c7ac-4d0e-aaf9-5d1605b134b2"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSchemaApiCompletenessCritique to srViewerSchemaApi;
    verification srViewerSchemaApiTestabilityCritique : Test { :>> id = "ba7d89b7-6a50-4d8f-9072-b21ed5c81695"; :>> title = "Critique srViewerSchemaApi - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES with the nothing-hardcoded fixture that this corpus now names for the sixth time: add a type or an attribute to the schema and require it to appear in /api/schema with NO code change. The negative case is sharp and the endpoint already exists, so the test is writable today. A second worthwhile assertion falls straight out of the correctness lens: declare an attribute in a valid but unusual layout (several assignments on one line, which is how much of this corpus is written) and require it to appear - that is the test that would have caught the attribute-vocabulary scan defect, and it is cheap."; }
    part srViewerSchemaApiTestabilityCritiqueR1 : TestResult { :>> id = "c5bcf2f9-300a-4c4f-8834-d69a9a87978f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSchemaApiTestabilityCritique to srViewerSchemaApi;
    verification srViewerScopedAuthoringCorrectnessCritique : Test { :>> id = "cbd0e7a7-fee2-4365-8fa0-d91b9de53355"; :>> title = "Critique srViewerScopedAuthoring - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "IT RESTS ON A GRAMMAR THAT ANSWERS A DIFFERENT QUESTION. The requirement offers creation of in-scope types plus 'the types they directly interface with upstream/downstream (per the declared grammar)', and view::grammar_json computes its triples by iterating the model's EXISTING edges - so the adjacency it consults is DESCRIPTIVE. Two consequences for this feature specifically: in a young or narrow scope the adjacent-type set is smaller than the truth, so the surface refuses creations that are perfectly valid and the user cannot make the first edge of a legitimate kind; and any mistaken edge already in the model widens the offered set permanently. The requirement is not wrong to delegate to the grammar - that is the right dependency - but it inherits the grammar's descriptive/prescriptive confusion without naming it, and the effect here is a surface that silently narrows what a user may author."; }
    part srViewerScopedAuthoringCorrectnessCritiqueR1 : TestResult { :>> id = "75c1663e-7966-4479-b047-bfb1c7a5a051"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerScopedAuthoringCorrectnessCritique to srViewerScopedAuthoring;
    verification srViewerScopedAuthoringCompletenessCritique : Test { :>> id = "852d9f98-b106-4963-b80b-7a3f760dd7ce"; :>> title = "Critique srViewerScopedAuthoring - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "SCOPE IS NEVER DEFINED, and the word is already overloaded in this engine. The statement turns entirely on 'an active scope filter' and 'out-of-scope creation', while keel now uses scope in at least two other senses: /api/scope reports the ENGINE-versus-DELIVERABLE partition of items (sprint 317), and a viewpoint's select predicate filters a working set. Those are different objects and only one of them is a UI filter. A reader cannot tell which is meant, and the two produce different offered sets. ALSO ABSENT: how far 'directly interface with' reaches - one hop is the obvious reading and the statement's 'upstream/downstream' hints at direction without distance - and what happens when the scope filter is changed WHILE a creation is in progress, which is the ordinary case in an exploratory surface."; }
    part srViewerScopedAuthoringCompletenessCritiqueR1 : TestResult { :>> id = "274732d3-e20a-43cd-bc50-aaa931b4af75"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerScopedAuthoringCompletenessCritique to srViewerScopedAuthoring;
    verification srViewerScopedAuthoringTestabilityCritique : Test { :>> id = "dc9acb19-67b5-4172-ab81-49ced04ff0ab"; :>> title = "Critique srViewerScopedAuthoring - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on a deterministic property with a clean pair of negative cases: with a scope filter active, require an out-of-scope type NOT to be offered; with no filter, require the full grammar to be available. Both fail loudly on an off-by-one in the adjacency or on a filter that is ignored. The test does depend on a definition of scope (see completeness), so a verification would encode the tester's reading - but unlike the unfalsifiable clauses elsewhere in this corpus, the property itself is sharp once the term is fixed, and fixing the term is a sentence rather than a design."; }
    part srViewerScopedAuthoringTestabilityCritiqueR1 : TestResult { :>> id = "5e8ff3a4-342d-4641-9dc6-b50b4ed29e18"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerScopedAuthoringTestabilityCritique to srViewerScopedAuthoring;
    verification srViewerSearchDiscoveryCorrectnessCritique : Test { :>> id = "a527cde0-745f-4873-b2d6-9962b636e199"; :>> title = "Critique srViewerSearchDiscovery - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "AN ELEMENT WITH A TITLE IS NOT FINDABLE BY ITS NAME, and that is the identifier every computed view prints. The search is scoped to 'displayLabel + id', and view::display_label returns the authored TITLE when present and non-blank, falling back to the name only when it is absent. So titles are searchable - I had assumed otherwise and checked - but the NAME is searchable only for untitled elements. Meanwhile `keel orient`, `whats-next`, `open-issues` and every guard message identify elements by name (dcViewpointEnumeration, srEncodingModular, issue140), and a user who reads one of those and types it into the search finds nothing. The `id` half does not help: it is a UUID, which nobody types. The fix is one word - search displayLabel, name and id - and without it the discovery surface is unreachable from the engine's own output."; }
    part srViewerSearchDiscoveryCorrectnessCritiqueR1 : TestResult { :>> id = "d1aff412-fb92-4666-b31b-d0622f46adb1"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSearchDiscoveryCorrectnessCritique to srViewerSearchDiscovery;
    verification srViewerSearchDiscoveryCompletenessCritique : Test { :>> id = "761e7bbc-57c1-40af-af81-8fd8accf4fdb"; :>> title = "Critique srViewerSearchDiscovery - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'BOUNDED, RANKED' names neither the bound nor the ranking, and both decide whether the feature works. A bound of 10 and a bound of 500 are different products; a ranking by string prefix, by edge degree, by recency, or by type priority puts entirely different elements first, and on a corpus of 8000 items the ranking IS the feature. Compare srEncodingSchemaSemantics' unnamed cap, which ended up living only in the code - the same outcome awaits here. ALSO ABSENT: what the pane shows when the query is EMPTY. The requirement forbids listing the entire model by default and does not say what replaces it, and an empty pane with no affordance is a worse first impression than a list - the obvious answers (recent, focused neighbourhood, obligations) are all defensible and none is stated."; }
    part srViewerSearchDiscoveryCompletenessCritiqueR1 : TestResult { :>> id = "35704e99-7c12-4ea2-b5f8-d65466303862"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSearchDiscoveryCompletenessCritique to srViewerSearchDiscovery;
    verification srViewerSearchDiscoveryTestabilityCritique : Test { :>> id = "3b6d45a6-ec7a-4379-83ee-5bdfc53cf10c"; :>> title = "Critique srViewerSearchDiscovery - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES on its two sharpest clauses, both negative and both mechanical. NOT A FULL DUMP: load the surface with no query and require the returned set to be strictly smaller than the model - it fails the moment someone reinstates the list. SINGLE-TYPE SOLO IN ONE ACTION: require one interaction to constrain to a type, which fails if the only route is toggling the others off one at a time, and that is exactly the friction the requirement was written against. The bound and the ranking are not testable as stated (see completeness), so a verification would assert whatever the implementation chose."; }
    part srViewerSearchDiscoveryTestabilityCritiqueR1 : TestResult { :>> id = "4bc32168-957a-4701-a6cc-0805b8621770"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSearchDiscoveryTestabilityCritique to srViewerSearchDiscovery;
    verification srViewerSystemBoundViewsCorrectnessCritique : Test { :>> id = "3c967ef3-bca8-4081-8e8f-aad9a906dc93"; :>> title = "Critique srViewerSystemBoundViews - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "SIBLING HAS NO BASIS IN THE TYPED GRAPH, and the requirement's own last sentence forbids the only place it could come from. It defines SIBLING as 'same type + shared parent' and then insists these are 'pure computed views over the typed graph (no stored state)'. There is no parent relation in the edge algebra - nothing in schema/core declares containment, and the closest construct is specialization - so shared parent could only mean same package or same FILE. ItemInfo does carry a file, so it is computable, but a file is a storage location rather than a typed edge: two elements are siblings because someone put them in one file, which changes when a file is split and is not a modelled fact. CHILDREN and ANCESTRY are sound (downstream closure and upstream trace over typed edges, which the traversal engine already walks). So two thirds of this requirement rests on the graph and one third rests on the filesystem while claiming otherwise."; }
    part srViewerSystemBoundViewsCorrectnessCritiqueR1 : TestResult { :>> id = "c8ee0673-d7fa-4f5a-97c1-dc0c7bccee7e"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSystemBoundViewsCorrectnessCritique to srViewerSystemBoundViews;
    verification srViewerSystemBoundViewsCompletenessCritique : Test { :>> id = "212eaa47-0ee9-45c1-a25e-da72861ab29f"; :>> title = "Critique srViewerSystemBoundViews - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Two unbounded closures and an unstated interaction. 'CHILDREN (downstream closure)' and 'ANCESTRY (upstream trace)' are transitive with no depth limit, and in this graph a closure from most seeds reaches most of the corpus - the same missing bound that srViewerChangeImpact at least mitigated by grouping results by distance, which this requirement does not. ALSO UNSPECIFIED: what 'a shifting focus' does to the previous view. If focusing a child recomputes all three slices, the user's ancestry context is destroyed exactly when they were following it, and srViewerNavHistory's undo is the only recovery - a coupling neither requirement mentions. AND: 'allow view/modify/critique over each set' quietly implies BULK operations over a computed set, which is a much larger claim than per-element actions and has none of the cost, confirmation or partial-failure semantics such a thing needs."; }
    part srViewerSystemBoundViewsCompletenessCritiqueR1 : TestResult { :>> id = "e6f8eb85-6ac0-48f4-b44f-0bfc2cdd9e70"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSystemBoundViewsCompletenessCritique to srViewerSystemBoundViews;
    verification srViewerSystemBoundViewsTestabilityCritique : Test { :>> id = "7f6babba-0c27-49e2-976c-e1b45aebdc99"; :>> title = "Critique srViewerSystemBoundViews - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "PASSES for two of its three slices, and the split is itself the useful result. CHILDREN and ANCESTRY are deterministic over a fixture with clean negative cases - an unrelated element must not appear, and an element reachable only upstream must not appear in children. SIBLING is testable only once 'shared parent' is defined, and the honest test today would assert same-type-and-same-file, which encodes the filesystem dependency the correctness lens objects to rather than a modelled fact. So a verification of this requirement would pass on two thirds and quietly define the remaining third, which is worth knowing before it is built."; }
    part srViewerSystemBoundViewsTestabilityCritiqueR1 : TestResult { :>> id = "5ddf97ff-2628-4146-bf31-bcb6441ef161"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerSystemBoundViewsTestabilityCritique to srViewerSystemBoundViews;
    verification srViewerVisualViewpointCorrectnessCritique : Test { :>> id = "e408cb69-2b54-46e5-a299-cd85cc75f8ff"; :>> title = "Critique srViewerVisualViewpoint - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT on both of its factual claims, each checked. First, that presentation vocabulary is hardcoded: `keel render` accepts exactly --mode graph|table|review and the mode dispatch is a hardcoded match in view.rs, so the three-fixed-modes complaint is live. Second, and more precisely, that 'viewpoints already declare an audience but cannot use it': the Viewpoint type does carry an audience attribute, and nothing consumes it - the console derives navigation from `surface`, added later under D0154 precisely because audience was free prose and could not group anything. So the requirement accurately identifies both a declared-but-unused attribute and a hardcoded presentation layer. Its 'unknown visual directives fail loud' clause is also the right stance and matches the engine's behaviour elsewhere (an undeclared marker is rejected; an unknown renderer is a violation)."; }
    part srViewerVisualViewpointCorrectnessCritiqueR1 : TestResult { :>> id = "a205d178-72d3-4c1c-af14-cde9d4811c16"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerVisualViewpointCorrectnessCritique to srViewerVisualViewpoint;
    verification srViewerVisualViewpointCompletenessCritique : Test { :>> id = "528074bb-80c3-4f81-bcbd-e4866e97d959"; :>> title = "Critique srViewerVisualViewpoint - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE AUTHORING SURFACE IS AN OPEN QUESTION INSIDE THE REQUIREMENT: 'extend .view.toml / new artifact / presentation layer is open question Q4'. That is the second requirement in this corpus to defer its own substance to an unwritten Decision (srViewerDatePredicates defers its predicate bound to Q3, and no such Decision exists either), and the consequence is the same structural gap: the engine can express BLOCKED WORK - an action with a #DependsOn to a proposed Decision drops off the ready frontier and shows in pendingAcceptances - and cannot express a BLOCKED REQUIREMENT, so this reads as an ordinary uncovered requirement rather than one waiting on a decision nobody has made. ALSO ABSENT: any vocabulary for the visual form itself. 'Layout/grouping/styling' names three categories and no members, and its sibling N-18/srEncodingSpec family defines channel bindings that would serve - the overlap is unstated in both directions."; }
    part srViewerVisualViewpointCompletenessCritiqueR1 : TestResult { :>> id = "9e19efd0-9080-4863-99c2-0afa91c567ee"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerVisualViewpointCompletenessCritique to srViewerVisualViewpoint;
    verification srViewerVisualViewpointTestabilityCritique : Test { :>> id = "2643a5cc-e9e3-4983-b5d7-66ad33e42e06"; :>> title = "Critique srViewerVisualViewpoint - testability (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::testability; :>> procedureText = "One clause is testable and the requirement's substance is not. TESTABLE, and worth writing: 'unknown visual directives fail loud' - author a viewpoint with a nonsense directive and require a loud failure rather than a silent default, which is a real negative case and matches how the engine treats an undeclared marker. NOT TESTABLE: 'a chosen VISUAL form targeting its named audience, rendered accordingly'. Accordingly to what? With no form vocabulary and no authoring surface (see completeness), a verification can only assert that SOMETHING rendered, and the audience half has no observable at all - nothing distinguishes a view rendered for an auditor from the same view rendered for a maintainer. Fixing this needs the Q4 decision, not better wording."; }
    part srViewerVisualViewpointTestabilityCritiqueR1 : TestResult { :>> id = "3e22b3e5-1e98-426e-804b-5e7bda3b146c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "cd1637e"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from srViewerVisualViewpointTestabilityCritique to srViewerVisualViewpoint;

    // == Element-critique backfill pass 10, 2026-08-17 (sprint 334). First DECISION pass: five Decisions x
    // the Decision lens set (completeness / correctness / feasibility, critique-policy.toml). Decisions are
    // gated only once accepted, so every target here is in force. INDEPENDENT: authors are wweatherholtz and
    // claudeOpus; the judge is claudeOpus5.
    verification d0105FeasibilityCritiqueOpus5 : Test { :>> id = "3394f9cc-0712-43bf-8249-6004cec82828"; :>> title = "Re-critique d0105 (earlier critique stale, D0084) - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "ITS CENTRAL ESTIMATE WAS WRONG AND ITS OWN SUCCESSOR SAYS SO. D0105 claimed EdgeRule 'subsumes the ~9 conformance guards' and ElementRule 'subsumes the ~5 structural guards'; D0107 records the outcome - about 5 cleanly migrated, the rest are bad-fit and stay Rust - and states outright that 'D0105's ~9 of 14 collapse headline is corrected'. TWO FURTHER CLAUSES WERE NEVER BUILT, measured: clause (c) promises 'a META-RULE caps scope-predicate growth (a new scope predicate requires a justifying rule)' and rules.sysml declares no such meta-rule, so the growth cap the Decision relied on does not exist; clause (d) promises 'a CLOSED RMWX verb axis (read/record/modify/execute) ... replaces the per-type write verbs' and keel record still accepts exactly two per-type verbs with no modify or execute subcommand. The flat-code-growth criterion also failed in the observable direction: guards have gone from 14 to 35 since. THE MECHANISM ITSELF IS ALIVE, which is the fair counterweight and why this is a feasibility failure rather than a wrong direction - eight declared rules now exist, three of them added AFTER D0107's five."; }
    part d0105FeasibilityCritiqueOpus5R1 : TestResult { :>> id = "0d2d6e95-96ee-4d0c-ad0d-f57b3140c607"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0105FeasibilityCritiqueOpus5 to d0105;
    verification d0105CompletenessCritiqueOpus5 : Test { :>> id = "3b022364-5d8d-4fea-9b36-f0ddf020c1b8"; :>> title = "Re-critique d0105 (earlier critique stale, D0084) - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "NO TEST FOR A BAD FIT IN ADVANCE, which is what made the migration cost what it did. The Decision proposes three rule kinds and a scope sub-language and identifies scope as 'the load-bearing complexity', but it gives no criterion for deciding BEFORE attempting whether a given guard is expressible - so fitness was discovered by trying, eight times, and D0107 had to be written to stop. A single stated test (does the check need relational set-ops, external files, git history, or prose judgment?) would have classified the eight bad fits on paper; D0107's own rejection list is exactly that test, written afterwards. ALSO ABSENT: any statement about NEW controls. The Decision is entirely about collapsing EXISTING guards and says nothing about whether a newly-discovered defect should become a declared rule or a Rust predicate - so the default stayed Rust, and 27 of the 35 current guards are bespoke predicates that the mechanism was built to avoid."; }
    part d0105CompletenessCritiqueOpus5R1 : TestResult { :>> id = "04a43b71-5d08-40a2-abe0-02c5af423468"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0105CompletenessCritiqueOpus5 to d0105;
    verification d0105CorrectnessCritiqueOpus5 : Test { :>> id = "82735cae-e7af-475f-b13e-7ba689320a58"; :>> title = "Re-critique d0105 (earlier critique stale, D0084) - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and its alternatives analysis is the best in the corpus - which is worth recording separately from the feasibility failure, because a decision can reason correctly and estimate badly. It rejects TOML-declared rules with three specific reasons that have all since proven true in this repository (a second store drifts; no typed provenance edge; opaque to critique, suspicion and coverage), and the two contract TOMLs that remain - critique-policy and attestation-policy - are precisely the cases it carved out as pure execution parameters referenced BY a rule rather than governance. Its stated reason for the whole direction also held: because keel is a reusable multi-project engine, a downstream project can declare its own rules and get enforcement free, and that payoff is real and is why the mechanism outlived the estimate. The FORK #1 resolution (rules as SysML elements, not TOML) was correct on the engine's own invariants."; }
    part d0105CorrectnessCritiqueOpus5R1 : TestResult { :>> id = "44476309-5601-402a-a2e4-3e20a9dc0418"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0105CorrectnessCritiqueOpus5 to d0105;
    verification d0106CorrectnessCritique : Test { :>> id = "927b24aa-67f4-449c-b81a-81e91f2f3306"; :>> title = "Critique d0106 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "ITS LOAD-BEARING CLAUSE IS UNENFORCEABLE AND THE ENGINE HAS SINCE ADMITTED IT. D0106 requires a VISIBLE enumerated parse at the start of every response and states that 'no action is proposed or taken that is not tied to a process'. D0151 records that this clause has NO control behind it, because no gate can read conversational output - the Parsed block is a property of what the AI SAYS, and every gate in this engine reads the model or the tree. The history is the evidence: D0130 had to move the response contract out of CLAUDE.md into the system-prompt output style precisely because context injection was demonstrably ignored (issue084/085), and even there the Stop hook can only check that the MODEL is honest, not that the response was parsed. So the Decision's strongest sentence is aspiration, and a reader auditing compliance has nothing to read. That does not make it a bad decision - a stated norm with no gate still shapes behaviour - but the statement should say which of its five clauses are ENFORCED (the trivial-fast-path labelling is not; the sign-off gate IS, via method=confirmation TestResults) rather than presenting all five as equally binding."; }
    part d0106CorrectnessCritiqueR1 : TestResult { :>> id = "a0d3f139-ca17-409f-aa91-229d7d8a3c9c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0106CorrectnessCritique to d0106;
    verification d0106FeasibilityCritique : Test { :>> id = "ab4d3710-b37f-49ab-b923-40f0affcd681"; :>> title = "Critique d0106 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "CLAUSE (3) HAS NEVER HAPPENED. It requires executing the routed process set 'in PARALLEL where the dependency DAG allows, leveraging skills where practical', and nothing in this engine schedules parallel process execution: the frontier is a RANKED list (declaration order is priority, D0052), sprints run one at a time, and no view computes a dependency DAG over ready work. Nothing tracks the omission either - there is no indicator for it, so a clause of an accepted Decision has been inert since it was written with no record of that. The other four clauses are feasible and three are in daily use. The honest repair is small: either drop the parallel clause, or root it in something that could exist (a computed independent-work set), because as written it is the one part of a live process definition that no one has ever executed and no one would notice."; }
    part d0106FeasibilityCritiqueR1 : TestResult { :>> id = "6e5dcf91-2b34-40f4-8855-243b1172492e"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0106FeasibilityCritique to d0106;
    verification d0106CompletenessCritique : Test { :>> id = "33631ca5-fe4c-44a6-b6af-c32052124072"; :>> title = "Critique d0106 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "NOTHING SAYS WHAT HAPPENS WHEN THE PARSE IS WRONG, and a mis-parse is the failure this Decision's whole first clause exists to expose. If the human corrects a routing, that correction is: (a) evidence the classification is ambiguous, (b) possibly a defect in a process definition, and (c) invisible - no mechanism records it, so the same mis-parse recurs with nothing accumulating. THIS SESSION SUPPLIES A CONCRETE INSTANCE: four options offered for issue132 were all framed around the wrong object, the human's answer named a different one, and only a sprint record captured that - not the model. ALSO ABSENT: what counts as trivial. The Decision names three examples (a typo, a single rename, one doc line) and gives no boundary, so the fast-path's width is set by whoever is using it, which is the one place a labelled exemption can quietly widen."; }
    part d0106CompletenessCritiqueR1 : TestResult { :>> id = "2a9455e3-af6e-4b6d-8947-ee5a3fc30292"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0106CompletenessCritique to d0106;
    verification d0107CorrectnessCritique : Test { :>> id = "c68f148f-bba6-4403-8f68-aec7d54292f4"; :>> title = "Critique d0107 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and it is a model of what a correcting Decision should look like. It invokes D0105's own rollback criterion rather than inventing an escape, states the corrected number plainly ('~5 cleanly migrate; the rest are bad-fit and stay Rust'), explicitly rewrites its predecessor's headline rather than leaving both numbers in circulation, and keeps the part that earned its keep (the mechanism, whose payoff is downstream projects declaring their own rules) while stopping the part that did not. Its rejection of alternative (i) - forcing the bad fits into new predicate kinds - names the inner-platform risk that D0105 itself had warned about, which is the rare case of a Decision holding its predecessor to its own stated guardrail. The CONTRACT clause is also verifiable and holds: guard issues sources its violations from rule_violations_opt on issuesTriagedRule rather than from a bespoke predicate."; }
    part d0107CorrectnessCritiqueR1 : TestResult { :>> id = "93fce4ab-2f3a-4e42-a7bd-20fdfccde335"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0107CorrectnessCritique to d0107;
    verification d0107CompletenessCritique : Test { :>> id = "1a62e6d7-df3d-4897-a752-1f35ad033d42"; :>> title = "Critique d0107 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'INDEFINITELY' WITH NO REVIEW TRIGGER IS HOW A PARTIAL MIGRATION BECOMES PERMANENT. Clause (3) says the bad-fit guards stay Rust 'indefinitely ... re-evaluated for rule-migration only if a fitting rule kind emerges', and names no owner, no cadence, and no signal that would constitute emergence - so nothing will ever prompt the re-evaluation. THE BIGGER OMISSION IS THE FORWARD DEFAULT: D0107 settles the fate of the EXISTING guards and says nothing about NEW ones, so every defect found since has become a Rust predicate by default. Measured today: 8 of 35 guards are rule-backed, and this session alone added two bespoke ones (resolver-kind, stale-gate-prose) without either being considered as a declared rule. A single sentence - a new control is a declared rule unless it needs relational, external, git or prose judgment - would have made the default the other way round."; }
    part d0107CompletenessCritiqueR1 : TestResult { :>> id = "d17bba55-9667-4d6f-8e59-6a531adf790c"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0107CompletenessCritique to d0107;
    verification d0107FeasibilityCritique : Test { :>> id = "c846e386-3297-4a7f-8c12-b96c005909dc"; :>> title = "Critique d0107 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, demonstrated rather than argued: the Decision was executed and its mechanism has outgrown its own number. Five rules were migrated and contracted as promised, and three MORE have been declared since (decisionNoVerdictProseRule, confirmationAuthenticityRule, researchSpikeCharterRule), so eight declared rules now exist and the declarative path is in live use for new governance checks - which is the strongest available evidence that the partial migration banked the right half. The count in D0107's text is now stale at five, which is a small cost of stating a number rather than a criterion, and the direction of the staleness is the favourable one."; }
    part d0107FeasibilityCritiqueR1 : TestResult { :>> id = "22f63686-6836-4b39-b385-92cb179f5ec2"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0107FeasibilityCritique to d0107;
    verification d0108CorrectnessCritique : Test { :>> id = "ccf1cd57-591b-4562-9e6b-823a5e0540f4"; :>> title = "Critique d0108 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CLAUSE (4) MANDATES THE ONE OPERATION A LATER DECISION FORBIDS. D0108 says that where two threads must edit the same file region, 'the second rebases on the first (git), never force-overwrites'. D0129 forbids rebasing outright and explains why in terms this engine cannot ignore: rewriting SHAs means the rewriting machine still resolves them as loose objects and reports GREEN while every other clone reports invalidEvidence - a passing TestResult counts as done only while its judgedAgainst SHA resolves, so a rebase orphans evidence and makes `orient` machine-dependent. Rebase-merge, history rewriting and force-push are now disabled on the remote and never performed locally on commits carrying recorded evidence. So two accepted Decisions give opposite instructions for the same situation, and the earlier one is still readable as current guidance. The rest of D0108 is sound and in daily use; this one clause needs superseding, and the correct answer is already known - integrate by MERGE."; }
    part d0108CorrectnessCritiqueR1 : TestResult { :>> id = "593889ca-14a4-4a6b-99ea-121b4a546c5f"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0108CorrectnessCritique to d0108;
    verification d0108CompletenessCritique : Test { :>> id = "f340e5bc-caee-4597-9e67-38806e132af5"; :>> title = "Critique d0108 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "OWNER-OF-RECORD IS STATED AND NOT DETECTABLE. Clause (1) says only the owner edits an item's fields, and nothing computes a violation: there is an ownership guard in the enforced set, but the protocol offers no way to tell an owner's edit from a non-owner's after the fact, because a diff shows what changed and not who was permitted to change it. The rule therefore rests on the actor honouring it - and D0047 says manual vigilance is not a control. ALSO ABSENT: what happens when the OWNER IS UNAVAILABLE. This session met that case squarely - a Need owned by the human blocked its own correction for two days - and the protocol has no delegation, timeout or hand-off path, so a correct change waits on a person rather than on a decision. The resolution used (propose a Decision, let blocked-on-acceptance hold the work) is a good pattern that D0108 does not contain."; }
    part d0108CompletenessCritiqueR1 : TestResult { :>> id = "a48d7a5b-435e-4d0f-81d8-7053ec126eed"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0108CompletenessCritique to d0108;
    verification d0108FeasibilityCritique : Test { :>> id = "178ca221-471c-44ea-9594-2b30af600efe"; :>> title = "Critique d0108 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, and its feasibility argument was the right one: it needs NO NEW MECHANISM, only a stated rule over the grain the engine already had - typed edges, append-only results, supersede-don't-mutate, human-gated decisions. That is why it survived contact with practice while D0105's more ambitious mechanism did not. The evidence is in this repository's shape: issues.sysml and backlog.sysml are appended to rather than rewritten, supersession rather than editing is how every Need and Decision has been changed (N-8, D0114, D0115's four Needs), and every conflicting conclusion this session produced was recorded as an Issue for the human. Clause (4)'s rebase instruction is wrong (see correctness) but the protocol's core is demonstrably workable, which is the question this lens asks."; }
    part d0108FeasibilityCritiqueR1 : TestResult { :>> id = "0be0edcc-10a9-466e-be32-ed3446a6e20a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0108FeasibilityCritique to d0108;
    verification d0109CorrectnessCritique : Test { :>> id = "4762a891-308f-42a6-a429-8cb2f691a4c2"; :>> title = "Critique d0109 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "ITS TITLE STILL SAYS PROPOSED WHILE ITS STATUS IS ACCEPTED, and that is not a nit in a system whose state is computed: the title reads 'D0109 (PROPOSED): agent discipline via action-space constraints' and the status field is accepted, so a reader who trusts the human-facing string believes an in-force Decision is still under consideration. This is the same defect class as the six stale gate comments found in sprint 328 (issue140), where prose frozen at authoring time contradicted the record beside it and misled me into publishing a false claim - and the new stale-gate-prose guard cannot catch this one, because it keys on comments near acceptance results rather than on a title contradicting its own status field. SECOND, SMALLER: the rationale justifies accepting friction 'single-user tool by the human's statement', and D0158 has since restated that boundary as one bound actor per machine with collaboration by git - the console is what is local-only. The reasoning survives the restatement; the phrase does not."; }
    part d0109CorrectnessCritiqueR1 : TestResult { :>> id = "1486c6b2-768f-447d-9615-3bdd655c11e9"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0109CorrectnessCritique to d0109;
    verification d0109FeasibilityCritique : Test { :>> id = "80363988-212e-493b-a736-447903a58023"; :>> title = "Critique d0109 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "CLAUSE (3) IS CONTRADICTED BY THE WAY THIS ENGINE IS ACTUALLY WORKED. It prescribes 'short single-purpose context decomposition (agents drift with long/diffuse context)' as one of four discipline levers, and the productive mode here has been the opposite: this session ran seventeen consecutive sprints in one continuous context, and the continuity is what made the work possible - a cross-Need collision, a stale-comment defect and two self-corrections were each found by carrying earlier findings forward, and a decomposed launch would have discarded exactly that. The causal claim is also unevidenced: the observed drift control in this engine is not context size but the computed frontier and the gates, since the agent re-reads state rather than remembering it. Clauses (1), (2) and (4) are feasible and partly built (the launcher, schema-validated output, engine-triage); clause (3) is the one that practice has falsified, and nothing records that."; }
    part d0109FeasibilityCritiqueR1 : TestResult { :>> id = "695c400f-5a0b-4213-a688-74bab545ac83"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0109FeasibilityCritique to d0109;

    // == Pass 10 completion: d0109's completeness lens, omitted from the batch above (14 critiques written
    // where 15 were owed, so d0109 stayed uncovered until this was added).
    verification d0109CompletenessCritique : Test { :>> id = "a12f7cbb-4ff9-4b8c-9261-f29ab8627b3d"; :>> title = "Critique d0109 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE RESIDUAL IT CLAIMS TO CLOSE STAYS OPEN FOR THE MODE THAT DOES THE WORK, and the Decision does not say so. Clause (1) asserts that a process-launcher which shows the parse and requires approval-before-execute 'STRUCTURALLY closes D0106's conversational residual that a commit gate cannot (issue059)'. That is true of work LAUNCHED THROUGH keel serve, and it is exactly false of an agent working in a terminal - which is how essentially all of this repository's work has been done, including every sprint in this session. For that path there is no launcher, no approval step, and no observable: D0151 records that no gate can read conversational output. So the Decision's central claim is scoped to a surface it does not name, and a reader concludes the residual is closed when it is closed for one of two execution paths. ALSO ABSENT: any acceptance bar. Four levers are ordered hard to soft with no statement of how much discipline is enough, so no future observation could show the direction had succeeded or failed - and clause (3) has since been falsified by practice with nothing recording it."; }
    part d0109CompletenessCritiqueR1 : TestResult { :>> id = "b1127bdd-b3b2-4c68-89bb-db25c71942ac"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "3fb4e2d"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0109CompletenessCritique to d0109;

    // == Element-critique backfill pass 11, 2026-08-17 (sprint 335). Five Decisions x completeness/correctness/feasibility.
    // INDEPENDENT: authors are wweatherholtz and claudeOpus; the judge is claudeOpus5.
    verification d0110FeasibilityCritique : Test { :>> id = "c5737414-6085-4988-8f31-e9353b28923e"; :>> title = "Critique d0110 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, and every element of the stack it promised exists in the tree. The process file is present (.engine/processes/decision-authoring.sysml) and it is NON-INERT because the deploying skill is registered (.engine/skills/decision-authoring/SKILL.md), which is what the process-skill guard checks. Both automated backstops are real: guard confirmation-authenticity is in the enforced set, and decisionNoVerdictProseRule is one of the eight declared rules in rules.sysml. So the Decision's enforcement claim is not aspirational - a reader can point at each of the three layers. That is unusual in this corpus: several Decisions promise a mechanism and one or two clauses turn out never to have been built, and this one delivered all of it."; }
    part d0110FeasibilityCritiqueR1 : TestResult { :>> id = "11ffce37-b114-40b4-b415-7d41462c3e6d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0110FeasibilityCritique to d0110;
    verification d0110CorrectnessCritique : Test { :>> id = "852b352c-6ebc-48c2-a2ae-fce95d8c94c9"; :>> title = "Critique d0110 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT, and its rejection of alternative (i) is the sharpest sentence in it: 'guidance is a linter, ignorable; the defect already slipped past it'. That is the right diagnosis of why issue058 recurred, and it names the general principle D0047 later generalised - a correction that could recur must become a control rather than a reminder. Its rejection of (ii), a guard alone, is equally right and less obvious: a guard checks artifacts while the DISCIPLINE of authoring is a sequence to be followed, so the two are complements rather than alternatives. The composed stack (carried-out process + artifact guard + prose detector) attacks the defect at three different points, and each point is where that kind of check can actually see something."; }
    part d0110CorrectnessCritiqueR1 : TestResult { :>> id = "e9cc3393-ca68-4fbc-9185-d926e65a14fc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0110CorrectnessCritique to d0110;
    verification d0110CompletenessCritique : Test { :>> id = "23a2b06c-3a72-4986-8fff-44752ecc0453"; :>> title = "Critique d0110 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "NOTHING TIES A GIVEN DECISION TO THE PROCESS. The process is deployed and non-inert, which means it EXISTS and is reachable - not that it was FOLLOWED for any particular Decision. There is no per-Decision record of having run it, no edge from a Decision to the process that authored it, and therefore no way to compute how many Decisions were authored under it. Compare a delivery sprint, which carries #CharteredBy to its governing Decision and gate results per phase: the process discipline there is auditable per instance, and here it is not. ALSO ABSENT: what happens when the prose detector fires on a legitimate Decision. decisionNoVerdictProseRule is a text heuristic over prose, so false positives are certain eventually, and the Decision names no exemption path - which for a rule at blocking severity would mean editing the rule or rewording a truthful Decision to appease it."; }
    part d0110CompletenessCritiqueR1 : TestResult { :>> id = "f35a10ab-645b-4db8-8f5d-b5e4bdba11d0"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0110CompletenessCritique to d0110;
    verification d0111CorrectnessCritique : Test { :>> id = "e4427a18-f6ef-47ed-a5f3-faf4d3e1acf5"; :>> title = "Critique d0111 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and it is the most honest implementation record in the corpus. It documents a widening DISCOVERED DURING IMPLEMENTATION - the first cut allowed Issue and Decision only and spuriously flagged sr19SpikeStory, a legitimate spike chartering to a SystemRequirement - and then classifies that widening correctly: 'corrected to match D0068, not a scope change'. Distinguishing a correction-to-intent from a scope change is exactly the judgment that keeps a Decision trustworthy, and most records in this corpus would simply have widened the list silently. It also routes the check through the DECLARED rules path rather than a bespoke Rust guard, citing issue055's own instruction and D0105's direction, which is the engine's stated preference actually being honoured rather than cited."; }
    part d0111CorrectnessCritiqueR1 : TestResult { :>> id = "e88f6585-f2f9-4cd3-8dfe-22d4df08834c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0111CorrectnessCritique to d0111;
    verification d0111FeasibilityCritique : Test { :>> id = "a27921ac-70ef-4756-a012-c0bcc885d5ab"; :>> title = "Critique d0111 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, demonstrated: researchSpikeCharterRule is one of the eight declared rules in .engine/rules/rules.sysml, and the two evaluator additions it needed - a whereKind(v) scope mirroring whereStatus, and a charterTargetType(T1,...) predicate term - were both small and both landed. That is the D0105 mechanism working as intended and is part of why the declarative path outlived D0105's own collapse estimate: three rules including this one were declared AFTER D0107 recorded the migration as partial. The Decision also chose the achievable severity (warning) over the ambitious one, which is why it shipped."; }
    part d0111FeasibilityCritiqueR1 : TestResult { :>> id = "79d42e22-4a34-4f38-93ce-c9e0eb5900b4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0111FeasibilityCritique to d0111;
    verification d0111CompletenessCritique : Test { :>> id = "8707a739-c42d-4a99-a80d-5b244d4872a3"; :>> title = "Critique d0111 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "'PROMOTE TO A HARD GUARD ONCE PROVEN LOW-NOISE' HAS NO CRITERION, NO OWNER AND NO TRIGGER - AND MEASURED ACROSS THE CORPUS, NO SUCH PROMOTION HAS EVER HAPPENED. At least three Decisions use this construction (the D0102 precedent this one cites, D0113's doc-sync guard, and this rule), 9 of the 35 current guards remain warning-only, and no Decision anywhere in .engine/decisions records a warning-to-hard promotion event. So the pattern is not a staged rollout, it is a permanent resting place - which matters because a warning-level control that will never gate is a reminder, and D0047 states that manual vigilance is not a control. Fixing it is one sentence per Decision: promote after N commits with zero false positives, or record why not. Without that, warning-first is indistinguishable from warning-forever, and the Decision cannot tell which it chose."; }
    part d0111CompletenessCritiqueR1 : TestResult { :>> id = "ac5f3129-70f8-4c42-89f8-5c63f239a5df"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0111CompletenessCritique to d0111;
    verification d0112CorrectnessCritique : Test { :>> id = "576f3be4-3d4a-4d83-a647-6a65019daaf5"; :>> title = "Critique d0112 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "ITS DECISION TEXT SAYS IT IS NOT ACCEPTED AND ITS STATUS SAYS IT IS. The decision field opens 'PROPOSED direction (Option C of the spike, not yet accepted)' while the status field reads accepted - so the two authoritative parts of one element contradict each other, and the prose is the half a reader trusts. This is the SECOND instance of the class in two passes (d0109's title still says '(PROPOSED)') and the THIRD in this session counting issue140's six stale gate comments, where prose frozen at authoring time contradicted the record beside it and misled me into publishing a false claim. The guard added for issue140 cannot catch either Decision: it keys on comments adjacent to a passing acceptance result, not on a Decision's own text contradicting its own status field - which is a narrower control than the defect class it was written for."; }
    part d0112CorrectnessCritiqueR1 : TestResult { :>> id = "1514533c-9fb1-42ad-9026-9ad6ac2c82eb"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0112CorrectnessCritique to d0112;
    verification d0112FeasibilityCritique : Test { :>> id = "0d4640a5-8c50-4e1f-8e9c-e24dc56e8b28"; :>> title = "Critique d0112 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, and it is the clearest case of a direction fully carried out in this corpus - all three clauses landed. Clause (2) is visible in every gate run: `keel check-engine` reports '.engine instance files validated clean (kernel-free; D0112 phase 2)', which is the extended cross-file reference resolver the Decision asked for, running with no JVM. Clause (3) landed as well: the kernel is now opt-in behind KEEL_KERNEL_VALIDATE=1 (D0132/issue081), demoted exactly as proposed. And the Decision's central judgment was vindicated rather than merely executed - it explicitly REJECTED full Rust reimplementation of SysML semantics as premature, and the residual it kept the kernel for is precisely what the conformance lane now measures as an indicator rather than a gate."; }
    part d0112FeasibilityCritiqueR1 : TestResult { :>> id = "b7338c22-914d-4f8a-9596-605340efb34a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0112FeasibilityCritique to d0112;
    verification d0112CompletenessCritique : Test { :>> id = "9f010239-0415-47b9-900b-c9678ef12ecd"; :>> title = "Critique d0112 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE RETIRE-FULLY OPTION IT PRESERVES HAS NO MEASUREMENT. Clause (3) keeps the kernel as a deep-semantics backstop and the Decision states that full retirement 'stays a later step contingent on measuring that the kernel-only residual catches nothing real'. Nothing measures that: the conformance lane reports what the kernel REJECTS (tracked as conformanceIndicator), which is the opposite quantity - it counts what the kernel finds, not whether any of it was real, and a rejection may be the pilot kernel's own gap rather than a defect in this model. So the contingency that would justify the final step cannot be evaluated as written, and the honest version would name the observable: N consecutive releases in which no kernel-only finding led to a change. ALSO ABSENT: what happens if the kernel becomes unavailable - it is opt-in and JVM-bound, and nothing states whether an unrunnable backstop is an accepted risk or a blocker."; }
    part d0112CompletenessCritiqueR1 : TestResult { :>> id = "fbc4a1af-7769-4066-b99b-65794c24a651"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0112CompletenessCritique to d0112;
    verification d0113FeasibilityCritique : Test { :>> id = "2237c2ef-160c-45fd-b420-b4a5289e59ec"; :>> title = "Critique d0113 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES: the doc-sync guard exists in guards.rs, is warning-level as specified, and reuses the staged-files git mechanism the Decision named rather than inventing a new one - which is why it was cheap enough to actually ship. Its narrow scope was also honoured rather than quietly widened: the check fires on staged changes to the definitional trio and excludes tool .rs code and skills, exactly as written. The mechanism reuse is the feasibility argument and it held, in the same way D0108's did: a Decision that needs no new machinery tends to get built."; }
    part d0113FeasibilityCritiqueR1 : TestResult { :>> id = "183af725-61bc-42f7-9719-0de8f11f74ea"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0113FeasibilityCritique to d0113;
    verification d0113CorrectnessCritique : Test { :>> id = "63fcf973-83c0-491b-a623-c2e059342574"; :>> title = "Critique d0113 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "CORRECT, and its self-assessment of its own limits is what makes it so: 'a mechanical check can't know a doc CLAIM is stale, only that a definitional change shipped with no doc touch'. That is precisely the guard's power and its ceiling, stated in the Decision rather than discovered later, and it is why warning-level is the right severity here where it would be wrong for a well-formedness check. THE SESSION SUPPLIES A LIMIT CASE THAT CONFIRMS THE STATED CEILING: sprint 328 found six comments asserting gates were PENDING beside their own passing acceptance results - stale doc CLAIMS inside model files - and doc-sync could not have caught any of them, because each stale comment shipped in a commit that touched no definitional artifact. The Decision predicted exactly that blind spot."; }
    part d0113CorrectnessCritiqueR1 : TestResult { :>> id = "23802df3-4f1b-4c42-9582-e73b1251e666"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0113CorrectnessCritique to d0113;
    verification d0113CompletenessCritique : Test { :>> id = "6c8421cc-3b2c-4633-ac22-8abe8da17288"; :>> title = "Critique d0113 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "TWO DEFERRALS, NEITHER WITH A TRIGGER. 'Promotable to a hard gate once proven low-noise' and 'widen once proven' both leave the criterion, the owner and the signal unstated - and measured, no control in this repository has ever been promoted from warning to hard, so both deferrals have the same practical meaning as never. The scope deferral is the more consequential of the two: excluding tool .rs code means the largest source of doc-invalidating change is outside the check, and this session is the evidence - every guard added (resolver-kind, stale-gate-prose) required a manual doc-sync of guards.md and CLAUDE.md's guard count, and the control that exists to catch a forgotten doc-sync was structurally incapable of seeing those commits. That is not an argument for widening it blindly; it is an argument that the Decision should say what would trigger the widening."; }
    part d0113CompletenessCritiqueR1 : TestResult { :>> id = "85320098-b69b-4150-9bbe-cdb1bbff4ff2"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0113CompletenessCritique to d0113;
    verification d0116CorrectnessCritique : Test { :>> id = "8ddcc2ad-d869-44c0-8b3e-d680a8bddb20"; :>> title = "Critique d0116 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and its central move is the best kind available to a Decision: it declines to build a state nobody asked for. All three offered alternatives assumed a due-or-overdue concept, the human did not want one, so rather than picking the least bad option it rejected the shared premise and redefined the capability as TIME-AS-QUERY-FILTER over date facts that already exist (judgedAt and friends). That is faithful to the engine's own invariants in two ways it names - not computing or storing a state the user does not need, and not authoring a due date that would then drift - and it collapses one Need into another already-accepted one rather than adding machinery. Superseding N-3 outright, and removing its requirement, satisfy edge and backlog action as moot, is the correct disposal rather than leaving a dangling capability."; }
    part d0116CorrectnessCritiqueR1 : TestResult { :>> id = "469af504-8b7e-4eb3-84a9-4fd2124f70a5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0116CorrectnessCritique to d0116;
    verification d0116FeasibilityCritique : Test { :>> id = "a51bd843-52da-4fe7-a811-c47486542480"; :>> title = "Critique d0116 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "IT DELEGATES ITS ONLY DELIVERABLE TO A CLAUSE THAT IS STILL UNSETTLED. The temporal capability is redefined as served by N-5, whose date and range predicates the Decision treats as 'already accepted' - and N-5's own bound is an open question (Q3) with no follow-on Decision written, while its derived requirement srViewerDatePredicates carries the same hedge ('and likely OR'). So the capability D0116 retires has been re-based onto a capability that cannot yet be verified, and a reader tracing whether temporal filtering works ends at an unwritten Decision. The partial good news, which I checked rather than assumed: a DateFilter with since and until IS implemented and wired into /api/slice, and D0075's accepted select-predicate form already lists time-range - so the substance exists on one path even though its acceptance boundary does not."; }
    part d0116FeasibilityCritiqueR1 : TestResult { :>> id = "9b3dd6f6-82a6-4c22-8be7-5c4be3e17ae4"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0116FeasibilityCritique to d0116;
    verification d0116CompletenessCritique : Test { :>> id = "391df477-7f6f-449b-acce-0e5f8d8a68a8"; :>> title = "Critique d0116 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "NOTHING SAYS WHAT THE SUPERSEDED CONCERN LEAVES BEHIND. Dropping due and overdue is right, and the Decision does not address the question that motivated N-3 in the first place: how a stakeholder notices that something has gone TOO LONG without attention. Time-as-query-filter answers it only for someone who thinks to ask - 'not reviewed since DATE' requires choosing a date and running a query - whereas a due state pushed it. The engine has since built the pushing half for one case (the authority queue reports how long each item has waited, and escalates after 14 days), which is exactly a computed staleness signal without an authored due date, and that pattern is the missing clause here. ALSO ABSENT: which date attributes are queryable. 'judgedAt etc.' names one and gestures at the rest, and the set matters - createdAt, judgedAt and completedAt answer entirely different questions."; }
    part d0116CompletenessCritiqueR1 : TestResult { :>> id = "11248dec-d5c0-409a-9fb7-d0cf78c6f1f5"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "db044d4"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0116CompletenessCritique to d0116;

    // == Element-critique backfill pass 12, 2026-08-17 (sprint 336). Five viewer-programme Decisions x
    // completeness/correctness/feasibility. INDEPENDENT: authors are wweatherholtz and claudeOpus; judge claudeOpus5.
    verification d0117CorrectnessCritique : Test { :>> id = "1440b9a9-3102-47ec-9339-c3cddbf089a3"; :>> title = "Critique d0117 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and its division of labour is the part that has held up: keel's job is to EXPOSE the declared model machine-readably and the viewer's job is to generate itself from that. Both halves are real - /api/schema returns declared types with their attribute fields and enum members, /api/launchables returns the actionable set - so the Decision drew the seam in the right place rather than asserting a property of a UI it did not own. Its rejection of alternative (ii), generating from a fixed template that ignores the schema, is also the non-obvious one and the right call: a generator that does not read real attributes and constraints produces forms that look generated and are wrong. The premise it rests on is this engine's own - the UI should follow the model the way keel's declared views and launchables already do."; }
    part d0117CorrectnessCritiqueR1 : TestResult { :>> id = "14b20be3-10b7-4145-b3ae-aa013647bca4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0117CorrectnessCritique to d0117;
    verification d0117FeasibilityCritique : Test { :>> id = "31adef80-f3f3-4bec-b022-b4069b279628"; :>> title = "Critique d0117 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "THE READ HALF IS BUILT AND THE MANIPULATE HALF IS NOT, and the Decision's own words claim both. It states that adding an attribute or an item type 'makes it viewable + manipulable with no viewer code change'. Viewable is true and demonstrable: view::item_detail returns any item's type, attributes and typed edges from one computation, and /api/schema exposes the declared types. Manipulable is not: `keel record` accepts exactly two verbs (decision, issue), each with its own hardcoded required-flag list, so a NEW item type arrives with a generic read path and NO write path at all - and the missing half lives in the ENGINE, which is precisely the side this Decision assigns to keel. So the clause that names keel's own job is the one only partly delivered, and nothing in the model records that."; }
    part d0117FeasibilityCritiqueR1 : TestResult { :>> id = "88bd5c04-8259-4d58-bf6f-855285d25a70"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0117FeasibilityCritique to d0117;
    verification d0117CompletenessCritique : Test { :>> id = "fc6c1a83-8571-4687-a689-616453709e8f"; :>> title = "Critique d0117 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "Silent on the case that is now the normal one: a declared type the write API cannot reach. Since /api/schema advertises every declared type while the write surface covers two, most types fall in the gap - and the Decision does not say whether the generated UI shows them read-only, hides the action, or offers one that fails. The engine's answer everywhere else is to REPORT the gap (the obligation bar shows NOT COUNTABLE with the unbound command named; unit.toml names what a receiving binary lacks), and that is what should be required here. ALSO ABSENT: how a generated form knows an attribute's CONSTRAINTS rather than just its type. A Timestamp, an enum and a free-text String are three different inputs, and 'nothing hardcoded per field' forbids the obvious per-field answer without supplying a derivation - the attribute-kind semantics that D0120 later adds are exactly what was missing here."; }
    part d0117CompletenessCritiqueR1 : TestResult { :>> id = "6eabf298-7743-42af-85b4-ec1fb135f1cb"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0117CompletenessCritique to d0117;
    verification d0118FeasibilityCritique : Test { :>> id = "7933c2a0-6ced-4d3a-a208-7ed51bf7de7a"; :>> title = "Critique d0118 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES on the strongest available evidence - the artifact exists and I have seen it from this repository. The viewer app is committed to the sysmlv2-viewer repo, and that project is discoverable as a sibling keel project from this one: sprint 317's /api/projects enumerated it by name alongside four others. The buildless choice is also vindicated rather than merely defended: keel's own console is a single self-contained HTML file with vendored assets and no toolchain, and it has been extended repeatedly in this session with no build step, which is the same bet paying off twice. Choosing the fastest path to a browser-verifiable artifact over a framework was the right call for an MVP whose main risk was never the rendering."; }
    part d0118FeasibilityCritiqueR1 : TestResult { :>> id = "6922049a-65cf-43ee-8bb4-3293d07707d1"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0118FeasibilityCritique to d0118;
    verification d0118CorrectnessCritique : Test { :>> id = "7f3bcdbb-a9ac-4845-beb2-0316f3cd0986"; :>> title = "Critique d0118 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and the governance clause is the more important half. Keeping the viewer PROGRAM governed in this repo while the CODE lives in sysmlv2-viewer avoids forking truth across two trackers, which the Decision names correctly as the dual-truth trap the discipline warns against - and it is right that all the viewer's Needs and Decisions already live here, so splitting would have duplicated them. It also states the exit properly: revisit and MIGRATE via a tracked Decision and the migration process if the viewer later needs independent governance, rather than leaving the arrangement permanent by silence. That is the rare deferral in this corpus with a named mechanism attached, and it stands in contrast to the promote-once-proven clauses that name none."; }
    part d0118CorrectnessCritiqueR1 : TestResult { :>> id = "5da4f4a4-84a8-4c44-847b-62dbcd5bc9a0"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0118CorrectnessCritique to d0118;
    verification d0118CompletenessCritique : Test { :>> id = "49054181-9ae9-466e-b04e-00dbd3ff5739"; :>> title = "Critique d0118 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE TWO-REPO SEAM HAS NO STATED SYNCHRONISATION. The program is governed here and the code is committed there, and nothing says how a change on one side reaches the other: no requirement that a viewer sprint record cite the viewer commit it delivered, no statement of which repo's gate runs on a viewer change, and no way to compute whether the code in sysmlv2-viewer corresponds to any recorded Decision here. The Decision does cite one commit inline (5f55952), which shows the intent and also shows the problem - a SHA in prose is not a typed link, and nothing keeps it true. This engine already solved the general case: every TestResult pins judgedAgainst to a commit precisely so evidence can be checked, and the viewer's deliverable has no equivalent. ALSO ABSENT: what happens if the viewer repo diverges or is unavailable - the governance home holds Needs for a deliverable it cannot verify."; }
    part d0118CompletenessCritiqueR1 : TestResult { :>> id = "565d0084-b710-420b-989a-8210608c8e30"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0118CompletenessCritique to d0118;
    verification d0119FeasibilityCritique : Test { :>> id = "38d2a2c7-6160-4b35-8f19-035e83f2afaa"; :>> title = "Critique d0119 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "BOTH ACTIONABLE CLAUSES ARE UNBUILT, INCLUDING THE ONE MARKED HIGH, and I checked rather than inferred. Clause (1) HIGH asks to align a read endpoint to the standard Systems Modeling API JSON envelope (@type/@id/ownedRelationship); no @type or ownedRelationship appears anywhere in keel-cli's source, so nothing emits the standard envelope. Clause (2) MEDIUM asks that the viewer's viewpoint presets be named after the standard view kinds (General, Interconnection, Action, State, Sequence, Requirement, Tree, Table); the registry's 32 viewpoints carry none of those names. Clause (3) was explicitly optional and is also absent, which is fine. So an accepted Decision whose stated payoff is interoperability with any SysML v2 tool has produced nothing in either priority band, and nothing in the model records that - no requirement was derived, so no coverage number falls."; }
    part d0119FeasibilityCritiqueR1 : TestResult { :>> id = "6f1f51e4-3d6c-4e88-b62a-501895d07cc6"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0119FeasibilityCritique to d0119;
    verification d0119CorrectnessCritique : Test { :>> id = "45e3186c-e3a5-4d80-922b-28e8dba6e913"; :>> title = "Critique d0119 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and its central factual judgment is the valuable part: no embeddable standard-notation web library exists, SysON is a full platform rather than a widget, and the Pilot's renderer is server-side PlantUML/GraphViz under GPL. That is a genuinely useful piece of research, and it is what licenses the Decision's asymmetric strategy - adopt the standard where it is strong and reusable (textual, already done; the JSON API and view-kind vocabulary, cheap and durable) and merely APPROXIMATE where it is not (graphical notation). Its claim that keel's UUID-typed-item plus typed-edge model 'already maps closely' to the standard envelope is plausible on inspection: an item with an identity and typed relationships is the shape @id and ownedRelationship describe."; }
    part d0119CorrectnessCritiqueR1 : TestResult { :>> id = "fc0e56eb-be7d-409e-8afc-dc255a995ada"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0119CorrectnessCritique to d0119;
    verification d0119CompletenessCritique : Test { :>> id = "5019a06b-a8aa-4f6e-8def-677f4980e93d"; :>> title = "Critique d0119 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "NO DEFINITION OF DONE FOR THE INTEROPERABILITY IT PROMISES. The payoff is that 'keel data is readable by any SysML v2 tool (SysON, Pilot MDK, generated clients) with zero custom notation work', and nothing states the test - which tool, reading what, successfully doing what? Round-tripping a package? Rendering a diagram? Listing elements? Those are wildly different bars, and without one the clause cannot be finished, only approximated indefinitely. That absence is likely why it was never started: a HIGH-priority clause with no acceptance criterion competes badly against work that has one. ALSO ABSENT: any statement of which SUBSET of the model is exposed in the standard envelope, and whether the engine's own metadata markers (which are not standard SysML constructs in the way the kernel accepts, per issue097) survive the mapping."; }
    part d0119CompletenessCritiqueR1 : TestResult { :>> id = "0da034ab-a8a6-4b86-888b-99866e3063af"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0119CompletenessCritique to d0119;
    verification d0120CorrectnessCritique : Test { :>> id = "6f028d0e-23d6-4c1a-b9c1-44aad35d8f6c"; :>> title = "Critique d0120 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and the choice it makes explicit is the right one: the DECISION is the declarative channel-binding SHAPE, not the library. Naming Vega-Lite as a candidate substrate while deferring the library choice to build time keeps the commitment at the level the Decision can actually hold, and the grammar-of-graphics channel model it borrows (colour, position, facet-as-swimlane) is well-established enough to lower risk honestly rather than rhetorically. The scale-selection rules are also correct against this engine's real schema, which I verified: enum to ordinal over declared members, Timestamp to temporal, Integer/Real to continuous or binned, String to categorical - and schema/core does declare Timestamp as a distinct type, so the temporal rule has something to key on rather than guessing at a String."; }
    part d0120CorrectnessCritiqueR1 : TestResult { :>> id = "454e8c5f-c2ca-4bd3-addc-23a1556330f6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0120CorrectnessCritique to d0120;
    verification d0120FeasibilityCritique : Test { :>> id = "b7a930cd-ca1d-494a-a848-5ae0de1e6b79"; :>> title = "Critique d0120 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES for the half it assigns to keel, which is the half this repository owes. It asks keel to expose the semantic metadata an auto-encoder needs - attribute kind, enum members, and value min/max/distribution - and view::attribute_stats does exactly that: per (type, attribute) it computes a kind, capped distinct values with a truncated flag, and numeric and string min/max, served through /api/schema. That is the enabling clause delivered. The viewer-side encoding engine and override editor are not built, and the Decision explicitly assigns those to the viewer app rather than here, so their absence is a scheduling fact rather than a feasibility failure of this Decision."; }
    part d0120FeasibilityCritiqueR1 : TestResult { :>> id = "401f9072-3234-4859-88c7-602b329e4806"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0120FeasibilityCritique to d0120;
    verification d0120CompletenessCritique : Test { :>> id = "d61936dc-1057-4b01-b7f7-0b03b1e5f39e"; :>> title = "Critique d0120 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE KIND VOCABULARY IT SPECIFIES CANNOT SEPARATE A CATEGORY FROM FREE TEXT, and the implementation shows the consequence. The Decision's scale rules end with 'String -> categorical', and view::stat_kind maps the declared type with everything not enum, Integer, Real or Timestamp falling through to categorical - so `title`, free text with hundreds of distinct values, and `owner`, with about eight, both report categorical, and an auto-encoder told to bind colour to a categorical attribute would attempt a palette over several hundred titles. A fifth kind, or a distinct-count threshold, is what an encoder actually needs, and the truncated flag the implementation added on its own initiative is the signal that would support it. ALSO ABSENT: conflict rules - what happens when two attributes bind the same channel, or when a bound attribute is ABSENT on some elements, which is the normal case since most attributes are optional."; }
    part d0120CompletenessCritiqueR1 : TestResult { :>> id = "3728f77a-cd39-4733-8e01-64cf3a231572"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0120CompletenessCritique to d0120;
    verification d0121FeasibilityCritique : Test { :>> id = "72a276fd-d468-4e89-95ea-dea7b033d190"; :>> title = "Critique d0121 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, delivered and verifiable: view::review_queue_json computes the queue, GET /api/review-queue serves it, and the write half exists as advertised endpoints (/api/decision/accept and /api/decision/reject appear in the API's own write contract). So the read side of the human-oversight loop and the control that records acceptance both exist. The Decision's compliance claim also holds where it matters most - an acceptance recorded through this surface lands as a method=confirmation TestResult judged by the human, which is the same mechanism D0106 requires and not a parallel path, so the surface adds convenience without adding a second way for a sign-off to exist."; }
    part d0121FeasibilityCritiqueR1 : TestResult { :>> id = "14d6bb13-c836-4dba-862e-df4ac42940de"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0121FeasibilityCritique to d0121;
    verification d0121CompletenessCritique : Test { :>> id = "a799bbe2-a4a4-4a2c-abc5-9df2c02bd92e"; :>> title = "Critique d0121 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "IT FILTERS THE ACTIONABLE SET BY A NAME HEURISTIC AND SAYS SO IN PARENTHESES. Legacy ceremony gates are excluded from the default view 'heuristic by structural name suffix', which means a gate named outside the expected pattern is silently misclassified in one direction or the other - shown when it is autonomous, or hidden when it needs a human. Hiding is the dangerous direction, and this engine has the same shape elsewhere (is_sitting_review_name, is_guard_producing) with the same exposure. The honest alternative exists and is cheap: ceremony gates are autonomous by D0049, so the distinction could be a DECLARED attribute on the gate rather than inferred from its name. ALSO STALE: the rendering clause names a 'Review console tab', and the sprint-315 rework replaced fixed tabs with surfaces derived from declared viewpoints - the queue is still served and still reachable, but the artifact the Decision describes no longer exists by that name."; }
    part d0121CompletenessCritiqueR1 : TestResult { :>> id = "09c612e1-27c2-4f4d-b539-7db918013564"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0121CompletenessCritique to d0121;

    // == Pass 12 completion: d0121's correctness lens. The batch above under-covered it (2 lenses of 3), the
    // same slip as d0109 in pass 10 -- crit_write.py now refuses a batch whose lens set matches no declared
    // required set, so this class cannot recur silently.
    verification d0121CorrectnessCritique : Test { :>> id = "fe47c9e5-41ac-4e17-9db7-51f576e5bccb"; :>> title = "Critique d0121 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and the clause that earns it is the one about WHAT a UI acceptance is: an acceptance recorded through this surface lands as a method=confirmation TestResult judged by the human - the same mechanism D0106 already requires - rather than as a new kind of sign-off object. That is the difference between adding convenience and adding a second way for an attestation to exist, and a second way is exactly how a fabricated or ambiguous sign-off would eventually appear. The queue's composition is right too: proposed Decisions plus method=confirmation Tests with no passing result IS the set of things only a human can discharge, computed rather than listed, so a newly-authored gate appears in the queue with no code change. The feedback-note field alongside Accept is a small but correct inclusion - a rejection or a caveat has somewhere to live in the record instead of in conversation."; }
    part d0121CorrectnessCritiqueR1 : TestResult { :>> id = "83555ff3-f04e-4a5a-9470-bc201495f613"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e6b25d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0121CorrectnessCritique to d0121;

    // == Element-critique backfill pass 13, 2026-08-17 (sprint 337). Five Decisions x completeness/correctness/feasibility.
    // Two feasibility claims were verified in the DOWNSTREAM viewer repo rather than taken on trust.
    // INDEPENDENT: authors are wweatherholtz and claudeOpus; the judge is claudeOpus5.
    verification d0122FeasibilityCritique : Test { :>> id = "770640c7-8399-4e8b-9a7f-afa9504d60a7"; :>> title = "Critique d0122 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, delivered exactly as specified: schema/core declares DecisionStatus as {proposed; accepted; rejected; superseded}, write::reject_decision exists, and POST /api/decision/reject is advertised in the API's own write contract. The claim that no migration was needed also held - it was purely additive, and nothing had to be rewritten. WORTH RECORDING ALONGSIDE THE PASS: the member has never been used. `DecisionStatus::rejected` appears nowhere in the corpus except inside D0122's own text, so across more than two hundred sprints no Decision has ever been rejected, and the reject path is unexercised in practice. That is not a failure of this Decision - the capability is correct and cheap - but it does mean a frozen-core change carrying human sign-off bought a branch nobody has taken, and the honest reading of that is that proposals here are either accepted or quietly left proposed."; }
    part d0122FeasibilityCritiqueR1 : TestResult { :>> id = "2c11b365-bafe-416b-9cad-797c6aee720a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0122FeasibilityCritique to d0122;
    verification d0122CorrectnessCritique : Test { :>> id = "3ea7adae-e81b-4625-afb9-94896a925933"; :>> title = "Critique d0122 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and its rejection of alternative (i) is the sharp one: recording a rejection event while leaving status=proposed would be dual truth - the Decision IS rejected and the field says otherwise - and the queue would then need a side-channel to hide it. That is the same defect this session found six times as stale prose contradicting a record, so refusing it at the schema level was right. Rejecting alternative (ii) is equally correct and less obvious: supersede replaces an ACCEPTED commitment, and using it to decline a PROPOSAL would overload one edge with two meanings and make 'what replaced this?' unanswerable. The observation that view.rs already spoke of 'rejected / proposed Decisions are not active commitments' is the best kind of justification for a schema addition - the code had the concept and the vocabulary was behind it."; }
    part d0122CorrectnessCritiqueR1 : TestResult { :>> id = "335b07e5-9749-42dc-a19b-dd99cf7321c6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0122CorrectnessCritique to d0122;
    verification d0122CompletenessCritique : Test { :>> id = "f5088a97-ef7d-4fec-a988-ef03d91f17e8"; :>> title = "Critique d0122 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "NOTHING SAYS WHAT A REJECTED PROPOSAL LEAVES BEHIND. A rejected Decision keeps its text and gains a Reject event, and the Decision does not address the work that referenced it: an action blocked by a #DependsOn to a PROPOSED Decision drops off the ready frontier by design, and on rejection that edge now points at a dead commitment - so the action is neither ready nor retired, and nothing computes its state. This session used exactly that mechanism (dcNeed8ScopeNarrowing blocked on the proposed D0156) and would have hit the gap had the human rejected instead of accepted. ALSO ABSENT: whether a rejected proposal may be re-proposed. The lifecycle is stated as proposed -> accepted | rejected with no return path, so revisiting a rejected direction means either editing status backwards (which contradicts the append-only grain) or authoring a fresh Decision that has no typed link to the one it revives."; }
    part d0122CompletenessCritiqueR1 : TestResult { :>> id = "9660b452-e3d2-4506-85ba-7bcce2e093ce"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0122CompletenessCritique to d0122;
    verification d0123FeasibilityCritique : Test { :>> id = "38758889-1043-4534-b458-50c6016028f6"; :>> title = "Critique d0123 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES on all four clauses, and clause (3) is directly checkable: `retro` IS declared as a Delivery workflow phase in .engine/workflows/delivery.sysml, with a succession (first closeOut then retro) and a flow carrying the implement result into it - so the model-driven ceremony filter has a declared phase to recognise rather than a hardcoded name list. Clause (4) is verifiable by absence, which is the harder half to honour: the legacy pre-D0049 confirmation gates still carry method=confirmation, so their creation-time truth was preserved and the VIEW was changed instead - the Decision did the thing it said rather than the easier data patch it explicitly reverted."; }
    part d0123FeasibilityCritiqueR1 : TestResult { :>> id = "304aaaaf-f289-4a74-9fac-4eaf59b09757"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0123FeasibilityCritique to d0123;
    verification d0123CorrectnessCritique : Test { :>> id = "49e4d2f5-a87b-48e7-b434-2c3113cc9fbe"; :>> title = "Critique d0123 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and clause (1) is the most reusable sentence in this corpus: a computed view of human obligations must not resurrect, nor flag as deficient, historical items governed by a superseded process version. That is forward-only retroactivity stated as a DESIGN RULE for views rather than as a one-off fix, and its rejection list shows why each shortcut was wrong - reclassifying the legacy gates would rewrite creation-time truth, and a guard that failed every ceremony confirmation would retroactively flag correct history as deficient. It also names its own root cause honestly: a new computed obligation-view was built without applying the governing-version discipline, and the durable fix is the rule rather than the data patch. This session proved the rule's value twice over - sitting-review-due reported 311 true-but-unworkable obligations until D0155 drew a grandfather line, which is the same failure this Decision warns about arriving through a different door."; }
    part d0123CorrectnessCritiqueR1 : TestResult { :>> id = "16f7c1ea-8a60-4171-9ff2-6cbb16e15c73"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0123CorrectnessCritique to d0123;
    verification d0123CompletenessCritique : Test { :>> id = "4b3268b0-8d5b-46b5-af98-ee98c3c6a42b"; :>> title = "Critique d0123 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE DESIGN RULE HAS NO ENFORCEMENT AND THE DECISION SAYS SO ONLY BY OMISSION. Clause (1) obliges every future obligation-view and guard to consult the governing-version resolver, and nothing checks that a new view did: there is no guard over views, so the rule holds exactly as long as each author remembers it - which D0047 identifies as not a control. THE EVIDENCE THAT IT DOES NOT HOLD IS THIS SESSION: the obligation bar built in sprint 316 derived its classes from declared viewpoints and counted them WITHOUT any governing-version consultation, and sitting-review-due consequently reported 311 obligations that predated the convention. That is precisely the failure clause (1) forbids, occurring in a view built after the rule was accepted. ALSO ABSENT: what 'honor governing-version' means for a view whose subject has no governing version at all, which is most of them."; }
    part d0123CompletenessCritiqueR1 : TestResult { :>> id = "f76b5b83-05cc-4bcc-b506-24082066497a"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0123CompletenessCritique to d0123;
    verification d0124FeasibilityCritique : Test { :>> id = "32eb4a43-a181-46fc-80dc-bba4c801fb3a"; :>> title = "Critique d0124 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, AND I VERIFIED THE CLAIM IN THE DOWNSTREAM REPO RATHER THAN CREDITING IT. The Decision states it was PROVEN by adding two channels with no other code change, citing 6 generated selects across 5 channels. The viewer's app.js declares exactly the registry described, with six channel modules: colour, size, shape, x, row and nest - so size and shape, the two the Decision says were added as the proof, are present as peers of the original four rather than as special cases. That is the extensibility claim demonstrated by the artifact, not by assertion, and it is the strongest feasibility evidence in this corpus. Checking it required looking outside this repository, which D0118 explicitly permits by putting the CODE in sysmlv2-viewer while the programme is governed here."; }
    part d0124FeasibilityCritiqueR1 : TestResult { :>> id = "8e72cf00-3dd8-4f40-8b3a-068b85768733"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0124FeasibilityCritique to d0124;
    verification d0124CorrectnessCritique : Test { :>> id = "f49dcb6a-8c80-4ca7-a093-fb9c70d5fa1f"; :>> title = "Critique d0124 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES. The registry contract is well chosen: each module declares its id, label, role (style, x or row), the attribute kinds it accepts, and for style channels a prep/apply/legend triple - so the panel, the apply pass and the legend are all generated by iterating the registry and no channel-specific branch exists anywhere else. Naming ROLE as the axis of variation is the insight: position channels and style channels differ in how they compose, and giving row-role channels a product-of-domains composition is what makes nested swimlanes of any depth fall out rather than needing a nesting feature. Its rejection of a full external grammar as the channel layer is also correctly hedged - the registry can wrap such a library later without changing the contract, which is a real option preserved rather than a rhetorical one."; }
    part d0124CorrectnessCritiqueR1 : TestResult { :>> id = "72b89e05-4817-4eb8-908b-65fe5bc773e0"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0124CorrectnessCritique to d0124;
    verification d0124CompletenessCritique : Test { :>> id = "f1dbdf19-4acf-4cab-9412-71ad2654b5ac"; :>> title = "Critique d0124 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "NO CONFLICT SEMANTICS FOR A DESIGN WHOSE WHOLE POINT IS SIMULTANEOUS CHANNELS. Unspecified: what happens when two modules bind the same attribute, or when two row-role channels produce an empty product cell, or when a style channel's accepted KINDS do not match the chosen attribute - the module declares the kinds it accepts and the Decision does not say who enforces that or what the panel does with a mismatch. ALSO ABSENT, and this is the one that will bite: what an element with NO VALUE for a bound attribute is rendered as. Most attributes in this model are optional, so a partial binding is the normal case, and hidden, greyed and other-bucket are three different statements about the data. The registry makes adding a channel cheap and says nothing about the cross-product of channels, which is where the rot it prevents would reappear."; }
    part d0124CompletenessCritiqueR1 : TestResult { :>> id = "58b1fd42-a9d7-45b1-9dd4-04254cbeb4f6"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0124CompletenessCritique to d0124;
    verification d0125FeasibilityCritique : Test { :>> id = "86282a41-cfb0-4730-b831-095e88d0a6bc"; :>> title = "Critique d0125 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, and the vendoring claim checks out in the downstream repo: app/vendor holds cytoscape-elk.js and elk.bundled.js alongside cytoscape.min.js and self-hosted fonts, so ELK really is vendored offline with no CDN and no build step - which is the constraint D0118 set and the reason this was buildable at all. The stated fallback (cose if the extension is absent) is the right defensive default for a vendored dependency, since a missing file degrades the layout rather than breaking the view."; }
    part d0125FeasibilityCritiqueR1 : TestResult { :>> id = "64e69e66-e9dd-4b52-8fce-54990638b0c6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0125FeasibilityCritique to d0125;
    verification d0125CorrectnessCritique : Test { :>> id = "a4a802fc-2d3b-4f1b-b472-58bd66f95a9c"; :>> title = "Critique d0125 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and it root-causes the complaint correctly: the problem was the layout ALGORITHM FAMILY, not the toolkit. Force-directed layout is wrong for a DAG and no amount of cose tuning reaches layered quality, so swapping renderers would have been the wrong axis of change - and the Decision says exactly that. Its rejection of Graphviz for the interactive view is specific rather than hand-waving: a static SVG loses expand, drag and live re-styling, needs a full relayout per change, and the encoding engine's MANUAL x and swimlane positioning does not map onto dot without pinned neato plus clusters. Reserving Graphviz for a future static export view keeps the good part of that option available for the case where publication quality matters and interactivity does not. Preferring ELK over dagre because ELK is the SysML-v2 ecosystem's engine also ties the choice back to D0119's leverage-the-standard direction, which is coherent even though D0119's own clauses went unbuilt."; }
    part d0125CorrectnessCritiqueR1 : TestResult { :>> id = "1c6479cf-39ab-40e3-a62c-d7ca7d4d24a3"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0125CorrectnessCritique to d0125;
    verification d0125CompletenessCritique : Test { :>> id = "60e34724-2df9-47b1-b778-212429d6df04"; :>> title = "Critique d0125 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE COMPOSITION WITH THE ENCODING ENGINE IS ASSERTED AND NOT SPECIFIED. The Decision's main reason for keeping cytoscape is that a Graphviz-owned layout 'would fight' the encoding engine's manual positioning - which is right, and it never says how ELK and manual positioning coexist. Does an active x-position or swimlane binding suppress the layered layout entirely, constrain it, or run before it? Those produce three different pictures and the Decision picks none. ALSO ABSENT: any performance statement. Layered layout over a large graph is the expensive operation in an interactive surface, and its sibling requirement srViewerGraphExpand asks the graph to stay interactive past a few thousand nodes with no latency budget either - so between the two documents nothing bounds the cost of the layout that was chosen for quality."; }
    part d0125CompletenessCritiqueR1 : TestResult { :>> id = "235ea197-2fc6-418a-b39d-3d692b9bc102"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0125CompletenessCritique to d0125;
    verification d0126CorrectnessCritique : Test { :>> id = "9ad962bc-727f-40b8-a6bd-0f614b52a58d"; :>> title = "Critique d0126 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "IT CITES A NEED THAT HAD ALREADY BEEN SUPERSEDED. The browse-first clause states that the register 'serves nViewerExplorableGraph + nViewerTemporalState/srViewerDatePredicates', and nViewerTemporalState is N-3, which D0116 SUPERSEDED outright - dropping its due/overdue computation and redefining the temporal capability as time-as-query-filter. D0116 is the earlier Decision, so D0126 was authored after N-3 was retired and still claims to serve it. The consequence is not cosmetic: a reader tracing what justifies the register's date filtering follows the citation to a superseded Need rather than to the live one, and the coverage computations exclude superseded elements precisely so that work is not credited against retired scope. The rest of the clause is accurate - srViewerDatePredicates IS the live requirement, and citing it alone would have been correct."; }
    part d0126CorrectnessCritiqueR1 : TestResult { :>> id = "e344645f-9ad2-4c99-9aa0-82bfe7898f79"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0126CorrectnessCritique to d0126;
    verification d0126FeasibilityCritique : Test { :>> id = "8395a328-b62d-4b32-a1bc-6c12d4ceec1e"; :>> title = "Critique d0126 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES on both substantive keel-side clauses, checked here rather than in the viewer. The browse-first register is backed by /api/index, which is advertised in the API's read contract; and the long-declared computed displayLabel was actually BUILT - view::display_label returns the authored title when present and non-blank, falling back to the immutable name, computed on every read rather than stored, exactly as the schema had declared for a long time and nothing had implemented. Building a declared-but-unbuilt computed view is the rarest kind of delivery in this corpus, and this Decision did it. The register's default exclusion of the verification items is also a real design accommodation for this corpus's shape rather than a hidden filter, since Tests and TestResults outnumber everything else."; }
    part d0126FeasibilityCritiqueR1 : TestResult { :>> id = "d1550643-d778-47ac-8c71-a956483a4aa1"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0126FeasibilityCritique to d0126;
    verification d0126CompletenessCritique : Test { :>> id = "73724219-ba48-4c98-9307-1390ac5c276e"; :>> title = "Critique d0126 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "THE DEFAULT EXCLUSION HAS NO STATED ESCAPE OR SIGNAL. The register 'excludes the ~5000 Test/TestResult verification items by default', which is a sensible default and a large omission, and the Decision does not say whether the reader is TOLD the exclusion is active or how they turn it off. This session made the number materially worse - the critique backfill has added roughly one hundred and sixty Tests and TestResults - so the hidden fraction grows precisely as examination improves, and an unsignalled default eventually hides most of the model. The engine's own pattern elsewhere is to report the boundary rather than apply it silently (sitting-coverage reports its grandfather basis; the obligation bar says NOT COUNTABLE with the command named). ALSO ABSENT: what displayLabel shows when an element has neither a title nor a meaningful name, which is the case the fallback chain ends on."; }
    part d0126CompletenessCritiqueR1 : TestResult { :>> id = "bf56a3aa-36f9-4131-aa7c-0a138840c852"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "f9eed06"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0126CompletenessCritique to d0126;

    // == Element-critique backfill pass 14, 2026-08-17 (sprint 338). THE LAST two critiquable Decisions.
    // After this, every element in this model that critique-policy.toml permits me to judge is covered;
    // 87 remain blocked because I authored them. INDEPENDENT: author wweatherholtz, judge claudeOpus5.
    verification d0127CorrectnessCritique : Test { :>> id = "e4f390f7-a579-4ced-b0c0-6ce9b09554d4"; :>> title = "Critique d0127 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and it ANSWERS AN OBJECTION I HAD ALREADY PUBLISHED AGAINST ITS REQUIREMENT - which is why reading a governing Decision before faulting its design is the discipline this pass taught me. In sprint 332 I recorded that the grammar is descriptive where the requirement is prescriptive, and concluded a client offering only observed triples could never bootstrap. This Decision chooses the observational grammar DELIBERATELY and supplies the escape: new never-used pairings stay reachable through Connect over the full closed algebra, and then become part of the observed grammar. So the bootstrap objection is answered by design and my critique of srViewerRelationshipGrammar is corrected accordingly. The reasoning behind the choice is also strong on this engine's own terms: no frozen-schema change, no per-domain authoring, the grammar is read per connected project so it stays generic rather than hardcoded to safety, and it reflects how the model is ACTUALLY used rather than how someone once said it should be."; }
    part d0127CorrectnessCritiqueR1 : TestResult { :>> id = "f9f18c1f-4fb8-4109-8ce0-d3239acedeba"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0127CorrectnessCritique to d0127;
    verification d0127CompletenessCritique : Test { :>> id = "c83c4066-6ee3-4dac-a6a0-440b64fc98d7"; :>> title = "Critique d0127 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "AN OBSERVED GRAMMAR HAS NO WAY TO FORGET, and the Decision does not address it. A triple enters the grammar the moment one edge of that shape exists, and nothing states what happens when that edge was a MISTAKE: the erroneous pairing becomes permanent vocabulary, every future client offers it, and correcting the edge does not obviously retract the triple - the Decision never says whether the grammar recomputes from live edges only, so whether a superseded or deleted edge still contributes its triple is unstated and decides the answer. THE ASYMMETRY IS THE PROBLEM: one correct edge is enough to admit a pattern and one incorrect edge is equally enough, so the grammar's precision only ever degrades. It also leaves the requirement it serves saying something different - srViewerRelationshipGrammar states which triples are VALID while this Decision says which are OBSERVED - and nothing reconciles the two texts."; }
    part d0127CompletenessCritiqueR1 : TestResult { :>> id = "06bf25a1-f9d0-4ef1-9af8-db296dea5a7f"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0127CompletenessCritique to d0127;
    verification d0127FeasibilityCritique : Test { :>> id = "9d89ebc6-94ac-4cec-8d19-e31b8494cc6d"; :>> title = "Critique d0127 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES, delivered and inspected: view::grammar_json computes the distinct (sourceType, edgeKind, targetType) triples by iterating the model's edges, adds the per-type up and down summary the Decision specifies, and is served at GET /api/grammar with per-fingerprint caching. The decision-light claim also holds in the way that matters - schema/core was not touched, so this needed no frozen-core sign-off and no migration, which is why it exists at all. AUTHORABLE_EDGE_KINDS bounds what the write surface may author alongside it, so the Connect escape the correctness lens credits is real rather than notional."; }
    part d0127FeasibilityCritiqueR1 : TestResult { :>> id = "b2d267d9-298e-41ec-bbc1-d674ba6f681e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0127FeasibilityCritique to d0127;
    verification d0128FeasibilityCritique : Test { :>> id = "a3c807c8-4143-47a6-9e75-407cb838a6f2"; :>> title = "Critique d0128 - feasibility (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::feasibility; :>> procedureText = "PASSES on all three directions, which is rare for a Decision this large - and the governance half is proven by this session's own tooling rather than by inspection. The Stop-hook PROTOTYPE it names (.engine/tools/stop_gate.py) became a subcommand IN THE BINARY: `keel hook post-edit` runs the fast tier after each .sysml edit and `keel hook stop` runs validate plus all guards at the turn boundary, and both fired on me during this run - the edit gate refused a batch with duplicate declared names and named the file and line. That is an in-loop gate blocking at the action boundary with corrective feedback, exactly as the direction specified. PORTABILITY landed as srPortCatalogExchange (sprint 297): a process unit exports as a bundle carrying its definition, deploying skill and the NAMES of the rules and guards a receiving project must activate. RELEASE landed too - the crate is at 0.2.3 with recorded release sprints, closing the dogfooding gap the Decision calls out honestly."; }
    part d0128FeasibilityCritiqueR1 : TestResult { :>> id = "4d01ecd6-781e-4b47-9f70-50a204474b02"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0128FeasibilityCritique to d0128;
    verification d0128CorrectnessCritique : Test { :>> id = "8c27fcc8-5af6-4bc8-b204-9c1ba084f91d"; :>> title = "Critique d0128 - correctness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::correctness; :>> procedureText = "PASSES, and the MCP correction is the most valuable sentence in the corpus: MCP is a SURFACE for discovery and ergonomics, NOT an enforcement layer, and letting it masquerade as governance would be a category error. Separating DISCOVERY (the agent does not know the process - a self-describing surface helps) from COMPLIANCE (the agent freelances - only gates and affordances help) is the distinction that makes the whole direction sound, and it has been vindicated since: no MCP server was ever built, and the compliance win arrived anyway through in-loop gates, which is precisely what the Decision predicted. Its statement that 'there is no deterministic prevention for an LLM' is also the honest premise D0151 later confirmed formally - the response contract's verify-before-asserting clause has no control behind it because no gate can read conversational output. A direction Decision that correctly predicts which of its own parts will and will not produce the win is doing the hardest thing available to it."; }
    part d0128CorrectnessCritiqueR1 : TestResult { :>> id = "3b108aa0-bcff-422e-8778-7f4fcdfb88f2"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0128CorrectnessCritique to d0128;
    verification d0128CompletenessCritique : Test { :>> id = "17758e72-c5f6-43ed-99d2-8ac363463f97"; :>> title = "Critique d0128 - completeness (independent)"; :>> createdAt = "2026-08-17"; :>> createdBy = "claudeOpus5"; :>> method = VerificationMethod::critique; :>> lens = CritiqueLens::completeness; :>> procedureText = "TWO CLAUSES WITH NO OBSERVABLE. (1) 'A concise per-project workflow spec' is named as part of the governance direction and nothing states what it is, where it lives, or how a project knows whether it has one - and no such artifact is identifiable in the tree, so the clause is inert with nothing recording that. (2) The 'over-governance-thrash guard (block clear violations, warn the rest)' has no measure of thrash. The 26-hard / 9-warning split realises the shape, and nothing observes whether governance is costing more than it returns: no indicator counts blocked-then-overridden gates, false-positive refusals, or time lost to a control that was wrong. THE SESSION IS THE ARGUMENT FOR IT: the guards blocked me correctly seven or eight times and wrongly none that I noticed, which is a good ratio and is UNRECORDED - so the Decision's own safeguard against over-governance cannot be evaluated in either direction. Also unaddressed: what retires a direction. Three directions in one Decision let it be sequenced, and nothing says how a reader learns which of the three is finished."; }
    part d0128CompletenessCritiqueR1 : TestResult { :>> id = "e45f2a36-b87e-4fdb-9617-1402a64856f7"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "1d2f9d0"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
    #Verify dependency from d0128CompletenessCritique to d0128;
    verification issue142Disp1 : Test { :>> id = "68dfa123-4e72-4f7d-a026-4347dad03b00"; :>> method = VerificationMethod::confirmation; :>> disposition = DispositionKind::act; :>> procedureText = "building cache isn't the same as authoring duplicate/stale facts.  max cache to improve speed here is just fine, if there's a good mechanism to piece-wise update the cache when changes are detected."; }
    part issue142Disp1R1 : TestResult { :>> id = "777004fa-b0c3-4f12-8b89-cfb76112d59f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e791083"; :>> judgedAt = "2026-08-18"; :>> judgedBy = "wweatherholtz"; }
