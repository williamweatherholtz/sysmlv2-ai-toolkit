    part issue123Disp1R1 : TestResult { :>> id = "5da8598a-fcfd-428a-a8dd-bc40c058959c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "0d33611"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "wweatherholtz"; }
    #Dispositions dependency from issue123Disp1 to issue123;
