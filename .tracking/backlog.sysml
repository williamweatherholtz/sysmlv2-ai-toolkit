        part dcWorkspaceDoDR1 : TestResult { :>> id = "b6483034-60bf-4372-902c-d2c895d00db4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f3567704fe492cf91920a24d80e9970ea8abeb20"; :>> judgedAt = "2026-08-26"; :>> judgedBy = "claudeFable5"; }
        action dcStagedFilesAreProjectScoped;
        verification dcStagedFilesAreProjectScopedDoD : Test { :>> id = "4f030a34-abbd-4ccf-95cd-137124cff34a"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue271 (D0234). git diff --cached answers for the whole REPOSITORY no matter which subdirectory asks, so in a repo holding several keel projects every project's guards saw every other project's staged files and the workspace-level ones too. Found live: a two-project workspace failed BOTH projects' process-change guard over .githooks/pre-commit, a file belonging to neither. DO: staged paths are filtered to the asking project and re-based project-relative, using git rev-parse --show-prefix; a project that IS the repo root keeps today's behaviour exactly. VERIFY: in a two-project workspace each project's guard sees only its own staged files; the cross-project violation is gone; this single-project repo's guard output is unchanged."; }
        // RAN: live two-project repos: ONE repo-root hook gated a commit across both projects and it landed (96e680e); a broken project BLOCKED the commit and named the project it skipped; a fresh single-project keel init + git add -A + commit now SUCCEEDS (98456c1) where it failed before; keel projects reports 2 in the workspace and 1 here; qualify() -> alpha/d0001 vs beta/d0001, d0231 unchanged; keel guard process-change -> PASS with the co-committed Decision found. cargo test --workspace -> 274+9+2+1+32; clippy 0 errors
        part dcStagedFilesAreProjectScopedDoDR1 : TestResult { :>> id = "6e5e6f3a-88af-4d76-ab4d-3d99480be6d7"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f3567704fe492cf91920a24d80e9970ea8abeb20"; :>> judgedAt = "2026-08-26"; :>> judgedBy = "claudeFable5"; }
        action dcKeystoneLockIsAboutChangeNotArrival;
        verification dcKeystoneLockIsAboutChangeNotArrivalDoD : Test { :>> id = "9a2f07f0-06dd-4cd6-b934-708f8224eef5"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue272. A freshly scaffolded project COULD NOT MAKE ITS FIRST COMMIT: keel init stages every .engine/processes file, the keystone lock read that as a locked surface changing without a signed Decision, and the first thing a new user does failed - telling them to record a process-change Decision for a scaffold they did not author. NOT a workspace defect: reproduced on a plain single-project keel init. DO: the lock applies to MODIFIED and DELETED locked files, never merely ADDED, because an added control is one ARRIVING rather than being weakened. State the residual where it lives: an added process CAN weaken by asserting a constraint that claims a CORE guard, and audit-adherence's guard-state monotonicity is the check that catches that transition. VERIFY: keel init then git add -A then commit SUCCEEDS on a fresh project through the scaffolded hook; modifying a process definition without a marked Decision still FAILS; deleting one still fails."; }
        // RAN: live two-project repos: ONE repo-root hook gated a commit across both projects and it landed (96e680e); a broken project BLOCKED the commit and named the project it skipped; a fresh single-project keel init + git add -A + commit now SUCCEEDS (98456c1) where it failed before; keel projects reports 2 in the workspace and 1 here; qualify() -> alpha/d0001 vs beta/d0001, d0231 unchanged; keel guard process-change -> PASS with the co-committed Decision found. cargo test --workspace -> 274+9+2+1+32; clippy 0 errors
        part dcKeystoneLockIsAboutChangeNotArrivalDoDR1 : TestResult { :>> id = "7b3714dc-e11f-4bf0-b0ef-0a4cbba863da"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f3567704fe492cf91920a24d80e9970ea8abeb20"; :>> judgedAt = "2026-08-26"; :>> judgedBy = "claudeFable5"; }
        action dcValidateRefusesANonProject;
        verification dcValidateRefusesANonProjectDoD : Test { :>> id = "20ec6596-e79a-4ecf-84e1-e023b0b03e22"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue269. keel validate pointed at a directory that is NOT a keel project reports 0 tracking file(s) validated clean and exits 0 - a VACUOUS PASS, and the loudest possible one because validate is the first line of every gate. Found while testing whether several keel projects can share one git repo: run at the parent, validate says clean over nothing, so a commit hook placed at the repo root would gate NOTHING while reporting success. guard all in the same position correctly FAILS, so the two halves of the gate disagree about whether an empty population is an answer. DO: validate REFUSES a root with no .engine directory, naming what it looked for and where, exactly as the guard root resolver already does - an absent project is a usage error, not a clean tree. Keep exit 0 for a real project that genuinely holds zero tracking files, since that is a true statement about a real project. VERIFY: validate on a directory with no .engine exits NON-ZERO with a message naming the missing directory; validate on a freshly scaffolded project still exits 0; validate on this repo still reports its full file count; the pre-commit hook of a real project is unaffected."; }
        // RAN: live two-project repos: ONE repo-root hook gated a commit across both projects and it landed (96e680e); a broken project BLOCKED the commit and named the project it skipped; a fresh single-project keel init + git add -A + commit now SUCCEEDS (98456c1) where it failed before; keel projects reports 2 in the workspace and 1 here; qualify() -> alpha/d0001 vs beta/d0001, d0231 unchanged; keel guard process-change -> PASS with the co-committed Decision found. cargo test --workspace -> 274+9+2+1+32; clippy 0 errors
        part dcValidateRefusesANonProjectDoDR1 : TestResult { :>> id = "cb0fc728-a8bf-4d99-9c48-9c37c3cbb548"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f3567704fe492cf91920a24d80e9970ea8abeb20"; :>> judgedAt = "2026-08-26"; :>> judgedBy = "claudeFable5"; }
        action dcEvidenceCited;
        verification dcEvidenceCitedDoD : Test { :>> id = "164702d8-8590-447c-9ab2-cac1e8a7c283"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue266 (D0232). The human named the over-claiming directly and asked for a SYSTEMIC fix. Measured: of 5135 recorded TestResults exactly ONE recorded what produced it, so every pass was a testimony no third party could re-derive, and the 3.9 percent fail rate is the signature of a system recording that work happened. DO: (a) guard 52 evidence-cited requires an AI-judged method=test result to carry a RAN receipt naming what produced the verdict, written by append-result --evidence as a structured comment because schema core is frozen; a HUMAN-judged result is never in scope, by design rather than as a courtesy, because their word IS the evidence; forward-only from 2026-08-25 on the D0198 cutover shape. (b) keel attestation reports the census - results by judge kind, how many EXERCISED claims carry a receipt, the fail rate, and the count of uncited coverage claims - so the over-claim rate is a number anyone can read. (c) The third proposed control, gating verdict WORDING, was NOT built as a guard: three calibrations against the real corpus produced 111, 35 and 1 false positives, the last at 0 percent precision on live data, so it ships as part of the indicator with the counts recorded. VERIFY: the guard fires on an AI method=test result with no receipt and passes with one; a HUMAN-judged result is not even scanned; a pre-cutover date is out of scope - all four asserted by test; the guard fired on my own five results from the same session and they now carry real receipts; keel attestation reports 4749 AI results, 1146 exercised, and 318 human judgments counted separately."; }
        // RAN: cargo test --lib a_receipt_is_demanded_of_the_ai_and_never_of_the_human -> 1 passed (4 directions incl. the human exemption); keel guard evidence-cited -> 5 scanned 0 violations; keel attestation . -> ai 4749/1146 exercised, human 318 out of scope; cargo test --workspace -> 271+9+2+1+32 passed
        part dcEvidenceCitedDoDR1 : TestResult { :>> id = "89301768-6ecd-4d59-8cd1-29a271ffce0a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "c84671a3f005feb4171d3087a0e11f76d6d81046"; :>> judgedAt = "2026-08-25"; :>> judgedBy = "claudeFable5"; }
        // RAN: verified after threading --evidence through append-gate-result too: keel guard evidence-cited -> 8 scanned 0 violations; cargo test --workspace -> all targets pass
        part dcEvidenceCitedDoDR2 : TestResult { :>> id = "bee21845-9d16-4ec4-8c10-3563f86fe49f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "c84671a3f005feb4171d3087a0e11f76d6d81046"; :>> judgedAt = "2026-08-25"; :>> judgedBy = "claudeFable5"; }
        action dcForeignTreeIsTheTest;
        verification dcForeignTreeIsTheTestDoD : Test { :>> id = "74747820-7596-4095-8e25-3da33849a02f"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue264. MEASURED, not impressions: 39 of 51 guards read only the authored model, 11 cross a boundary, and ZERO read another project tree - while 11 of the last 20 issues were discoveredInField and cluster at exactly that boundary (another project tree: 251, 252, 253, 259, 263; an external service: 260, 262; a shell layer: 255, 256; a different binary: 261; the human attention: 244, 258). Verification reports 99 percent EXAMINED and 91 percent EXERCISED, and 5120 recorded TestResults carry a 3.9 percent fail rate, so the measures are neither weak nor mis-thresholded - they point INWARD, at the artifact I author, and every recent failure happened where the engine meets something it does not author. DO: make adoption a CONTROL rather than an occasional act. A CI job scaffolds a fresh project with keel init, imports every declared unit into it, and gates that FOREIGN tree - validate, guard, check-engine - failing the build when a unit cannot land clean. This is precisely the manual act that found five of those defects, run every push instead of when someone remembers. VERIFY: the job FAILS on a deliberately broken unit (a process asserting a constraint the unit does not carry, which is issue263 exact shape) and PASSES on the current tree; the guard-target census is reported so the inward/boundary ratio stops being invisible; no unit is exempted silently."; }
        // RAN: keel adoption-check . -> 25/25 units clean both directions; cargo test --test adoption_check_can_fail -> 2 passed (the mutilated-bundle case turns the foreign gate RED); CI step log quoted at run 32851429166
        part dcForeignTreeIsTheTestDoDR1 : TestResult { :>> id = "f126ec22-20d0-4bda-9271-ea46c87cd5ca"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3b2bb4912509f6a97b6465c992826831f6ffc3a7"; :>> judgedAt = "2026-08-25"; :>> judgedBy = "claudeFable5"; }
        action dcPinnedFirstBinary;
        verification dcPinnedFirstBinaryDoD : Test { :>> id = "b8565acc-1895-4b63-a2f5-16447628df86"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue261 (D0230). penumbra commit gate was running THIS repository working build - keel on PATH resolved to a sibling target/release reporting 0.3.0+dirty - so a broken build here would break their gate, and a guard added here applied to their commits without them adopting anything (that is how issue259 happened). The author chose to decouple: pin to a release. DO: the scaffolded pre-commit resolves PINNED-FIRST - explicit KEEL_BIN, then a repo-local .keel/bin/keel or .keel/bin/keel.exe, then PATH - so dropping a released binary at that path IS the pin, with no wrapper and nothing to keep in sync, and .keel stays machine-local so no binary is committed. A project that does not create the directory is unaffected. VERIFY: a fresh keel init scaffold renders the pinned-first resolution; a stub placed at .keel/bin/keel is the binary the hook ACTUALLY invokes for validate, guard and rules, checked by running the hook rather than reading it; an unpinned scaffold still resolves from PATH."; }
        part dcPinnedFirstBinaryDoDR1 : TestResult { :>> id = "bdee4fba-0a04-4af1-bbf7-bc87dffa0e55"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "811a9a15ef0633a15b94f8abbf96b212fe12ec01"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcGatingWorkflowHistory;
        verification dcGatingWorkflowHistoryDoD : Test { :>> id = "f8a71395-6c7d-4cf9-a22c-41daf73b1d58"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue260 (D0229). Tagging v0.3.0, the release workflow FAILED - on the scan-count test, because claim-ancestry skips loudly on a shallow clone and actions/checkout defaults to depth 1. ci.yml carries fetch-depth 0 with a comment citing issue229, the exact fix for the exact reason; release.yml never got it, so the release gate had been RED since guard 48 landed weeks earlier and nobody could have known, because v0.2.3 was tagged before that guard existed. DO: (a) release.yml gate job checks out full history; (b) guard 51 gating-workflow-history refuses any workflow that RUNS the gate - judged by what it invokes, not by its name - while checking out shallow, because such a workflow reports a pass it never verified; (c) the scan-count test records claim-ancestry as legitimately empty on a shallow clone WITH the reason; (d) the per-file-not-per-job limitation is stated in the guard doc and guards.md rather than left to be found. VERIFY: the guard passes 3 scanned on the real tree and FAILS when release.yml depth is flipped to 1 (probed both ways); guard count reads 51; the release workflow goes green on a re-cut tag."; }
        part dcGatingWorkflowHistoryDoDR1 : TestResult { :>> id = "1e1363b0-3e0c-4b79-8eef-0699516c9bba"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "c444ca562706e2645424c27e03c66d39419b1f98"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcGuardScopedToAdoption;
        verification dcGuardScopedToAdoptionDoD : Test { :>> id = "799685b1-c6ef-4dfc-a8ff-598a9e78b80f"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue259 (D0228). Guard 50, landed hours earlier, failed the FIRST project keel was adopted onto 22 times out of 22 - a control that project never chose, breaking its commit gate, which is exactly the failure D0164 names. DO: scope the guard to adoption - it enforces nothing unless project-onboarding is present in the project, and REPORTS 0 scanned rather than skipping silently, so an out-of-scope guard stays visible. Not solved by claiming the guard from the process: a project lacking the unit has no claim either, so guard_state would return Core and enforce it anyway. VERIFY: penumbra goes from 22 violations to guard ALL PASS with the fixed binary; keel own count unchanged at 25 scanned; the unit test asserts both directions plus the out-of-scope zero."; }
        part dcGuardScopedToAdoptionDoDR1 : TestResult { :>> id = "82efc9b3-4ece-4aca-927d-1e94559ec356"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f4417e9033b3d306085a2e5b34a9e89b2e708243"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcChannelNotificationCost;
        verification dcChannelNotificationCostDoD : Test { :>> id = "66a0302c-3495-4a08-a75e-e7bac9491a69"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue258. MEASURED before proposing anything: 22 GitHub issues exist and 20 were opened in a single day, one per proposed Decision, because D0207 gives every non-fork a forever-open override thread of its own; 94 workflow runs landed that same day, of which 28 CI runs failed and each failure emails the pusher; and the decision-record sweeper fires on a 30-minute cron. The override thread is the human ONLY route to reverse an auto-accepted Decision, so it cannot be removed - but it does not have to be a separate issue per Decision. DO: one STANDING override thread carrying a comment per auto-accepted non-fork, while a FORK still opens its own issue - which separates the FYI stream from the you-must-decide stream, so the human can mute the first and keep the second. That requires a gesture comment to be able to NAME its decision (reject d0225 because ...) rather than inheriting it from the issue body, which is the only code change on the parsing side. VERIFY: a comment naming a decision routes to that decision and one that does not still inherits from the issue; a fork opens its own issue; a non-fork appends to the standing thread and the receipt cites thread plus comment; the issues-per-decision rate drops from one to zero for non-forks; no auto-accepted Decision loses its override route. ALSO RESOLVES issue262, the two defects the FIRST LIVE RUN produced and the stubbed dry run could not: the thread was created TWICE because the lookup used the GitHub search index, which lags creation - now found by LABEL, which the API serves directly, plus an in-process cache and lowest-number-wins if a race ever leaves two; and the recorder CLOSED the standing thread after its receipt, destroying the reversal route for every auto-accepted decision at once - it now never closes a thread carrying the keel-standing label, while a fork's own issue still closes. VERIFY LIVE, not by dry run: exactly one open thread carrying the label; a non-fork produces ZERO new issues and one comment; a fork still opens its own assigned issue; the thread is still OPEN after a receipt lands on it."; }
        part dcChannelNotificationCostDoDR1 : TestResult { :>> id = "9fd07c9c-6d2d-4e80-a24d-b1177a1f0334"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "811a9a15ef0633a15b94f8abbf96b212fe12ec01"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        #DependsOn dependency from dcChannelNotificationCost to d0227;
    #DependsOn dependency from dcDecisionClausesAreAddressable to d0303;
        verification dcProjectOnboardingDoD : Test { :>> id = "fdc17e60-0390-487f-90dc-dcbdb9bf3dda"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue257 (D0225, D0226), raised by the author as a precondition on the penumbra migration. keel init lays down a working project with every process active and never asks what is being built, so the author faces 25 processes with no basis to judge them. DO: (a) a project-onboarding process and skill that elicit the WORK - deploying business-elicitation so answers are Statements first - then match, research the gaps, recommend as an argument, and charter; NEVER offering the catalogue as a menu, because a chosen option is evidence about the menu (D0216); (b) an APPLIES-WHEN condition declared BESIDE each process, stating the SITUATION rather than a domain label, so a domain nobody listed is still served and the fact travels with the unit (D0222); (c) keel onboard as the computed view of charter state and conditions, never a gate (D0098); (d) guard 50 process-applicability so a new process cannot be added without a condition; (e) charteredBy in activation.toml naming the Decision, and keel chartering its own set as the first real use. VERIFY: 25 processes declare a condition and the guard passes 25 scanned; a Process file without one FAILS it, tested in both directions with the non-Process file out of scope; a FRESH keel init scaffold reports NOT CHARTERED, ships all 25 conditions and passes every guard; process audit reports project-onboarding TRAVELS WHOLE; keel onboard reports CHARTERED by d0226 on this project; every test target passes."; }
        part dcProjectOnboardingDoDR1 : TestResult { :>> id = "895c42f3-7138-4298-8b14-ed0ad67f41fc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "64f2dea614166747b60f17c9fe97d283f8f06dbe"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        verification dcNoShellInjectionIntoRecordsDoD : Test { :>> id = "1e439734-4905-4c3b-a5ae-2566c7a3c48f"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue255 and issue256. A BACKTICK inside a double-quoted shell argument is command substitution: recording D0223 the prose NAMED a keel command, sh RAN it, and roughly 2000 characters of JSON landed in the decision field of a governance record - caught only incidentally, because that JSON carried an escape the parser rejects. Investigating it found the same injection had ALREADY LANDED: D0214's context held 13,136 characters of console transcript, recorded, auto-accepted and pushed undetected. DO: (a) the write path REFUSES a prose field carrying captured tool output, in both observed shapes - a run of three or more quoted-key-colon pairs (JSON and dict repr) and four or more strong guard markers (a console transcript) - on record decision and record issue alike, with a message that names the backtick mechanism so the author learns it where it bites; (b) keel record decision --from FILE takes the prose from a draft file, key-value headers and verbatim sections, so no shell layer exists to run anything and the safe road is the easy one (D0054); (c) the landed D0214 dump is excised and its sentence restored, acceptance receipt untouched. VERIFY: the D0223 text and the D0214 transcript are both refused by name with the offending region quoted; a clean decision quoting guard names still records; the whole existing corpus of decision prose flags ZERO with the population asserted non-empty, so the check cannot pass vacuously; D0224 itself was recorded through --from; every test target passes."; }
        part dcNoShellInjectionIntoRecordsDoDR1 : TestResult { :>> id = "677cdbf3-0000-4a41-bdd5-0c770e3134f8"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "016cadaa627a5dda4345e66d1167859e60e8e5ec"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        verification dcDecisionAuthoringIsCoreDoD : Test { :>> id = "a925bae1-4d42-4ba2-abf5-857ae27ff531"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue254 (D0223), human-directed. decision-authoring - the process by which a Decision is authored, which is how a process gets cemented here - CLAIMED five guards, and a guard is core precisely when no unit claims it. So keel deactivate decision-authoring switched off decisionRationale, acceptanceEvents, decisionRequirementLink, attestationSubstance AND confirmationAuthenticity - the guard that stops an AI recording a human acceptance that never happened. DO: the process asserts NO guard, making all five CORE and therefore never deactivatable AND more portable (an adopting project gets them with no activation step, since nothing claims them there either); the definition carries the reason and an explicit instruction not to re-add an assert; the process-to-guard link is recorded as core = [...] in process-enforcement.toml and hardening counts core guards as enforced, because otherwise a core-enforced process reports guards 0 and reads as NOT enforced. VERIFY: all five read CORE in keel activation; deactivate REFUSES with the accurate message; hardening moves decisionAuthoring from undeclared to enforced (15 to 16); audit-adherence treats Active to Core as a strengthening and does not flag it; every test target passes."; }
        part dcDecisionAuthoringIsCoreDoDR1 : TestResult { :>> id = "38f074d0-4ca7-4b6c-8984-d58473f73e2e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "016cadaa627a5dda4345e66d1167859e60e8e5ec"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        verification dcTransferabilityIsComputedDoD : Test { :>> id = "ce656e18-8ef4-4b19-8039-0f5af60a7359"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue253 (D0222). The human asked for a final pass on whether everything is easily transferable BEFORE migrating to penumbra. Twice already a unit had been declared transferable and was not, both times found by adopting rather than reading - so the answer had to be computed. DO: keel process audit reports per unit whether it would land GREEN in a project that lacks it (deploying skill present, the declaration binding skill to process travels, declared extras exist, no carried file cites a path the adopter will not have); then a committed migration transform MOVES all 36 AISkill declarations beside their skills, import RETIRES a central declaration an incoming per-skill file supersedes, and the stale references are swept. VERIFY: the audit goes 23 LANDS-RED of 24 to 0; intake, migration, obligation-review and agile-workflow each export and import into a fresh project lacking them and leave it at guard ALL PASS; the penumbra case (skill declared centrally from an older engine) is simulated and import announces the retirement with duplicate-identity clean; the migration reconciles 36 found = 36 moved = 0 skipped; the audit is narrowed twice against the real corpus so a directory convention and a placeholder are not flagged."; }
        part dcTransferabilityIsComputedDoDR1 : TestResult { :>> id = "2652f128-7b09-4001-acc4-bef486297d33"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "43a7b10f0a9662043e4099dccbb746a280d1d850"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        verification dcChannelLogicInBinaryDoD : Test { :>> id = "9a3f0f48-c089-4d29-970d-51935d8c47c6"; :>> method = VerificationMethod::test; :>> procedureText = "Delivers D0221 in part. The human: I do not want all these bespoke scripts - if we need something consistently, build it into keel, or into a process if we need it flexible. The channel shipped 272 lines of bespoke shell and python whose recurring defects all came from that: record_decision.sh RE-GREPPED the login table the binary owns (two implementations of one rule, the D0219 drift), parsed the gesture with a shell case and a locale-dependent tr that nothing unit-tested, and was invisible to every keel surface. DO: move the DETERMINISTIC text logic into the binary - gesture parsing, the decision-marker read, idempotency, and the decider lookup - as keel github-gesture emitting JSON, with the vocabulary in ONE place; leave gh effects in the script as I/O only; keep policy in the process definition. VERIFY: five unit tests pin the documented vocabulary AND that nothing unrecognised (lgtm, yes, acceptable, accept BB) ever reads as an accept, because a misread gesture is a fabricated human attestation; the live command returns the right JSON for B / accept / reject <why> and exit 1 for unparsed; record_decision.sh contains NO decision logic afterward. REMAINING (stated, not claimed): open_decision_issues.py still composes the issue body in python, and the scripts still exist as the I/O layer - the target of `.github/scripts/` disappearing is not reached."; }
        part dcChannelLogicInBinaryDoDR1 : TestResult { :>> id = "856132e8-c54c-41a6-8c83-a2d460a21c8b"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "9253f3c907438e52e00817b954b5e410661922da"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        verification dcSkillRegistersBesideItselfDoD : Test { :>> id = "31c69d7d-770b-4dce-a086-d5ad12ac480d"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue252 (D0220), found by ACTUALLY adopting the channel on penumbra rather than testing the export here. The skills-registry entry that binds skill to process lives in one shared file holding all 37 skills and stayed home, so process-skill FAILED in the receiving project on its first run - a new project met an adopted unit as a red gate it could only clear by hand-editing a shared file. DO: a skill may declare its deployment beside itself in any .sysml under .engine/skills/, and BOTH readers (the process-skill guard and activation::deploying_skills) scan the directory rather than the single file; move decisionChannelSkill into .engine/skills/decision-channel/registry.sysml and have unit_files carry it. VERIFY: export carries 7 files; after import penumbra reports validate clean, process-skill 22 scanned 0 violations and guard ALL PASS where the same adoption previously FAILED; this repo stays green at process-skill 24/0; duplicate-identity refuses a copy so the entry must be MOVED."; }
        part dcSkillRegistersBesideItselfDoDR1 : TestResult { :>> id = "f5032649-32a4-4f43-8ea4-d0ad251ba53a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "232c0cd491c0a3cb15250180df1a2c689c3c8867"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        verification dcChannelUnitTravelsDoD : Test { :>> id = "87c706bb-0dea-482d-8666-bb72d47225ef"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue251 (D0219). The human asked to activate the GitHub decision channel on another project (asirobots/penumbra) with the constraint that they must not be forced to own every project. FOUR defects: the unit exported 3 files while the 5 that ARE the channel stayed home (srPortModularProcessUnit violation); the opener assigned to github.repository_owner which is an ORG for that repo, so gh issue create would FAIL; the decider login was a literal in the workflow in 3 places, forcing every adopter to fork the mechanism; and keel init shipped THIS project github-actors.toml verbatim, so every new project inherited my login as its authorized decider. DO: unit-extras.toml declares per-unit files and prerequisites carried by export and listed by show; keel github-decider is the single implementation of who-may-decide read from the committed table, with the workflow condition structural only and authorization a step that leaves an outsider comment GREEN; assignment goes to declared deciders or nobody; github-actors.toml joins the init instance-contract reset and starts empty. VERIFY: export yields 6 files + unit.toml at exit 0; a round trip into a throwaway inited project lands the workflows and scripts in .github/ with the project own keel-gate.yml intact; a fresh init declares NO decider and refuses any login with the remedy; both the fresh-import and --update loops share one destination mapper, closing two bugs that had reported success while copying a file onto itself and writing into .engine/.github/."; }
        part dcChannelUnitTravelsDoDR1 : TestResult { :>> id = "28d2a64a-0634-4943-ae8a-90e1e215784e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d129343588ed2ab4dd901d9c28b4c598bc3be2bb"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcTestsAssertRepoNotMachine;
        verification dcTestsAssertRepoNotMachineDoD : Test { :>> id = "23f2f0af-4eeb-4325-8cbf-9735f031b5e4"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue248. The sprint447 test this_repos_commit_gate_is_armed asserted that THIS repository has an armed local git hook, which is a property of a MACHINE and not of the repository: a CI checkout configures no core.hooksPath and correctly needs none, because CI is the hook-INDEPENDENT layer (K15/D0179). Every push went red from issue243 onward. My own sprint447 review gate had named the risk verbatim and I overrode it. DO: state the CONDITIONAL invariant instead - IF core.hooksPath is configured it must resolve to a directory holding pre-commit - which still fails the exact issue240 state (configured to a null device) while an unconfigured checkout is not a violation. VERIFY: the test passes locally where a hooksPath is configured and reachable, passes on CI where none is configured, and the unchanged negative test still fails an unreachable path; CI green on main."; }
        part dcTestsAssertRepoNotMachineDoDR1 : TestResult { :>> id = "737ffdc4-9b9e-4757-a252-1935f9373d9f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "dfae3ca847e41f040906a06b4dd92bf53bd7b4e1"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        verification dcNoFalseCleanRangeDoD : Test { :>> id = "fef137fb-9286-425b-8dd8-44e8ae60d0ad"; :>> method = VerificationMethod::test; :>> procedureText = "Raised by sprint448 retro: the negative-probe-range error has now occurred THREE times (sprint440, sprint441, sprint448). audit-adherence prints `fewer than 2 commits in range - nothing to compare. Clean.` and exits 0, so a probe run with --since HEAD~1 against a REAL unsigned weakening reports CLEAN - a false clean from the gate built to prevent false cleans. Manual vigilance has now failed three times, which D0047 says is not a control. DO: a range that cannot compare anything is a USAGE error, not a clean result - exit non-zero with the remedy (widen the range so the parent is included), and never print the word Clean for a population of one. VERIFY: --since HEAD~1 exits non-zero naming the range problem; --since HEAD~2 over the same pair still detects the weakening; a genuinely clean 2+ commit range still passes; the CI invocation is unaffected because github.event.before spans more than one commit."; }
        part dcNoFalseCleanRangeDoDR1 : TestResult { :>> id = "8cfcd528-84b2-4cb0-ba22-450ad4a7572c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "220b1ba5564b4f7128bddc0110634f7ae05b81d4"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcWarningsAreRead;
        verification dcWarningsAreReadDoD : Test { :>> id = "93756efd-fae0-4c80-9256-21b82b393170"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue244 (MEDIUM). `keel guard` prints [guard] ALL PASS while emitting 80 warnings across 10 guards, one of which is a live report-vs-truth contradiction that has been shipped and unread: 'tag v0.2.0 points at e2c812f but its Release item records commit 425145d - the recorded release and the shipped tag disagree (D0191)'. Detected-but-unread is the highest-frequency drift mechanism in this repo and it grows with every control added, which is why the panel refused a new detector. DO the SUBTRACTIVE fix: route the warning population into orient's non-blocking burndown (count + the guards carrying them + the oldest), so detected drift is read rather than re-detected; triage the release/tag contradiction. VERIFY: orient reports the warning count and it is non-zero today; the tag/Release disagreement is resolved or dispositioned."; }
        part dcWarningsAreReadDoDR1 : TestResult { :>> id = "c6ccd75d-ae92-4b97-b64c-855c39fc12c5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36694872766baf4eb45c4aec55dc23986743394d"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcElicitationThroughIntake;
        verification dcElicitationThroughIntakeDoD : Test { :>> id = "dee9928f-0934-47ed-9e36-364d6d6aec6e"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue245 (MEDIUM). keel's actual elicitation surface is the business-architecture SKILL (it runs a design/scoping dialogue Brief->Personas->Needs->UseCases and has authored 11 Briefs, 15 Personas, 69 UseCases, 75 Needs), but (a) it has NO process definition, so it appears in no catalogue, is enforced by nothing and is transferable by nothing - and the process-skill guard is one-directional (it requires every process to have a skill, never every skill to have a process), so nothing notices; and (b) it authors Needs from a conversation whose utterances are never recorded, which is the mechanical cause of the unsourced population and the D0157 'wider than the demand' risk - a Need with no cited utterance cannot be checked against what the human said. DO: give business-architecture a process definition; make its dialogue record each answer verbatim as a Statement before authoring the Brief/Needs, with every authored Need carrying #DerivedFrom to a UserStory citing one; make process-skill bidirectional. VERIFY: the skill appears in the catalogue and exports; a dialogue run produces Statements before Needs; a skill naming no process is flagged."; }
        part dcElicitationThroughIntakeDoDR1 : TestResult { :>> id = "b8ae6a98-2ca5-407a-9934-e5914ecf1210"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "00417f16318529a5d0ac04ede8df3293cd9658cd"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcInitContractReset;
        verification dcInitContractResetDoD : Test { :>> id = "0e6a0c07-f5ce-4aae-b38a-5683bebf8aef"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue243 (MEDIUM). `keel init` scaffolds the embedded .engine verbatim, so a fresh project inherits THIS repo's adoption declaration: the new tree's .engine/contracts/activation.toml is byte-identical to the self-build's (11 named active processes + 32 viewpoints) and `keel activation` there reports 'declared manifest: yes' for a declaration that project never made - falsifying CLAUDE.md's guarantee that an absent manifest means everything is active so a project that never adopted a control has not violated it. It also inherits unit-ids.toml, i.e. the self-build's EXCHANGE identity for units the new project never exported. DO: init emits a starter (or omits) activation.toml and does not copy unit-ids.toml/installed-units.toml - the same special-case shape init already uses for deliverable-manifest.txt. VERIFY: a fresh init declares nothing it did not choose; activation reports the honest default; no inherited unit ids."; }
        part dcInitContractResetDoDR1 : TestResult { :>> id = "9e194d94-5af3-4302-8cea-c753181221bc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "7b7f7791c962e895238c3ab67023e1aa324be452"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcDocCountsReconciled;
        verification dcDocCountsReconciledDoD : Test { :>> id = "c7029525-4be2-4ef6-8a9b-9f2aae4a024c"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue246 (LOW). A number typed into prose beside a number the engine can compute, with no control tying them: CLAUDE.md and .engine/docs/guards.md both say '45 forward guards' while keel guard runs 48; the shipped activation.toml header still directs readers to .engine/contracts/process-units.toml, a file D0141 deleted. hardening.helpCoverage already proves the technique (88 dispatched / 88 documented), so the counter-measure is cheap. DO: reconcile declared counts against their computed source in the doc surface, and sweep the ghost reference. VERIFY: the doc counts match the computed ones and a deliberate mismatch is flagged."; }
        part dcDocCountsReconciledDoDR1 : TestResult { :>> id = "b8f2d3cf-a806-4f4b-92b7-b4e80a746856"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "766343d54c7f883b457b38f5b23f08fd66f560de"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        verification dcOverrideThreadEveryAcceptDoD : Test { :>> id = "55181156-ff00-4b9a-929d-5a975712275a"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue238 (channel-bypass, caught by the human: I claimed D0209 was overridable on its GitHub issue but NO issue existed). D0205's githubChannel opens an override-thread issue only for PROPOSED decisions; a decision accepted locally (serve API / keel accept) before its push is already 'accepted' when the workflow runs, so the proposed-only issue-opener skips it and the human loses the override surface (confirmed: d0207 and d0209 had zero issues). DO: open_decision_issues.py gains ensure_override_threads() - for EVERY accepted decision numbered >= D0205 (the channel's birth) that has no thread on any state, it opens-and-closes an override-thread issue, regardless of acceptance path; run on every push. VERIFY: three mocked-gh dry-runs against the real decision-card set - none-exist targets exactly d0205..d0209 (5); all-exist targets 0; only d0207/d0209 missing targets exactly those 2 (the exact real bypass); a true decision is matched by name d + four digits, so acceptance-record cards (d0205AcceptR1) are excluded."; }
        part dcOverrideThreadEveryAcceptDoDR1 : TestResult { :>> id = "081106f7-d48f-49c7-8955-5981ee80e797"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3b6570f"; :>> judgedAt = "2026-08-23"; :>> judgedBy = "claudeFable5"; }
