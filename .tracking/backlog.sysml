        action dcProcessRemoveCommand;
        verification dcProcessRemoveCommandDoD : Test { :>> id = "15630119-583c-444c-8387-545550477198"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: keel process remove <unit> removes an installed process unit as one act under a co-committed Decision - the process file, its skill and registry, its declared extras, its installed-unit record, its unit id and its adoption entry - and refuses when any live surface still references the unit (tool-reference, process-skill, activation-manifest and control-map-reconciled would go red), naming the references so the remover rewrites them first. Twice now (exec-summary, sprint 524; decision-channel, sprint 527) a unit was removed by hand-editing two contracts because process lists, exports and imports and deactivate is not removal. VERIFY: a fixture imports a unit, removes it, and every contract and file is gone with the tree green; removal with a dangling reference refuses and names it; the library copy is untouched and the output says so."; }
        action dcDeactivatedSkillSaysSo;
        verification dcDeactivatedSkillSaysSoDoD : Test { :>> id = "59bf4163-3605-4b58-941e-a639a74899fc"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: sync-claude deploys the skill of a DEACTIVATED process with its inactive state written first in the skill's description, so an agent reading its skill list learns the channel is closed before acting. GH#49 (st080): deactivate turned off the guard but the skill stayed deployed unchanged. OPTION B, the reporter's own lean, chosen over removal because a removed file reads as drift (GH#46) and a stated state teaches the model. VERIFY: deactivate a process in a fixture, sync-claude, the skill file begins with the inactive statement; reactivate, it does not; claude-surface-drift stays green in both states."; }
        action dcRedYieldKeepsTheDiagnostic;
