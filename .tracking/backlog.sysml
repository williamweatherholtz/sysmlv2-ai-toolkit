        part dcKickoffReadyDoDR1 : TestResult { :>> id = "f1e48f27-d51e-4f91-aef7-70d2725105c6"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "c4d5dbf"; :>> judgedAt = "2026-08-29"; :>> judgedBy = "claudeOpus5"; }

        action retireTheConfidenceProse;
        // ── D0052 reorder (st035, 2026-08-29): PRIORITY IS ASSESSED, from the computed signals -
        // resolver severity first (Critical > High > Medium > none), the priority-inversion guard's
        // six standing warnings discharged rather than re-explained. dcRenameIsAChange (Critical
        // issue273) had sat at rank 16 below two no-issue items. ──
        action dcRenameIsAChange;
        verification dcRenameIsAChangeDoD : Test { :>> id = "41830da5-272d-4f06-a55e-7ba90484985d"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue273 (D0235). An adversarial panel found that the issue272 fix - narrowing the keystone lock from --diff-filter=ACMR to MD so a fresh scaffold could make its first commit - DROPPED R, renames. Reproduced on a plain single-project repo: sed blocking to warning into rules2.sysml, remove rules.sysml, git add -A gives git an R096 rename, the MD filter matches nothing, and guard process-change reports PASS 0 scanned - every blocking rule downgraded by a git mv with no signed Decision, live in every repository. Same function, second blindness: git C-QUOTES non-ASCII paths in this output while rev-parse --show-prefix does not, so a project whose name carries a non-ASCII byte was invisible to the workspace gate and to its own guards. DO: the keystone reads MDR, never a bare A; the staged-path reader parses NUL-separated --name-status -M records with core.quotePath=false and returns BOTH sides of a rename. VERIFY BOTH DIRECTIONS: the rename downgrade FAILS with both paths named where it passed before; a fresh keel init plus git add -A plus commit still SUCCEEDS through the scaffolded hook so the issue272 fix survives; this repo guard output is otherwise unchanged."; }
        // RAN: // RAN: keel-cli/tests/keystone_sees_renames.rs -> 3/3. Direction 1: a REAL staged rename (git-confirmed R09x, asserted in-fixture after the first draft staged a D+A below similarity threshold) of a locked rules file with a blocking->warning downgrade FAILS guard process-change naming the path - the exact issue273 reproduction that once passed with 0 scanned. Direction 2: a fresh keel init's first commit (all additions) still PASSES, so the issue272 fix survives the MDR re-widening. Direction 3: the same downgrade renamed to a non-ASCII (C-quoted) filename still FAILS - the second blindness. The guard-side fix (--name-status -M -z, core.quotePath=false, both rename sides) had landed with the panel's finding; this probe is the DoD's owed VERIFY, discriminating in both directions
        part dcRenameIsAChangeDoDR1 : TestResult { :>> id = "5a96d6d6-d8c7-4844-bfe0-22d191a256cf"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "fd7a064"; :>> judgedAt = "2026-08-29"; :>> judgedBy = "claudeOpus5"; }
        action dcIntakeHasAWritePath;
        verification dcIntakeHasAWritePathDoD : Test { :>> id = "4f9e92b3-7517-49f6-b298-69d4ac46881f"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue289. Intake had NO write path: keel record covered decision and issue only, so every Statement and UserStory in this repository was written by hand-editing a file. That is the record type where it matters most, because D0216 makes the VERBATIM Statement the precondition for every Need - a Need with no cited utterance cannot be checked against what the human actually said, which is how one comes to be written wider than the demand (D0157). Hand-editing meant no actor validation, no write lock, no refusal on a defaulted date, and nothing stopping a paraphrase typed from memory being stored in a field labelled verbatim. DO: keel record statement and keel record story, with --from FILE for prose (the D0224 lesson: prose through shell arguments is how tool output got injected into a governance record twice); a Statement's text escaped ONLY as the literal requires, never through the whitespace-collapsing sanitiser used for titles; an unknown channel or implication REFUSED rather than defaulted, because the channel is provenance; and a story's #DerivedFrom edge authored WITH it, with a story citing a non-existent Statement refused and nothing written. VERIFY: the human's own message recorded and read back BYTE-IDENTICAL including double spaces; a title through the same input collapses, proving the two escapings differ; a story citing st999 is refused and leaves no trace; the edge is present in the file; three unit tests plus a live end-to-end run."; }
        // RAN: // RAN: cargo test -p keel-cli --lib intake_write -> 4 passed: a_statements_text_survives_verbatim_where_a_title_would_be_collapsed (byte-identical round-trip INCLUDING double spaces, and the title collapse contrast proving the two escapings differ), a_statement_records_and_a_story_must_cite_one (st999 refused, nothing written; #DerivedFrom authored WITH the story), an_unknown_channel_or_implication_is_refused_rather_than_defaulted, every_schema_declared_member_of_both_intake_vocabularies_is_accepted (the issue300 control). LIVE: st001-st036 + us001-us051 all entered through keel record statement/story across this arc, including six concurrent writers in the lock probe. issue289 and issue300 resolve
        part dcIntakeHasAWritePathDoDR1 : TestResult { :>> id = "62870ad8-0507-43cc-aa4b-ca8ffa2a2aa7"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "fd7a064"; :>> judgedAt = "2026-08-29"; :>> judgedBy = "claudeOpus5"; }
        action activateDoesNotLoseFacts;
        verification activateDoesNotLoseFactsDoD : Test { :>> id = "61d241cd-5d97-4c38-be49-8b3409229c96"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: keel activate / keel deactivate PRESERVE every fact in .engine/contracts/activation.toml that they do not intend to change. Measured loss on one deactivate+activate round trip: charteredBy = d0226 was deleted along with its explanatory comment (the D0225 charter reference - a set without a charter is a collection of switches nobody can account for), and decision-authoring was dropped from active because it is [always] and asserts no guard, so the writer omits non-switchable processes. The second is worse than untidy: an ABSENT section means everything is active (D0138/D0164), but a PRESENT list of 10 of 11 means the 11th is INACTIVE, so omitting a process from a list that exists is a semantic change. VERIFY: a deactivate+activate round trip leaves the file byte-identical apart from the one process named; charteredBy and comments survive; a non-switchable [always] process is never removed from a present active list; held by a test that round-trips the real file."; }
        // RAN: // RAN: see sprint497. RED-first 4/4 reproducing both documented losses, GREEN 4/4; byte-identical live round trip on .engine/contracts/activation.toml (git diff empty); charteredBy + its comment survive; decision-authoring ([always]) never dropped from a present list; the one named process is the only thing that changes
