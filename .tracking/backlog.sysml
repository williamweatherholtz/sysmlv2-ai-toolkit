        action viewerSystemBoundViews;
        verification viewerSystemBoundViewsDoD : Test { :>> id = "71e8db70-cee1-438f-9a38-0a9a629e50ed"; :>> method = VerificationMethod::demo; :>> procedureText = "srViewerSystemBoundViews (D0126): sibling/children/ancestry dynamic views with a shifting focus. keel: compute, from a focus, SIBLINGS (same type sharing a parent via a shared incoming edge), CHILDREN (downstream closure), ANCESTRY (upstream trace) — reuse the slice/traversal engine (directional, typed). Expose as slice modes or a /api/relations endpoint. viewer: context-menu Siblings/Children/Ancestry re-anchor the graph + a working set; VMC (view/modify/critique) over the set. Pure computed views, no stored state."; }
        part viewerSystemBoundViewsDoDR1 : TestResult { :>> id = "ce65bfc1-96d0-45dc-803c-390f013b2594"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d21ee73"; :>> judgedAt = "2026-07-17"; :>> judgedBy = "claudeOpus"; }
        action viewerCreateLinkage;
        verification viewerCreateLinkageDoD : Test { :>> id = "bc9eae8c-81f0-44fb-9a38-0a9a6a1d91d5"; :>> method = VerificationMethod::demo; :>> procedureText = "srViewerCreateLinkage (D0126): create authors traceability edges, not orphans. viewer: the New-item flow (+ a connect action on existing items) offers upstream/downstream 'connect to' targets with the valid edge kinds for the pair (closed algebra); on create, author the item (/api/item) + edges (/api/edge) in one flow; inline /api/check. Depends partly on srViewerRelationshipGrammar for which edge kinds are valid per pair (until then, offer the full algebra + let guards/check validate)."; }
        part viewerCreateLinkageDoDR1 : TestResult { :>> id = "b516d19e-4c0c-4a21-ae4c-e92b1d4c89c3"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "1e7f524"; :>> judgedAt = "2026-07-17"; :>> judgedBy = "claudeOpus"; }
        action keelProcessPortability;
        verification keelProcessPortabilityDoD : Test { :>> id = "e61843aa-b7d2-46ad-9f61-4a3c3cae2ff7"; :>> method = VerificationMethod::demo; :>> procedureText = "Modular process portability (nProcessPortability, D0128): make a process a self-contained unit (definition + deploying skill + DECLARED rules/guards + metadata); a per-project ACTIVATION manifest so guards/orient enforce only active processes; keel process list/search/import/export/activate/disable + a curated palette; BYO + AI-assisted selection; opt-in popularity. Leans on the D0105/D0107 declarative-rules migration so activate/disable toggles enforcement."; }
        part keelProcessPortabilityDoDR1 : TestResult { :>> id = "0d80024e-0814-624e-9b3e-00000030024e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "76635b4"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        // ── extensibility: project-declared types (raised from the fcn-arch STPA project, 2026-08-07) ──
        action userDefinedTypedefs;
        verification userDefinedTypedefsDoD : Test { :>> id = "2716f8e8-19fb-493b-b80b-3853bc0f1269"; :>> method = VerificationMethod::test; :>> procedureText = "Let PROJECTS declare their own domain types in .tracking/ and have keel resolve them everywhere (validate/guard/render/query), so a project can extend the model WITHOUT editing the read-only .engine/ schema. TODAY a user-authored `part def` in .tracking fails semantic validation with `unresolved type reference` — type resolution only scans .engine/schema. MOTIVATING CASE (fcn-arch STPA control structure): the engine provides EngineSafety::ProcessModel (a controller's BELIEFS) but no type for a controller's CONTROL ALGORITHM (its decision logic); Leveson/Thomas treat these as distinct. Modeling both cleanly needs a project-local `part def ControlAlgorithm :> Element { attribute logic : String; ref heldBy : Controller; }`, which cannot be added to the frozen engine schema and does not resolve from .tracking. DESIGN: resolve type defs authored under .tracking (subtyping Element / engine defs), same as schema/core — likely extend the schema text-scan (cf. build_dod_files / viewerSchemaApi /api/schema) to include .tracking type defs; decide precedence + collision rules vs engine types; ensure /api/schema, guards, and renderers pick them up automatically. Consider whether this should be gated (a project may WANT the engine schema to be the sole authority — make it opt-in per project). VERIFY: a project `part def Foo :> Element { attribute bar : String; }` in .tracking + instances `part x : Foo { :>> bar = \"y\"; }` validate clean and guard green; /api/schema lists Foo with attribute bar; a renderer/query can select Foo instances; clippy + cargo test + keel validate + guard green."; }
        part userDefinedTypedefsDoDR1 : TestResult { :>> id = "0d80025e-0814-625e-9b3e-00000030025e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "eeebc13"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action keelReleaseProcess;
        verification keelReleaseProcessDoD : Test { :>> id = "4a71c549-2c70-420d-9f61-4a3c44ebb513"; :>> method = VerificationMethod::demo; :>> procedureText = "Disciplined release/deploy (nReleaseDiscipline, D0128): operationalise the Deploy workflow — a deploy PROCESS + deploying skill (D0059); semver reconciled across crate/API/engine; a CI job that builds + publishes a GitHub release on a vX.Y.Z tag; a recorded Release item (version + SHA + contents); cadence per-milestone. First real run cuts a fresh release (main is a month past v0.1.0)."; }
        part keelReleaseProcessDoDR1 : TestResult { :>> id = "3494ec32-f721-4bdc-9fb3-77a257bb6616"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e2c812f"; :>> judgedAt = "2026-08-14"; :>> judgedBy = "claudeOpus5"; }
        // ── extensibility: project vocabulary as INGESTED data, not a side-channel file
        // (raised from the fcn-arch function dictionary, 2026-08-11; needs userDefinedTypedefs first) ──
        // ── distributed collaboration: async remote mostly-AI team (D0129, 2026-08-12) ──
        // DAY-ONE BLOCKERS (dcMergeOnly..dcPortableGate): without these a multi-machine team
        // corrupts the model in week one. Each closes a VERIFIED defect (see D0129 context).
        action dcMergeOnlyIntegration;
        verification dcMergeOnlyIntegrationDoD : Test { :>> id = "0d5e0001-0812-4e01-9b3e-00000000e001"; :>> method = VerificationMethod::demo; :>> procedureText = "srDcMergeOnlyIntegration (D0129). Closes the EXISTENTIAL defect: orient is machine-dependent because `done` needs judgedAgainst to RESOLVE (orient.rs:494-531/123) and squash/rebase mint new SHAs, so the rewriting machine reads green while every other clone reads invalidEvidence and re-lists finished work. DO: (a) remote — disable squash-merge + rebase-merge, protect main (no force-push, no deletion), require the CI check; (b) local — rewrite .githooks/post-commit so a rejected push FETCHES and MERGES (never rebases) and retries, reporting loudly on failure instead of printing a note; (c) add a pre-merge-commit hook so merge commits are gated like any other; (d) document merge-never-rebase in CLAUDE.md. VERIFY: `gh api` shows squash+rebase disabled and main protected; two clones push concurrently and the loser auto-merges + lands with every judgedAgainst still resolvable in BOTH clones; a deliberate rebase attempt on evidence-carrying commits is refused/flagged; orient output is byte-identical across the two clones. clippy + validate + guard + check-engine green."; }
        part dcMergeOnlyIntegrationDoDR1 : TestResult { :>> id = "9b23fa03-a52c-4aa9-acda-5e09293ef2e7"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b518c23"; :>> judgedAt = "2026-08-12"; :>> judgedBy = "claudeOpus5"; }
        action dcDuplicateIdentityGuard;
        verification dcDuplicateIdentityGuardDoD : Test { :>> id = "0d5e0002-0812-4e02-9b3e-00000000e002"; :>> method = VerificationMethod::test; :>> procedureText = "srDcUniqueIdentityGuard (D0129). Closes SILENT corruption: two offline agents both mint the next decision number by directory scan (write.rs:929-942); different slugs => different filenames => NO git conflict => both land => duplicate `package DecisionNNNN` silently merged by registry.rs:52-53. No guard among the seventeen detects duplicate id or name. DO: add a hard-blocking `duplicate-identity` guard (new entry in GUARD_NAMES + guards.rs) that scans the whole model for repeated element `id`, repeated declared item name within a package, repeated package name across files, and repeated allocated sequence number (decision/issue/sprint). Prefer sourcing it as a DECLARED ElementRule (D0105/D0107) if it fits the generic evaluator; otherwise Rust with the rollback criterion recorded. VERIFY: unit tests for each of the four duplicate classes fail the guard and a clean model passes; a synthesized duplicate DecisionNNNN pair is caught (the registry-merge case); guard runs in the pre-commit hook + CI; clippy + cargo test + validate + guard green."; }
        part dcDuplicateIdentityGuardDoDR1 : TestResult { :>> id = "589dc901-ed7e-42ee-9bf0-c45122c9047f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b518c23"; :>> judgedAt = "2026-08-12"; :>> judgedBy = "claudeOpus5"; }
        action dcCollisionResistantIds;
        verification dcCollisionResistantIdsDoD : Test { :>> id = "0d5e0003-0812-4e03-9b3e-00000000e003"; :>> method = VerificationMethod::test; :>> procedureText = "srDcCollisionResistantIds (D0129). gen_uuid (write.rs:63-99) mixes only clock seconds + subsec nanos + PID + an in-process counter that is 0 for the first record of every invocation, self-documents as 'not cryptographically random', and has NO host component — so independent machines are not independent sources, and identity (CLAUDE.md §2.3) is what a collision corrupts. DO: replace with a cryptographically-seeded random UUIDv4 (os RNG / `uuid` crate with the `v4` feature), keeping the emitted format identical so existing ids and parsers are unaffected. VERIFY: generated ids are RFC-4122 v4 (version + variant nibbles correct); a large-volume generation test shows no collisions and no clock/PID correlation; ids differ across simulated same-instant same-PID generation; existing recorded ids untouched; clippy + cargo test + validate + guard green."; }
        part dcCollisionResistantIdsDoDR1 : TestResult { :>> id = "c8b18ea7-f596-471e-96b4-6799e9fe5eda"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b518c23"; :>> judgedAt = "2026-08-12"; :>> judgedBy = "claudeOpus5"; }
        action dcActorIdentityBinding;
        verification dcActorIdentityBindingDoD : Test { :>> id = "0d5e0004-0812-4e04-9b3e-00000000e004"; :>> method = VerificationMethod::test; :>> procedureText = "srDcActorIdentityBinding + srDcActorKindClassification (D0129). Closes TWO independent confirmation-authenticity bypasses (D0106/issue059 exists to stop an AI fabricating HUMAN acceptance): (i) seven serve.rs sites default author/judged_by to the human 'wweatherholtz' (304,331,357,384,409,483,1313), record decision likewise (main.rs:967), and five paths default to the UNREGISTERED 'keel-cli' (main.rs:910,935,1121,1151) — so an AI-driven call that merely OMITS the field records a human attestation silently; (ii) capture_user.py registers every enrolled actor as `: Person` with no kind question, so an onboarding AI is registered as a human and thereafter satisfies the guard legitimately. DO: resolve the acting actor from an explicit per-machine binding (config file or env var) or an explicit argument; REFUSE the write when unstated; remove every default that names a human or an unregistered actor; make actor kind an explicit required input when registering, with no inference from git identity and no Person default. VERIFY: every write path refuses with a clear message when identity is unstated; no default in the codebase names a registered human or an unregistered actor (grep-asserted in a test); registering an AI produces `: Actor` with kind=ai and cannot produce Person; a fabricated-human-acceptance attempt by an AI actor is refused; confirmation-authenticity guard still green; clippy + cargo test + validate + guard green."; }
        part dcActorIdentityBindingDoDR1 : TestResult { :>> id = "b03308aa-ed75-40e1-b60c-cdd9fcb24ea7"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b518c23"; :>> judgedAt = "2026-08-12"; :>> judgedBy = "claudeOpus5"; }
        action dcPortableGate;
        verification dcPortableGateDoD : Test { :>> id = "0d5e0005-0812-4e05-9b3e-00000000e005"; :>> method = VerificationMethod::demo; :>> procedureText = "srDcPortableGate (D0129). The local gate evaporates off this machine: .githooks/pre-commit:17-21 hardcodes an absolute conda path + a Windows binary name; elsewhere it prints 'guards skipped' (pre-commit:66-68) so the gate silently becomes nothing, or aborts .engine commits and teaches SKIP_VALIDATE=1; only pre-commit/post-commit are installed so `git merge` (pre-merge-commit) is UNGATED — the conflict-resolution commits this workflow generates are exactly the ones with no local check; .gitattributes normalizes only *.sh, leaving *.sysml at each machine's core.autocrlf, which turns every shared model file into a whole-file phantom diff for a differently-configured contributor. DO: probe for `keel`/`keel.exe` on PATH and in target/release; make the conda/kernel path configurable and OPTIONAL (skip the kernel layer with a clear notice, never abort); install pre-merge-commit; add `* text=auto` + `*.sysml text eol=lf` to .gitattributes; make an unrunnable check FAIL LOUDLY rather than pass silently. VERIFY: the hook runs clean on a POSIX machine with no conda and on Windows; a merge commit is gated; a missing binary yields a NON-ZERO honest failure, not a silent skip; `git ls-files --eol` shows *.sysml as lf after normalization with no content change; clippy + validate + guard + check-engine green."; }
        part dcPortableGateDoDR1 : TestResult { :>> id = "8a14bcac-2c49-4800-8de8-2b9748f7a30b"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b518c23"; :>> judgedAt = "2026-08-12"; :>> judgedBy = "claudeOpus5"; }
        // FROZEN-SCHEMA sign-off required (CLAUDE.md §2.5) — deliberately NOT day-one.
        // FOLLOW-ONS (post-day-one; each its own sprint).
        action dcTwoPassRegistration;
        verification dcTwoPassRegistrationDoD : Test { :>> id = "0d5e000e-0812-4e0e-9b3e-00000000e00e"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue079 (filed 2026-08-12 for a fix found + written in an EARLIER, uncommitted session and never recorded). Defect: validate_root registered and validated each .tracking package in ONE pass, so resolution depended on filesystem iteration order — a tracking file importing another package (requirements.sysml importing ProjectBusiness) failed when visited before that package was registered. It flaked on CI's Linux file order while PASSING on Windows: a machine-dependent validation verdict, the same class as issue071 with the filesystem rather than the git object store as the varying input. FIX (present in the working tree, uncommitted at time of filing): two-pass — parse and register ALL tracking packages first, THEN validate all (keel-cli/src/lib.rs validate_root; mirrored in keel-parser/tests/parse_engine_files.rs). VERIFY: validation verdict is identical under reversed/randomized file iteration order; a cross-package import resolves regardless of visit order; the CI-vs-Windows divergence no longer reproduces; clippy + cargo test + keel validate + guard green. NOTE the fix is another session's uncommitted work — its author should confirm + commit it; this entry exists so the defect is RECORDED rather than living only in a code comment."; }
        part dcTwoPassRegistrationDoDR1 : TestResult { :>> id = "774e5edd-8898-4da1-af7c-1cc5fa5ec898"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b518c23"; :>> judgedAt = "2026-08-12"; :>> judgedBy = "claudeOpus5"; }
        action projectVocabularyIngestible;
        verification projectVocabularyIngestibleDoD : Test { :>> id = "bfc1758a-f24e-4eab-b09d-031c87cea5a5"; :>> method = VerificationMethod::test; :>> procedureText = "Let a project author its DOMAIN VOCABULARY as facts keel INGESTS, so the two-model boundary (CLAUDE.md section 1 - the deliverable's own vocabulary stays in the deliverable's model) stops pushing authored data OUT of keel. Builds on userDefinedTypedefs, but is not the same ask: type resolution makes project types PARSE; this makes their instances COUNT (identity, query, render, coverage, temporal). SECOND MOTIVATING CASE (fcn-arch, 2026-08-11, Decision d0012 - independent of the ControlAlgorithm case that raised userDefinedTypedefs): the project needed a FUNCTION DICTIONARY as the enforced vocabulary for its functional architecture - 7 function kinds each with a definition-of-done template, 59 sanctioned verbs each with its kind + definition + a real example, 25 retired verbs each with why it was retired and what to use instead, 4 node roles with their obligations, and 12 naming rules each with rationale and example (about 100 terms). Authoring it in .tracking needed 5 project part defs subtyping Element (FunctionKindDef, FunctionVerb, RetiredVerb, NodeRoleDef, NamingRule). `keel validate` returned 107 semantic diagnostics, every one `unresolved type reference`. FALLBACK TAKEN: the vocabulary moved to keel/views/function-dictionary.yaml - authored YAML OUTSIDE .tracking - plus a project-side generator and renderer. COST OF THE FALLBACK (this is the real problem): that vocabulary is NORMATIVE (adopted by Decision d0012) and is what the project's checker enforces against, yet it has no UUID identity in the model, cannot be reached by satisfy/verify/allocate edges, is invisible to orient, coverage, critique and suspicion, is absent from /api/schema, cannot be selected by a declared view (D0075 enriched-select), and cannot be asked as-of a commit via the git-temporal substrate (D0013). A retired verb is exactly the kind of fact that should go SUSPECT when the decision behind it changes - and it cannot. Every downstream project that needs a controlled vocabulary (glossary, taxonomy, unit set, verb dictionary, state alphabet) will hit this and will invent its own side-channel file, so the engine loses sight of the deliverable's own definitions. DESIGN NOTES: (a) resolution alone is insufficient - decide how project-typed instances flow into the enriched item-table (D0075) so views can select them, and whether they are exempt from work-item semantics so orient/burndown do not miscount a glossary term as work; (b) they should carry the standard Element attrs (id/title/createdAt/createdBy) and take part in edges, so a Decision can verify-link a vocabulary; (c) consider a declared 'reference data' class of project type - authored, versioned, edge-addressable, but NOT work - since that is what a dictionary, glossary or taxonomy actually is; (d) keep it opt-in per project (a project may want the engine schema as the sole authority). VERIFY: a project authors >= 2 domain types + >= 20 instances under .tracking; keel validate and guard are green; the instances appear in /api/schema and are selectable by a declared view; they carry UUID identity and createdAt/createdBy; a Decision can satisfy/verify-link them and they go suspect when it changes; as-of queries work at an older commit; orient/burndown do not count them as outstanding work; the fcn-arch function dictionary is migrated from views/*.yaml back into .tracking with no loss and its checker reads the model instead of the YAML; clippy + cargo test + keel validate + guard green."; }
        part projectVocabularyIngestibleDoDR1 : TestResult { :>> id = "0d80025f-0814-625f-9b3e-00000030025f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "eeebc13"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action dcContractDedup;
        verification dcContractDedupDoD : Test { :>> id = "0d650002-0813-4502-9b3e-000000150002"; :>> method = VerificationMethod::inspect; :>> procedureText = "Resolves issue086 (raised by the sprint 249 retro under the new issue085 obligation — a retro finding must become a tracked item, not prose). D0130 makes the output style the CANONICAL home of the response contract and CLAUDE.md a REFERENCE, and a pointer was added at the head of section 3 — but the RESTATEMENT was not fully removed: section 3's 'Strict process-boundedness' paragraph still spells out the Parsed-block mandate, the label vocabulary and the trivial-exemption rule that `.claude/output-styles/keel.md` now owns. Two live copies of one rule is exactly the dual truth D0105 forbids, and the copy in the weaker layer is the one that will drift. DO: reduce section 3 to the ROUTES (the classification table + the recurring-or-one-time check) plus a pointer, deleting the restated contract text outright — no tombstones, state what IS. Then confirm no other doc surface restates it (grep the doc surface per the doc-sync skill). VERIFY: the Parsed-block format, label vocabulary and trivial-exemption appear in EXACTLY ONE place (the output style); CLAUDE.md section 3 still fully defines the routes; guard doc-sync passes; keel validate + guard green."; }
        part dcContractDedupDoDR1 : TestResult { :>> id = "b8e6a21f-f0c4-4356-ab29-e3f76d96aa00"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e2c812f"; :>> judgedAt = "2026-08-14"; :>> judgedBy = "claudeOpus5"; }
        // ---- deprioritized: lowest-value ready work ----
        action keelArchViews;
        verification keelArchViewsDoD : Test { :>> id = "4152d90a-2a4d-4ccb-b0cf-aabcca5b6261"; :>> method = VerificationMethod::test; :>> procedureText = "Add the keel `arch` view command group so a downstream project's EngineCodeAudit CodeElement registry is COMPUTABLE (first consumer: SelfSync, its D0029 + docs/design-history/2026-07-18-architecture-audit-design.md). Prereq: promote the EngineCodeAudit schema module (CodeElement + RiskClass/InvariantSafety/StpaRole/DesignPattern + #Controls/#Feedback/#Restructure markers) into the engine's shipped schema so `keel init` gives every downstream the type (SelfSync authored a local copy at .engine/schema/codeaudit/ to prove the model; keel already parses the module-defined type generically). Commands (all COMPUTED views; keel never parses deliverable source — it reads authored CodeElement instances + the Needs graph + the in-code @audit-hash markers): arch elements [--kind --file] (list); arch criticality (risk-class tier bumped by high-severity Need-trace = the ranked audit frontier); arch coupling (Ca/Ce/instability/distance-from-main-sequence + dependency cycles over the #DependsOn graph); arch drift (each CodeElement.codeHash vs the live // @audit-hash, reusing the audit_hash brace-scan -> the re-audit frontier, unifying with D0028); arch stpa-inputs [--render] (the captured stpaRole/actions/#Controls/#Feedback control structure as the hand-off to a later STPA analysis process, NO analysis here); arch coverage (non-blocking: heuristic top-level-def enumeration flags un-catalogued elements). Register each as a declared viewpoint (viewpoint-registry). VERIFY: on SelfSync's authored registry, arch criticality ranks the DataLoss/security elements top; arch drift flags a function whose body changed since its codeHash; a coverage-floored test per command; clippy + cargo test + keel validate + guard green."; }
        part keelArchViewsDoDR1 : TestResult { :>> id = "4f960cbe-1400-494f-8170-f7b332a5a288"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "4bf8906"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
    }

    // issue106 established that `ref createdBy : Actor` cannot be built without inverting the D0093
    // engine/instance boundary, and sprint 278 recorded that dcProvenanceAsRefs "must not be executed
    // as written". That was recorded in PROSE inside a procedureText and nowhere else, so the item
    // stayed on the ready frontier — third-ranked, auto-followed (D0052), and pointing a successor at
    // work already found to be structurally impossible. The retirement is a typed edge or it is not
    // state (D0018 / issue100).
    #Supersede dependency from dcActorTraceView to dcProvenanceAsRefs;

    #Resolves dependency from dcSchemaSweepResidue to issue108;

    // dcWorkClaim cannot start until D0147 signs a `Claim` type into frozen core, and the frontier is
    // AUTO-FOLLOWED (D0052) — so without this edge the next contributor is pointed straight at work
    // that provably cannot be done. The edge is the authored fact; `ready` computes the rest, and the
    // item returns by itself when the Decision is accepted or rejected (issue112).
    #DependsOn dependency from dcWorkClaim to d0147;

    // keelArchViews cannot start until D0148 ships a `CodeElement` type for `keel arch` to read.
    // The frontier is AUTO-FOLLOWED (D0052), so without this edge the next contributor is pointed at
    // work whose own DoD opens with an unmeetable prerequisite (issue112's machinery, issue114).
    #DependsOn dependency from keelArchViews to d0148;

    // dcCorrectExclusionText changes PROCESS DEFINITION text (§3a), so it cannot start until D0149 is
    // signed off. The frontier is AUTO-FOLLOWED (D0052) — without this edge the next contributor is
    // pointed at a correction they are not authorised to apply (issue112's machinery).
    #DependsOn dependency from dcCorrectExclusionText to d0149;

    // dcVerifyBeforeAsserting changes the RESPONSE CONTRACT (§3a), which lives in the output style
    // per D0130, so it cannot start until D0151 is signed off. Without this edge the auto-followed
    // frontier would point a successor at a contract edit nobody authorised (issue112's machinery).
    #DependsOn dependency from dcVerifyBeforeAsserting to d0151;
        action dcGateEvidenceControl;
        verification dcGateEvidenceControlDoD : Test { :>> id = "bcb6f165-a75b-4377-a8e1-632838c05dbd"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue116. A commit made with hooks bypassed is INDISTINGUISHABLE from a gated one afterwards, which I proved by making one: to build a two-clone fixture I committed with core.hooksPath set to the null device, and the only reason it was recovered is that I disclosed it in the same session. Disclosure is not a control (D0047). DO: a check that computes, over a commit range, which commits carry no evidence of having passed the gate, and reports them - so a bypass is VISIBLE in a computed view rather than depending on the bypasser to mention it. DESIGN CONSTRAINT, and the hard part: the evidence must be something a bypasser cannot trivially forge while still being derivable from the repo alone, so a self-asserted 'I ran the gate' marker in the commit message is NOT sufficient. Consider instead re-running the gate at each commit in the range and reporting which commits FAIL it - honest, forgery-proof, and expensive, so it belongs in CI or an on-demand audit rather than in the per-edit tier. VERIFY: the known-bypassed commit in this repo's history is detected by whatever rule is chosen, or the rule is documented as unable to detect it and says why; a clean range reports nothing; the check never blocks a commit (it is an audit, not a gate, per D0098 - completeness is a burndown, not a commit gate); clippy + cargo test + validate + guard green."; }
        part dcGateEvidenceControlDoDR1 : TestResult { :>> id = "68399d59-3a31-4c27-a741-adfea016481b"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "9bcab3b"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action dcCorrectExclusionText;
        verification dcCorrectExclusionTextDoD : Test { :>> id = "e3cb927f-e5ce-4822-9b6f-384d013fa8a4"; :>> method = VerificationMethod::inspect; :>> procedureText = "Resolves issue115. D0129 and the dcWorkClaim DoD both state that two contributors claiming one item are excluded because the remote accepts exactly one push (a ref update being a compare-and-swap). A two-clone race test DISPROVED this: claims are written to per-actor files under srDcPerActorWriteTargets, which deliberately removes the write contention, so the loser merges and retries and BOTH claims land. claim.rs now states the true mechanism and computes the holder, but the PROCESS TEXT still teaches the false one - dual truth in exactly the document a downstream project would build on. DO: correct D0129's exclusion clause and the dcWorkClaim DoD text, and check the distributed-collaboration skill and any doc making the same claim. The correction is not a footnote: it changes exclusion from a property of git to a property of a computed rule, and the two facts that fell out of it belong in the corrected text - that whoever-landed-first is NOT recoverable from merged history (parallel claims are siblings of equal ancestry depth and their commit timestamps tie within a second), and that expiry must remove a claim from contention rather than only from the top of the ranking. VERIFY: no surviving doc asserts the push provides exclusion; grep the doc surface for the compare-and-swap claim; validate + guard green; the correction rides one commit with its doc-sync."; }
        part dcCorrectExclusionTextDoDR1 : TestResult { :>> id = "93023c80-3565-4a4e-941e-eab56825d727"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "01fce65"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        // Ranked ABOVE dcArchRegistryPortability deliberately (D0052: declaration order IS
        // priority, and reordering is how you reprioritize). The priority-inversion guard flagged
        // the original placement: this item resolves two HIGH findings, while
        // dcArchRegistryPortability is blocked on data no one in this repo can supply.
        action dcServeRequirementRework;
        verification dcServeRequirementReworkDoD : Test { :>> id = "4b413c5c-e8df-4585-bc1f-4bcf11ae11fc"; :>> method = VerificationMethod::inspect; :>> procedureText = "Resolves issue121-issue125, the five findings from the independent Core-3 critique of the serve-discipline SystemRequirement cluster (critic claudeOpus5, independent of author wweatherholtz). BLOCKED ON HUMAN DISPOSITION: every finding is >= Medium, so each needs a typed act/accept-risk/dismiss verdict (D0092) before any rework is authorised - and ACT on some findings may be declined in favour of accepting the risk, which would close them without a text change. DO, for whichever findings are dispositioned ACT: (C1, High) srServeModelDrivenRegistry requires computing each process's expected output schema from the declared model, and no schema type can hold one - producedArtifact is free-text prose, so this Tier-1 contract is half unbuildable and two Tier-2 requirements #DependsOn it; either add the schema representation (a frozen-core change needing its own Decision) or re-scope the requirement to the launchable set alone. (C3, High) srServeApproveGate never constrains the approving operator to a HUMAN, so an AI could approve its own routing and defeat the parent Need; bind it to the attestation-policy kinds=human machinery that D0146 and the attestation-authority guard now provide. (C2, Medium) srServeLauncherDefinedOnly states a universal negative no test can demonstrate; restate as a structural property a guard can enforce. (C4, Medium) srServeOutputSchemaValidate governs the result but not side effects already taken by a failed attempt; say what happens to work already performed. (C5, Medium) srServeScopedContext bounds only passed-in context while a launched agent reconstitutes context by READING, so the anti-drift property it claims is not delivered by input scoping alone. VERIFY: each dispositioned-ACT finding has a corrected requirement text; each accept-risk/dismiss finding is closed by its typed disposition rather than by an edit; re-critique at HEAD after any text change, since the existing critique goes suspect the moment its target moves; validate + guard green."; }
        part dcServeRequirementReworkDoDR1 : TestResult { :>> id = "49cbbf65-3cba-4664-b37d-504ac1e23516"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b05548a"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action dcArchRegistryPortability;
        verification dcArchRegistryPortabilityDoD : Test { :>> id = "932a0ef5-409b-4487-8ab8-483708b360be"; :>> method = VerificationMethod::demo; :>> procedureText = "Resolves issue117. keelArchViewsDoD required verifying the six arch views on SelfSync's authored registry; this repo does not hold that data, so sprint 301 verified against a registry authored for keel's OWN source instead. That registry was authored by the same author as the views, so it cannot detect an assumption shared between them - which is precisely the portability claim keelArchViews was about. BLOCKED ON EXTERNAL DATA and recorded as such rather than quietly counted as done. DO: run the six views against a registry authored by a DIFFERENT project (SelfSync's, or a second project's), reached either by that project running keel arch itself or by importing its registry here for the test. VERIFY: each of the six views computes a defensible result on that project's data without a change to keel; any change keel DOES need is the finding, and is recorded as such; the schema module reaches the project through keel init rather than by hand-copying, since shipping it was D0148's entire point."; }
        part dcArchRegistryPortabilityDoDR1 : TestResult { :>> id = "57b67241-ab65-496a-9108-373a0fa77558"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "0deee4e"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action dcSchemaReconciliation;
        verification dcSchemaReconciliationDoD : Test { :>> id = "634748e9-04d7-401e-81e5-ccd5980d9a4d"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue118, issue119, issue120. A holistic pass over every hook against the schema found that the engine checks MARKERS (D0133) and ENUM VALUES but not ATTRIBUTE NAMES, and that three hardcoded lists in the binary mirror schema vocabulary with nothing reconciling them. DO: (1) an attribute-vocabulary guard - every :>> name = on a typed element must be an attribute declared by that type or an ancestor - hard-blocking and FORWARD-ONLY grandfathered per issue068, since a new control must never retro-fail work that was correct when written; (2) a schema-reconciliation guard that fails when a hardcoded list in the binary disagrees with the schema it mirrors, covering at minimum KNOWN_EDGES vs the EdgeKind enum, ENGINE_MARKERS vs the declared metadata defs, and RISK_ORDER vs the RiskClass enum; (3) reconcile the KNOWN_EDGES drift itself so derivedFrom, covers, dispositions and specialize become traversable in declared views. VERIFY: a misspelled attribute is REJECTED with the type it was authored on and the nearest declared name; a correctly spelled one passes; every pre-existing file still validates green so the control is forward-only; a deliberately drifted hardcoded list FAILS the reconciliation guard; a view over derivedFrom resolves and returns the 97 edges that exist; clippy + cargo test + validate + guard green."; }
        part dcSchemaReconciliationDoDR1 : TestResult { :>> id = "b931f5e1-bd2e-4609-82dd-30ba6cde6c65"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "0f964ae"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action dcScratchPathControl;
        verification dcScratchPathControlDoD : Test { :>> id = "3829266e-b045-4746-a292-0c2621d34603"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue126. The pre-bash hook (shellcheck.rs, issue094) advises on host/shell adaptation and is the natural home for a defect that has now recurred three times in one session: writing a heredoc to git-bash /tmp and then reading that path from Windows python, which cannot see it. Each occurrence cost a failed step and a retry, and the remedy was already recorded in a sprint 301 retro before recurring in sprint 305 - which is exactly the D0047 case where a reminder is not a control. DO: extend keel hook pre-bash to detect a command that writes to a /tmp path AND a later step in the same command reading it with a Windows interpreter, or more simply any /tmp path used in a command that also invokes python/conda on this platform, and emit the advisory naming the scratchpad alternative. ADVISORY ONLY, never blocking (issue094 established that this hook must not block, and a false positive that stops work would be worse than the defect). VERIFY: a command mixing a /tmp heredoc with a python read triggers the advisory; a pure-bash /tmp use does not; the hook stays silent when it has nothing to say; on a POSIX host the check does not fire at all since the defect is Windows-specific; clippy + cargo test + validate + guard green."; }
        part dcScratchPathControlDoDR1 : TestResult { :>> id = "2f367261-8b8b-4758-bb65-89c0576ffa46"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "c918626"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action dcCritiqueCoverageSupersede;
        verification dcCritiqueCoverageSupersedeDoD : Test { :>> id = "e47a4268-c5bc-4dbe-bb10-9d4aa53cf3af"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue127. critique-coverage counts SUPERSEDED elements as governed, while compute_coverage and compute_tier_satisfaction both exclude them (view.rs builds a descoped set from supersede edges and filters targets by it). Proven by acting on the sprint 305 findings: srServeApproveGate and srServeModelDrivenRegistry are now superseded by corrected requirements and still report governed=true, so a retired requirement occupies a slot in the critique-coverage denominator permanently and its critique must be maintained forever. DO: exclude #Supersede-targeted elements from the critique-coverage governed set, matching the two sibling views and the engine's own doctrine that superseded means RETIRED. NOTE THIS CHANGES A COMPUTED VIEW'S NUMBERS and is therefore section 3a: it needs sign-off before it lands, and the pre-change and post-change counts must both be reported so the human sees exactly what moved. VERIFY: a superseded element drops out of governed; its critiques remain readable and #Verify-linked, since retiring an element must never delete the evidence about it; the three views agree on which elements are in scope; a non-superseded element is unaffected; clippy + cargo test + validate + guard green."; }
        part dcCritiqueCoverageSupersedeDoDR1 : TestResult { :>> id = "5836fa6a-94f1-476e-a51e-87b4685386e2"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "bc8097f"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action dcVerifyBeforeAsserting;
        verification dcVerifyBeforeAssertingDoD : Test { :>> id = "27c91919-3740-4491-b3b9-14976e6be343"; :>> method = VerificationMethod::inspect; :>> procedureText = "Resolves issue134. Applies D0151 once accepted: add the verify-before-asserting clause to the response contract in .claude/output-styles/keel.md, which is where the contract lives (D0130 — CLAUDE.md was demonstrably ignored, issue084/085). DO: state that an unverified suspicion is either silent or explicitly labelled as unverified, never asserted as a defect; and that a defect claim made to the human NAMES THE CHECK that established it, the same way a claim about code cites file:line. VERIFY: the clause is present in the output style; the existing contract sections are unchanged; a Decision records the acceptance; validate + guard green. HONEST LIMIT, to be stated in the clause itself rather than discovered later: no gate can read conversational output, so unlike every other item in the contract this one is unenforceable by the engine. It is a stated rule plus the human noticing, and the naming-the-check requirement exists precisely so the reader can audit a claim they cannot have machine-checked."; }
        part dcVerifyBeforeAssertingDoDR1 : TestResult { :>> id = "b7caf928-b6b8-46c6-ac75-1af9c93c8ac3"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b82e777"; :>> judgedAt = "2026-08-15"; :>> judgedBy = "claudeOpus5"; }
        action dcSittingObligationScope;
        // Result recorded below the DoD it judges; the DoD's own text is unchanged (D0108: add, never overwrite).
        verification dcSittingObligationScopeDoD : Test { :>> id = "2a2e018e-6a62-4369-b1f3-0f359ee7ab05"; :>> method = VerificationMethod::inspect; :>> procedureText = "Resolves issue135. The obligation surface reports sitting-review-due as 311 of 315 sprints, because per-sitting review (D0049) post-dates almost all of this repo's history and nothing distinguishes a sitting that is actually AWAITING review from one that predates the convention. The number is true and useless as a queue: N-C1 says the surface shows every obligation requiring the human's judgment AND NOTHING ELSE, and 311 historical sittings do not require judgment now. It is currently reported WITH a caveat rather than filtered, because silently scoping it to 'recent' would invent an actionable definition nobody has agreed. DO: decide what makes a sitting review ACTIONABLE - candidates are sittings after the D0049 convention took effect, sittings within a bounded recency window, or sittings whose work is not yet superseded - and either scope the computed class accordingly or grandfather the pre-convention set explicitly the way issue068 grandfathers other forward-only controls. VERIFY: the obligation total reflects only actionable items; the grandfathered set is still visible somewhere rather than deleted; the caveat is removed once the definition is defensible; a sitting that genuinely awaits review still appears."; }
        part dcSittingObligationScopeDoDR1 : TestResult { :>> id = "6b1d84f0-2c73-4a95-8e61-df02a7c5b913"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "9d10ee1"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
        action dcResolverKindGuard;
        verification dcResolverKindGuardDoD : Test { :>> id = "9f2c0a71-4d85-4b16-9e03-7ca518d6b204"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue136. DO: add a hard guard so a #Resolves edge whose resolver could not possibly resolve anything is a violation rather than a pass. A resolver must be a declared `action` (work that closes the Issue) or a `Decision` (which moots it, §1.4); a requirement, Need, Test or Story is not an act and can never compute as complete against the Issue. Repoint the two pasted edges onto real resolvers in the same change so the guard starts at zero. VERIFY: the guard is in the enforced set and reports 134 edges scanned with no violation; reintroducing a requirement-as-resolver fails it; `keel open-issues` no longer reports untriaged=false for an Issue nothing is on the hook for."; }
        part dcResolverKindGuardDoDR1 : TestResult { :>> id = "7d4b2e19-8c60-4a37-95f1-0eb3c85479da"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "5547107"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
        action dcRootArmSweep;
        verification dcRootArmSweepDoD : Test { :>> id = "3a6e91b8-72f4-4c0d-b5a9-1e8d04c37f65"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue133's remaining half. The reverify parser was fixed when the issue was recorded; the issue also says the same catch-all-as-root arm exists in OTHER subcommand parsers, and that sweep was never done. DO: find every subcommand argument parser whose final arm treats an unrecognised token as ROOT, and make an unrecognised `--flag` an error naming the usage line instead of a path. This is the session's dominant defect shape — a wrong input producing a confident wrong answer downstream instead of an error at the point of the mistake. VERIFY: each fixed subcommand rejects an unknown flag with its usage line; a legitimate positional ROOT still works; the count of remaining catch-all arms is reported rather than claimed to be zero."; }
        part dcRootArmSweepDoDR1 : TestResult { :>> id = "b8e0f36c-51a2-4d78-8b04-2c9741ed6a5f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "5547107"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
        action dcNeed8ScopeNarrowing;
        verification dcNeed8ScopeNarrowingDoD : Test { :>> id = "c1b70de4-5a29-4f83-8d61-2b940ae7c518"; :>> method = VerificationMethod::confirmation; :>> procedureText = "Resolves issue132, and BLOCKED BY DESIGN on d0156 (proposed) — nViewerPersistedViewpoints is owned by wweatherholtz and D0108 forbids a non-owner editing its fields, so this cannot be worked until its owner decides. The #DependsOn edge to a proposed Decision keeps it off the ready frontier (blocked-on-acceptance) rather than ranking work an AI is not permitted to do. DO, once d0156 is accepted: narrow N-8's statement to the surviving single-user half, or supersede N-8 with a Need that states it. VERIFY: N-8 no longer states scope D0115 removed; srViewerPersistedViewState still satisfies it; the human authored or explicitly authorized the edit."; }
