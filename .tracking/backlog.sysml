        action dcStopAdvisoryIsOneLine;
        verification dcStopAdvisoryIsOneLineDoD : Test { :>> id = "ae477060-2997-4256-b06d-5bbc4d919a47"; :>> method = VerificationMethod::demo; :>> procedureText = "DONE MEANS: the Stop hook's exit-0 advisory is one line - N decisions outstanding, their short names, and how to accept (your quoted word, or keel accept) - with the console/bridge nag gone. GH#52 (st077) quotes the owner's wanted format. Partly moot after D0289 (accept by quoted word) and D0291 (record-time consent leaves few outstanding), which is why it is Low. VERIFY: the advisory on a project with N pending forks is one line naming them; on none, silence."; }
        action dcLandRequiresASuiteReceipt;
        verification dcLandRequiresASuiteReceiptDoD : Test { :>> id = "c93d0de2-3874-472a-a5d1-dce58dda2d49"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: keel land refuses to push a tree whose deliverable changed since the last recorded green suite run on that tree, unless the suite ran at HEAD. On 2026-09-02 sprint 521 was landed on validate plus guards alone; the full suite had last run at sprint 520; CI went red for twenty minutes on a test the suite would have caught locally (a shipped process naming a tool the scaffold did not ship). CI is detective (the control structure says so, computed) - the commit was already on main. DO: the suite run writes a machine-local receipt (tree fingerprint, timestamp, pass/fail) beside the hook fire-ledger; land compares the receipt's fingerprint to HEAD's and refuses when the deliverable manifest files differ from the receipted tree, printing what to run; KEEL_LAND_UNTESTED=1 overrides with an obligation recorded, never silently. VERIFY: a fixture whose source changed after the last receipt is refused by name; a fresh receipt at HEAD lets it through; a docs-only change needs no receipt."; }
        action dcScaffoldShipsNoGrants;
        verification dcScaffoldShipsNoGrantsDoD : Test { :>> id = "b18a52c4-257e-49e9-a845-a083733e0905"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: a fresh keel init ships attestation-policy.toml WITHOUT this repository's standingConsent line and WITHOUT its delegatedRecording lines - those are THIS project's grants (the human's words of 2026-08-22 and 2026-08-23 are quoted in them) and a downstream project never made them. Found 2026-09-03 (sprint 527 retro): a scaffold declares standing consent it never granted; inert today only because it also declares no decider, which is an accident of two absences cancelling. The D0219 class: project data shipped as engine data. DO: the shipped policy carries the classes with kinds and roles and a commented example of each delegation; init or migrate never copies a grant; this repository's own file keeps its grants. VERIFY: a fresh scaffold's policy has no delegatedRecording and no standingConsent; record decision on the scaffold stays proposed and says so; this repository's behaviour is unchanged."; }
        action dcRecordDecisionDeclaresSupersedes;
        verification dcRecordDecisionDeclaresSupersedesDoD : Test { :>> id = "cdedf98b-4e56-489e-9478-14f5974190da"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: keel record decision accepts --supersedes <dNNNN>[,<dNNNN>] (and the --from file a supersedes: line) and writes the #Supersede edge with the Decision, so a Decision that reverses another cannot land edgeless. Found 2026-09-03: D0289 reversed D0178 layer 3 and carried no edge to it; the human noticed, not a guard, because decision-requirement-link warns only when prose names an item by id and D0289's text did not. Also: --derived-from <stNNN|usNNN> for the statement or story it came from. VERIFY: a decision recorded with --supersedes carries the edge and keel show why reads it back; a --supersedes naming a missing Decision refuses; the record-time acceptance path is unaffected."; }
        verification dcForkShapeIsDetectedDoD : Test { :>> id = "27f5985f-1a9b-4193-b060-a12b808f4e6a"; :>> method = VerificationMethod::test; :>> procedureText = "DONE when record decision refuses to auto-accept a Decision whose text weighs alternatives without the OPTION marker: a lexical fork detector beyond deck::fork_options - two or more of 'alternative', 'either', 'or we could', 'option', 'versus', 'trade-off', 'A:', 'B:' style enumerations, or a decision field that names more than one course and recommends one - makes the Decision stay proposed with a message asking the author to write it as a fork (OPTION X (label) ... COST ...) or to state in the text that it is not one. Measured first over the accepted corpus: how many auto-accepted Decisions the detector would have held, read by hand for precision before the threshold is set (the D0102 way). Arming test: a disguised fork stays proposed; a genuine non-fork with the word alternative in passing auto-accepts. Records: ucaRecordForkDisguised, ccRecordForkShape (stpa-self run 1)."; }
        // RAN: cargo test --release: 521 passed, 0 failed, exit 0 (2026-09-05) incl. deck::fork_shape_tests and tests/disguised_fork_stays_proposed.rs; corpus measured 109 auto / 4 held / 1 real (D0292)
        part dcForkShapeIsDetectedDoDR1 : TestResult { :>> id = "5cdb7415-f8ec-4502-bb86-be226dbb4a73"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "50175b68d8fb95f333b6d66c7806c580ab3d42b2"; :>> judgedAt = "2026-09-05"; :>> judgedBy = "claudeOpus5"; }
        action dcResultBindsToItsLandingCommit;
        verification dcResultBindsToItsLandingCommitDoD : Test { :>> id = "9393c050-ba83-482d-ac3d-51ce0630c4b6"; :>> method = VerificationMethod::test; :>> procedureText = "DONE when a TestResult is bound to the tree that carries the work it judges, not the tree that preceded it. FOUND by stpa-self run 1 (UCA-A2): the ordinary shape of a DoD pass is `append-result --sha HEAD` while the work sits uncommitted, so judgedAgainst names a commit whose tree does NOT contain what was verified; deliverable-drift suspicion then measures drift from the wrong baseline, and `governing-version`-style reads of the result point at a tree where the claim is false. DO: the same fallback D0308 gave acceptances - when the result's judgedAgainst commit is an ancestor of the commit that INTRODUCED the result, every reader that dereferences judgedAgainst (orient's deliverable suspicion, reverify, attestation) treats the introducing commit as the binding; `append-result` says so in its output when the working tree is dirty, so the author knows which tree the pass will read against. VERIFY: a fixture that records a pass at HEAD, then commits the work, reads the pass as bound to the landing commit; a pass recorded on a clean tree is unchanged; this repository's own history re-reads without a new suspect."; }
        action dcProcessStepDeclaresItsCheck;
        verification dcProcessStepDeclaresItsCheckDoD : Test { :>> id = "b03c9fd7-3925-4fd3-b702-76adcaccf4be"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS (D0321 option A, the human's choice 2026-09-05 'd0321 A'): ProcessStep carries `checkedBy : String [0..1]` naming the guard or declared rule that checks the step, and the seven bindable processes measured in D0321 carry theirs - controlDefect (control-defect-registry), decisionSurfacing (judgment-request-quality), libraryStewardship (unit-extras-present), migration (marker-census), stpaDiagram (viewpoint-renderer), stpaSelf (stpa-currency), githubIntake's routing steps (untrusted-routing, untrusted-taint) - through a D0067 migration (schema Decision for the attribute, expand, the bindings authored, control totals: 37 processes and every step counted before and after). A guard `step-check-resolves` fails a checkedBy that names no GUARD_NAMES entry and no rules.sysml rule. `keel show hardening` reports per STEP: checked / declared judgment (process-enforcement.toml) / undeclared, beside the per-process figures it reports today. VERIFY: schema validates (validate_schema.py, kernel-checked construct); the seven bindings resolve; a fixture step naming a ghost guard fails the new guard; hardening's per-step counts equal a hand count over the process files."; }
        action dcAdvanceRefusesAnyBoundStep;
        verification dcAdvanceRefusesAnyBoundStepDoD : Test { :>> id = "cf2bb579-4bae-4619-bc98-7bce5b2f7fa2"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS (D0321 option A, second half): `keel advance <process-or-sprint> --to <step>` generalises the agile-ceremony refusal to ANY process step that declares checkedBy - the advance is refused until every earlier step's bound guard passes, and the ceremony table hand-coded in advance today becomes data read from the steps' bindings, with the agile-workflow steps carrying theirs so behaviour is unchanged there. Depends on dcProcessStepDeclaresItsCheck. VERIFY: `keel advance` on a sprint behaves exactly as before (the existing ceremony tests pass unchanged); a fixture process with two bound steps refuses --to the second while the first's guard is red and permits it when green; a process with no bound step is reported as unenforceable-by-step, not refused."; }
        action dcProposedOutcomeTier;
        verification dcProposedOutcomeTierDoD : Test { :>> id = "422f1a98-2863-4cca-874f-840a17ac5bf3"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS (D0312 option B, the human's choice 2026-09-05 'd0312 B' - the schema half): VerdictKind gains `proposed`, and an AI-judged result whose method is demo, analyze or inspect and which carries no REPLAYABLE receipt is recorded with outcome proposed; orient's done computation, suspect, the burndown, attestation and every view that reads outcomes treat proposed as not-done-yet with its own count (never folded into pass or fail); guard 52 (evidence-cited) and confirmation-authenticity read the new value; MACHINE results - method test with a receipt CI can re-run (a ci-run receipt, D0323, or a command receipt) - and HUMAN confirmations are unchanged. Forward-only: the 5,024 standing AI results are grandfathered by judgedAt and never re-judged (D0129). One Decision per clause (D0303): this is the schema clause; the set-judgment write path and the replayable-demo rule are their own items. VERIFY: schema validates and the construct is kernel-checked; a fixture AI-judged inspect with no receipt lands proposed and orient reports the item not done with a proposed count of 1; a pre-cutoff AI inspect pass is still done; a human confirmation and a ci-run test are unchanged."; }
        action dcSetJudgmentWritePath;
        verification dcSetJudgmentWritePathDoD : Test { :>> id = "17481d44-7876-48ec-9b1e-869366b33017"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS (D0312 option B - the human's judging half): `keel judge-set` records the human's verdict on a SET of proposed results in one sitting - one card on the console deck and one command - while every item is recorded INDIVIDUALLY (its own pass or fail result, judgedBy the human, with the verbatim quote receipt D0198 requires) so issue158's COUNT-accepted-as-a-card cannot recur; the human samples rather than judges every set: `attestation-policy.toml` declares a sampling rule (a share or a count per sprint) and `keel show attestation` reports proposed / sampled / judged as separate numbers. Depends on dcProposedOutcomeTier. VERIFY: a fixture with six proposed results and a 50% rule presents three; judging the set writes three individual results each quoting the human; the census shows 6 proposed, 3 sampled, 3 judged; a set judged from an agent session without the human's quoted words is refused (D0289)."; }
        action dcReplayableDemoStaysAPass;
        verification dcReplayableDemoStaysAPassDoD : Test { :>> id = "bdff30b1-9998-409f-9a7b-d87d6cc65944"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS (D0312 option B - the demonstration clause, the one that separates B from A): an AI-judged `demo` result whose receipt is REPLAYABLE stays a pass - replayable means the receipt is a command a human or CI can re-run (a `// RAN: <command>` receipt whose command `keel reverify` recognises, or a ci-run receipt, D0323) - and a demo without one is proposed like any other AI-examined claim; `keel reverify --demos` re-runs the replayable demo receipts at HEAD and stamps or fails them, so the replay is exercised, not asserted; the attestation census counts demo-replayable apart from demo-proposed. Depends on dcProposedOutcomeTier. VERIFY: a fixture demo with a command receipt that exits 0 stays pass and reverify re-stamps it; the same with a command that exits 1 flips to fail naming the command; a demo with a prose receipt lands proposed; the sampling rule of dcSetJudgmentWritePath still samples replayable demos, so a demo receipt that replays green for the wrong reason has a reader (the risk D0312 names)."; }
    }
