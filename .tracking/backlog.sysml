        action dcObligationRecorderValidates;
        verification dcObligationRecorderValidatesDoD : Test { :>> id = "773e6537-d1c0-4bd7-8530-38cc086ee768"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue274. The obligation recorder emitted a file importing only EngineElement, while Issue is defined in EngineWork and the Resolves edge in EngineRelationships - so RECORDING an obligation made the tree INVALID with an unresolved type reference. Self-defeating for a record whose purpose is to say the tree needs a correction pass, and it put the recorder in the one position it must never occupy: unable to record without breaking the thing it reports on. DO: the template carries both imports. VERIFY: a freshly recorded obligation validates clean; the instance already on disk validates; validate over the whole tree is clean."; }
        // RAN: cargo test --release --test init_smoke => 2 passed 0 failed incl recording_an_obligation_keeps_the_tree_valid | disable-and-rerun: template EngineWork import removed => FAILED with 'unresolved type reference Issue' at override-58a0b47d.sysml:8, restored => pass | keel validate . => 526 tracking files clean
        part dcObligationRecorderValidatesDoDR1 : TestResult { :>> id = "934f63b5-84ee-496f-af13-63dd692c653e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e7d2683"; :>> judgedAt = "2026-08-27"; :>> judgedBy = "claudeOpus5"; }
        action dcWorkspaceDiscoveryIsComplete;
        verification dcWorkspaceDiscoveryIsCompleteDoD : Test { :>> id = "c6af8dff-56db-428d-839e-65d6293c877a"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue275. Three panelists independently found that discovery stops at the first project on a branch and is bounded at depth 3, so a project nested inside another, or deeper than three, is invisible - and keel init refuses neither position. Verified: keel init . then keel init sub reports one project; a commit adding a broken sysml file plus a full rules downgrade in the invisible project exits 0 with the gate reporting clean. My own unit test asserted the broken shape as correct, pinning the bug as intended behaviour. DO: derive the project set from git ls-files rather than a bounded walk - exact, unbounded, no skip list; make init refuse a target inside an existing project; make the gate FAIL when a staged path lies under an undiscovered engine-plus-tracking directory. VERIFY: nested and depth-4 projects are discovered; the broken-file commit is BLOCKED; the misleading unit test is replaced."; }
