    action def NextWork {
        // ---- TRACKING-MECHANISM FIXES (top priority, human direction 2026-08-13) ----
        // "if we're inaccurately identifying work, we need to be fixing our tracking
        // mechanisms so that these mistakes aren't missed." Each item below is a CONTROL for
        // a miss that actually happened in sprint 247 — vigilance already failed, so per D0047
        // each becomes an automated check rather than a reminder.
        // FIELD-REPORTED regression, top priority: D0133 blocked a downstream project entirely.
        action dcEngineMarkerBuiltins;
        verification dcEngineMarkerBuiltinsDoD : Test { :>> id = "0d770001-0814-5701-9b3e-000000270001"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue089 (Critical, discoveredInField). D0133 shipped `marker-vocabulary` as a HARD guard in the BINARY whose passing condition was `metadata def` lines in the PROJECT's schema. include_dir! embeds .engine at BUILD time, so upgrading the binary never updates an existing project's on-disk .engine/schema/ — reproduced: pre-D0133 schema + v0.2.0 binary = 566 violations, exit 1, every commit blocked, including on the engine's own shipped files. Worse, the only remedy was editing FROZEN schema/core, so the guard forced downstream projects into a frozen-schema sign-off just to keep committing. FIX: (a) ENGINE_MARKERS builtin set in the binary — the engine's own algebra (#Verify, #DerivedFrom, #CharteredBy, #Resolves, #Measures, #Informs, #JustifiedBy, #Dispositions, #Covers, #DependsOn, #Supersede, #OrderingOnly, #ProspectiveChange, #SafetyChange, #Capability, #ProcessDefect, #View) is always valid with NO project declaration, because it is the engine's contract and the binary owns it; (b) project-declared markers scanned from ANY .engine or .tracking file, so a project declares its own vocabulary without touching frozen core; (c) guard stays HARD — with (a) and (b) the only remaining failures are genuine typos; (d) the violation message no longer directs people to edit frozen schema. VERIFY: the reproduced downstream state goes 566 -> 0; `#DerivdFrom` still hard-fails with exit 1 IN that state; this repo stays at 0; unit test asserts every engine marker resolves with an EMPTY project declaration set and that a misspelling does not; clippy + cargo test + keel validate + guard green. Ship as a patch release immediately — a downstream team is blocked."; }
        part dcEngineMarkerBuiltinsDoDR1 : TestResult { :>> id = "cb9d8483-fdd2-46e9-a346-b19754e74a60"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "c4464de"; :>> judgedAt = "2026-08-14"; :>> judgedBy = "claudeOpus5"; }
        action dcVerificationTrace;
        verification dcVerificationTraceDoD : Test { :>> id = "0d630001-0813-4301-9b3e-000000130001"; :>> method = VerificationMethod::test; :>> procedureText = "MISS IT CATCHES (sprint247, real): six SystemRequirements were IMPLEMENTED and CI-verified, yet tier-satisfaction correctly reported them UNVERIFIED because the passing DoD Tests #Verify-link the BACKLOG ACTION, not the requirement — so `work done` and `requirement verified` are disconnected, and the burndown was then mis-narrated to the human as if 34% meant functional verification. DO: a computed check (prefer a DECLARED rule per D0105/D0107) that flags a DONE work item whose charter/satisfy chain reaches a SystemRequirement carrying NO #Verify edge — i.e. work claims to deliver a requirement while no verification is linked to the requirement itself. Report the pair (done action -> untraced SR) so the fix is obvious. WARNING-level first (D0102 promote-once-low-noise), surfaced in orient's burndown; it is honest-state completeness, so it must NOT hard-block (D0098). ALSO: make `keel tier-satisfaction` state WHAT verified each SR (method mix), because in this repo the 24 'verified' SRs are verified overwhelmingly by method=critique, not by functional tests — a reader cannot currently tell. VERIFY: the six sprint247 SRs are flagged before their #Verify edges are authored and clean afterwards; a done action whose SR is critique-only is distinguishable from one verified by test; the check is non-blocking; clippy + cargo test + keel validate + guard green."; }
        part dcVerificationTraceDoDR1 : TestResult { :>> id = "275ef412-ffc8-4db9-9b6b-12029c8996dc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "af2edd1"; :>> judgedAt = "2026-08-13"; :>> judgedBy = "claudeOpus5"; }
        action dcAttestationSubstance;
        verification dcAttestationSubstanceDoD : Test { :>> id = "0d630002-0813-4302-9b3e-000000130002"; :>> method = VerificationMethod::test; :>> procedureText = "MISS IT CATCHES (2026-08-13, real, found in the human's own record): d0129Accept was recorded with `procedureText = \"\"` — an EMPTY attestation — and passed EVERY guard, including acceptance-events and confirmation-authenticity. For method=confirmation the attestation text IS the evidence (D0016), so a contentless acceptance is an unsupported claim that looks complete. DO: extend the acceptance/confirmation checks so a method=confirmation Test carrying a passing TestResult must have a SUBSTANTIVE procedureText — non-empty and beyond a trivial token (a bare name, 'ok', 'approved') — mirroring the decision-rationale guard's substantive-field test (D0103). Forward-only: grandfather existing thin attestations to WARNING so historical records are not retro-failed (the issue068 lesson), hard-fail only NEW ones. VERIFY: an empty and a single-token procedureText both fail for a new acceptance; a substantive one passes; the existing corpus produces warnings, not violations; clippy + cargo test + keel validate + guard green."; }
        part dcAttestationSubstanceDoDR1 : TestResult { :>> id = "7cc82f28-6494-4fee-9456-7e0122a91867"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "336cec5"; :>> judgedAt = "2026-08-13"; :>> judgedBy = "claudeOpus5"; }
        action dcPriorityInversion;
        verification dcPriorityInversionDoD : Test { :>> id = "0d630003-0813-4303-9b3e-000000130003"; :>> method = VerificationMethod::test; :>> procedureText = "MISS IT CATCHES (sprint247, real): D0052 makes backlog DECLARATION ORDER the priority and requires the AI to auto-follow the ranked frontier. Sprint 247 appended 15 new actions at the file tail, so `keelArchViews` (issue069, Low) ranked #1 purely because an earlier session appended it to the end of the completed EngineBuild block, while `dcStaleKernelInstanceGate` (issue081, HIGH — an enforced commit gate being routinely bypassed) ranked 14th; the AI then narrated 'highest-leverage' items in PROSE instead of reordering the file. Both severity and order are recorded facts, so the inversion is COMPUTABLE. DO: a computed check flagging a ready item whose #Resolves-linked Issue is severity >= High while a lower-severity (or issue-free) ready item outranks it. WARNING-level + surfaced in orient (priority is judgment, so never a hard block) — it makes the inversion visible instead of trusting curation. VERIFY: the pre-reorder backlog state reproduces a flag for dcStaleKernelInstanceGate vs keelArchViews; the reordered state is clean; an issue-free ready item above a High one is flagged; clippy + cargo test + keel validate + guard green."; }
