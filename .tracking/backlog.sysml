        action reverifyDeliverable; // issue014 (autonomous retro S19): re-verify the rust deliverable tasks at HEAD (cargo test + parity_check) and append fresh TestResults to clear the 12 deliverable-suspect items (D0050)
        action backlogPrioritization; // D0052: rank the ready frontier by backlog declaration order so the AI auto-follows the top item (no more 'which one?')
        action decisionAnalysis;      // D0054/issue016: capture structured alternatives + selection criteria in Decision records (ISO 42010 / NPR 7123.1 Decision Analysis), not just the verdict
        action formalViewpointsSchema; // D0057: increment 1 — part def Viewpoint + declared registry (8 viewpoints) + validator wiring (DONE, schema sign-off given)
        action formalViewpoints;      // D0056/issue018: increment 2 — rewire report.py/orient as declaration-DRIVEN renderers + concern-coverage view (which concerns lack a viewpoint)
        first formalViewpointsSchema then formalViewpoints;
        action processDeployingSkills; // D0059: every process has a deploying skill — added doc-sync skill + principle (DONE this sprint)
        // attributionModel (D0060) decomposed into ordered sub-tasks (D0061). Pre-authorized breaking change; kick off in a fresh context.
        action attrModelSchema;          // 1: schema EXPAND (D0063) — ADD createdBy[0..1] (Element + 3 Tracked* bases) + decision[0..1]+rationale[0..1] (Decision), KEEP authoredBy/decisionText/context (additive, green); rename/retire deferred to attrModelContract
        action attrModelInstances;       // 2: MIGRATE (additive, D0063) — every instance +createdBy; every decision +decision+rationale (split from decisionText, KEEP context+decisionText); old fields removed at attrModelContract
        action attrModelTooling;         // 3: validate_actors(createdBy), query.py(read_issues/read_viewpoints), Rust parser/indexer+validate, report.py; re-verify deliverable
        action attrModelAcceptanceEvents;// 4: Decision acceptance as a confirmation TestResult (verify edge); migrate 'Accepted: X' prose to events
        action attrModelCoverageView;    // 5: process-required-attestation coverage view (items missing a required attestation); pairs with formalViewpoints
        action attrModelGuard;           // 6: guard — Decision acceptance is a TestResult, never prose (D0047)
        first attrModelSchema then attrModelInstances;
        first attrModelSchema then attrModelTooling;
        first attrModelInstances then attrModelAcceptanceEvents;
        first attrModelAcceptanceEvents then attrModelCoverageView;
        first attrModelAcceptanceEvents then attrModelGuard;
        first attrModelInstances then attrModelContract;
        first attrModelTooling then attrModelContract;
