        action dcDeckReviewIntake;
        verification dcDeckReviewIntakeDoD : Test { :>> id = "4a7e60c9-3b12-4d85-9f01-e6b25a7c3f14"; :>> method = VerificationMethod::test; :>> procedureText = "Intake of the human's first obligations-deck review, step 4 of the obligation-review skill. RECORDED AS THEIRS: 4 Decision acceptances via `keel accept` with their submission quoted; 19 finding dispositions with each per-item note VERBATIM and the deck-verdict-to-DispositionKind mapping STATED rather than assumed (Accept -> act, Needs work -> act because their note says the answer is insufficient, Reject -> dismiss); sitting05Review covering the 34 due sprints on their instruction `accept all sprints`, scoped to the live queue and NOT re-attesting what D0155 grandfathered. RECORDED AS MINE, under the delegation their third clause granted (D0165): dispositions for issue154-157, which accrued after the deck was generated and were never in front of them - judgedBy claudeOpus5, each citing D0165, so nothing claims a human judged them. Read back: pendingAcceptances 0, undispositioned 0 of 116, sittings due 0. ALSO FIXED, answering their issue150 note (`Root cause? How did the model miss? Be specific`): the oversight advisory I shipped in sprint 349 sat INSIDE the green branch of `hook stop`, so a red model MASKED it - the same single-channel blindness as the original defect. It now computes in both branches and appends to the blocking reason. Its test was rewritten to assert the PROPERTY (the advisory alone resolves to a systemMessage; a block stays gated on `problems`) rather than the layout it had been asserting. 191 tests, clippy clean, 36 guards ALL PASS."; }
        part dcDeckReviewIntakeDoDR1 : TestResult { :>> id = "d05f3e81-7a46-4b29-8c73-15be0f2a9c46"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "513a1a4"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcIdentityPresent;
        verification dcIdentityPresentDoD : Test { :>> id = "7e51c8a3-0d84-4b17-9f26-38ea5c1074bd"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue166. Guard 37 `identity-present`, HARD: every id-bearing declaration in `.tracking` or `.engine` must carry an `:>> id`. Closes an invariant that was unguarded - `keel validate` passed with issue159 stripped of its id. A TEXT SCAN, not a model walk, because an item with no identity is what the model layer sees least clearly and this must run at commit speed: measured 172/246/254ms over 8738 declarations with `Model::build was never called`, confirming the design rather than assuming it. NO GRANDFATHER LINE: the corpus was measured BEFORE the guard was written (8738 declarations, 0 missing), so an exemption would have been ceremony over an empty set. The body of each declaration stops at the NEXT declaration, so a member can never borrow its sibling's id - the bug that would let a file pass with one item holding two ids and its neighbour none. VERIFIED BOTH WAYS ON A NEW TYPE AND AN OLD ONE: clean PASS; a Statement stripped of its id FAILS and is named with file and line; an Issue stripped of its id FAILS. Also registered Statement and UserStory in all THREE copies of the id-type list (guards.rs plus both python validators), which is what their instruction to implement into parsing literally required."; }
        part dcIdentityPresentDoDR1 : TestResult { :>> id = "b0e6d942-51a7-4c38-8065-2fd93be71c4a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "890b2dd"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcIntakeChain;
        verification dcIntakeChainDoD : Test { :>> id = "6b09fa42-8d75-4c31-b028-e5710af9c634"; :>> method = VerificationMethod::test; :>> procedureText = "Implements D0166 (accepted). `EngineIntake` in schema/core declares Statement (verbatim text, saidBy, saidAt, channel), UserStory (asA/iWant/soThat, implication, triageNote) and `metadata def Implicates`, so #Implicates is a legal marker and `implicates` a traversable edge kind derived from the declaration rather than restated in code. ImplicationKind carries THEIR nine members verbatim plus five that answer their question about others from categories this session actually produced - question, priority, attestation, correction, convention - and `none` so that implicating nothing is a recorded decision. `keel intake` reports three gaps that were not computable before: unparsed (direction nothing translated), unrouted (triaged then dropped - worse than untriaged because it looks handled), unsourced (downstream items with no statement behind them, stated as a FLOOR on the record rather than a claim about the human). Wired as a CLI command AND a computed view, so the console and the deck reach it through the one dispatch table. VERIFIED END TO END on their own words: 3 statements, 3 user stories, 0 unparsed, 0 unrouted, 0 stories without a source, 7 of 479 downstream items now sourced, byImplication bug/need/process = 1/1/1. Process and skill registered as a pair (process-skill PASS at 19)."; }
        part dcIntakeChainDoDR1 : TestResult { :>> id = "f31c7ed5-06b8-4a29-9754-2ba08cf16e37"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "a7050c2"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcMintCommand;
        verification dcMintCommandDoD : Test { :>> id = "2c3b9eb4-8ad6-4173-a58a-ebfe69ad3241"; :>> method = VerificationMethod::test; :>> procedureText = "us019 (their words: we should be programatically creating UUIDs, not via AI diligence). DONE MEANS: `keel mint [N]` prints N (default 1) freshly generated v4 UUIDs, lowercase, one per line, nothing else on stdout - composable into any authoring script. Advertised in the help catalogue (its coverage test fails the build without the line). Unit tests assert: every minted id satisfies guard 38's uuid_shaped; 10000 mints contain no duplicate; N=0 and a non-numeric arg are refused with usage, exit 2, per the positional_arg convention (issue179)."; }
        part dcMintCommandDoDR1 : TestResult { :>> id = "3d4ca0c5-9be7-4284-b69b-0cbf70be4352"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "36f226e"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcSprintScaffold;
        verification dcSprintScaffoldDoD : Test { :>> id = "4e5db1d6-0cf8-4395-c7ac-1dda81cf5463"; :>> method = VerificationMethod::test; :>> procedureText = "us019, the largest uuid-by-hand consumer: every sprint file hand-authors ~14 ids plus the 7-gate skeleton, and two hand ids have already been mangled (issue170). DONE MEANS: `keel new sprint <number> <slug>` writes .tracking/delivery/sprint<number>_<slug>.sysml containing the Story and the seven ceremony gates (refine, standup, implement, review, closeOut, retro, DoD) with EVERY id minted by the engine, createdAt/judgedAt stamped from the real clock, owner/createdBy from the bound actor (REFUSED if none - the provenance rule, never defaulted), and every procedureText set to a FILL-ME placeholder that `keel gate --fast` REJECTS, so an unfilled skeleton cannot pass a gate or be committed. Refuses to overwrite an existing file. Advertised in the help catalogue. Unit test scaffolds into a temp tree: file validates structurally, all ids pass uuid_shaped and are unique, and the placeholder is rejected by the fast gate."; }
        part dcSprintScaffoldDoDR1 : TestResult { :>> id = "5f6ec2e7-1d09-44a6-d8bd-2eeb92da6574"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "74ecefb"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcDecisionFollowThroughView;
        verification dcDecisionFollowThroughViewDoD : Test { :>> id = "6a7fd3f8-2e10-45b7-e9ce-3ffc03eb7685"; :>> method = VerificationMethod::test; :>> procedureText = "us020 (their issue174 note: the scaffolding under a decision isn't being made - backlog items? user stories? verification test cases?). DONE MEANS: `keel decision-follow-through` is a first-class computed view (not a lens buried in `keel hardening`): for EVERY accepted Decision it lists the tracked items reaching it by typed edge (#CharteredBy, #DerivedFrom, #Resolves, satisfy), each item's evidence state from its DoD results, and a GAPS section naming accepted Decisions with ZERO downstream tracked items. JSON is the authority; a table renders for humans; served at /api/computed/decision-follow-through; advertised in the help catalogue. VERIFIED against three hand-checked anchors: D0173 shows sprints 379/380 chartered and green; at least one known-bare accepted Decision appears in GAPS; and the gap count reconciles with the hardening lens it supersedes there, or the difference is explained in the view's own output."; }
        part dcDecisionFollowThroughViewDoDR1 : TestResult { :>> id = "7b80e409-3f21-46c8-fadf-400d14fc8796"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "245d2d3"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcDecisionScaffoldingGuard;
        verification dcDecisionScaffoldingGuardDoD : Test { :>> id = "8c91f510-4032-47d9-0bea-511e25ad9807"; :>> method = VerificationMethod::test; :>> procedureText = "us020's enforcement half, gated on their st014 (depends on WHAT is being asserted) - so step one is a PROPOSED DECISION, not a guard. DONE MEANS: a proposed Decision is authored and queued for their signature that names the exact assertion - the candidate: an ACCEPTED #ProspectiveChange Decision must, by the close of the sprint that lands it, be reachable by at least one tracked item edge, enforced as a guard whose scope starts forward-only from acceptance (no retro-failing history) - including the hard-vs-warning choice, the D0163 removal path, and what dcDecisionFollowThroughView must exist to compute first. IMPLEMENTED only per whatever they sign: guard registered in GUARD_NAMES with dispatch and doc row, unit-tested against a synthetic tree with one covered and one bare decision, green over the real tree at the forward-only boundary. If they reject, the rejection is recorded and this item is superseded by it."; }
        part dcDecisionScaffoldingGuardDoDR1 : TestResult { :>> id = "7cf0319e-3678-4981-b6a8-854170150e1e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "06742e4"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
        action dcDeckWorkSurface;
        verification dcDeckWorkSurfaceDoD : Test { :>> id = "5f28c1a3-7d60-4b94-8e17-03ba69dc5f42"; :>> method = VerificationMethod::inspect; :>> procedureText = "Resolves issue161-165, the artifact-idea half of their requested UX critique. NOT STARTED. Five defects, one theme: the deck is a QUEUE and they need a WORK SURFACE. (161) regeneration overwrites unsubmitted marks - ordering rule mitigates, diff-and-merge would fix. (162) no notification; they must remember to look. (163) no history; it cannot show what was decided before. (164) three buttons, four meanings - a schema-vs-user vocabulary gap, not a display one. (165) they can judge but not act; every verdict round-trips through me. UNSCOPED DELIBERATELY: 164 wants a schema conversation and 165 wants a write path from an artifact to this machine, which D0158 makes local-only by decision. Their direction is needed before any of it."; }
        part dcDeckWorkSurfaceDoDR1 : TestResult { :>> id = "c94b0f75-1e38-4a26-b503-7fd28ea61c90"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcLegibleOutput;
        verification dcLegibleOutputDoD : Test { :>> id = "8d1a67f0-3b52-4c94-a806-7e25fb019c43"; :>> method = VerificationMethod::inspect; :>> procedureText = "Resolves issue160. NOT STARTED beyond the review deck, where the duplication is already cut: a title losing its self-referential prefix, the class stated once in its heading rather than per card, and one line per item in the export. THE ENGINE-WIDE WORK IS UNSCOPED ON PURPOSE and needs their direction, because each part trades something: a cap on procedureText loses detail that a gate's own text is supposed to carry; suppressing the 52 legacy-actor warnings hides real pre-convention debt; a human mode for `keel orient` means a second surface to keep truthful. VERIFY by a legibility test I cannot write alone - can a reader answer WHAT DO I DO NEXT from one screen of output without grep."; }
        part dcLegibleOutputDoDR1 : TestResult { :>> id = "e740b3c8-95d1-4a26-b073-1cf85ea6209d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcLiveDoc;
        verification dcLiveDocDoD : Test { :>> id = "0b53e971-8c24-4d36-a170-e6f2b8940a5c"; :>> method = VerificationMethod::demo; :>> procedureText = "Resolves issue159. The review deck is now an artifact LIVE DOC (`capabilities: {artifact: {}}`, runtime contract 0.2.9): the page's markup is the document, so a verdict tap and a typed note are appended as the human and reach the watching session with NO copy step. The export survives as a fallback for a read-only view and now copies ON OPEN rather than charging a second click. Contract rules honoured and each one would have failed silently: shared content authored as HTML and mutated only in gesture handlers (the localStorage restore is deleted - a load-time mutation saves nothing and a second record would contradict the document); per-viewer chrome on `data-local-open`; notes as `<input>` because textarea values are not captured; read-only detected as a body-level `claude:sync-off` REJECTION rather than assumed. METHOD IS demo and the result stays FAILING until the human confirms a tap reached me without a paste - D0160 means I cannot execute the page, and this is the ninth browser behaviour this session I would otherwise be asserting unobserved."; }
        part dcLiveDocDoDR1 : TestResult { :>> id = "3a7f14c8-06e5-4b92-8d31-72cb50fe6a94"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcObligationDeck;
        verification dcObligationDeckDoD : Test { :>> id = "9c40b768-2e51-4a83-b109-57fd6e2c8340"; :>> method = VerificationMethod::demo; :>> procedureText = "The human asked for a skill that renders outstanding items as STATIC HTML usable as an artifact on mobile. Delivered as `obligation-review` (D0040: a recurring task with no skill becomes the skill first), deploying `.engine/tools/obligation_canvas.py`. It shells out to the `keel` binary for orient/authority-queue/dispositions/sitting-coverage, so the deck cannot disagree with `keel orient` and needs NO running server - which is the point, since `keel serve` requires a shell, a server and a localhost browser and their obligations do not wait for those conditions. 86 items across four classes, one hue each. Verdict (accept/needs-work/reject) and note per item, stored in localStorage keyed by each item's MINTED UUID rather than its label, with a content signature so an item edited after being judged re-surfaces with a `changed` badge. Copy for Claude emits markdown for paste-back. Verified: counts match the computed views (4/27/22/33); zero non-ASCII bytes in the output, because the artifact runtime supplies the head and this file cannot declare a charset; the only synthetic uid is an aggregate authority row whose item is a sentence, not an item. METHOD IS demo - whether it is usable on their phone is theirs to judge, and the skill records nothing until they paste the export back."; }
        part dcObligationDeckDoDR1 : TestResult { :>> id = "1e8a4d05-6b39-4c72-8e04-fa93c1257b6d"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcViewpointActivation;
        verification dcViewpointActivationDoD : Test { :>> id = "6e07b325-4c81-4a97-b06d-51fe8a29d340"; :>> method = VerificationMethod::test; :>> procedureText = "Implements the human's direction in their D0159 acceptance (viewpoints activatable like processes) under D0164, and resolves issue156. `.engine/contracts/activation.toml` gains a `[viewpoints]` section read by the same loader under the same rule as processes: absent means all active, declared-but-empty means none. Observed in `surfaces_json` (the one derivation behind the console nav and the act obligation bar) and in the `viewpoint-renderer` guard; deliberately NOT observed in concern-coverage, because suppressing an inactive lens there would let a project reach full concern coverage by switching off the concerns it was failing. VERIFIED BY ROUND TRIP, not by the command's own report: deactivate archDriftVP, then `keel activation` shows INACTIVE, the manifest carries both sections with all six active processes preserved, and /api/surfaces stops mentioning it (grep count 1 -> 0); reactivate and delete the manifest restores everything active. That round trip is what caught issue156 - the broken version printed the same success message. Re-run after the clippy refactor that extracted switch_viewpoint. 191 tests, clippy clean, 36 guards ALL PASS."; }
        part dcViewpointActivationDoDR1 : TestResult { :>> id = "b4f28e51-9a06-4d73-8c25-1e73fb0a6d92"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "93b9447"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcOneClickToAct;
        verification dcOneClickToActDoD : Test { :>> id = "5a92f30c-7e18-4b64-a207-93cd6e15b482"; :>> method = VerificationMethod::demo; :>> procedureText = "Resolves issue155. The SERVER names the discharging panel per obligation class in the same pass that computes the count, so the card lands on the panel with the controls in ONE click instead of opening a read-only view that offers a bridge. `discharge_panel(cmd)` is stated per command with a reason rather than inferred from payload shape - a wrong guess would send the human to a panel that cannot act, which is the defect issue154 addressed. None is a first-class answer, so a newly declared act viewpoint still needs no console change and its card reads `click to view (read-only)` rather than overpromising. Verified live: acceptances-pending -> review, authority-queue -> review, findings-awaiting-disposition -> dispositions, sitting-review-due -> none. METHOD IS demo: whether a click now lands in one hop is a browser behaviour D0160 says we cannot execute, and I have asserted unobserved browser behaviour three times this session already."; }
        part dcOneClickToActDoDR1 : TestResult { :>> id = "d7014e83-2b65-4c39-8f10-6ae82b537c94"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcActionableDestination;
        verification dcActionableDestinationDoD : Test { :>> id = "7d3e15a2-6b48-4c09-9e71-84fa20b5cd67"; :>> method = VerificationMethod::demo; :>> procedureText = "Resolves issue154. A panel holding work it cannot discharge now carries a warning-bordered note stating that nothing on it is a control, plus a bridge to the panel that can act - keyed on the PAYLOAD's shape (kinds matching accept/confirm, or a pendingAcceptances array) rather than a list of viewpoint names, so a later-declared class gets it with no console change. The orient panel gained the bridge and an `Awaiting YOUR acceptance` card it had never rendered despite orient always returning the data. The bridge travels as `data-panel` through the same document-level delegation as card targets, so it cannot be orphaned by a re-render. METHOD IS demo, NOT test, and no passing result is recorded from my side: D0160 records that we cannot execute the page, and this is the fourth time I would have been asserting a browser behaviour I cannot observe. The human closes this one."; }
        part dcActionableDestinationDoDR1 : TestResult { :>> id = "c56b09d7-3f81-4e26-a940-1b78ec25f0a3"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcConsoleSelfReport;
        verification dcConsoleSelfReportDoD : Test { :>> id = "4c7f2b98-1a30-4d65-b842-e0193fa6c57d"; :>> method = VerificationMethod::demo; :>> procedureText = "Resolves issue152, and it is NOT resolved by shipping the diagnostics - it is resolved when the human reports what the page says. DELIVERED: click delegation moved to `document` and registered immediately after the element handles, so no later top-level error and no replaced node can orphan it; a targeted click announces `opening <viewpoint>...` before any await; an untargeted card click reports how many targeted cards exist in the DOM; and the file's LAST statement stamps `js ok` plus the clickable-card count into the header. VERIFICATION IS A DEMONSTRATION BY THE HUMAN because D0160 records that we cannot execute the page - the honest method here is `demo`, not `test`, and no passing result may be recorded from my side. THE ONE OBSERVATION THAT DISCRIMINATES: if the header does not read `js ok`, the script threw before its end; if it does, the listener is attached and the click message says whether a target was found."; }
        part dcConsoleSelfReportDoDR1 : TestResult { :>> id = "e83a15c6-70b4-4e29-9d07-2b56cf1a94e0"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcOversightAdvisory;
        verification dcOversightAdvisoryDoD : Test { :>> id = "9a24e70f-6c53-4b18-8d92-1fe0b57ca346"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue150. (a) `keel serve` runs from a COPY of the binary so it no longer blocks rebuilds - verified by rebuilding while the console kept answering, and recorded in CLAUDE.md section 6. (b) When the model is GREEN, `keel hook stop` advises - never blocks - if items are waiting on the human and no console answers on 127.0.0.1:7777. Verified BOTH WAYS live: with the console down it reported 70 items and named the command to run; with the console up it was silent. The check asks /api/version and requires `apiVersion` in the response, so a foreign process on the port cannot be reported as a console. The count comes from `serve::obligations_json`, extracted to one home so the advisory and the console cannot disagree. Controlled by the_oversight_advisory_never_blocks (the green branch of hook_stop must contain no block decision and must emit a systemMessage) and the_advisory_counts_what_the_console_shows (the reused total must be computable and non-zero here)."; }
        part dcOversightAdvisoryDoDR1 : TestResult { :>> id = "c1b85f30-4d67-4e29-a074-6b3ea9c25d81"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3859cf7"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcActivationSurface;
        verification dcActivationSurfaceDoD : Test { :>> id = "3e58c701-9d42-4b86-a137-6f0ba4c92d18"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue149. `keel activation` now lists every process file in `.engine/processes/`, marking those that assert no guard as `[always] asserts no guard - nothing to switch off`, and the `keel deactivate` refusal distinguishes an unknown process name from a declared-but-unswitchable one, saying what to do instead. Activation semantics are UNCHANGED: it still governs guards (D0138), and no guard changed state - this is a reporting fix, because the mechanism was right and only its surface lied. Verified by declared_processes_is_every_file_not_only_the_guard_bearing_units, which asserts the declared set strictly exceeds the unit set and that every unit is also declared, plus a live read: 18 processes listed where 6 were before, and the two refusal messages differ correctly for `knowledge-graph-memory` versus `no-such-process`."; }
        part dcActivationSurfaceDoDR1 : TestResult { :>> id = "0c96b4f8-7e31-4a25-b968-24da51e0c73f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "a6d6545"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcBatchGitReads;
        verification dcBatchGitReadsDoD : Test { :>> id = "1f47ae0c-6b28-4d91-8305-9ca2e7b41f60"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue147. DO: (1) finish the instrumentation - count spawns at all ~25 a raw `Command::new` git spawn sites, not just the two shared helpers, so the reported total stops understating; (2) replace the per-element historical-content reads with ONE `git cat-file --batch` process fed every (sha, path) pair on stdin. VERIFY on a warmed binary with five samples, and verify with the SPAWN COUNTER as well as the clock - the count is the direct measurement and the clock is the consequence. TARGET: 483 spawns to fewer than 10, and `assured` from ~21s toward the ~6s that remains once 15s of spawn cost is removed. DO NOT accept a wall-clock-only demonstration: a previous 31% improvement on this codebase was noise under five samples, and a previous 62% attribution was invalid because removing git changed the code path (D0050 makes grandfathered_under return None). The spawn counter is immune to both failure modes."; }
        part dcBatchGitReadsDoDR1 : TestResult { :>> id = "5b0c8f31-42d7-4e69-a814-c37e9b25f0da"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        part dcBatchGitReadsDoDR2 : TestResult { :>> id = "8f3d0a62-51c7-4b94-a70e-16de5b8c2947"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "a92e916"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcInstrumentAllGitSites;
        verification dcInstrumentAllGitSitesDoD : Test { :>> id = "6d17b40e-8c25-4f39-b082-a4e7139cf520"; :>> method = VerificationMethod::test; :>> procedureText = "The remaining half of issue147, split out so dcBatchGitReads can be honestly done. The spawn counter covers only `view::git_out` and `govern::git_lines` - two of about 25 a raw `Command::new` git spawn sites - so every reported total UNDERSTATES, and `orient` reports git x0 while demonstrably shelling out. DO: route every site through one counted helper, so the tally cannot silently omit a caller. VERIFY: `orient` reports a non-zero spawn count, and a grep for a raw `Command::new` git spawn outside the shared helper returns nothing - a static check, because a counter that depends on remembering to call it is the manual vigilance D0047 refuses."; }
        part dcInstrumentAllGitSitesDoDR1 : TestResult { :>> id = "a09e5c74-3b18-4d62-8f05-71ca4e39b8d6"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "PENDING"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        part dcInstrumentAllGitSitesDoDR2 : TestResult { :>> id = "a7d88982-7928-44b9-8437-c64fc60fd8bc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "9ef39ed"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcFingerprintEpoch;
        verification dcFingerprintEpochDoD : Test { :>> id = "7a1e5d38-2c60-4b94-8f17-e05b3c92a641"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue145. ONE home for the content fingerprint (`crate::fingerprint`), replacing identical copies in view.rs and serve.rs, memoized by an EXPLICIT EPOCH rather than a timer: a CLI process is one epoch (one-shot, read-only), serve bumps per HTTP request so each request sees one snapshot and the request after a write re-reads, and the SSE change detector uses the uncached `compute` because it IS the detector. Measured with the new KEEL_PERF instrumentation on a warmed binary: `assured` fingerprint 1472ms to 41ms, stats 21,534 to 582, tree walks 74 to 2; `orient` 301ms to 36ms. Invalidation EXERCISED end to end against the running server, not asserted: the fingerprint changed after an edit to .tracking/issues.sysml. Two unit tests cover the memo being keyed by root as well as epoch, and an epoch bump forcing a re-walk. CLI `assured` wall clock did NOT improve materially and that is stated rather than glossed - it is dominated by 483 git spawns, which is a separate finding."; }
        part dcFingerprintEpochDoDR1 : TestResult { :>> id = "b6e04f27-91a3-4c58-8d06-2f73ea5c1849"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "dfd2677"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcComputedBindingSplit;
        verification dcComputedBindingSplitDoD : Test { :>> id = "c82f6a13-4d75-4e09-b731-05af9e2c6d14"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue146. `computed_binding(cmd) -> Option<ComputedFn>` answers IS THIS BOUND from the dispatch table alone and returns the function; `computed_view` is that call plus an application. The old signature `Option<Result<String, _>>` folded boundness and computation into one value, so `api_computed` could only ask the cheap question by answering the expensive one - it computed the view to decide the status code, discarded it, then computed it again through the cache, defeating the per-fingerprint cache its own doc comment advertised. MEASURED SAME-SESSION on the eight endpoints the console requests, three samples each: warm burst 7197ms to 979/1227/1291ms; cold burst 12066ms to 5185/5277/5505ms. Both fixes (this and dcFingerprintEpoch) are in the after number and are not separated, which is stated rather than implied - the fingerprint instrument readings isolate that half directly."; }
        part dcComputedBindingSplitDoDR1 : TestResult { :>> id = "e5c19b04-7f26-4a83-9d15-38b0ce74f291"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "dfd2677"; :>> judgedAt = "2026-08-19"; :>> judgedBy = "claudeOpus5"; }
        action dcImpossibleEvidenceDate;
        verification dcImpossibleEvidenceDateDoD : Test { :>> id = "5c8f3b21-04ae-4d76-9137-a2e608bd5f49"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue144. Guard 36 impossible-evidence-date: a TestResult may not cite a judgedAgainst commit made AFTER its judgedAt, because a judgment cannot be made against a commit that did not exist yet. HARD-blocking and forward-only from 2026-08-18 (D0162), keyed on the CITED COMMIT's date and not on judgedAt - the first draft keyed on judgedAt and exempted the very defect the guard exists for, since a day-old judgment stamped at today's commit is old by judgedAt and brand new by evidence. Verified BOTH WAYS against the live corpus: clean tree PASS at 3799 results scanned, and with the actual defect reintroduced at keel-console.sysml:136 it FAILS naming srConsoleObligationActionableConfirmR1. The thirteen grandfathered cases are two midnight-rollover sessions, each a single commit exactly one day later; five are the human's own attestations, which D0108 forbids me from editing, so the line is drawn rather than their dates rewritten."; }
        part dcImpossibleEvidenceDateDoDR1 : TestResult { :>> id = "e0a74c93-1b62-4f85-a3d0-96c72e5b148f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "fd46d85"; :>> judgedAt = "2026-08-18"; :>> judgedBy = "claudeOpus5"; }
        action dcConsoleLoudFailure;
        verification dcConsoleLoudFailureDoD : Test { :>> id = "8e5b1a67-4c02-4d93-b718-6f3a0e29c845"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue143. Three structural controls so a console failure can never again be indistinguishable from a console no-op: the page is served no-store and stamps the API version it loaded against, so a stale browser is detectable rather than arguable; a thrown render writes the failure INTO the panel instead of leaving the previous view up with a whisper in the status line; and a click announces its target BEFORE its first await, so a click that fired and failed is distinguishable from one that never fired. Verified by a_console_failure_can_never_look_like_nothing_happened (serve.rs), which asserts all four properties, and by the live server returning cache-control: no-store on /. NOT VERIFIED and stated as such: whether any of this fixes the human's reported failure, whose cause remains unknown because D0160 leaves us unable to execute the page."; }
        part dcConsoleLoudFailureDoDR1 : TestResult { :>> id = "b3d7f09a-52e1-4c86-9047-1ae6c85b2f73"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "cb53ba0"; :>> judgedAt = "2026-08-18"; :>> judgedBy = "claudeOpus5"; }
        action dcStaleGateProse;
        verification dcStaleGateProseDoD : Test { :>> id = "1e58a7c0-4d36-4b91-a2f7-83be05c14d29"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue140. Six comments in keel-viewer.sysml claimed Business gates 2, 3 and 5 were PENDING while all three carry passing acceptance results, and one of them misled me into publishing a false claim in a landed critique. DO: rewrite all six to state what IS (no tombstones), correct the false clause in the critique with the correction left visible, and add a guard that fails on a PENDING-style claim within three lines of a PASSING acceptance result - precise enough that an honest PENDING note beside an unsigned gate is untouched. VERIFY both directions: the fixed corpus passes with the acceptance-result count reported, and re-injecting the exact stale comment FAILS with its file and line."; }
        part dcStaleGateProseDoDR1 : TestResult { :>> id = "6c3f19b5-0a74-4e82-95d1-27ef4a806b3c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "6e16e18"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
        action dcViewpointEnumeration;
        verification dcViewpointEnumerationDoD : Test { :>> id = "5d29b7f4-3e60-4a18-9c73-81ea0f5d2b96"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue139, and is a PREREQUISITE for dcUnitPortabilityScope: the viewpoint-renderer hard guard and concern-coverage read one hardcoded filename while the Model globs the views directory, so a viewpoint declared elsewhere escapes the guard - and splitting the registry per-viewpoint would therefore disable the guard for every one of them. DO: source both readers from the same enumeration the Model uses, so the engine holds ONE answer to 'what viewpoints exist'. VERIFY: a test declares a viewpoint OUTSIDE viewpoint-registry.sysml with an unknown renderer and asserts the guard FAILS on it - the direction that was broken, not just the green one; the scanned count rises to include it; concern-coverage reports it; and the existing 32 still behave identically."; }
        part dcViewpointEnumerationDoDR1 : TestResult { :>> id = "9b40e2d7-5c18-4f63-a091-38ec7a2b5f04"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "105da24"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
        action dcUnitPortabilityScope;
        verification dcUnitPortabilityScopeDoD : Test { :>> id = "a1f6c2b3-7d40-4e19-95c8-3ba7e0f24d18"; :>> method = VerificationMethod::inspect; :>> procedureText = "Resolves issue138. A viewpoint is the same portable UNIT shape as a process - files to copy plus names that must exist in the receiving project - but `keel process export` enumerates only activation units. DO: decide whether the unit machinery generalizes (processes and viewpoints as two KINDS of unit, one bundle format, one import that reports what the receiving binary lacks) or whether a viewpoint bundle is a separate command, and record it as a Decision before writing code. Scope the decision on the two facts already measured: 7 of 32 viewpoints have a .view.toml, and 21 of 32 name a keel subcommand as their renderer. VERIFY: the Decision states which way and why; if it generalizes, a viewpoint exported from one project imports into another and the import REPORTS a renderer the receiving binary does not have rather than importing a lens that cannot render."; }
        part dcUnitPortabilityScopeDoDR1 : TestResult { :>> id = "f47ac3b1-6e29-4d80-95a4-08bd2e57c916"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "7f09bc8"; :>> judgedAt = "2026-08-17"; :>> judgedBy = "claudeOpus5"; }
        action dcServeWarmCache;
        verification dcServeWarmCacheDoD : Test { :>> id = "3f80c1a7-6b24-4d95-8e13-07ba5ce29f41"; :>> method = VerificationMethod::test; :>> procedureText = "THE INTERACTIVE SURFACE IS FAST BECAUSE A CACHE HIT IS A CACHE HIT. Measured at the HTTP boundary on the six-request console arrival burst, warm, five samples, same tree: was 1.05-1.17s, now 0.02s. The finding that got there: a HIT cost 137-208ms and the fingerprint was ALL of it (`fp 180ms/604 stat, parse 0ms, build x0, git x0`), because the epoch advanced on every request and each of the six re-statted 604 files. Fixed by advancing the epoch on an OBSERVED CHANGE or a WRITE, never on a read (D0167), with one watcher task per server rather than one poll per open tab. Also: /api/obligations now computes through the shared store instead of a private local, so `orient` is computed once per arrival rather than twice; and the store is keyed by the VIEW rather than the ROUTE. DONE MEANS: the warm burst is under 100ms; an out-of-band edit is still observed and honestly labelled `stale` while it recomputes; a write through the server is visible to the very next read with no wait; and `the_epoch_is_advanced_by_writes_and_observations_not_by_reads` fails if the unconditional bump returns."; }
        part dcServeWarmCacheDoDR1 : TestResult { :>> id = "8d24e0b6-5f19-4a73-b0c8-31ea6d795f02"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e5c376b"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcUuidWellFormed;
        verification dcUuidWellFormedDoD : Test { :>> id = "5b91d3e8-4f07-4a62-9c18-73ea20bd6f45"; :>> method = VerificationMethod::test; :>> procedureText = "Invariant 3 says identity is an immutable UUID. `identity-present` (guard 37) checks that an id EXISTS and `duplicate-identity` checks that two items do not SHARE one; NOTHING checks the string is a UUID. Verified by deliberate corruption: an id of `not-a-uuid-at-all` passes `keel validate` and all 37 guards. DONE MEANS: a guard rejects any id that is not 8-4-4-4-12 lowercase hex, over the same id-bearing declarations guard 37 already walks; it is verified BOTH WAYS on a clean tree and a corrupted one; the corpus is measured BEFORE the guard is written so the need for a grandfather line is known rather than discovered; and it is a text scan, so `Model::build` is never called and `keel assured` does not slow down (the rule sprint 347 set)."; }
        part dcUuidWellFormedDoDR1 : TestResult { :>> id = "fa4ea93e-bb7a-4c62-bf81-04ccf50693cf"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3abc583"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcAuditInstrument;
        verification dcAuditInstrumentDoD : Test { :>> id = "6c14a8f2-3b57-4d90-8e26-71fa05cd3e84"; :>> method = VerificationMethod::test; :>> procedureText = "The hardening audit has NO reusable instrument, so every audit re-derives its probes as throwaway python and gets them WRONG. In this single pass four probes were wrong before they were right: a regex matching `: Process` also matched `: ProcessStep` (131 vs 24), help-text extraction failed twice (reporting `keel orient` as missing when it obviously exists, then 0-of-72 documented), and a registry probe reported 0 skills registered against 35 real ones. Each wrong number was one edit from becoming a recorded finding. DONE MEANS: the audit's questions are COMPUTED views with the rest of them - subcommand-help coverage, process enforcement census, decision follow-through, field-liveness - so the next audit reads numbers instead of inventing probes. This is the highest-leverage item in the pass because it is the one that makes the other findings re-checkable rather than re-derivable."; }
        part dcAuditInstrumentDoDR1 : TestResult { :>> id = "5e44c539-e9b0-4f2c-a4cf-a05725268f79"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcHelpFromDispatch;
        verification dcHelpFromDispatchDoD : Test { :>> id = "b7e0396c-5d24-4a81-9f03-28ce74ab516d"; :>> method = VerificationMethod::test; :>> procedureText = "`keel --help` names 38 of 72 top-level subcommands; 34 are absent (47%), including `assured`, `intake`, `rootedness`, `suspect`, `reverify`, `dispositions`, `open-issues`, `indicators`, `concern-coverage` and `tier-satisfaction`. The CLI is the authority and the automation substrate (D0093), and nearly half of it is undiscoverable from its own front door - a reader who has not read CLAUDE.md cannot find the commands the discipline depends on. DONE MEANS: help is DERIVED from the dispatch table rather than hand-maintained beside it, and a test asserts every dispatch arm is reachable from help output. Hand-maintained help next to a hand-maintained match is two truths (section 1)."; }
        part dcHelpFromDispatchDoDR1 : TestResult { :>> id = "1ca654d3-2836-4b46-b690-47fa7517cbba"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcProcessEnforcement;
        verification dcProcessEnforcementDoD : Test { :>> id = "2f8b51d0-7c46-4e93-a105-63da09be2c71"; :>> method = VerificationMethod::test; :>> procedureText = "13 of 19 processes assert NO guard - `keel activation` prints `asserts no guard - nothing to switch off` for actor-enrollment, architectural-critique, definition-of-done, definition-of-ready, deploy, diagram, distributed-collaboration, indicator, intake, introduction, knowledge-graph-memory, migration and report. D0141 says processes assert their constraints; for 68% of the catalogue the assertion is empty, which means the process cannot be enforced, `activate`/`deactivate` is a no-op on it, and adoption is a claim rather than a control. Some of these are genuinely unenforceable by a text guard (a critique is a judgment), and that is exactly the distinction nothing currently records. DONE MEANS: every process either asserts a guard or carries a recorded justification for why its constraint is not machine-checkable - and the ratio is an INDICATOR, since a guard cannot be conjured for a genuinely human step (invariant 7)."; }
        part dcProcessEnforcementDoDR1 : TestResult { :>> id = "db2073cb-eb2d-44ef-8ea5-cc540b4b7aa4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcDecisionFollowThrough;
        verification dcDecisionFollowThroughDoD : Test { :>> id = "9a45c7e1-8f30-4b62-9d17-50ba21ce7f39"; :>> method = VerificationMethod::test; :>> procedureText = "An ACCEPTED Decision can promise an artifact that is never built, and nothing notices. D0161 was accepted 2026-08-20 and its `.knowledge/` retrieval index DOES NOT EXIST. 64 of 161 accepted Decisions have no `#CharteredBy` work at all - most legitimately, because a policy Decision needs no implementation, and that ambiguity is the defect: the model cannot distinguish `accepted and needs nothing` from `accepted and abandoned`. That is the mechanism behind the human's report of half-baked implementations. DONE MEANS: a Decision that promises a named artifact declares it, and a computed view reports accepted Decisions whose promised artifact is absent. Not a gate - a Decision may be accepted long before it is built, and blocking would only push the promise out of the record."; }
        part dcDecisionFollowThroughDoDR1 : TestResult { :>> id = "c2efc4cf-e15f-4dc6-abd1-9ed28e0c389a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcActualHoursOrRetire;
        verification dcActualHoursOrRetireDoD : Test { :>> id = "4d72e0b9-1a68-4c53-8b04-95fc37ae2d16"; :>> method = VerificationMethod::test; :>> procedureText = "354 of 358 sprints record no `actualHours` - the field carries data in 1% of the corpus. D0072 accepted it as the record of AI time and `keel audit` reports the gap as `estimation_discipline`. A field populated 1% of the time is not discipline; it is either a dead field dressed as a practice, or a practice nobody performs. Both readings are worse than deciding. DONE MEANS: either the field is filled as a matter of course (a write-path default, since a human is not going to type it), or D0072 is superseded and the field is REMOVED with its audit metric - per the doc-removal rule, state what is, do not leave a tombstone. Recording an unpopulated field as a metric trains a reader to ignore the metric, which is issue160's warning-fatigue one layer down."; }
        part dcActualHoursOrRetireDoDR1 : TestResult { :>> id = "955d6bc7-1bc2-4531-aec2-893ec6a55640"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcCharterProvenanceSplit;
        verification dcCharterProvenanceSplitDoD : Test { :>> id = "8e0c4a63-2d19-4f75-b830-16ca57de9241"; :>> method = VerificationMethod::test; :>> procedureText = "306 of 360 delivery Stories are chartered by a Decision I authored; 53 reach a Need; 1 is an orphan. The engine's stated purpose is tracking work that satisfies stakeholder needs, and 85% of its own work is self-chartered - which D0064 explicitly permits as decision-driven engine evolution, and that permission is what makes the number unfalsifiable. Paired with `keel intake` reporting 472 of 480 downstream items as unsourced, the model cannot currently distinguish legitimate engine evolution from work the AI invented. DONE MEANS: `decision_chartered` is split so that a charter tracing to a Decision that itself traces to a Statement or Need is counted separately from one that traces to nothing but my own judgment. The number is not the problem; the fact that one number covers both cases is."; }
        part dcCharterProvenanceSplitDoDR1 : TestResult { :>> id = "8d1cc480-9cdb-4eb3-b133-7678ef3c8188"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcUnknownNameFails;
        verification dcUnknownNameFailsDoD : Test { :>> id = "c93e4b17-6f28-4d05-8a71-24be05cd7e39"; :>> method = VerificationMethod::test; :>> procedureText = "A read command given a name that does not exist returns EXIT 0 and a valid-looking empty result. `trace .` gives upstream [] downstream []; `trace-need .` gives trace []; `actor-trace .` and `governing-version .` answer as though the name were real; `boundary .` and `item .` return an `error` KEY with rc=0, which is dual signalling. D0093 makes the CLI the automation substrate, and a consumer reads that as 'this item has no relations', not 'there is no such item' - so a typo in a script becomes a silent wrong answer rather than a failure. `report`, `render` and `arch` already exit nonzero for an unknown argument, so the CLI is inconsistent with itself. DONE MEANS: an unresolvable name exits nonzero with a message naming the item, uniformly across every name-taking read command, and a test pins it."; }
        part dcUnknownNameFailsDoDR1 : TestResult { :>> id = "69686eef-4c98-431e-b102-0f49841d4a54"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcAdvertiseApiSurface;
        verification dcAdvertiseApiSurfaceDoD : Test { :>> id = "7f05a2e6-8c31-4b94-9d60-53ca17be0d28"; :>> method = VerificationMethod::test; :>> procedureText = "13 of 46 HTTP routes are referenced by NEITHER the console nor the contract `/api/version` advertises: baseline-compare, change-impact, check, critique-plan, edge, fingerprint, grammar, index, item/attr, relations, scope, slice, snapshot. D0114 commits a VERSIONED read API for a separate viewer app, so an endpoint the console does not call is legitimate - but an endpoint nothing declares is unaccounted surface, and a consumer cannot discover it. THIS IS ISSUE172 ONE LAYER OUT: a hand-maintained advertisement beside a hand-maintained router, drifting in one direction only. DONE MEANS: `/api/version` advertises the route set DERIVED from the router rather than hand-listed, and a test asserts every route is either advertised or referenced by the console - so a new endpoint cannot land unaccounted."; }
        part dcAdvertiseApiSurfaceDoDR1 : TestResult { :>> id = "79ea9016-c187-4ee1-b7d7-68629c545fed"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcFlagIsNotAPath;
        verification dcFlagIsNotAPathDoD : Test { :>> id = "d15e7a04-3c96-4b28-8f51-70ba24ce6d13"; :>> method = VerificationMethod::test; :>> procedureText = "`keel init --help` CREATES A DIRECTORY NAMED `--help` and scaffolds a whole engine into it. Found by accident: a robustness sweep ran `<cmd> --help` across every subcommand, and 277 files landed in this repository under a directory called `--help` and were COMMITTED before anyone noticed. A positional path argument accepts anything, so a mistyped or unsupported flag becomes a filesystem mutation - the worst possible failure mode for the one command whose whole job is writing a tree to disk. DONE MEANS: any argument beginning with `-` is REJECTED where a path is expected, across every command that takes a path or a name, with a message saying the flag is unrecognised rather than treating it as a target; verified on `init` and on the name-taking commands; pinned by a test."; }
        part dcFlagIsNotAPathDoDR1 : TestResult { :>> id = "8dbc435b-757c-4c60-b196-e3779cdd71a7"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcGuardScanCount;
        verification dcGuardScanCountDoD : Test { :>> id = "e04a7c92-5b13-4f68-9d20-46ca81be5f07"; :>> method = VerificationMethod::test; :>> procedureText = "Nine of 38 guards report `0 scanned` - base-first-justification, charter, critic-independence, doc-sync, edge-endpoints, ownership, process-change, requirement-rootedness, retro-backlog. Three of them HARDCODE `scanned: 0` while doing real work, and `requirement_rootedness` receives its own count and discards it (`Ok(Some((_scanned, gaps)))`). PROVED THEY STILL ENFORCE: a deliberately dangling edge made edge-endpoints FAIL - printing `0 scanned, 0 warning(s), 1 violation(s)`, which is internally contradictory output. So this is a REPORTING defect, and the damage is that `scanned` is the one number that would let anyone audit guard liveness, and it is absent in exactly the nine cases where you would want to ask. It nearly cost a false finding: `0 scanned` reads as `this guard can never fire`. DONE MEANS: every guard reports a scan count that is the size of the population it actually examined; no guard can report a violation with 0 scanned; pinned by a test over the full guard set."; }
        part dcGuardScanCountDoDR1 : TestResult { :>> id = "2455b1cf-4a9d-447a-a726-589d7bf93e7e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcHookBoundedLife;
        verification dcHookBoundedLifeDoD : Test { :>> id = "f28b04c6-7d51-4a93-8e60-31ca75be2d18"; :>> method = VerificationMethod::test; :>> procedureText = "`keel hook` blocks on an unbounded `stdin().read_to_string()`. If the parent goes away without closing stdin, the hook process waits forever and holds a Windows file lock on `target/release/keel.exe`, so EVERY subsequent `cargo build` fails with `Access is denied (os error 5)`. Observed three times in one turn during hardening pass 4: a stray keel.exe had to be killed by PID before the build would proceed. THE IN-LOOP GATE CAN WEDGE THE BUILD IT GATES, which is the worst property an in-loop tool can have - it fails in a way that looks like a toolchain problem rather than a hook problem. DONE MEANS: a hook process has a BOUNDED lifetime - a watchdog exits it after a few seconds - and it exits 0 when it does, because D0134 says a hook never fails a turn. Verified by starting a hook with no stdin and watching it exit on its own rather than needing a kill."; }
        part dcHookBoundedLifeDoDR1 : TestResult { :>> id = "d255b843-6306-4995-87f9-c166a656c59e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcDateNeverDefaulted;
        verification dcDateNeverDefaultedDoD : Test { :>> id = "a37c0b58-9e24-4d61-8f03-52ba17ce4d29"; :>> method = VerificationMethod::test; :>> procedureText = "FIVE write paths silently default a provenance date to the hardcoded literal 2026-01-01: append-result, append-gate-result, record-measurement, snapshot-indicators and apply-review. CLAUDE.md says provenance is never defaulted, and that rule was implemented for the ACTOR only - the DATE was defaulted to a false constant. A TestResult or Measurement written without an explicit date claims it happened on 2026-01-01, which corrupts any time series and feeds guard 36, whose entire job is catching evidence that cites an impossible date. LATENT, NOT ACTIVE: zero items in the corpus carry 2026-01-01, because every real invocation has passed an explicit date - so this is a trap that has never fired rather than damage to repair, and saying so is part of the finding. FOUND BY A WRITE-API SMOKE TEST that invoked every write command with no arguments: `keel snapshot-indicators` alone MUTATED THE TREE, stamping two Measurements dated 2026-01-01. DONE MEANS: the date is REFUSED rather than defaulted, so a bare invocation cannot write; every one of the five sites errors without an explicit date; and a test forbids a hardcoded date literal in a write path."; }
        part dcDateNeverDefaultedDoDR1 : TestResult { :>> id = "09098fd7-6eeb-4445-adad-e97d5977515f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcLensCannotFalseGreen;
        verification dcLensCannotFalseGreenDoD : Test { :>> id = "c81b6f03-4a29-4d57-9e14-70ba53ce8d26"; :>> method = VerificationMethod::test; :>> procedureText = "`keel hardening` reports `helpCoverage 0/0 -> 100%` and `apiSurface unaccounted 0` when it cannot read `keel-cli/src` AT ALL. Verified against a tree containing only .engine and .tracking - which is what every DOWNSTREAM project is, since they run the installed binary rather than this source tree. So the lens built one sprint earlier to stop wrong numbers hands a clean bill of health to every consumer who cannot possibly be measured. THE MECHANISM IS A HELPER I WROTE: `pct(part, whole)` returns 100 when whole is 0, and the lenses treat an unreadable file as an empty one. A FALSE GREEN IS WORSE THAN A WRONG NUMBER because nobody investigates a pass. DONE MEANS: a lens that cannot read its input reports UNAVAILABLE with the reason and NO percentage; `pct` cannot return 100 for an empty population; verified on a tree with no source; and the source-tree-only limitation, already stated in D0169, is enforced rather than merely documented."; }
        part dcLensCannotFalseGreenDoDR1 : TestResult { :>> id = "27e625fe-5695-44c8-b253-d9e53daaa42b"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcAtomicModelWrite;
        verification dcAtomicModelWriteDoD : Test { :>> id = "b640e7a1-5c93-4d28-8f06-71ca42be3d95"; :>> method = VerificationMethod::test; :>> procedureText = "Every model write is `std::fs::write(path, content)` - 16 sites in write.rs plus 5 across actor/enroll/activation - which TRUNCATES the file and then writes. If the process dies between those two steps the authoritative record is left truncated or half-written. Invariant 1 says text is truth; the write path to that truth is not atomic, and no temp-file-plus-rename helper exists anywhere in the crate. THE BOUNDED PART, stated honestly: the gate catches a truncated file as a parse error, so the blast radius is a red gate rather than silent corruption - EXCEPT for a partial write that still parses, which is the case that gets committed. DONE MEANS: one helper writes to a sibling temp file and RENAMES over the target, every model write site uses it, and a test proves the target is either the old content or the new content and never a prefix of the new one."; }
        part dcAtomicModelWriteDoDR1 : TestResult { :>> id = "51140ab6-e52b-4ec3-918a-97c4846c84b3"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcConcurrentWriteSafe;
        verification dcConcurrentWriteSafeDoD : Test { :>> id = "d72f05b8-6c41-4a93-8e27-50ba63ce9d14"; :>> method = VerificationMethod::test; :>> procedureText = "FOUR concurrent `keel record issue` calls against the same file landed TWO issues. All four exited 0, the tree validated clean, and no temp file was left behind - so two recorded facts vanished with every command reporting success. Every write is a read-modify-write (`read_to_string`, insert, write) with NO lock and NO conflict detection, at eight sites in write.rs. D0108 and D0129 explicitly design for multi-contributor work and instruct a non-owner to ADD items; two contributors adding at once silently discard one. SILENT IS THE DEFECT, not slow: a refused write is recoverable, a lost one is not, and rc=0 on a lost write means no automation can even detect it. DONE MEANS: concurrent writers to the same file are serialised by an atomically-created lock file with bounded retry, a writer that cannot acquire it FAILS LOUDLY rather than proceeding, and the four-way concurrent probe lands 4 of 4."; }
        part dcConcurrentWriteSafeDoDR1 : TestResult { :>> id = "e9aa3454-a0d2-4942-9690-6f7a7f1a7936"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d951cff"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcDeadCoreFields;
        verification dcDeadCoreFieldsDoD : Test { :>> id = "e59b1c76-8a03-4d42-9f18-63ca07be5d21"; :>> method = VerificationMethod::test; :>> procedureText = "Three attributes in FROZEN `schema/core` are neither written nor read: `actualPoints`, `impact`, `reasonForChange` - zero `:>>` settings across the whole model and zero references in the Rust code. `impact` and `reasonForChange` sit on the process-change type, so the CR discipline declares that a change records WHY and WHAT IT AFFECTS, and no change ever has. That is a declared practice nobody performs, which is the same shape as issue175's actualHours at 1% - resolved there by demoting the metric to an indicator. THIS ONE CANNOT BE COMPLETED WITHOUT A SIGNATURE: `schema/core` is frozen (invariant 5), so retiring a field needs explicit human sign-off, and filling them retroactively is impossible because past reasons live in commit messages rather than the model. DONE MEANS: a Decision proposing either retirement or a write-path that fills them going forward, ACCEPTED - and until then the finding stays open rather than being quietly closed as documented."; }
        part dcDeadCoreFieldsDoDR1 : TestResult { :>> id = "d116f584-07cd-41c9-9bbd-c6da022ddebf"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "3abc583"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcDeckIsPortable;
        verification dcDeckIsPortableDoD : Test { :>> id = "f471a03c-6d29-4b58-8e07-52ba14ce9d63"; :>> method = VerificationMethod::test; :>> procedureText = "Their words: cement the mobile, automatic-feedback (NO copy paste), claude-hosted artifact skill that clearly delineates decisions, so it is reusable anywhere keel is used. THREE PROPERTIES ALREADY HELD - mobile-first fluid column with a device-width viewport, published as a Claude-hosted artifact, and already a LIVE DOC via the `artifact` capability. TWO DID NOT: the skill deployed NO process, so it could not travel (D0128 makes a process the movable unit, and `keel activate` operates on processes); and `Copy for Claude` sat in every view including writable ones, teaching a habit the live doc exists to remove. DONE MEANS: a declared process with five steps; the skill registry naming it (D0059); acceptance cards carrying `Sign` plus a heavier rail and a `needs your signature` ribbon while other classes keep `Accept`; the copy button hidden unless the view genuinely cannot write; and the counts verified from the EMITTED HTML rather than from reading the generator."; }
        part dcDeckIsPortableDoDR1 : TestResult { :>> id = "1656ff2f-6940-44fb-acaf-416ed2ee0aa5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "40d4f5b"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcDeckButtonsLive;
        verification dcDeckButtonsLiveDoD : Test { :>> id = "b0c37e14-5f28-4d63-9a05-71ba46ce8d29"; :>> method = VerificationMethod::demo; :>> procedureText = "The published deck reported by the human as having buttons that DO NOT WORK. ROOT CAUSE, and it is an anti-pattern the skill itself documents: on a live doc the runtime switches a sync region OFF when the regions DOM is changed by SCRIPT rather than by a gesture. `count()` ran at the end of the script and set `#cnt.textContent`, so the bodys region went off the instant the page loaded, before the human touched anything. The `claude:sync-off` handler then set `data-local-readonly=true`, which is anti-pattern 3 - concluding read-only from a benign region-off - so the page declared itself unwritable and every tap reported `not saved`. THREE FIXES: the initial count is RENDERED BY THE GENERATOR (the contracts own instruction), so no DOM write happens at load; read-only is concluded ONLY from a sync() rejection carrying not_writer or not_granted; and the last statement of the script sets a `data-local-*` marker that CSS renders as `script ok`, so its ABSENCE says the script threw. TWO MORE DEFECTS FOUND IN THE SAME PASS, both mine from the previous sprint: `var(--acc)` is not a declared property so the signature ribbon silently lost its colour, and the marker set an attribute nothing displayed. DONE MEANS: zero top-level DOM mutations before the click listener registers, verified from the EMITTED HTML; and the human confirms a tap turns a card and the header reads `script ok` - which only they can confirm."; }
        part dcDeckButtonsLiveDoDR1 : TestResult { :>> id = "7ad3866c-0e8d-4cfd-8926-bbc571369bf5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "02ea1af"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        part dcDeckButtonsLiveDoDR2 : TestResult { :>> id = "cbdc262b-bc41-479f-aff0-285c514fcc87"; :>> outcome = VerdictKind::fail; :>> judgedAgainst = "329b5cb"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcRetroGuardTiesFinding;
        verification dcRetroGuardTiesFindingDoD : Test { :>> id = "a80f5c27-3e94-4b61-8d05-72ca16be4d59"; :>> method = VerificationMethod::test; :>> procedureText = "The retro-backlog guard passes when ANY tracked item is co-staged with a retro-bearing commit, so a retro finding never needs ITS OWN item as long as the sprint recorded something else - and every hardening commit did, which is how one failure class reached five retros and zero backlog items. DONE MEANS: the guard ties the co-staged item to THE FINDING - the retro text names the item it produced, or carries a recorded no-item justification - verified both ways on a retro with an untracked finding and one with a tracked one."; }
        part dcRetroGuardTiesFindingDoDR1 : TestResult { :>> id = "ba0ba73f-7add-4be1-a6a4-3262ffcd0c6c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "edd129a"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action dcEmittedJsMustParse;
        verification dcEmittedJsMustParseDoD : Test { :>> id = "e17f42b9-6c05-4a83-9d20-58ba31ce7f64"; :>> method = VerificationMethod::test; :>> procedureText = "The deck's script contained THREE syntax errors and had therefore been COMPLETELY DEAD since its first publish: a regex fix appended an end-of-line comment inside a single-line .then() and commented out the closing braces; a stray fragment of a replaced multi-line push survived an old edit; and a backslash-n eaten by a heredoc split a string literal across two lines. A syntax error runs NOTHING - no listener, no marker, no debug log - so every button report was the same one defect, and three real fixes (load-time write, async isolation, data-id) shipped untestable because the page they shipped into could not execute at all. EVERY audit I ran grepped STRINGS in the emitted HTML; none parsed the JS, and node was on PATH the whole time. DONE MEANS: the generator's emitted script passes node --check as a hard gate before any publish, wired into the skill's checklist as pass zero - before the string checks, because a parse failure makes every string check meaningless."; }
        part dcEmittedJsMustParseDoDR1 : TestResult { :>> id = "82be89fb-347c-4f3a-be60-391efe7d9207"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "37ea4f3"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcRecorderForwardsBy;
        verification dcRecorderForwardsByDoD : Test { :>> id = "3d4ca0b4-8ad6-4495-c76c-ebfe69ad3230"; :>> method = VerificationMethod::test; :>> procedureText = "The inbox recorder treats the actor as DATA IT CARRIES: every path (finding disposition, decision acceptance/rejection, sitting review) forwards the row's By as judged_by, so a verdict is recorded as the person who tapped it - never as the session actor the server would otherwise resolve (issue197: a High disposition landed as judgedBy=claudeOpus5, guard-invisible because D0165's delegation makes an AI judge legal). Attestation text composes the event's substance - who tapped what, row id, timestamp, deck HEAD, note verbatim when present - never a bare row pointer. Rehearsed on a served COPY: recorded, view-verified, tree validates. The two mis-recorded facts were corrected before commit and their texts state the correction."; }
        part dcRecorderForwardsByDoDR1 : TestResult { :>> id = "4e5db1c5-9be7-4506-8d7d-0cbf70be4341"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d24d52d"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcInboxTransport;
        verification dcInboxTransportDoD : Test { :>> id = "f8ed6b70-4c92-4051-8368-a7ba25cf9eeb"; :>> method = VerificationMethod::test; :>> procedureText = "Their instruction: just make the remote artifact pipeline work; test again. DONE MEANS: the dead live-doc fallback is REPLACED by the mcp inbox - the page delivers each tap as one row to the keel-deck-inbox sheet via the viewer's Smartsheet connector and shows the store's row id as its receipt (the label ladder rung it earned: delivered-to-inbox, never saved); the inbox config lives in .engine/contracts/deck-inbox.toml and a partial config makes the page claim NO transport rather than half of one; connector errors branch per contract code; .engine/tools/deck_inbox_record.py pulls Processed=false rows, records each through the write API, VERIFIES each from the computed view, and dedups by latest-At per (uid, kind); the add_rows request/response pair was OBSERVED live before publish; the local acceptance path sends the API's required file field (issue195) and the e2e's new throwaway-decision fixture makes the acceptance leg unconditional - 17 checks green; the real delivered test row was rehearsed through a served COPY and read back dispositioned from the computed view."; }
        part dcInboxTransportDoDR1 : TestResult { :>> id = "0a1f7c81-5da3-4162-9479-b8cb36da0ffc"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "5264d27"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcToolReferenceGuard;
        verification dcToolReferenceGuardDoD : Test { :>> id = "1b2a8d92-6eb4-4273-a58a-c9dc47eb100d"; :>> method = VerificationMethod::test; :>> procedureText = "Guard 39 (tool-reference): every .engine/tools/<file> named on the LIVING doc surface (processes, skills, docs, contracts, workflows, rules, CLAUDE.md) must exist on disk; decisions and .tracking are excluded as historical records. Exists because sprint 377 recorded a deletion that never happened (issue196) and nothing could notice. Its first dry run found a second stale reference. Unit-tested (missing file flagged, existing file and bare directory mention not, .tracking out of scope) and green over the real tree after the two stale references were fixed and the file actually deleted."; }
        part dcToolReferenceGuardDoDR1 : TestResult { :>> id = "2c3b9ea3-7fc5-4384-b69b-daed58fc211e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "5264d27"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcHonestSaveLabel;
        verification dcHonestSaveLabelDoD : Test { :>> id = "a25d70c8-4b93-4e16-8f52-61ca38be0d74"; :>> method = VerificationMethod::test; :>> procedureText = "MEASURED END TO END WITH THE HUMAN AS THE INSTRUMENT: their phone showed transport=artifact-fallback and `saved` per tap; a fresh fetch of the served document after their taps showed EVERY verdict empty. So sync() resolving proves only that the RUNTIME accepted the write - it does not prove keel can ever read it, and keel demonstrably cannot: the artifact transport is WRITE-ONLY from the receiver's perspective. A confirmation the receiver cannot verify is the runtime marking its own homework. DONE MEANS: the fallback's per-tap label reads `marked in page - NOT confirmed in keel` and its transport line says judgments marked there DO NOT reach keel; the word `saved` appears only on the LOCAL transport, where a 200 from the write API and a view read-back make it true; and the limitation is recorded as the reason mobile needs a route to the TESTED transport (a tunnel to keel serve), which is an infrastructure choice that is theirs."; }
        part dcHonestSaveLabelDoDR1 : TestResult { :>> id = "5df7ae06-6c0b-4d21-bdf2-b2cd90c27757"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "e752393"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcDeckInRust;
        verification dcDeckInRustDoD : Test { :>> id = "f14c38a6-9e72-4b05-8d61-84ae29fc5b93"; :>> method = VerificationMethod::test; :>> procedureText = "Their instruction verbatim: make the artifact locally in rust, test thoroughly, then deploy; use httpx. DONE MEANS: `keel deck` generates the page from the engine (keel-cli/src/deck.rs) off the same computed views the console reads; `keel serve` serves it at /deck; every tap saves through the server's OWN POST endpoints (disposition, decision accept/reject, and the new /api/deck/sitting which records the HUMAN critique with its #Covers edge and REFUSES an AI); the artifact live-doc mechanism is a FALLBACK the page selects only when /api/version does not answer; and .engine/tools/test_deck_e2e.py exercises the whole loop with httpx against a served COPY - 13 checks including verdicts read back from the COMPUTED VIEWS and the human-gate refusal - green before any deploy. The e2e found four real defects pre-deploy: a missing actor binding, an actor name written into the CriticKind enum, a sitting critique that counted for nothing without its Covers edge, and the D0167 staleness window in naive reads."; }
        part dcDeckInRustDoDR1 : TestResult { :>> id = "7fcc6336-7dfa-42e8-8a5d-09f22d757e77"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "db6b575"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcDeckSyncAddressable;
        verification dcDeckSyncAddressableDoD : Test { :>> id = "c53e08b1-7a46-4d92-8f15-60ba27ce4d83"; :>> method = VerificationMethod::demo; :>> procedureText = "Third latch failure, and this time the diagnosis came from EVIDENCE rather than the contract text: WebFetch of the published artifact exposed the frame runtime itself, whose patch layer addresses every synced element by [data-id=...] with an allowlist of data-*/aria-*/class/hidden/value/checked. The deck's cards carried data-uid - the canvas template said data-id and the generator had renamed it - so NO mutation was addressable, nothing could be recorded, and every tap reverted. The same fetch exposed two more defects: the version stamp I told the human to look for existed only inside a JS variable and NEVER RENDERED (my check found it in the file, not on the screen), and the script-ok marker's CSS escape was mangled to plain b7. DONE MEANS: every card and note input carries data-id; script writes ZERO text into the synced region (the pill and count render via CSS from attributes; the last offender, the copy button label, is data-local too); the version is VISIBLE in the sub-line (deck v4); and the human confirms a tap latches - which only they can."; }
        action dcAuthorViaWriteTool;
        verification dcAuthorViaWriteToolDoD : Test { :>> id = "b96d02e5-4c73-4a18-8f60-51ca38be7d92"; :>> method = VerificationMethod::inspect; :>> procedureText = "THE ITEM FIVE RETROS SHOULD HAVE PRODUCED. The failure class: content authored through a shell gets reinterpreted by the shell - heredoc backslash-n becoming real newlines (three times), backticks executed as command substitution deleting words from a recorded issue (twice), quotes breaking mid-string. SIX occurrences across sprints 357-371, each recorded as retro prose, each relearned. THE RULE, now tracked rather than remembered: any authored content containing escapes, quotes, backticks or multi-line strings is written via the Write tool as a FILE (a script, a message file, a patch), and the shell only ever receives file PATHS. DONE MEANS: the rule is in the review-critique process (rcRecurrence cites this item as its founding example), the obligation-review skill carries it, and the next occurrence of the class is judged against this item rather than rediscovered."; }
        part dcAuthorViaWriteToolDoDR1 : TestResult { :>> id = "38486949-84bd-4e2c-a3fd-cf04b605ec5f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "edd129a"; :>> judgedAt = "2026-08-20"; :>> judgedBy = "claudeOpus5"; }
        action issue142Fix;
        verification issue142FixDoD : Test { :>> id = "53a25aca-168e-4fca-8133-4d95ba1b7dca"; :>> method = VerificationMethod::inspect; :>> procedureText = "VERIFIED MOOT, and the DoD itself is evidence of a defect. The original text here was the fragment -in original statement- : damaged at authoring, almost certainly by the shell-mangling class dcAuthorViaWriteTool now tracks (a quote ended the string early and the remainder was silently dropped). The item was a SECOND resolver for issue142, which its sibling dcSharedParsedModel resolved on sprint 358 evidence - the parsed model was already cached, the premise refuted three ways. A pass on this DoD means -verified moot with the damage recorded-, not -work done-."; }
        part issue142FixDoDR1 : TestResult { :>> id = "5d4d21dc-5c1e-4933-b0ef-35e816ef22b5"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "2fabe08"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeOpus5"; }
        action dcDeckFindingJudgedBy;
        verification dcDeckFindingJudgedByDoD : Test { :>> id = "fb4bb4af-7f59-454c-88b6-b208d822c242"; :>> method = VerificationMethod::test; :>> procedureText = "DONE MEANS: the deck's saveLocal finding body carries judged_by=HUMAN and a substantive default rationale (who tapped, no-note stated); delivered in the same commit that corrected the 19 misattributed records; the emitted script still parses under node --check."; }
        part dcDeckFindingJudgedByDoDR1 : TestResult { :>> id = "90bb9ecf-caff-4f09-90db-b31926a030e4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "92254e1"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
        action dcEnforcementPointSpecPin;
        verification dcEnforcementPointSpecPinDoD : Test { :>> id = "43c526ab-e03a-418a-8e0e-e04e99a101ca"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue203 (critique pass 1, srK02 completeness). The build-time spec-pin check (keel-parser build.rs) is an enforcement point the hardening lens's enforcementPoints inventory does not enumerate, and its network-error path resolves to ALLOW (warn-skip) - the exact timeout-resolves-to-allow residual class srK02FailLoud demands be RECORDED, unrecorded. DO: add the point to the enforcementPoints lens with its absent/error/timeout behaviors stated (absent=no build, error=warn-allow, offline-flag=skip-by-declaration); the warn-allow residual appears in the lens output rather than in nobody's head. VERIFY: the lens lists the point; the residual is machine-readable; validate + guards green."; }
        part dcEnforcementPointSpecPinDoDR1 : TestResult { :>> id = "c0a5e333-8b9e-4b00-8907-ed3c95bdfe96"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "114663c"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
        action dcHumanChannelDelegationRule;
        verification dcHumanChannelDelegationRuleDoD : Test { :>> id = "8e5591b6-7e4d-43fb-9230-bda27aba606d"; :>> method = VerificationMethod::confirmation; :>> procedureText = "Resolves issue204 (critique pass 1, srK06 completeness). srK06HumanChannel's letter says human-judgment records originate only from a channel the agent cannot invoke - but the HTTP acceptance endpoint is agent-invokable by design and the sanctioned D0165 delegation practice (AI records the human's verbatim words with judged_by=<human>) uses it, including for D0191 this very week. The letter and the practice contradict; one must move, and WHICH is a direction Decision for the human, not a patch. DO: draft the Decision with both options costed - (a) supersede srK06 with an explicit delegation clause (verbatim words quoted in the record, guard-checkable shape) legitimising the practice, or (b) close the delegation path: acceptances become human-gesture-only (console/deck/TTY), the AI queues instead of recording. Queue it for signature. VERIFY: the proposed Decision exists naming both options and their costs; issue204 resolves via whichever is signed."; }
        part dcHumanChannelDelegationRuleDoDR1 : TestResult { :>> id = "96c87142-2d00-4ffc-9151-7b71acfb6d22"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "247805778bb52b3ac8a1e9a5b96be6da2c6bb36b"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "wweatherholtz"; }
        action dcActorRebindLedger;
        verification dcActorRebindLedgerDoD : Test { :>> id = "41bdafcd-0ae8-45b1-bda8-602db939f6e1"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue205 (critique pass 2, srK07 completeness). keel actor set writes only the machine-local gitignored .keel/actor - an actor rebind, a weakening class srK07RecordedWeakening itself names, leaves no durable record and no visibility. DO: a rebind leaves a durable, surfaced record - at minimum a fire-ledger line (event=actor-rebind) written by cmd set, with the old and new bindings carried in the record (within the frozen 6-field schema's string fields, or as a tracked fact if the schema cannot honestly hold them - the mechanism is the implementer's call, the RECORD is not); surfaced via keel enforcement-report's per-event counts. VERIFY: a rebind is followed by an observable record naming both bindings; a fresh binding (first set) records too; guard/validate green."; }
        part dcActorRebindLedgerDoDR1 : TestResult { :>> id = "b2b1338e-e075-4f79-8003-aba6a499aae0"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "114663c"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
        action dcRunGateTreeDerivable;
        verification dcRunGateTreeDerivableDoD : Test { :>> id = "b2c20337-051f-4172-8a71-746c409b805a"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue206 (critique pass 3, srK15 completeness). The launched-run gate folds a machine-local input into its verdict: finish() turns the gate RED when no fire-ledger line follows the spawn, and .keel/metrics/hooks.jsonl is gitignored - another clone cannot re-derive that run's gate verdict from committed truth, so K15's tree-derivability and K3's enforcement-loss check pull against each other inside one verdict. DO one of the two stated options: (a) demote the fired-since-spawn component to report-only (the problem text stays in the run record, the verdict stays a pure function of the tree), or (b) commit the relevant ledger excerpt into the tracked run record so the input becomes committed truth. VERIFY: a second clone re-derives the same gate verdict for a recorded run; the K3 signal is still visible either way; launcher tests updated."; }
        part dcRunGateTreeDerivableDoDR1 : TestResult { :>> id = "f87f9d13-9468-43e7-975c-c11f65b8e4f7"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "29adc28"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
        action dcOverrideCountedOnSuccess;
        verification dcOverrideCountedOnSuccessDoD : Test { :>> id = "4633616d-5e3f-44dd-b4f7-c534c4340e97"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue207 (critique pass 3, srK14 completeness). consume_override emits a ledger line only on the FAILURE path (override-obligation-UNSYNCED), so enforcement-report's override counter structurally misses every successful override - the normal case is invisible to the very evidence K14 says a promotion review must cite. DO: the happy path emits a ledger line too (event=override-consumed, within the frozen 6-field schema), and the report counts consumed and unsynced separately. VERIFY: a successful override consumption produces a counted line; the report distinguishes consumed from unsynced; pm.rs schema test still green."; }
        part dcOverrideCountedOnSuccessDoDR1 : TestResult { :>> id = "16c89817-9cc4-48e7-9593-d8f95fa2e82e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "114663c"; :>> judgedAt = "2026-08-21"; :>> judgedBy = "claudeFable5"; }
        action dcPrePushBehindCheck;
        verification dcPrePushBehindCheckDoD : Test { :>> id = "05b3c1de-b221-45d1-b07b-a7d68cdd58a7"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue209 (critique pass 5, srDcGateOnMergedTree completeness). A raw git push dodges the sanctioned fetch-integrate-gate-push loop: .githooks has no pre-push, so a contribution gated only in isolation can land on the shared trunk with CI catching it POST-HOC - the SR says it shall never land. DO: a pre-push hook in .githooks (installed by the same sync-claude/hooksPath machinery) that fetches and REFUSES when the local ref is not a fast-forward of the fetched trunk, naming keel land as the sanctioned path (srK13 deny-and-provide) - behind-ness detection only, never the full gate (keel land already gates the merged tree; the hook's job is forcing the loop, not duplicating it). VERIFY: a push from a behind clone is refused with the message; a fast-forward push passes; keel land unaffected; hook portable (no absolute paths, loud when git/binary absent)."; }
        part dcPrePushBehindCheckDoDR1 : TestResult { :>> id = "b8769ef4-b2bc-4934-abaf-94d0cdfd3f37"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "42e5c6b"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
        action dcPerActorAppendFiles;
        verification dcPerActorAppendFilesDoD : Test { :>> id = "4cbb5a2a-b714-46d9-a750-0c42274dafc7"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue210 (critique pass 6, srDcPerActorWriteTargets completeness). append_critique and the issue recorder insert every contributor's records before the same package-closing brace of shared files (critiques.sysml, issues.sysml) - two contributors appending concurrently merge-conflict at identical lines, exactly what the SR forbids; the write-lock serialises one machine only. DO: route NEW records to per-actor files (critiques-<actor>.sysml / issues-<actor>.sysml or equivalent distinct anchors); readers already glob .tracking so reads are unchanged; existing files stay where they are (no history migration - the fix is forward-only routing); the deck/serve write paths pick the target from the acting judge. VERIFY: two clones append one critique each, merge clean, both land; validate + guards green; sequence allocation (issue numbers) stays collision-guarded across the split files (duplicate-identity already scans cross-file)."; }
        part dcPerActorAppendFilesDoDR1 : TestResult { :>> id = "eb4ead5e-26f6-4307-852a-b5af1e4d291a"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "f8279a8"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
        action dcReleaseGatedPublish;
        verification dcReleaseGatedPublishDoD : Test { :>> id = "bc625f86-0f12-47ec-9db1-ad74397b4b87"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue211 (critique pass 9, srRelPublishedArtifact completeness). release.yml runs zero gate steps - a tag on a red or ungated commit still builds and PUBLISHES three platform binaries, while the deploy process's own purpose text promises a full gate between green trunk and tag. DO: a gate job in release.yml (cargo test + keel validate + keel guard over the tagged commit, same surfaces as ci.yml) that the publish job REQUIRES via needs:; the manual-smoke path keeps building without publishing as today. VERIFY: a deliberately red tag in a scratch repo builds but does NOT publish; a green tag publishes; the four existing releases are unaffected (forward-only)."; }
        part dcReleaseGatedPublishDoDR1 : TestResult { :>> id = "ee27cf8e-f5d0-4612-a9e5-83287f89268e"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d3ccabd"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
        action dcRecordDecisionMarkerFlag;
        verification dcRecordDecisionMarkerFlagDoD : Test { :>> id = "f538caad-dc41-4efb-b9b9-67ecb0a872cb"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue213. SECOND occurrence (sprints 395 and 407) of the same commit-time refusal: keel record decision emits a plain Decision, the author forgets the #ProspectiveChange marker, and the process-change guard refuses the landing commit - correct behavior, avoidable friction (D0054). DO: keel record decision gains --process-change (and --safety-change) emitting the D0070 marker + a standard governs-comment; the guard's refusal message names the flag (srK13 deny-and-provide). VERIFY: a decision recorded with the flag carries the marker; a process-def commit citing it passes the guard; docs updated same commit."; }
        part dcRecordDecisionMarkerFlagDoDR1 : TestResult { :>> id = "8ff5581b-44d7-4389-9351-e442bb122b29"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "58f54f0"; :>> judgedAt = "2026-08-22"; :>> judgedBy = "claudeFable5"; }
        action dcAllocationRefresh;
        verification dcAllocationRefreshDoD : Test { :>> id = "4d72c065-e395-4545-8595-0e3e87e6dea7"; :>> method = VerificationMethod::test; :>> procedureText = "Delivers D0194 once signed (panel R1, all five panelists' convergent finding). DO: supersede the June Component set + its allocate edges from d0194; author SR->CodeElement allocate edges for the standing high-consequence set (the 17-element registry); add the allocation-coverage leg to tier-satisfaction (same structural-floor semantics as satisfy/verify); trace-need recomputes over the live mechanism or labels its component layer historical. VERIFY: tier-satisfaction reports the third leg; trace-need no longer serves the queryStack-era components as current; the coverage number is honest even if low."; }
