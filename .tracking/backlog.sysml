        // ---- 2026-06-16 process step-back: CAE+GQM+ATAM audit program (D0046, all 4 accepted) ----
        action rustToolchainFix;     // W1: repair sysmlv2 validate (schema preload) + orient (drop cursor, fix ready-list parse + count parity); add Python<->Rust parity gate; make no-kernel Rust the default validation path; update CLAUDE.md §5
        action deliverySkills;       // W3: build/compile + test/verify skills (cargo build, cargo test, validators) alongside repo-push
        action auditSkill;           // W2: create+register architectural-critique skill (CAE+GQM+ATAM); rewrite critique process to record findings as tracked Issues/Decisions
        action deliverableSuspicion; // W4: extend suspicion so Rust source-tree changes invalidate the parity TestResults (closes the regression-hiding hole)
        first rustToolchainFix then auditSkill;          // audit GQM metrics consume the parity check
        first rustToolchainFix then deliverableSuspicion; // suspicion extension needs the parity mechanism
        action ceremonyGateGuard;    // D0047/issue010: permanent guard — validate_ceremony.py fails commits where a ceremony gate passes while an earlier-ordered gate is unpassed
        action reviewInvocationGuard; // issue011: enforce that the sprint-review Phase-3 transcript scan ran before the review gate is recorded (guard design dispatched at retro)

