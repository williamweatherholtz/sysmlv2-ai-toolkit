        action dcPaletteIsDeclared;
        verification dcPaletteIsDeclaredDoD : Test { :>> id = "2182c48c-d1b1-4a91-b2ad-6c4a7d6bfb78"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue241 (HIGH). `keel process list|search|show|export` iterate act.unit_names() (process_cmd.rs rows()), so the 12 processes that assert no guard are DENIED rather than listed: `keel process show intake` returns 'error: no process intake' while .engine/processes/intake.sysml exists. That violates srPortModularProcessUnit (accepted must: a unit carries its definition, deploying skill and rules/guards so it can be moved between projects whole) and it is the un-swept half of issue149, whose remedy reached `activation`/`activate`/`deactivate` and not the process catalogue - a D0047 correct-at-the-root failure. DO the minimal fix the panel converged on: point rows() at the already-existing, already-tested activation::declared_processes(), mark unit-less rows non-switchable (keep the accurate refusal - a zero-guard unit must NOT become deactivatable, which would re-create 'deactivate reported success and changed nothing'), keep is_process_active true for zero-guard units so no adopted process flips to INACTIVE, and sweep activation-manifest's scanned count (reports 11 of 23). VERIFY: all 23 appear in list/search/show; export works for a guard-less process; the existing declared_processes_is_every_file_not_only_the_guard_bearing_units test still passes; no process changes activation state; an activate/deactivate round-trip does not rewrite the manifest."; }
        part dcPaletteIsDeclaredDoDR1 : TestResult { :>> id = "1d6539f6-a836-4cf9-ae79-91d288c77839"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "bca4265a4f02db2dcddf566db43035103e0a76f3"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcArmedNotDeclared;
        verification dcArmedNotDeclaredDoD : Test { :>> id = "80fc1764-2629-490c-917b-59db14b76d0b"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue240 (HIGH). The commit gate was DISARMED on this machine (core.hooksPath = nul, so git resolved hooks to a nonexistent dir and .githooks/pre-commit never ran) while three shipped surfaces reported it armed: keel hardening says the pre-commit point is present=true failMode=fail-closed, keel orient printed no warning, keel controls reported uncoveredHazards=[]. Root cause: the wiredness predicate is 'git config core.hooksPath returned non-empty', a PROXY for the control being reachable rather than the control being reachable. DO: compute armed-ness as 'the resolved hooksPath directory exists AND contains an executable pre-commit', report ARMED vs DECLARED distinctly for every ctl* with a runtime binding, and add hooksPath=nul as a regression test. VERIFY: with hooksPath=nul the surfaces say NOT ARMED and orient warns; with .githooks armed they say armed; the negative test pins it."; }
        part dcArmedNotDeclaredDoDR1 : TestResult { :>> id = "50a54ea3-02b6-48a4-8232-8bd012242837"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "60dc411f4858899910a2b83ca9ccb7ef9677435a"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcAdherenceCoversActivation;
        verification dcAdherenceCoversActivationDoD : Test { :>> id = "650c5f02-7b35-4715-b329-13e0bece1c02"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue242 (HIGH). Two ways to disarm a control that audit-adherence (D0209 clause 1) cannot see, because signature() reads only .engine/rules/ trees: (a) adding one `assert constraint <guard>` line to a guard-less process file makes a CORE (never-deactivatable) guard become that process's switchable property - guard_state returns Core only when NO unit claims the guard, so claiming it demotes it, and the CLI's own remediation text ADVISES the edit; (b) narrowing activation.toml's active list disarms every guard the removed process owns. Both land inside the keystone at commit time but D0209's premise is independent re-derivation for when the hook is bypassed - and the hook WAS bypassed here (issue240). DO: extend the enforcement signature to include the per-commit effective guard state (Core/Active/Inactive per guard name) derived from processes + activation.toml, so a Core->Inactive or Active->Inactive transition ranks as a weakening needing a signed Decision; stop advising the assert-to-make-switchable remedy. VERIFY: a committed core-guard capture and a committed activation narrowing each return exit 1 naming the guard; the real history still passes."; }
        part dcAdherenceCoversActivationDoDR1 : TestResult { :>> id = "be5e5d35-7bfc-43b1-96dd-4d295365c7f4"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "543e1fa967b8d9d301925a2e6c9d5152c01a0902"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcHonestSurfaceEverywhere;
        verification dcHonestSurfaceEverywhereDoD : Test { :>> id = "a3e2de80-797e-4bb0-8f08-77d62180bd11"; :>> method = VerificationMethod::test; :>> procedureText = "Resolves issue239 (HIGH). nConsoleNeverMisleads (N-C2, human-accepted 2026-08-16) already requires that absence of information be distinguishable from information about absence, that a view which could not be computed never render as a negative result, and that stale content never show as current - but its only satisfying requirement (srConsoleViewStatusExplicit) is scoped to the CONSOLE, while CLAUDE.md/D0093 make CLI/JSON the authority. Every violation found this session was on the CLI side: a catalogue denying processes that exist, a wiredness proxy reporting an unreachable hook as armed, a ratio published without its denominator or floor caveat. DO: widen the invariant to the authority substrate - for every computed answer, on any surface, the answer states which of {computed-with-content, computed-empty, could-not-compute, true-as-of-T} it is and the population it was computed over; derive the requirement, then pick the enforcement leg. VERIFY: the three CLI instances above each report their status and population; a view that cannot compute says so rather than returning empty."; }
        part dcHonestSurfaceEverywhereDoDR1 : TestResult { :>> id = "56cd9990-146a-4d00-928b-7ba6aeec212d"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "26c68ff2c02be662974360d5a34efa9a1a74d5d0"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
        action dcControlsReportArming;
        verification dcControlsReportArmingDoD : Test { :>> id = "53b808f8-96ca-4588-b683-b08df829c1f1"; :>> method = VerificationMethod::test; :>> procedureText = "Follow-on from issue240, stated as a residual rather than silently claimed closed. keel controls (D0195) is a purely DECLARATIVE hazard/control diff: it reported uncoveredHazards=[] for ehz2/ehz4 while their covering control (ctlCommitGate, .githooks/pre-commit + CI) was unreachable, because the view has no notion of runtime arming at all - it cannot distinguish a control that is declared from one that can fire. dcArmedNotDeclared fixed the two predicates that made a POSITIVE false claim (orient, hardening); this closes the third surface. DO: declare, per control, whether its arming is machine-checkable and how (ctlCommitGate -> gitx::commit_gate_armed; CI -> a workflow file naming the gate), then have controls report DECLARED vs ARMED coverage as separate numbers rather than one - a control whose arming is not checkable must say so rather than counting as armed. VERIFY: with the commit gate unreachable, controls reports ehz2/ehz4 as declared-but-not-armed; with it armed they read armed; a control with no checkable binding is reported as such and never silently counted."; }
        part dcControlsReportArmingDoDR1 : TestResult { :>> id = "57848329-2b7d-4c24-b110-7cb6589e1ae3"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "9ca8eeb2afb111f7da277d7cd72bdb531df8c917"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
