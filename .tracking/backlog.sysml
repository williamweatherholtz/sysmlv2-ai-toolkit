        action dcProcessAdherenceAudit;
        verification dcProcessAdherenceAuditDoD : Test { :>> id = "63b9254f-cef4-4c07-b929-e4a1bcc90cbd"; :>> method = VerificationMethod::test; :>> procedureText = "Delivers D0209 clause 1. A CI process-adherence audit that re-derives from the git tree ALONE, on infra the agent cannot touch, that the enforcement signature never weakened unsigned across the pushed range - guard-set/rule-severity monotonicity, the issue236 self-modification class caught independently even when the commit-time hook is bypassed. DO: keel audit-adherence [--since REF] reads each commit's rule severities + guard-constraint bindings via git show (no checkout, CI-fast), flags any weakening/vanishing vs the parent unless that commit co-commits a marked Decision, and EXITS NON-ZERO (a gate, unlike audit-history's report); wired into ci.yml. VERIFY: the real history PASSes; a hook-BYPASSED unsigned rule weakening in a throwaway worktree returns exit 1 with the rule named; unit tests pin the severity ranking."; }
        part dcProcessAdherenceAuditDoDR1 : TestResult { :>> id = "c3633170-aefe-4799-9196-039269069e0f"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "be3e4c1692b29e9502e3047bc866a27259b3e2fe"; :>> judgedAt = "2026-08-24"; :>> judgedBy = "claudeFable5"; }
