        // ── post-D0094 forward items (perf + robustness + coverage; from the console-arc retros) ──
        action assurancePerf; // D0048: kill the per-task git spawn in done_names so the assurance report + guard (a pre-commit gate) are fast.
        verification assurancePerfDoD : Test { :>> id = "a1c70113-0113-4113-9113-516273840113"; :>> method = VerificationMethod::test; :>> procedureText = "D0048 (the Rust toolchain is the FAST kernel-free authority): `report assurance` was ~27s cold, `guard`/`assured` ~15s (and `guard` runs in the pre-commit hook, so this taxes EVERY commit). Profiling pinned it to orient::done_names spawning one `git cat-file` PER task (~N=120 process spawns on Windows). FIX: batch-validate all distinct passing-result SHAs in ONE `git cat-file --batch-check` (the same `valid_commits` helper orient::compute already uses) — identical semantics (empty SHA -> done; else commit-validity, conservative-true on git failure). VERIFY (measured): report assurance 27s->~4.7s, assured 14.9s->~3.6s, guard 15.5s->~3.7s; assured verdict + blocker counts + orient done count BYTE-IDENTICAL before/after; clippy --workspace -D warnings + cargo test (46 lib + all BDD) + keel validate + guard all (13) green."; }
        part assurancePerfDoDR1 : TestResult { :>> id = "5db339ce-f271-4030-8a7f-3707032d6f7c"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "d9dbba2"; :>> judgedAt = "2026-06-23"; :>> judgedBy = "claudeOpus"; }

        action serveAgentCancel; // D0094: process-TREE kill on cancel so a stopped agent reaps its claude.exe grandchild (Windows).
        verification serveAgentCancelDoD : Test { :>> id = "a1c70114-0114-4114-9114-516273840114"; :>> method = VerificationMethod::test; :>> procedureText = "D0094 agent-bridge robustness: on Windows the agent is `cmd /C claude` -> `claude.exe`, and tokio's kill_on_drop reaps only the direct `cmd` child on client disconnect/Stop, ORPHANING the `claude.exe` grandchild (no process-tree kill; #![forbid(unsafe_code)] rules out a Win32 Job Object). FIX: a TreeKiller Drop-guard captures the cmd PID at spawn and runs `taskkill /T /F /PID <pid>` (whole-tree) when the SSE stream is dropped, declared AFTER `child` so it drops first; DISARMED on normal exit so it never targets a reaped/recycled PID. Unix spawns `claude` directly so kill_on_drop already reaps it (guard is a no-op). Never blanket-kills (specific PID tree, not /IM — the user's own session is safe). VERIFY (LIVE): spawn an agent (claude.exe appears, count 14->15), disconnect, confirm the agent's claude.exe PID is reaped (back to 14) while the user's session is untouched; clippy --workspace -D warnings + cargo test + keel validate + guard all (13) green."; }
        part serveAgentCancelDoDR1 : TestResult { :>> id = "345650b0-d783-43ec-8b0e-a9b113912f60"; :>> outcome = VerdictKind::pass; :>> judgedAgainst = "b10fc70"; :>> judgedAt = "2026-06-23"; :>> judgedBy = "claudeOpus"; }

